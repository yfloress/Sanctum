// Shared FilterInput component for search/filter fields

import { Palette } from "../../globals.slint";

export component FilterInput inherits Rectangle {
    in property <string> label: "SEARCH";
    in property <string> placeholder: "Search...";
    in-out property <string> value: "";

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        input-box := Rectangle {
            height: 40px;
            horizontal-stretch: 1;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "🔎";
                    color: Palette.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                input-area := Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    background: transparent;

                    input := TextInput {
                        text <=> root.value;
                        color: Palette.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    if root.value == "" && !input.has-focus: Text {
                        text: root.placeholder;
                        color: Palette.text-subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}
