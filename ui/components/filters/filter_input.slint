// Shared FilterInput component for search/filter fields

import { Theme } from "../../theme.slint";

export component FilterInput inherits Rectangle {
    in property <string> label: "SEARCH";
    in property <string> placeholder: "Search...";
    in-out property <string> value: "";

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        input-box := Rectangle {
            height: 40px;
            horizontal-stretch: 1;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Image {
                    source: @image-url("../../assets/icons/search.svg");
                    width: 14px;
                    height: 14px;
                    colorize: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                }

                input-area := Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    background: transparent;

                    input := TextInput {
                        text <=> root.value;
                        color: Theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    if root.value == "" && !input.has-focus: Text {
                        text: root.placeholder;
                        color: Theme.text-subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                    input.set-selection-offsets(2147483647, 2147483647);
                }
            }
        }
    }
}
