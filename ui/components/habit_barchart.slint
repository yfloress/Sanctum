// ==================== Habit Bar Chart ====================
// Premium Fintech UI - Monthly completion volume chart

import { Palette, MonthlyStats, HabitAdapter } from "../globals.slint";

component ChartBar inherits Rectangle {
    in property <MonthlyStats> stat;

    horizontal-stretch: 1;
    height: 100%;
    background: transparent;
    
    touch := TouchArea { mouse-cursor: pointer; }

    VerticalLayout {
        alignment: end;
        spacing: 10px;

        Text {
            text: stat.total-completions > 0 || touch.has-hover ? round(stat.total-completions) : "";
            color: touch.has-hover ? Palette.text-primary : Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            width: 100%;
            opacity: stat.total-completions > 0 || touch.has-hover ? 1.0 : 0.0;
        }

        // Track
        Rectangle {
            width: 100%;
            vertical-stretch: 1;
            background: Palette.background.with-alpha(0.25);
            border-radius: 10px;
            border-width: 1px;
            border-color: touch.has-hover ? Palette.border-light.with-alpha(0.25) : Palette.border-subtle;
            clip: true;

            // Bar fill (from bottom)
            Rectangle {
                width: parent.width;
                height: stat.total-completions <= 0 ?
                    0px :
                    max(6px, (stat.total-completions / max(1.0, stat.max-completions)) * parent.height);
                y: parent.height - self.height;
                border-radius: 10px;
                clip: true;
                background: transparent;

                animate height { duration: 350ms; easing: ease-out; }

                HorizontalLayout {
                    spacing: 0px;
                    for seg in stat.segments: Rectangle {
                        background: seg.color;
                        horizontal-stretch: seg.fraction;
                    }
                }

                // Subtle shine
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, #ffffff22 0%, #ffffff00 60%);
                    opacity: 0.25;
                }
            }
        }

        // Month Label
        Text {
            text: stat.month-name;
            color: Palette.text-primary;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            width: 100%;
            opacity: touch.has-hover ? 1.0 : 0.85;
        }
    }
}

export component HabitBarChart inherits Rectangle {
    height: 240px;
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        
        // Header
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            Text {
                text: "MONTHLY COMPLETIONS";
                color: Palette.text-secondary;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }

            Text {
                text: HabitAdapter.heatmap-year;
                color: Palette.text-primary;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        
        // Chart area
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Grid lines
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 10px;
                padding-bottom: 24px;
                alignment: space-between;

                for i in 5: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: i == 2 ? 0.35 : 0.12;
                }
            }

            // Bars
            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-top: 6px;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 6px;
                spacing: 10px;

                for stat in HabitAdapter.chart-data: ChartBar {
                    stat: stat;
                }
            }
        }
    }
}
