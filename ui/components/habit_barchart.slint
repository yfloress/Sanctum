// ==================== Habit Bar Chart ====================
// Premium Fintech UI - Monthly completion volume chart

import { Palette, MonthlyStats, HabitAdapter } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component ChartBar inherits Rectangle {
    in property <MonthlyStats> stat;
    
    width: 50px;

    VerticalLayout {
        alignment: end;
        spacing: 8px;
        
        // Bar container
        Rectangle {
            width: 100%;
            height: 100px;
            background: #222222; // Debug background
            border-radius: 4px;
            
            // The actual bar (positioned from bottom)
            Rectangle {
                width: parent.width - 4px;
                x: 2px;
                height: max(5px, (stat.total-completions / max(1.0, stat.max-completions)) * 100px);
                y: parent.height - self.height;
                border-radius: 3px;
                background: stat.dominant-color;
                
                animate height { duration: 400ms; easing: ease-out; }
                
                // Debug text showing value
                Text {
                    text: round(stat.total-completions);
                    color: white;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        
        // Month Label
        Text {
            text: stat.month-name;
            color: Palette.text-primary;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            width: 100%;
        }
    }
}

export component HabitBarChart inherits Rectangle {
    height: 220px;
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        
        // Header
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            Text {
                text: "MONTHLY VOLUME";
                color: Palette.text-secondary;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }

            Text {
                text: HabitAdapter.heatmap-year;
                color: Palette.text-primary;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        
        // Chart area
        Rectangle {
            vertical-stretch: 1;
            background: #0a0a0a; // Debug background
            clip: true;

            chart-scroll := Flickable {
                width: 100%;
                height: parent.height;
                viewport-width: 12 * 54px;
                interactive: true;

                HorizontalLayout {
                    spacing: 4px;
                    padding: 10px;
                    alignment: start;
                    
                    for stat in HabitAdapter.chart-data: ChartBar {
                        stat: stat;
                    }
                }
            }

            // Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: chart-scroll.viewport-width;
                viewport-x: chart-scroll.viewport-x;
            }
        }
    }
}
