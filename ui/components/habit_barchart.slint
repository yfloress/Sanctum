// ==================== Habit Bar Chart ====================
// Premium Fintech UI - Monthly completion volume chart

import { Palette, MonthlyStats, HabitAdapter } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component ChartBar inherits Rectangle {
    in property <MonthlyStats> stat;
    in property <length> bar-width: 36px;

    width: bar-width;
    height: parent.height;
    background: transparent;
    
    touch := TouchArea { mouse-cursor: pointer; }

    VerticalLayout {
        alignment: end;
        spacing: 10px;

        Text {
            text: stat.total-completions > 0 || touch.has-hover ? round(stat.total-completions) : "";
            color: touch.has-hover ? Palette.text-primary : Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            width: 100%;
            opacity: stat.total-completions > 0 || touch.has-hover ? 1.0 : 0.0;
        }

        // Track
        Rectangle {
            width: 100%;
            vertical-stretch: 1;
            background: Palette.background.with-alpha(0.25);
            border-radius: 10px;
            border-width: 1px;
            border-color: touch.has-hover ? Palette.border-light.with-alpha(0.25) : Palette.border-subtle;
            clip: true;

            // Bar fill (from bottom)
            Rectangle {
                width: parent.width;
                height: stat.total-completions <= 0 ?
                    0px :
                    max(6px, (stat.total-completions / max(1.0, stat.max-completions)) * parent.height);
                y: parent.height - self.height;
                border-radius: 10px;
                clip: true;
                background: transparent;

                animate height { duration: 350ms; easing: ease-out; }

                HorizontalLayout {
                    spacing: 0px;
                    for seg in stat.segments: Rectangle {
                        background: seg.color;
                        horizontal-stretch: seg.weight;
                    }
                }

                // Subtle shine
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, #ffffff22 0%, #ffffff00 60%);
                    opacity: 0.25;
                }
            }
        }

        // Month Label
        Text {
            text: stat.month-name;
            color: Palette.text-primary;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            width: 100%;
            opacity: touch.has-hover ? 1.0 : 0.85;
        }
    }
}

export component HabitBarChart inherits Rectangle {
    height: 240px;
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    property <int> month-count: 12;
    property <length> bar-gap: 10px;
    property <length> bar-min-width: 22px;
    property <length> bar-max-width: 56px;
    property <length> inner-padding: 8px;
    
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        
        // Header
        HorizontalLayout {
            height: 28px;
            alignment: space-between;

            Text {
                text: "MONTHLY COMPLETIONS";
                color: Palette.text-secondary;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }

            Text {
                text: HabitAdapter.heatmap-year;
                color: Palette.text-primary;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        
        // Chart area
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Grid lines
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 10px;
                padding-bottom: 24px;
                alignment: space-between;

                for i in 5: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: i == 2 ? 0.35 : 0.12;
                }
            }

            // Bars
            chart-scroll := Flickable {
                width: 100%;
                height: 100%;

                // Prefer to show all 12 months without scrolling if there's space.
                property <length> computed-bar-width: max(
                    bar-min-width,
                    min(
                        bar-max-width,
                        (self.width - 2 * inner-padding - (bar-gap * (month-count - 1))) / month-count
                    )
                );

                property <length> required-width: (month-count * (computed-bar-width + bar-gap)) - bar-gap + 2 * inner-padding;
                viewport-width: max(self.width, required-width);
                interactive: viewport-width > self.width;

                HorizontalLayout {
                    spacing: bar-gap;
                    padding-left: inner-padding;
                    padding-right: inner-padding;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    alignment: start;

                    for stat in HabitAdapter.chart-data: ChartBar {
                        stat: stat;
                        bar-width: computed-bar-width;
                    }
                }
            }

            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: chart-scroll.viewport-width;
                viewport-x: chart-scroll.viewport-x;
                visible: chart-scroll.viewport-width > chart-scroll.width;
            }
        }
    }
}
