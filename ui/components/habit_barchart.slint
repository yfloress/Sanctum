// ==================== Habit Bar Chart ====================
// Premium Fintech UI - Monthly completion volume chart

import { Palette, MonthlyStats, HabitAdapter } from "../globals.slint";

component ChartBar inherits Rectangle {
    in property <MonthlyStats> stat;
    
    width: 36px;

    VerticalLayout {
        alignment: end;
        spacing: 6px;
        
        // Bar container
        Rectangle {
            width: 100%;
            height: 120px;
            background: transparent;
            
            // Background bar (track)
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: Palette.surface-hover;
                opacity: 0.3;
            }
            
            // The actual bar
            Rectangle {
                width: 100%;
                height: stat.max-completions > 0 
                    ? (stat.total-completions / stat.max-completions) * 120px 
                    : 0px;
                y: parent.height - self.height;
                border-radius: 4px;
                background: @linear-gradient(180deg, 
                    stat.dominant-color.brighter(0.2) 0%, 
                    stat.dominant-color 100%
                );
                
                // Shine effect
                Rectangle {
                    width: 50%;
                    height: 100%;
                    border-radius: 4px;
                    background: @linear-gradient(90deg, 
                        #ffffff20 0%, 
                        transparent 100%
                    );
                }

                // Glow effect
                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: parent.width + 4px;
                    height: parent.height + 4px;
                    border-radius: 6px;
                    background: stat.dominant-color;
                    opacity: 0.2;
                }

                animate height { duration: 300ms; easing: ease-out; }
                
                // Hover tooltip
                if touch.has-hover: Rectangle {
                    x: (parent.width - 56px) / 2; 
                    y: -36px;
                    width: 56px;
                    height: 28px;
                    background: Palette.sidebar-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.border-light;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000066;
                    drop-shadow-offset-y: 2px;

                    Text {
                        text: stat.total-completions;
                        color: Palette.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                
                touch := TouchArea {
                    mouse-cursor: pointer;
                }

                states [
                    hover when touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
        
        // Month Label
        Text {
            text: stat.month-name;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            horizontal-alignment: center;
            width: parent.width;
        }
    }
}

export component HabitBarChart inherits Rectangle {
    height: 200px;
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        
        // Header
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;

                // Accent line
                Rectangle {
                    width: 3px;
                    height: 16px;
                    border-radius: 2px;
                    background: @linear-gradient(180deg, #8b5cf6 0%, #ec4899 100%);
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "MONTHLY VOLUME";
                    color: Palette.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }

            // Total indicator
            Rectangle {
                height: 24px;
                border-radius: 6px;
                background: Palette.surface-hover;
                border-width: 1px;
                border-color: Palette.border;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;

                    Text {
                        text: "📊";
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "12 months";
                        color: Palette.text-muted;
                        font-size: 10px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
        
        // Chart area
        Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            viewport-width: 12 * (36px + 8px); // 12 months * (bar width + spacing)
            interactive: true;

            HorizontalLayout {
                alignment: start; // Align start to respect scrolling
                spacing: 8px;
                // horizontal-stretch: 1; // Removed to allow proper scrolling sizing
                
                for stat in HabitAdapter.chart-data: ChartBar {
                    stat: stat;
                }
            }
        }
    }
}
