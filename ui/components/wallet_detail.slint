// ==================== Wallet Detail Panel ====================
// Noir Fintech - Premium wallet details drawer

import { CryptoAdapter, AppState, NotificationAdapter } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { CryptoIcon } from "./crypto_widgets.slint";

// ==================== Section Header ====================
component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;

        Rectangle {
            width: 3px;
            height: 16px;
            border-radius: 1px;
            background: Theme.accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            vertical-alignment: center;
        }
    }
}

// ==================== Holding Row ====================
component WalletHoldingRow inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    in property <string> name;
    in property <string> amount;
    in property <string> value;

    height: 56px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            CryptoIcon {
                symbol: root.symbol;
                icon: root.icon;
                y: (parent.height - self.height) / 2;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.symbol;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }

                Text {
                    text: root.name;
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.amount;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: right;
            }

            Text {
                text: root.value;
                color: Theme.text-muted;
                font-size: 10px;
                horizontal-alignment: right;
            }
        }
    }
}

// ==================== Transaction Row ====================
component WalletTransactionRow inherits Rectangle {
    in property <string> tx-id;
    in property <string> tx-type;
    in property <string> tx-date;
    in property <string> tx-amount;
    in property <string> tx-price;
    in property <string> tx-fee;
    in property <string> tx-notes;
    in property <bool> tx-is-swap: false;
    in property <bool> is-last: false;

    callback delete-clicked(string);
    callback edit-clicked(string);

    property <bool> show-swap: root.tx-is-swap;
    property <bool> is-inflow: root.tx-type == "BUY" || root.tx-type == "IN";
    property <bool> is-outflow: root.tx-type == "SELL" || root.tx-type == "OUT";

    height: 64px;
    background: transparent;

    touch-area := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            background: transparent;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                horizontal-stretch: 1;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: root.is-inflow ? Theme.success.with-alpha(0.1) : root.is-outflow ? Theme.danger.with-alpha(0.1) : root.show-swap ? Theme.primary.with-alpha(0.1) : Theme.text-muted.with-alpha(0.1);
                    border-width: 1px;
                    border-color: root.is-inflow ? Theme.success.with-alpha(0.2) : root.is-outflow ? Theme.danger.with-alpha(0.2) : root.show-swap ? Theme.primary.with-alpha(0.2) : Theme.border;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: root.is-inflow ? "▲" : root.is-outflow ? "▼" : root.show-swap ? "⇄" : "•";
                        color: root.is-inflow ? Theme.success : root.is-outflow ? Theme.danger : root.show-swap ? Theme.primary : Theme.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.tx-type;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        overflow: elide;
                    }

                    Text {
                        text: root.tx-date;
                        color: Theme.text-muted;
                        font-size: 10px;
                    }

                    if root.tx-notes != "": Text {
                        text: root.tx-notes;
                        color: Theme.text-subtle;
                        font-size: 9px;
                        overflow: elide;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.tx-amount;
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: right;
                }

                if root.tx-price != "" && root.tx-price != "N/A": Text {
                    text: "@ " + root.tx-price;
                    color: Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: right;
                }
                if root.tx-fee != "": Text {
                    text: Translations.fee-label + " " + root.tx-fee;
                    color: Theme.text-subtle;
                    font-size: 9px;
                    horizontal-alignment: right;
                }
            }

            // Edit Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: edit-touch.has-hover ? Theme.surface-hover : transparent;
                y: (parent.height - self.height) / 2;

                animate background { duration: 150ms; }

                Image {
                    source: @image-url("../assets/icons/pencil.svg");
                    width: 14px;
                    height: 14px;
                    colorize: edit-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                edit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.edit-clicked(root.tx-id);
                    }
                }
            }

            // Delete Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: del-touch.has-hover ? Theme.danger.with-alpha(0.1) : transparent;
                y: (parent.height - self.height) / 2;

                animate background { duration: 150ms; }

                Text {
                    text: "×";
                    color: del-touch.has-hover ? Theme.danger : Theme.text-muted;
                    font-size: 16px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                del-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.delete-clicked(root.tx-id);
                    }
                }
            }
        }
    }

    if !root.is-last: Rectangle {
        height: 1px;
        width: parent.width;
        background: Theme.border-subtle;
        y: parent.height - 1px;
    }
}

// ==================== Main Panel ====================
export component WalletDetailPanel inherits Rectangle {
    width: 420px;
    height: 100%;
    property <bool> show-delete-transaction: false;
    property <string> delete-transaction-id: "";
    property <string> delete-transaction-label: "";
    property <bool> editing-name: false;
    property <string> edit-name-value: "";
    background: @linear-gradient(180deg, Theme.crypto-panel-gradient-start 0%, Theme.crypto-panel-gradient-end 100%);

    // Left border accent
    Rectangle {
        width: 1px;
        height: 100%;
        x: 0;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header
        Rectangle {
            height: 100px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 16px;

                // Wallet Icon
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: @linear-gradient(135deg, Theme.crypto-icon-gradient-start 0%, Theme.crypto-icon-gradient-end 100%);
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    y: (parent.height - self.height) / 2;

                    if CryptoAdapter.selected-wallet-icon-path == "": Image {
                        source: CryptoAdapter.selected-wallet-icon;
                        width: 24px;
                        height: 24px;
                        colorize: Theme.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if CryptoAdapter.selected-wallet-icon-path != "": Image {
                        source: CryptoAdapter.selected-wallet-icon;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if root.editing-name: Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        x: parent.width - self.width - 2px;
                        y: parent.height - self.height - 2px;

                        Image {
                            source: @image-url("../assets/icons/upload.svg");
                            width: 10px;
                            height: 10px;
                            colorize: Theme.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                CryptoAdapter.icon-edit-wallet-id = CryptoAdapter.selected-wallet-id;
                                CryptoAdapter.icon-edit-wallet-category = CryptoAdapter.selected-wallet-category-key;
                                CryptoAdapter.icon-edit-wallet-icon = CryptoAdapter.selected-wallet-icon-path;
                                AppState.show-edit-wallet-icon = true;
                            }
                        }
                    }
                }

                // Wallet Info
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;

                    if !root.editing-name: Text {
                        text: CryptoAdapter.selected-wallet-name;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 400;
                        letter-spacing: 0.5px;
                    }

                    if root.editing-name: Rectangle {
                        height: 32px;
                        background: Theme.surface;
                        border-radius: 6px;
                        border-width: name-input.has-focus ? 2px : 1px;
                        border-color: name-input.has-focus ? Theme.accent : Theme.border;

                        animate border-color { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;

                            name-input := TextInput {
                                text <=> root.edit-name-value;
                                color: Theme.text-primary;
                                font-size: 14px;
                                vertical-alignment: center;

                                accepted => {
                                    let result = CryptoAdapter.update-wallet-name(CryptoAdapter.selected-wallet-id, root.edit-name-value);
                                    if (result == "") {
                                        root.editing-name = false;
                                        root.edit-name-value = "";
                                    } else {
                                        NotificationAdapter.show(result, true);
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: CryptoAdapter.selected-wallet-category;
                        color: Theme.text-muted;
                        font-size: 11px;
                    }

                    Text {
                        text: CryptoAdapter.selected-wallet-balance;
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }
                }

                // Edit Button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: edit-name-touch.has-hover ? Theme.surface-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    animate background { duration: 150ms; }

                    Image {
                        source: root.editing-name ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/pencil.svg");
                        width: 14px;
                        height: 14px;
                        colorize: edit-name-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    edit-name-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.editing-name) {
                                // Save
                                let result = CryptoAdapter.update-wallet-name(CryptoAdapter.selected-wallet-id, root.edit-name-value);
                                if (result == "") {
                                    root.editing-name = false;
                                    root.edit-name-value = "";
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            } else {
                                // Start editing
                                root.edit-name-value = CryptoAdapter.selected-wallet-name;
                                root.editing-name = true;
                            }
                        }
                    }
                }

                // Close Button
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    animate background { duration: 150ms; }

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            CryptoAdapter.show-wallet-detail = false;
                        }
                    }
                }
            }

            // Bottom border
            Rectangle {
                height: 1px;
                width: parent.width;
                background: Theme.border;
                y: parent.height - 1px;
            }
        }

        // Content
        VerticalLayout {
            padding: 28px;
            spacing: 24px;

            // Holdings Section
            VerticalLayout {
                spacing: 12px;

                SectionHeader {
                    title: "HOLDINGS";
                }

                if CryptoAdapter.wallet-holdings.length == 0: Rectangle {
                    height: 48px;
                    background: Theme.surface.with-alpha(0.3);
                    border-radius: 8px;

                    Text {
                        text: Translations.wallet-no-holdings;
                        color: Theme.text-subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if CryptoAdapter.wallet-holdings.length > 0: Flickable {
                    height: min(256px, CryptoAdapter.wallet-holdings.length * 64px);
                    horizontal-stretch: 1;
                    viewport-height: CryptoAdapter.wallet-holdings.length * 64px;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 8px;

                        for item in CryptoAdapter.wallet-holdings: WalletHoldingRow {
                            symbol: item.symbol;
                            icon: item.icon;
                            name: item.name;
                            amount: item.amount;
                            value: item.value;
                        }
                    }
                }
            }

            // Transactions Section
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                SectionHeader {
                    title: Translations.section-transactions;
                }

                if CryptoAdapter.wallet-history.length == 0: Rectangle {
                    height: 48px;
                    background: Theme.surface.with-alpha(0.3);
                    border-radius: 8px;

                    Text {
                        text: Translations.crypto-no-transactions-found;
                        color: Theme.text-subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: CryptoAdapter.wallet-history.length * 64px;

                    VerticalLayout {
                        for tx[index] in CryptoAdapter.wallet-history: WalletTransactionRow {
                            tx-id: tx.id;
                            tx-type: tx.type;
                            tx-date: tx.date;
                            tx-amount: tx.amount;
                            tx-price: tx.price;
                            tx-fee: tx.fee;
                            tx-notes: tx.notes;
                            tx-is-swap: tx.is-swap;
                            is-last: index == CryptoAdapter.wallet-history.length - 1;

                            delete-clicked(id) => {
                                root.delete-transaction-id = id;
                                root.delete-transaction-label = tx.type + " " + tx.amount;
                                root.show-delete-transaction = true;
                            }
                            edit-clicked(id) => {
                                let result = CryptoAdapter.load-edit-transaction(id);
                                if (result == "") {
                                    AppState.show-edit-crypto = true;
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-delete-transaction: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        z: 1200;

        Rectangle {
            background: Theme.overlay-bg-strong;
            TouchArea {
                clicked => {
                    root.show-delete-transaction = false;
                    root.delete-transaction-id = "";
                    root.delete-transaction-label = "";
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: Translations.confirm-delete-title + "?";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.confirm-delete-generic + " " + root.delete-transaction-label + ". " + Translations.confirm-delete-message;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.action-cancel;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-transaction = false;
                                root.delete-transaction-id = "";
                                root.delete-transaction-label = "";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Theme.delete-bg-active : Theme.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.delete-border;

                        Text {
                            text: Translations.action-delete;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let result = CryptoAdapter.delete-crypto-transaction(root.delete-transaction-id);
                                if (result == "") {
                                    CryptoAdapter.fetch-wallet-details(CryptoAdapter.selected-wallet-id);
                                    root.show-delete-transaction = false;
                                    root.delete-transaction-id = "";
                                    root.delete-transaction-label = "";
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
