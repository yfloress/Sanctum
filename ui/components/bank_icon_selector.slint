// ==================== Bank Icon Selector ====================
// Reusable picker for bank account icons

import { Theme } from "../theme.slint";

component BankIconOption inherits Rectangle {
    in property <image> icon;
    in property <string> icon-path;
    in property <string> label: "";
    in property <string> selected-path: "";
    callback clicked;

    property <bool> is-selected: icon-path == selected-path;

    width: 72px;
    height: 72px;
    background: is-selected ? Theme.surface-hover : Theme.surface;
    border-radius: 12px;
    border-width: is-selected ? 2px : 1px;
    border-color: is-selected ? Theme.accent : Theme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-subtle;

            Image {
                source: root.icon;
                width: 22px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 9px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component BankIconSelector inherits Rectangle {
    in-out property <string> selected-icon: get-default-icon();
    callback icon-changed(string);

    function get-default-icon() -> string {
        return "../assets/icons/building-2.svg";
    }

    init => {
        if (selected-icon == "") {
            selected-icon = get-default-icon();
        }
    }

    height: 260px;
    background: transparent;

    VerticalLayout {
        spacing: 12px;

        Text {
            text: "BANK ICONS";
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                width: parent.width;
                spacing: 12px;

                GridLayout {
                    spacing: 8px;

                    Row {
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/banco-chile.svg");
                            icon-path: "../assets/bank-icons/banco-chile.svg";
                            selected-path: root.selected-icon;
                            label: "Chile";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/banco-estado.svg");
                            icon-path: "../assets/bank-icons/banco-estado.svg";
                            selected-path: root.selected-icon;
                            label: "Estado";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/bci.svg");
                            icon-path: "../assets/bank-icons/bci.svg";
                            selected-path: root.selected-icon;
                            label: "BCI";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/santander.svg");
                            icon-path: "../assets/bank-icons/santander.svg";
                            selected-path: root.selected-icon;
                            label: "Santander";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                    }

                    Row {
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/citibank.svg");
                            icon-path: "../assets/bank-icons/citibank.svg";
                            selected-path: root.selected-icon;
                            label: "Citibank";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/bank-of-america.svg");
                            icon-path: "../assets/bank-icons/bank-of-america.svg";
                            selected-path: root.selected-icon;
                            label: "Bank of A.";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/jpmorgan.svg");
                            icon-path: "../assets/bank-icons/jpmorgan.svg";
                            selected-path: root.selected-icon;
                            label: "JPMorgan";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                        BankIconOption {
                            icon: @image-url("../assets/bank-icons/wf.svg");
                            icon-path: "../assets/bank-icons/wf.svg";
                            selected-path: root.selected-icon;
                            label: "Wells F.";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                    }

                    Row {
                        BankIconOption {
                            icon: @image-url("../assets/icons/building-2.svg");
                            icon-path: "../assets/icons/building-2.svg";
                            selected-path: root.selected-icon;
                            label: "Generic";
                            clicked => { root.selected-icon = self.icon-path; root.icon-changed(self.icon-path); }
                        }
                    }
                }
            }
        }
    }
}
