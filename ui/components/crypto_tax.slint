// Crypto tax tab UI (offline-first)

import { CryptoAdapter, TaxReadinessItem } from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { SectionHeader } from "./sections/section_header.slint";
import { FormField } from "./forms/form_field.slint";
import { TabButton } from "./buttons/tab_button.slint";
import { ActionButton, BorderButton, SanctumCard } from "../widgets.slint";

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> value: false;
    callback toggled(bool);

    height: 68px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 500;
            }

            Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: 38px;
            height: 20px;
            border-radius: 10px;
            background: value ? Theme.accent : Theme.surface-hover;
            border-width: 1px;
            border-color: value ? Theme.accent : Theme.border;
            y: (parent.height - self.height) / 2;

            animate background { duration: 150ms; }

            Rectangle {
                x: value ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: value ? Theme.background : Theme.text-secondary;

                animate x { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(!value); }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!value); }
    }
}

component ReadinessRow inherits Rectangle {
    in property <TaxReadinessItem> item;

    height: 52px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;

    property <color> status-color: item.status == "ok"
        ? Theme.success
        : item.status == "warn"
            ? Theme.warning
            : Theme.danger;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        Rectangle {
            width: 8px;
            height: 28px;
            border-radius: 4px;
            background: root.status-color.with-alpha(0.6);
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.item.code == "settings"
                    ? Translations.crypto-tax-readiness-settings
                    : root.item.code == "history"
                        ? Translations.crypto-tax-readiness-history
                        : root.item.code == "balances"
                            ? Translations.crypto-tax-readiness-balances
                            : root.item.code == "prices"
                                ? Translations.crypto-tax-readiness-prices
                                : root.item.code == "transfers"
                                    ? Translations.crypto-tax-readiness-transfers
                                    : root.item.code;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }

            if root.item.detail != "": Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }
}

export component CryptoTaxTab inherits Rectangle {
    property <string> active-view: "summary";
    background: transparent;

    content := VerticalLayout {
        spacing: Theme.spacing-lg;
        horizontal-stretch: 1;

        SectionHeader {
            title: Translations.crypto-tax-title;
        }

        HorizontalLayout {
            spacing: 8px;

            TabButton {
                text: Translations.crypto-tax-subtab-summary;
                active: root.active-view == "summary";
                clicked => { root.active-view = "summary"; }
            }

            TabButton {
                text: Translations.crypto-tax-subtab-settings;
                active: root.active-view == "settings";
                clicked => { root.active-view = "settings"; }
            }
        }

        if root.active-view == "summary": VerticalLayout {
            spacing: Theme.spacing-lg;

            SanctumCard {
                horizontal-stretch: 1;
                card-padding: 24px;
                background: @linear-gradient(135deg, Theme.crypto-panel-gradient-start 0%, Theme.crypto-panel-gradient-end 100%);
                border-color: Theme.border-subtle;

                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: Translations.crypto-tax-summary-title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    if !CryptoAdapter.tax-summary-ready: Text {
                        text: Translations.crypto-tax-summary-empty;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        ActionButton {
                            text: Translations.crypto-tax-report-generate;
                            primary: true;
                            clicked => { CryptoAdapter.generate-tax-report(); }
                        }

                        BorderButton {
                            text: Translations.crypto-tax-summary-export-history;
                            clicked => { CryptoAdapter.export-tax-history(); }
                        }

                        BorderButton {
                            text: Translations.crypto-tax-summary-export-capital;
                            clicked => { CryptoAdapter.export-tax-report(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;

                SanctumCard {
                    horizontal-stretch: 1;
                    card-padding: 20px;
                    background: Theme.surface;
                    border-color: Theme.border;

                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: Translations.crypto-tax-summary-capital;
                            color: Theme.text-subtle;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.tax-summary-gain;
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                        }

                        Text {
                            text: Translations.crypto-tax-summary-proceeds + ": " + CryptoAdapter.tax-summary-proceeds;
                            color: Theme.text-muted;
                            font-size: 11px;
                        }

                        Text {
                            text: Translations.crypto-tax-summary-cost + ": " + CryptoAdapter.tax-summary-cost;
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                SanctumCard {
                    horizontal-stretch: 1;
                    card-padding: 20px;
                    background: Theme.surface;
                    border-color: Theme.border;

                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: Translations.crypto-tax-summary-income;
                            color: Theme.text-subtle;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.tax-summary-income;
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                        }

                        Text {
                            text: Translations.crypto-tax-summary-income-total;
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }

                SanctumCard {
                    horizontal-stretch: 1;
                    card-padding: 20px;
                    background: Theme.surface;
                    border-color: Theme.border;

                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: Translations.crypto-tax-summary-balance;
                            color: Theme.text-subtle;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.tax-summary-balance;
                            color: Theme.text-primary;
                            font-size: 18px;
                            font-weight: 600;
                        }

                        Text {
                            text: Translations.crypto-tax-summary-balance-total;
                            color: Theme.text-muted;
                            font-size: 11px;
                        }
                    }
                }
            }

            SanctumCard {
                horizontal-stretch: 1;
                card-padding: 20px;
                background: Theme.surface;
                border-color: Theme.border;

                VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: Translations.crypto-tax-readiness-title;
                        color: Theme.text-subtle;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1px;
                    }

                    Text {
                        text: Translations.crypto-tax-readiness-desc;
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        spacing: 8px;
                        for item in CryptoAdapter.tax-readiness: ReadinessRow {
                            item: item;
                        }
                    }
                }
            }

            SanctumCard {
                horizontal-stretch: 1;
                card-padding: 20px;
                background: Theme.surface;
                border-color: Theme.border;

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: Translations.crypto-tax-summary-simulation;
                        color: Theme.text-subtle;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1px;
                    }

                    Text {
                        text: CryptoAdapter.tax-summary-period;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                    }

                    Text {
                        text: Translations.crypto-tax-summary-transactions + ": " + CryptoAdapter.tax-summary-transactions;
                        color: Theme.text-muted;
                        font-size: 11px;
                    }

                    Text {
                        text: Translations.crypto-tax-summary-volume + ": " + CryptoAdapter.tax-summary-volume;
                        color: Theme.text-muted;
                        font-size: 11px;
                    }

                    Text {
                        text: CryptoAdapter.tax-summary-warnings;
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.active-view == "settings": VerticalLayout {
            spacing: Theme.spacing-lg;

            SanctumCard {
            horizontal-stretch: 1;
            card-padding: 24px;
            background: @linear-gradient(135deg, Theme.crypto-panel-gradient-start 0%, Theme.crypto-panel-gradient-end 100%);
            border-color: Theme.border-subtle;

            VerticalLayout {
                spacing: 16px;

                FormField {
                    label: Translations.crypto-tax-period-label;
                    placeholder: Translations.crypto-tax-period-placeholder;
                    value <=> CryptoAdapter.tax-period;
                    edited => {
                        CryptoAdapter.load-tax-settings();
                    }
                }

                Text {
                    text: Translations.crypto-tax-jurisdiction-label;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                }

                HorizontalLayout {
                    spacing: 8px;

                    TabButton {
                        text: Translations.crypto-tax-jurisdiction-cl;
                        active: CryptoAdapter.tax-jurisdiction == "chile";
                        clicked => {
                            CryptoAdapter.tax-jurisdiction = "chile";
                        }
                    }

                    TabButton {
                        text: Translations.crypto-tax-jurisdiction-us;
                        active: CryptoAdapter.tax-jurisdiction == "usa";
                        clicked => {
                            CryptoAdapter.tax-jurisdiction = "usa";
                        }
                    }
                }

                Text {
                    text: Translations.crypto-tax-method-label;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                }

                HorizontalLayout {
                    spacing: 8px;

                    TabButton {
                        text: "HIFO";
                        active: CryptoAdapter.tax-method == "hifo";
                        clicked => { CryptoAdapter.tax-method = "hifo"; }
                    }

                    TabButton {
                        text: "LIFO";
                        active: CryptoAdapter.tax-method == "lifo";
                        clicked => { CryptoAdapter.tax-method = "lifo"; }
                    }

                    TabButton {
                        text: "FIFO";
                        active: CryptoAdapter.tax-method == "fifo";
                        clicked => { CryptoAdapter.tax-method = "fifo"; }
                    }

                    TabButton {
                        text: "CPP";
                        active: CryptoAdapter.tax-method == "cpp";
                        clicked => { CryptoAdapter.tax-method = "cpp"; }
                    }
                }

                ToggleRow {
                    title: Translations.crypto-tax-include-swaps;
                    description: Translations.crypto-tax-include-swaps-desc;
                    value: CryptoAdapter.tax-include-swaps;
                    toggled(value) => { CryptoAdapter.tax-include-swaps = value; }
                }

                ToggleRow {
                    title: Translations.crypto-tax-include-fee-crypto;
                    description: Translations.crypto-tax-include-fee-crypto-desc;
                    value: CryptoAdapter.tax-include-fee-crypto;
                    toggled(value) => { CryptoAdapter.tax-include-fee-crypto = value; }
                }

                HorizontalLayout {
                    spacing: 12px;

                    ActionButton {
                        text: Translations.crypto-tax-save-settings;
                        primary: true;
                        clicked => { CryptoAdapter.save-tax-settings(); }
                    }
                }
            }
        }

        SanctumCard {
            horizontal-stretch: 1;
            card-padding: 24px;
            background: @linear-gradient(135deg, Theme.crypto-panel-gradient-start 0%, Theme.crypto-panel-gradient-end 100%);
            border-color: Theme.border-subtle;

            VerticalLayout {
                spacing: 12px;

                Text {
                    text: Translations.crypto-tax-report-title;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: Translations.crypto-tax-report-desc;
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;

                    ActionButton {
                        text: Translations.crypto-tax-report-generate;
                        primary: true;
                        clicked => { CryptoAdapter.generate-tax-report(); }
                    }

                    ActionButton {
                        text: Translations.crypto-tax-report-export;
                        primary: false;
                        clicked => { CryptoAdapter.export-tax-report(); }
                    }
                }

                Text {
                    text: Translations.crypto-tax-report-summary-label;
                    color: Theme.text-subtle;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                Text {
                    text: CryptoAdapter.tax-report-summary;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    text: Translations.crypto-tax-report-warnings-label;
                    color: Theme.text-subtle;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                Text {
                    text: CryptoAdapter.tax-report-warnings;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

            if CryptoAdapter.tax-jurisdiction == "chile": SanctumCard {
            horizontal-stretch: 1;
            card-padding: 24px;
            background: @linear-gradient(135deg, Theme.crypto-panel-gradient-start 0%, Theme.crypto-panel-gradient-end 100%);
            border-color: Theme.border-subtle;

            VerticalLayout {
                spacing: 12px;

                Text {
                    text: Translations.crypto-tax-ipc-title;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: Translations.crypto-tax-ipc-desc;
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Text {
                    text: Translations.crypto-tax-ipc-source-label;
                    color: Theme.text-subtle;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    BorderButton {
                        text: Translations.crypto-tax-ipc-copy-url;
                        clicked => { CryptoAdapter.copy-ipc-url(); }
                    }
                }

                Rectangle { height: 6px; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    ActionButton {
                        text: Translations.crypto-tax-ipc-import;
                        primary: true;
                        clicked => { CryptoAdapter.import-ipc-csv(); }
                    }
                }

                Text {
                    text: Translations.crypto-tax-ipc-summary-label;
                    color: Theme.text-subtle;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                Text {
                    text: CryptoAdapter.tax-ipc-summary;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            }
        }
    }
}
