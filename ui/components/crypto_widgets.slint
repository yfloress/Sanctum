// ==================== Crypto Widgets ====================
// Noir Fintech - Premium crypto portfolio components

import { Palette } from "../globals.slint";

// ==================== Animated Glow Effect ====================
component GlowDot inherits Rectangle {
    in property <color> glow-color: Palette.success;
    in property <bool> animated: true;
    
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: glow-color;
    
    // Outer glow
    Rectangle {
        x: -4px;
        y: -4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: glow-color.with-alpha(animated ? 0.3 : 0.1);
        animate background { duration: 1500ms; }
    }
}

// ==================== Crypto Icon ====================
component CryptoIcon inherits Rectangle {
    in property <string> symbol;
    in property <bool> large: false;
    
    width: large ? 48px : 36px;
    height: large ? 48px : 36px;
    border-radius: large ? 24px : 18px;
    
    // Gradient background based on symbol
    background: @linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-width: 1px;
    border-color: Palette.border-subtle;
    
    Text { 
        text: symbol; 
        color: Palette.text-primary; 
        font-size: large ? 14px : 11px; 
        font-weight: 700; 
        letter-spacing: 0.5px;
        vertical-alignment: center; 
        horizontal-alignment: center; 
    }
}

// ==================== Change Badge ====================
component ChangeBadge inherits Rectangle {
    in property <string> change;
    in property <bool> is-positive;
    in property <bool> compact: false;
    
    width: compact ? 64px : 80px;
    height: compact ? 22px : 28px;
    border-radius: 4px;
    background: is-positive ? Palette.success.with-alpha(0.12) : Palette.danger.with-alpha(0.12);
    border-width: 1px;
    border-color: is-positive ? Palette.success.with-alpha(0.2) : Palette.danger.with-alpha(0.2);
    
    HorizontalLayout {
        alignment: center;
        spacing: 3px;
        
        Text { 
            text: is-positive ? "▲" : "▼"; 
            color: is-positive ? Palette.success : Palette.danger; 
            font-size: compact ? 8px : 9px;
            vertical-alignment: center;
        }
        Text { 
            text: change; 
            color: is-positive ? Palette.success : Palette.danger; 
            font-size: compact ? 10px : 11px; 
            font-weight: 600; 
            vertical-alignment: center;
        }
    }
}

// ==================== Crypto Row (Table) ====================
export component CryptoRow inherits Rectangle {
    in property <bool> is-last: false;
    in property <string> name;
    in property <string> symbol;
    in property <string> price;
    in property <string> amount;
    in property <string> value;
    in property <string> change;
    in property <bool> is-positive;
    
    callback clicked();

    horizontal-stretch: 1;
    height: 64px;
    background: area.has-hover ? Palette.surface-hover : transparent;
    border-radius: 8px;
    
    animate background { duration: 200ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;
        alignment: start;

        // Asset Column
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: start;
            
            CryptoIcon {
                symbol: root.symbol;
                y: (parent.height - self.height) / 2;
            }
            
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { 
                    text: root.name; 
                    color: Palette.text-primary; 
                    font-size: 14px; 
                    font-weight: 500; 
                    overflow: elide; 
                }
                Text { 
                    text: root.symbol; 
                    color: Palette.text-muted; 
                    font-size: 11px;
                    font-weight: 500;
                    letter-spacing: 0.5px;
                }
            }
        }

        // Price Column
        VerticalLayout {
            width: 120px;
            alignment: center;
            Text { 
                text: root.price; 
                color: Palette.text-primary; 
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: right; 
            }
        }

        // Holdings Column
        VerticalLayout {
            width: 120px;
            alignment: center;
            Text { 
                text: root.amount; 
                color: Palette.text-secondary; 
                font-size: 13px; 
                horizontal-alignment: right; 
            }
        }

        // Value Column
        VerticalLayout {
            width: 120px;
            alignment: center;
            Text { 
                text: root.value; 
                color: Palette.text-primary; 
                font-size: 14px; 
                font-weight: 600;
                horizontal-alignment: right; 
            }
        }

        Rectangle { width: 24px; }

        // 24h Change
        Rectangle {
            width: 90px;
            ChangeBadge {
                change: root.change;
                is-positive: root.is-positive;
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
            }
        }
    }
    
    if !root.is-last: Rectangle { 
        height: 1px; 
        width: parent.width - 32px; 
        x: 16px;
        background: Palette.border-subtle; 
        y: parent.height - 1px; 
    }
    
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ==================== Wallet Row ====================
export component WalletRow inherits Rectangle {
    in property <bool> is-last: false;
    in property <string> name;
    in property <string> category;
    in property <string> balance;
    in property <int> count;
    in property <string> id;

    callback delete;

    property <bool> confirm-mode: false;

    horizontal-stretch: 1;
    height: 72px;
    background: transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 0px;
        alignment: start;

        // Wallet Info
        HorizontalLayout {
            width: 300px;
            spacing: 16px;
            alignment: start;
            
            // Icon based on category
            Rectangle {
                width: 44px; 
                height: 44px; 
                border-radius: 10px; 
                background: @linear-gradient(135deg, #1f1f2e 0%, #2a2a3e 100%);
                border-width: 1px;
                border-color: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
                
                Text { 
                    text: root.category == "exchange" ? "📊" : root.category == "wallet_multi" ? "🔐" : "💳";
                    font-size: 20px; 
                    vertical-alignment: center; 
                    horizontal-alignment: center; 
                }
            }
            
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { 
                    text: root.name; 
                    color: Palette.text-primary; 
                    font-size: 14px; 
                    font-weight: 500; 
                }
                Text { 
                    text: root.category == "exchange" ? "Exchange" : root.category == "wallet_multi" ? "Hardware Wallet" : "Software Wallet";
                    color: Palette.text-muted; 
                    font-size: 11px;
                    letter-spacing: 0.5px;
                }
            }
        }
        
        // Asset count
        Rectangle {
            width: 100px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.count > 0 ? Palette.success : Palette.text-subtle;
                        y: (parent.height - self.height) / 2;
                    }
                    Text { 
                        text: root.count + " Assets"; 
                        color: Palette.text-secondary; 
                        font-size: 12px; 
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
        
        // Balance
        Text { 
            width: 150px; 
            text: root.balance; 
            color: Palette.text-primary; 
            font-size: 15px; 
            font-weight: 600; 
            vertical-alignment: center; 
            horizontal-alignment: right; 
        }
        
        // Delete button / Confirm
        Rectangle {
            width: root.confirm-mode ? 80px : 40px; 
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: root.confirm-mode ? Palette.danger : (del-area.has-hover ? Palette.danger.with-alpha(0.1) : transparent);
            
            animate width { duration: 150ms; }
            animate background { duration: 150ms; }
            
            Text { 
                text: root.confirm-mode ? "SURE?" : "✕"; 
                color: root.confirm-mode ? #ffffff : (del-area.has-hover ? Palette.danger : Palette.text-muted);
                font-size: root.confirm-mode ? 10px : 14px; 
                font-weight: 700;
                letter-spacing: root.confirm-mode ? 1px : 0px;
                vertical-alignment: center; 
                horizontal-alignment: center;
                animate color { duration: 150ms; }
            }
            del-area := TouchArea { 
                mouse-cursor: pointer;
                clicked => { 
                    if (root.confirm-mode) {
                        root.delete();
                    } else {
                        root.confirm-mode = true;
                    }
                }
            }
        }
    }
    
    // Auto-reset confirm mode when mouse leaves
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && !del-area.has-hover) {
                root.confirm-mode = false;
            }
        }
    }
}

// ==================== Ticker Item ====================
export component TickerItem inherits Rectangle {
    in property <string> symbol;
    in property <string> price;
    in property <string> change;
    in property <bool> is-positive;

    width: 180px;
    height: 48px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;
        alignment: space-between;
        
        // Left: Symbol
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            
            GlowDot {
                glow-color: root.is-positive ? Palette.success : Palette.danger;
                y: (parent.height - self.height) / 2;
            }
            
            Text { 
                text: root.symbol; 
                color: Palette.text-primary; 
                font-size: 12px; 
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
        }
        
        // Right: Price & Change
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            
            Text { 
                text: root.price; 
                color: Palette.text-primary; 
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: right;
            }
            
            Text { 
                text: root.change; 
                color: root.is-positive ? Palette.success : Palette.danger; 
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: right;
            }
        }
    }
    
    // Separator
    Rectangle {
        width: 1px;
        height: 24px;
        background: Palette.border-subtle;
        x: parent.width - 1px;
        y: (parent.height - self.height) / 2;
    }
}

// ==================== Crypto Card (Portfolio View) ====================
export component CryptoCard inherits Rectangle {
    in property <string> name;
    in property <string> symbol;
    in property <string> price;
    in property <string> amount;
    in property <string> value;
    in property <string> change;
    in property <bool> is-positive;
    
    callback clicked();

    width: 240px;
    height: 180px;
    border-radius: 12px;
    clip: true;
    
    // Background with gradient
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(145deg, #0d0d14 0%, #111118 50%, #0a0a10 100%);
        border-width: 1px;
        border-color: touch.has-hover ? Palette.border-light.with-alpha(0.3) : Palette.border-subtle;
        border-radius: 12px;
        
        animate border-color { duration: 250ms; easing: ease-out; }
    }
    
    // Decorative accent line at top
    Rectangle {
        width: parent.width;
        height: 2px;
        y: 0;
        background: is-positive ? 
            @linear-gradient(90deg, transparent 0%, Palette.success.with-alpha(0.5) 50%, transparent 100%) :
            @linear-gradient(90deg, transparent 0%, Palette.danger.with-alpha(0.5) 50%, transparent 100%);
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 0px;
        alignment: space-between;

        // Header: Symbol + Change
        HorizontalLayout {
            alignment: space-between;
            
            // Icon + Info
            HorizontalLayout {
                spacing: 12px;
                
                CryptoIcon {
                    symbol: root.symbol;
                    large: true;
                }
                
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { 
                        text: root.symbol; 
                        color: Palette.text-primary; 
                        font-size: 14px; 
                        font-weight: 700;
                        letter-spacing: 0.5px;
                    }
                    Text { 
                        text: root.name; 
                        color: Palette.text-muted; 
                        font-size: 11px; 
                        overflow: elide;
                        max-width: 80px;
                    }
                }
            }

            // Change Badge
            ChangeBadge {
                change: root.change;
                is-positive: root.is-positive;
                compact: true;
            }
        }

        // Center: Price
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            
            Text {
                text: root.price;
                color: Palette.text-primary;
                font-size: 24px;
                font-weight: 300;
                letter-spacing: -0.5px;
                horizontal-alignment: center;
            }
            
            Text {
                text: "per coin";
                color: Palette.text-subtle;
                font-size: 10px;
                letter-spacing: 1px;
                horizontal-alignment: center;
            }
        }

        // Footer: Holdings
        Rectangle {
            height: 40px;
            background: Palette.surface.with-alpha(0.5);
            border-radius: 6px;
            
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;
                
                VerticalLayout {
                    alignment: center;
                    Text { 
                        text: "Holdings"; 
                        color: Palette.text-muted; 
                        font-size: 9px;
                        letter-spacing: 1px;
                    }
                    Text { 
                        text: root.amount; 
                        color: Palette.text-primary; 
                        font-size: 12px;
                        font-weight: 500;
                    }
                }
                
                VerticalLayout {
                    alignment: center;
                    Text { 
                        text: "Value"; 
                        color: Palette.text-muted; 
                        font-size: 9px;
                        letter-spacing: 1px;
                        horizontal-alignment: right;
                    }
                    Text { 
                        text: root.value; 
                        color: Palette.text-primary; 
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

// ==================== Ghost Button ====================
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> icon-mode: false;
    callback clicked;

    width: icon-mode ? 32px : 80px;
    height: 28px;
    background: touch.has-hover ? Palette.surface : transparent;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.border-subtle : transparent;
    
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Text {
        text: root.text;
        color: touch.has-hover ? Palette.text-primary : Palette.text-muted;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        vertical-alignment: center;
        horizontal-alignment: center;
        
        animate color { duration: 150ms; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

