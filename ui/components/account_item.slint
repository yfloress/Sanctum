// ==================== Account Item ====================
// Premium Fintech UI - Single account card for list view

import { AccountData } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";

component AccountTypeIcon inherits Rectangle {
    in property <string> account-type;
    in property <image> icon;

    width: Theme.icon-xl;
    height: Theme.icon-xl;
    border-radius: Theme.radius-xl;
    background: root.icon.width > 0 ? Theme.surface : @linear-gradient(135deg, account-type == "Bank" ? Theme.account-bank : account-type == "Cash" ? Theme.account-cash : account-type == "Savings" ? Theme.account-savings : account-type == "Credit Card" ? Theme.account-credit : Theme.account-other, account-type == "Bank" ? Theme.account-bank-light : account-type == "Cash" ? Theme.account-cash-light : account-type == "Savings" ? Theme.account-savings-light : account-type == "Credit Card" ? Theme.account-credit-light : Theme.account-other-light);
    border-width: 1px;
    border-color: root.icon.width > 0 ? Theme.border : account-type == "Bank" ? Theme.account-bank-light : account-type == "Cash" ? Theme.account-cash-light : account-type == "Savings" ? Theme.account-savings-light : account-type == "Credit Card" ? Theme.account-credit-light : Theme.account-other-light;

    if root.icon.width > 0: Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon.width == 0 && account-type == "Bank": Image {
        source: @image-url("../assets/icons/landmark.svg");
        width: 22px;
        height: 22px;
        colorize: Theme.text-light;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.icon.width == 0 && account-type != "Bank": Image {
        source: account-type == "Cash" ? @image-url("../assets/icons/banknote.svg") : account-type == "Savings" ? @image-url("../assets/icons/piggy-bank.svg") : account-type == "Credit Card" ? @image-url("../assets/icons/credit-card.svg") : @image-url("../assets/icons/wallet.svg");
        width: 22px;
        height: 22px;
        colorize: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AccountItem inherits Rectangle {
    in property <AccountData> account;
    in property <bool> is-last: false;

    callback clicked();

    height: 80px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-light : Theme.border;

    animate background {
        duration: 150ms;
        easing: ease-out;
    }
    animate border-color {
        duration: 150ms;
        easing: ease-out;
    }

    // Content layout
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        // Account icon
        VerticalLayout {
            alignment: center;
            AccountTypeIcon {
                account-type: account.account-type;
                icon: account.icon;
            }
        }

        // Account info (name + type)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: account.name;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                // Type badge
                Rectangle {
                    height: 20px;
                    min-width: 50px;
                    border-radius: 4px;
                    background: Theme.surface-hover;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: account.account-type;
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-weight: 500;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Currency badge
                Rectangle {
                    height: 20px;
                    min-width: 36px;
                    border-radius: Theme.radius-sm;
                    background: @linear-gradient(135deg, Theme.tx-income-bg, Theme.account-cash);
                    border-width: 1px;
                    border-color: Theme.account-cash-light;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: account.currency;
                            color: Theme.success;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Balance (right aligned)
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: Translations.account-balance;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 400;
                letter-spacing: 0.5px;
                horizontal-alignment: right;
            }

            Text {
                text: account.balance;
                color: account.balance-negative ? Theme.danger : Theme.text-primary;
                font-size: 18px;
                font-weight: 600;
                letter-spacing: 0.5px;
                horizontal-alignment: right;
            }
        }

        // Edit indicator
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: touch.has-hover ? Theme.surface : transparent;
                border-width: touch.has-hover ? 1px : 0px;
                border-color: Theme.border-light;

                Text {
                    text: "›";
                    color: Theme.text-muted;
                    font-size: 18px;
                    font-weight: 300;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Touch area
    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }
}
