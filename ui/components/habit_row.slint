// ==================== Habit Row ====================
// Premium Fintech UI - Habit tracking row with day grid

import { Palette, HabitData, HabitDay, HabitAdapter } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component StatBadge inherits Rectangle {
    in property <string> icon;
    in property <string> value;
    in property <color> accent-color: Palette.text-muted;

    width: 64px;
    height: 22px;
    border-radius: 6px;
    background: Palette.surface-hover;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: root.icon;
            font-size: 10px;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: accent-color;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component DayCell inherits Rectangle {
    in property <HabitDay> day;
    in property <color> habit-color;
    callback clicked;

    width: Palette.day-cell-size;
    height: Palette.day-cell-size;
    border-radius: 6px;
    background: day.completed 
        ? habit-color 
        : (day.is-future ? Palette.background : (touch.has-hover && !day.is-future ? Palette.surface-hover : Palette.surface));
    border-width: 1px;
    border-color: day.completed 
        ? habit-color.darker(0.2)
        : (touch.has-hover && !day.is-future ? Palette.border-light : Palette.border);
    opacity: day.is-future ? 0.3 : 1.0;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    // Glow for completed
    if day.completed: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        background: habit-color;
        opacity: 0.3;
    }

    // Day Number
    Text {
        text: day.day;
        color: day.completed ? Palette.background : Palette.text-muted;
        font-size: 10px;
        font-weight: day.completed ? 600 : 400;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: !day.is-future;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component HabitRow inherits Rectangle {
    in property <HabitData> habit;
    callback toggle(string);
    callback delete(string, string);
    callback edit(string);
    callback select(string);

    // State to show/hide delete button
    property <bool> show-delete: false;
    property <length> scroll-x: 0px;
    property <int> currentDayInt: HabitAdapter.current-day-int;
    property <bool> isViewingCurrentMonth: HabitAdapter.is-viewing-current-month;
    property <bool> autoScrollHabits <=> HabitAdapter.auto-scroll-habits;
    property <length> savedScrollX <=> HabitAdapter.habits-scroll-x;

    function auto-scroll-target() -> length {
        if !isViewingCurrentMonth {
            return 0px;
        }

        return min(0px, max(grid-scroll.width - grid-scroll.viewport-width, (grid-scroll.width / 2) - ((currentDayInt * 30px) - 15px)));
    }

    function update-auto-scroll() {
        if autoScrollHabits && isViewingCurrentMonth {
            let target = auto-scroll-target();
            scroll-x = target;
            savedScrollX = target;
        } else if !isViewingCurrentMonth {
            scroll-x = 0px;
            savedScrollX = 0px;
        } else if !autoScrollHabits {
            scroll-x = savedScrollX;
        }
    }

    height: Palette.habit-row-height;
    background: transparent;

    init => { update-auto-scroll(); }
    changed currentDayInt => { update-auto-scroll(); }
    changed isViewingCurrentMonth => { update-auto-scroll(); }
    changed autoScrollHabits => { update-auto-scroll(); }
    
    HorizontalLayout {
        spacing: 16px;

        // Info Column
        Rectangle {
            width: 180px;
            
            HorizontalLayout {
                spacing: 12px;
                padding-left: 8px;
                alignment: start;
                
                // Color Indicator with glow
                Rectangle {
                    width: 4px;
                    height: 32px;
                    background: @linear-gradient(180deg, habit.color 0%, habit.color.darker(0.3) 100%);
                    border-radius: 2px;
                    
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 4px;
                        background: habit.color;
                        opacity: 0.3;
                    }
                }
                
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    
                    Text {
                        text: habit.name;
                        color: Palette.text-primary;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    
                    StatBadge {
                        icon: "🔥";
                        value: habit.streak;
                        accent-color: #f59e0b;
                    }
                }
            }
            
            // TouchArea para activar el modo delete
            info-touch := TouchArea {
                clicked => {
                    root.select(habit.id);
                    root.show-delete = !root.show-delete;
                }
            }
        }

        // Days Grid Container with Scrollbar
        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // The Scrollable Grid
            grid-scroll := Flickable {
                width: 100%;
                height: 30px;
                y: (parent.height - self.height - 8px) / 2;
                viewport-width: habit.days.length * (26px + 4px);
                interactive: true;
                viewport-x <=> scroll-x;
                changed width => { root.update-auto-scroll(); }
                changed viewport-width => { root.update-auto-scroll(); }
                changed viewport-x => {
                    if !autoScrollHabits {
                        savedScrollX = grid-scroll.viewport-x;
                    }
                }
                    
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    
                    for day in habit.days: DayCell {
                        day: day;
                        habit-color: habit.color;
                        clicked => {
                            autoScrollHabits = false;
                            root.toggle(day.date);
                        }
                    }
                }
            }

            // The Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: grid-scroll.viewport-width;
                viewport-x: grid-scroll.viewport-x;
            }
        }

        // Action buttons - aparece con width animation
        Rectangle {
            width: root.show-delete ? 92px : 0px;
            clip: true;

            animate width { duration: 250ms; easing: ease-in-out; }

            if root.show-delete: HorizontalLayout {
                spacing: 8px;
                x: 6px;
                y: (parent.height - 36px) / 2;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: edit-touch.has-hover ? Palette.surface-hover : Palette.surface;
                    border-width: 1px;
                    border-color: Palette.border;

                    animate background { duration: 150ms; }

                    Text {
                        text: "✎";
                        color: edit-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    edit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.edit(habit.id);
                            root.show-delete = false;
                        }
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: delete-touch.has-hover ? Palette.delete-bg-hover : Palette.delete-bg;
                    border-width: 1px;
                    border-color: delete-touch.has-hover ? Palette.delete-border : Palette.delete-bg-hover;
                    
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }
                    
                    Text {
                        text: "🗑";
                        font-size: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    delete-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.delete(habit.id, habit.name);
                            root.show-delete = false;
                        }
                    }
                }
            }
        }
    }
}
