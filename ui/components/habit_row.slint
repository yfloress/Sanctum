// ==================== Habit Row ====================
// Premium Fintech UI - Habit tracking row with day grid

import { Palette, HabitData, HabitDay, HabitAdapter } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component StatBadge inherits Rectangle {
    in property <string> icon;
    in property <string> value;
    in property <color> accent-color: Palette.text-muted;

    height: 22px;
    border-radius: 6px;
    background: Palette.surface-hover;
    border-width: 1px;
    border-color: Palette.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: root.icon;
            font-size: 10px;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: accent-color;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component DayCell inherits Rectangle {
    in property <HabitDay> day;
    in property <color> habit-color;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: day.completed 
        ? habit-color 
        : (day.is-future ? Palette.background : (touch.has-hover && !day.is-future ? Palette.surface-hover : Palette.surface));
    border-width: 1px;
    border-color: day.completed 
        ? habit-color.darker(0.2)
        : (touch.has-hover && !day.is-future ? Palette.border-light : Palette.border);
    opacity: day.is-future ? 0.3 : 1.0;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    // Glow for completed
    if day.completed: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        background: habit-color;
        opacity: 0.3;
    }

    // Day Number
    Text {
        text: day.day;
        color: day.completed ? Palette.background : Palette.text-muted;
        font-size: 10px;
        font-weight: day.completed ? 600 : 400;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: !day.is-future;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component HabitRow inherits Rectangle {
    in property <HabitData> habit;
    callback toggle(string);
    callback delete(string);
    
    // State para mostrar/ocultar botón de eliminar
    property <bool> show-delete: false;
    property <length> scroll-x: 0px;
    property <int> current_day_int: HabitAdapter.current-day-int;
    property <bool> is_viewing_current_month: HabitAdapter.is-viewing-current-month;
    property <bool> auto_scroll_habits <=> HabitAdapter.auto-scroll-habits;

    function auto-scroll-target() -> length {
        if !is_viewing_current_month {
            return 0px;
        }

        return min(0px, max(grid-scroll.width - grid-scroll.viewport-width, (grid-scroll.width / 2) - ((current_day_int * 30px) - 15px)));
    }

    function update-auto-scroll() {
        if auto_scroll_habits && is_viewing_current_month {
            scroll-x = auto-scroll-target();
        } else if !is_viewing_current_month {
            scroll-x = 0px;
        }
    }

    height: 72px;
    background: transparent;

    init => { update-auto-scroll(); }
    changed current_day_int => { update-auto-scroll(); }
    changed is_viewing_current_month => { update-auto-scroll(); }
    changed auto_scroll_habits => { update-auto-scroll(); }
    
    HorizontalLayout {
        spacing: 16px;

        // Info Column
        Rectangle {
            width: 180px;
            
            HorizontalLayout {
                spacing: 12px;
                padding-left: 8px;
                alignment: center;
                
                // Color Indicator with glow
                Rectangle {
                    width: 4px;
                    height: 32px;
                    background: @linear-gradient(180deg, habit.color 0%, habit.color.darker(0.3) 100%);
                    border-radius: 2px;
                    
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 4px;
                        background: habit.color;
                        opacity: 0.3;
                    }
                }
                
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    
                    Text {
                        text: habit.name;
                        color: Palette.text-primary;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    
                    // Stats Row
                    HorizontalLayout {
                        spacing: 6px;
                        StatBadge {
                            icon: "🔥";
                            value: habit.streak;
                            accent-color: #f59e0b;
                        }

                        StatBadge {
                            icon: "🏆";
                            value: habit.best-streak;
                            accent-color: #8b5cf6;
                        }

                        StatBadge {
                            icon: "📊";
                            value: habit.completion-rate + "%";
                            accent-color: Palette.success;
                        }
                    }
                }
            }
            
            // TouchArea para activar el modo delete
            info-touch := TouchArea {
                clicked => {
                    root.show-delete = !root.show-delete;
                }
            }
        }

        // Days Grid Container with Scrollbar
        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // The Scrollable Grid
            grid-scroll := Flickable {
                width: 100%;
                height: 30px;
                y: (parent.height - self.height - 8px) / 2;
                viewport-width: habit.days.length * (26px + 4px);
                interactive: true;
                viewport-x <=> scroll-x;
                changed width => { root.update-auto-scroll(); }
                changed viewport-width => { root.update-auto-scroll(); }
                    
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    
                    for day in habit.days: DayCell {
                        day: day;
                        habit-color: habit.color;
                        clicked => {
                            auto_scroll_habits = false;
                            root.toggle(day.date);
                        }
                    }
                }
            }

            // The Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: grid-scroll.viewport-width;
                viewport-x: grid-scroll.viewport-x;
            }
        }

        // Delete button - aparece con width animation
        Rectangle {
            width: root.show-delete ? 48px : 0px;
            clip: true;
            
            animate width { duration: 250ms; easing: ease-in-out; }
            
            if root.show-delete: Rectangle {
                width: 36px;
                height: 36px;
                x: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: delete-touch.has-hover ? #5a2020 : #3d2020;
                border-width: 1px;
                border-color: delete-touch.has-hover ? #ff4444 : #5a2020;
                
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }
                
                Text {
                    text: "🗑";
                    font-size: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                delete-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { 
                        root.delete(habit.id);
                        root.show-delete = false;
                    }
                }
            }
        }
    }
}
