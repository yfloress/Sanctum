import { Palette, HabitData, HabitDay, HabitAdapter } from "../globals.slint";

export component HabitRow inherits Rectangle {
    in property <HabitData> habit;
    callback toggle(string); // date
    callback delete(string); // id

    height: 64px;
    background: transparent;

    HorizontalLayout {
        spacing: 16px;
        alignment: start;

        // Info Column
        Rectangle {
            width: 200px;
            
            info-touch := TouchArea { }
            
            HorizontalLayout {
                spacing: 12px;
                
                // Color Indicator
                Rectangle {
                    width: 4px;
                    height: 24px;
                    background: habit.color;
                    border-radius: 2px;
                    y: (parent.height - self.height) / 2;
                }
                
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    
                Text {
                    text: habit.name;
                    color: Palette.text-primary;
                    font-size: 14px;
                    overflow: elide;
                }
                
                // Stats Row
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "🔥 " + habit.streak;
                        color: Palette.text-muted;
                        font-size: 10px;
                    }
                    Text {
                        text: "|";
                        color: Palette.text-subtle;
                        font-size: 10px;
                    }
                    Text {
                        text: "🏆 " + habit.best-streak;
                        color: Palette.text-muted;
                        font-size: 10px;
                    }
                    Text {
                        text: "|";
                        color: Palette.text-subtle;
                        font-size: 10px;
                    }
                    Text {
                        text: habit.completion-rate + "%";
                        color: Palette.text-muted;
                        font-size: 10px;
                    }
                }
                }
                
                // Delete button (hover)
                if info-touch.has-hover : TouchArea {
                    width: 24px;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    
                    Text {
                        text: "×";
                        color: parent.has-hover ? Palette.danger : Palette.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    clicked => {
                        root.delete(habit.id);
                    }
                }
            }
        }

        // Days Grid
        HorizontalLayout {
            spacing: 4px;
            
            for day in habit.days : Rectangle {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                
                border-radius: 4px;
                background: day.completed ? habit.color : (day.is-future ? Palette.background : Palette.surface);
                border-width: 1px;
                border-color: day.completed ? habit.color : Palette.border-subtle;
                opacity: day.is-future ? 0.3 : 1.0;
                
                // Day Number
                Text {
                    text: day.day;
                    color: day.completed ? Palette.background : Palette.text-muted;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: day.completed ? 0.8 : 0.5;
                }
                
                TouchArea {
                    enabled: !day.is-future;
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => {
                        root.toggle(day.date);
                    }
                }
            }
        }
    }
}
