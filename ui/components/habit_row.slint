// ==================== Habit Row ====================
// Premium Fintech UI - Habit tracking row with day grid

import { HabitData, HabitDay, HabitAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { CustomScrollbar } from "../widgets.slint";

component StatBadge inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <color> accent-color: Theme.text-muted;

    width: 64px;
    height: 22px;
    border-radius: 6px;
    background: Theme.surface-hover;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-top: 4px;
        padding-bottom: 4px;

        Image {
            source: root.icon;
            width: 10px;
            height: 10px;
            colorize: accent-color;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.value;
            color: accent-color;
            font-size: 10px;
            font-weight: 600;
            y: (parent.height - self.height) / 2;
        }
    }
}

component DayCell inherits Rectangle {
    in property <HabitDay> day;
    in property <color> habit-color;
    callback clicked;

    width: Theme.day-cell-size;
    height: Theme.day-cell-size;
    border-radius: 6px;
    background: day.completed ? habit-color : (day.is-future ? Theme.background : (touch.has-hover && !day.is-future ? Theme.surface-hover : Theme.surface));
    border-width: 1px;
    border-color: day.completed ? habit-color.darker(0.2) : (touch.has-hover && !day.is-future ? Theme.border-light : Theme.border);
    opacity: day.is-future ? 0.3 : 1.0;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    // Glow for completed
    if day.completed: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        background: habit-color;
        opacity: 0.3;
    }

    // Day Number
    Text {
        text: day.day;
        color: day.completed ? Theme.background : Theme.text-muted;
        font-size: 10px;
        font-weight: day.completed ? 600 : 400;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: !day.is-future;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

export component HabitRow inherits Rectangle {
    in property <HabitData> habit;
    // Scroll position is now passed in from parent to avoid recursion
    in property <length> shared-scroll-x: 0px;
    in property <bool> auto-scroll-enabled: true;

    callback toggle(string);
    callback delete(string, string);
    callback edit(string);
    callback select(string);
    // Notify parent when user manually scrolls
    callback scroll-changed(length);

    // State to show/hide delete button
    property <bool> show-delete: false;
    // Local scroll state - initialized from shared but can be modified locally
    property <length> local-scroll-x: shared-scroll-x;

    height: Theme.habit-row-height;
    background: transparent;

    // Sync from parent when auto-scroll is enabled or shared value changes
    changed shared-scroll-x => {
        if auto-scroll-enabled {
            local-scroll-x = shared-scroll-x;
        }
    }

    HorizontalLayout {
        spacing: 16px;

        // Info Column
        Rectangle {
            width: 180px;

            HorizontalLayout {
                spacing: 12px;
                padding-left: 8px;
                alignment: start;

                // Color Indicator with glow
                Rectangle {
                    width: 4px;
                    height: 32px;
                    background: @linear-gradient(180deg, habit.color 0%, habit.color.darker(0.3) 100%);
                    border-radius: 2px;

                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 4px;
                        background: habit.color;
                        opacity: 0.3;
                    }
                }

                VerticalLayout {
                    alignment: start;
                    spacing: 6px;

                    Text {
                        text: habit.name;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }

                    StatBadge {
                        icon: @image-url("../assets/icons/flame.svg");
                        value: habit.streak;
                        accent-color: Theme.habit-color-5;
                    }
                }
            }

            // TouchArea para activar el modo delete
            info-touch := TouchArea {
                clicked => {
                    root.select(habit.id);
                    root.show-delete = !root.show-delete;
                }
            }
        }

        // Days Grid Container with Scrollbar
        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // The Scrollable Grid
            grid-scroll := Flickable {
                width: 100%;
                height: 30px;
                y: (parent.height - self.height - 8px) / 2;
                viewport-width: habit.days.length * (26px + 4px);
                interactive: true;
                viewport-x: local-scroll-x;

                changed viewport-x => {
                    // Only notify parent if user is manually scrolling (not auto-scroll)
                    if !auto-scroll-enabled && grid-scroll.viewport-x != local-scroll-x {
                        local-scroll-x = grid-scroll.viewport-x;
                        root.scroll-changed(grid-scroll.viewport-x);
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for day in habit.days: DayCell {
                        day: day;
                        habit-color: habit.color;
                        clicked => {
                            root.toggle(day.date);
                        }
                    }
                }
            }

            // The Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: grid-scroll.viewport-width;
                viewport-x: grid-scroll.viewport-x;
            }
        }

        // Action buttons - aparece con width animation
        Rectangle {
            width: root.show-delete ? 92px : 0px;
            clip: true;

            animate width {
                duration: 250ms;
                easing: ease-in-out;
            }

            if root.show-delete: HorizontalLayout {
                spacing: 8px;
                x: 6px;
                y: (parent.height - 36px) / 2;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: edit-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    animate background { duration: 150ms; }

                    Image {
                        source: @image-url("../assets/icons/pencil.svg");
                        width: 14px;
                        height: 14px;
                        colorize: edit-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    edit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.edit(habit.id);
                            root.show-delete = false;
                        }
                    }
                }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: delete-touch.has-hover ? Theme.delete-bg-hover : Theme.delete-bg;
                    border-width: 1px;
                    border-color: delete-touch.has-hover ? Theme.delete-border : Theme.delete-bg-hover;

                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    Image {
                        source: @image-url("../assets/icons/trash.svg");
                        width: 14px;
                        height: 14px;
                        colorize: delete-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    delete-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.delete(habit.id, habit.name);
                            root.show-delete = false;
                        }
                    }
                }
            }
        }
    }
}
