//Shared panel for displaying import summary stats, errors, and skipped reasons

import {
    ImportErrorData,
    IngestionAdapter,
    ImportPreviewChange,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { SummaryPill } from "summary_pill.slint";
import { CustomVScrollbar } from "../widgets.slint";

// ==================== Change Row ====================
component ChangeRow inherits Rectangle {
    in property <ImportPreviewChange> change;

    height: 62px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: change.change-type;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
        }

        Text {
            text: change.summary;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 500;
        }

        Text {
            text: change.details;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 400;
            overflow: elide;
        }
    }
}

// ==================== Error Row ====================
component ErrorRow inherits Rectangle {
    in property <ImportErrorData> error;

    height: 62px;
    background: Theme.surface-hover;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;

            if error.line-label != "": Text {
                text: error.line-label;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
            }

            if error.field-label != "": Text {
                text: error.field-label;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 500;
            }
        }

        Text {
            text: error.message;
            color: Theme.text-primary;
            font-size: 11px;
            font-weight: 500;
            wrap: word-wrap;
        }

        if error.raw-data != "": Text {
            text: error.raw-data;
            color: Theme.text-muted;
            font-size: 9px;
            font-weight: 400;
            overflow: elide;
        }
    }
}

// ==================== Import Summary Panel ====================
export component ImportSummaryPanel inherits VerticalLayout {
    in property <bool> show-file-info: true;
    in property <int> error-list-height: 140;

    spacing: 0px;

    // File details row
    if show-file-info && IngestionAdapter.import-file-name != "": Rectangle {
        height: file-info-layout.preferred-height + 16px;

        file-info-layout := HorizontalLayout {
            spacing: 24px;
            alignment: center;

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-file-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-file-name;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 160px;
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-format-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-format;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-type-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-data-type;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Total processed
    Rectangle {
        height: total-processed-text.preferred-height + 16px;

        total-processed-text := Text {
            text: "\{Translations.import-total-processed}: \{IngestionAdapter.import-total-processed}";
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }

    // Summary pills
    Rectangle {
        height: pills-layout.preferred-height + 16px;

        pills-layout := HorizontalLayout {
            spacing: 12px;
            alignment: center;

            SummaryPill {
                label: Translations.import-inserted;
                value: IngestionAdapter.import-inserted;
                accent: Theme.success;
            }

            SummaryPill {
                label: Translations.import-skipped;
                value: IngestionAdapter.import-skipped;
                accent: Theme.warning;
            }

            SummaryPill {
                label: Translations.import-errors;
                value: IngestionAdapter.import-errors;
                accent: Theme.danger;
            }
        }
    }

    // Preview changes list - only rendered when there are changes
    if IngestionAdapter.import-preview-changes.length > 0: Rectangle {
        height: preview-changes-content.preferred-height + 16px;

        preview-changes-content := VerticalLayout {
            spacing: 8px;
            padding-top: 16px;

            Text {
                text: Translations.import-preview-changes;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            Rectangle {
                height: root.error-list-height * 1px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                preview-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: IngestionAdapter.import-preview-changes.length * 70px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        for change in IngestionAdapter.import-preview-changes: ChangeRow {
                            change: change;
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 4px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: preview-scroll.viewport-height;
                    viewport-y: preview-scroll.viewport-y;
                }
            }
        }
    }

    // Error list
    if IngestionAdapter.import-errors > 0: Rectangle {
        height: error-list-content.preferred-height + 16px;

        error-list-content := VerticalLayout {
            spacing: 8px;
            padding-top: 16px;

            Text {
                text: Translations.import-error-details;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            Rectangle {
                height: root.error-list-height * 1px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                error-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: IngestionAdapter.import-error-details.length * 70px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        for err in IngestionAdapter.import-error-details: ErrorRow {
                            error: err;
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 4px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: error-scroll.viewport-height;
                    viewport-y: error-scroll.viewport-y;
                }
            }
        }
    }

    // Skipped reasons
    if IngestionAdapter.import-skipped-reasons.length > 0: Rectangle {
        height: skipped-reasons-content.preferred-height + 16px;

        skipped-reasons-content := VerticalLayout {
            spacing: 6px;
            padding-top: 16px;

            Text {
                text: Translations.import-skipped-reasons;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            for reason in IngestionAdapter.import-skipped-reasons: Text {
                text: "- " + reason;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 400;
            }
        }
    }
}
