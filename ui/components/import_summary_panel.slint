// Shared panel for displaying import summary stats, errors, and skipped reasons

import {
    ImportErrorData,
    IngestionAdapter,
    ImportPreviewChange,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { SummaryPill } from "summary_pill.slint";
import { CustomVScrollbar } from "../widgets.slint";

// ==================== Change Type Badge ====================
component ChangeTypeBadge inherits Rectangle {
    in property <string> change-type;

    // Determine color based on change type
    property <color> badge-color: {
        if (change-type == "Income" || change-type == "Ingreso") {
            Theme.success
        } else if (change-type == "Expense" || change-type == "Gasto") {
            Theme.danger
        } else if (change-type == "Transfer" || change-type == "Transferencia") {
            Theme.accent
        } else if (change-type == "Crypto Transaction" || change-type == "Transacción Crypto") {
            #8b5cf6 // purple for crypto
        } else if (change-type == "Habit Log" || change-type == "Registro de Hábito") {
            Theme.warning
        } else {
            Theme.text-muted
        }
    };

    height: 18px;
    width: badge-text.preferred-width + 12px;
    background: badge-color.with-alpha(0.15);
    border-radius: 4px;

    badge-text := Text {
        text: root.change-type;
        color: root.badge-color;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ==================== Change Row ====================
component ChangeRow inherits Rectangle {
    in property <ImportPreviewChange> change;

    // Determine accent color based on change type
    property <color> accent-color: {
        if (change.change-type == "Income" || change.change-type == "Ingreso") {
            Theme.success
        } else if (change.change-type == "Expense" || change.change-type == "Gasto") {
            Theme.danger
        } else if (change.change-type == "Transfer" || change.change-type == "Transferencia") {
            Theme.accent
        } else if (change.change-type == "Crypto Transaction" || change.change-type == "Transacción Crypto") {
            #8b5cf6
        } else if (change.change-type == "Habit Log" || change.change-type == "Registro de Hábito") {
            Theme.warning
        } else {
            Theme.text-muted
        }
    };

    height: 66px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    touch := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // Colored accent bar on the left
        Rectangle {
            width: 4px;
            background: root.accent-color;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;

            ChangeTypeBadge {
                change-type: root.change.change-type;
            }

            Text {
                text: root.change.summary;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 500;
            }

            Text {
                text: root.change.details;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 400;
                overflow: elide;
            }
        }
    }

    animate background {
        duration: 120ms;
        easing: ease-out;
    }
}

// ==================== Error Row ====================
component ErrorRow inherits Rectangle {
    in property <ImportErrorData> error;

    height: error.can-add-missing-coin ? 84px : 66px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    touch := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // Red accent bar on the left for errors
        Rectangle {
            width: 4px;
            background: Theme.danger;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;
                height: 18px;

                if error.line-label != "": Rectangle {
                    height: 18px;
                    width: line-text.preferred-width + 12px;
                    background: Theme.danger.with-alpha(0.15);
                    border-radius: 4px;

                    line-text := Text {
                        text: error.line-label;
                        color: Theme.danger;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if error.field-label != "": Rectangle {
                    height: 18px;
                    width: field-text.preferred-width + 12px;
                    background: Theme.warning.with-alpha(0.15);
                    border-radius: 4px;

                    field-text := Text {
                        text: error.field-label;
                        color: Theme.warning;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: error.message;
                color: Theme.text-primary;
                font-size: 11px;
                font-weight: 500;
                wrap: word-wrap;
            }

            if error.can-add-missing-coin: HorizontalLayout {
                spacing: 8px;
                height: 20px;

                Rectangle {
                    height: 20px;
                    width: add-coin-text.preferred-width + 14px;
                    background: Theme.accent.with-alpha(0.18);
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.35);

                    add-coin-text := Text {
                        text: Translations.modal-add-coin + " " + error.missing-coin-symbol;
                        color: Theme.accent;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.3px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    add-coin-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            IngestionAdapter.add-missing-exchange-coin(error.missing-coin-symbol);
                        }
                    }
                }
            }

            if error.raw-data != "": Text {
                text: error.raw-data;
                color: Theme.text-muted;
                font-size: 9px;
                font-weight: 400;
                overflow: elide;
            }
        }
    }

    animate background {
        duration: 120ms;
        easing: ease-out;
    }
}

// ==================== Import Summary Panel ====================
export component ImportSummaryPanel inherits VerticalLayout {
    in property <bool> show-file-info: true;
    in property <int> error-list-height: 140;

    spacing: 0px;

    // File details row
    if show-file-info && IngestionAdapter.import-file-name != "": Rectangle {
        height: file-info-layout.preferred-height + 16px;

        file-info-layout := HorizontalLayout {
            spacing: 24px;
            alignment: center;

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-file-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-file-name;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 160px;
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-format-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-format;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Text {
                    text: Translations.import-preview-type-label;
                    color: Theme.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    horizontal-alignment: center;
                }

                Text {
                    text: IngestionAdapter.import-data-type;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Total processed
    Rectangle {
        height: total-processed-text.preferred-height + 16px;

        total-processed-text := Text {
            text: "\{Translations.import-total-processed}: \{IngestionAdapter.import-total-processed}";
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }

    // Summary pills
    Rectangle {
        height: pills-layout.preferred-height + 16px;

        pills-layout := HorizontalLayout {
            spacing: 12px;
            alignment: center;

            SummaryPill {
                label: Translations.import-inserted;
                value: IngestionAdapter.import-inserted;
                accent: Theme.success;
            }

            SummaryPill {
                label: Translations.import-skipped;
                value: IngestionAdapter.import-skipped;
                accent: Theme.warning;
            }

            SummaryPill {
                label: Translations.import-errors;
                value: IngestionAdapter.import-errors;
                accent: Theme.danger;
            }
        }
    }

    // Preview changes list - only rendered when there are changes
    if IngestionAdapter.import-preview-changes.length > 0: Rectangle {
        height: preview-changes-content.preferred-height + 16px;

        preview-changes-content := VerticalLayout {
            spacing: 8px;
            padding-top: 16px;

            Text {
                text: Translations.import-preview-changes;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            Rectangle {
                height: root.error-list-height * 1px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                preview-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: IngestionAdapter.import-preview-changes.length * 74px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        for change in IngestionAdapter.import-preview-changes: ChangeRow {
                            change: change;
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 4px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: preview-scroll.viewport-height;
                    viewport-y: preview-scroll.viewport-y;
                }
            }
        }
    }

    // Error list
    if IngestionAdapter.import-errors > 0: Rectangle {
        height: error-list-content.preferred-height + 16px;

        error-list-content := VerticalLayout {
            spacing: 8px;
            padding-top: 16px;

            Text {
                text: Translations.import-error-details;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            Rectangle {
                height: root.error-list-height * 1px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                error-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: IngestionAdapter.import-error-details.length * 92px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        for err in IngestionAdapter.import-error-details: ErrorRow {
                            error: err;
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 4px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: error-scroll.viewport-height;
                    viewport-y: error-scroll.viewport-y;
                }
            }
        }
    }

    // Skipped reasons
    if IngestionAdapter.import-skipped-reasons.length > 0: Rectangle {
        height: skipped-reasons-content.preferred-height + 16px;

        skipped-reasons-content := VerticalLayout {
            spacing: 6px;
            padding-top: 16px;

            Text {
                text: Translations.import-skipped-reasons;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
            }

            for reason in IngestionAdapter.import-skipped-reasons: HorizontalLayout {
                spacing: 6px;

                Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.warning;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: reason;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 400;
                }
            }
        }
    }
}
