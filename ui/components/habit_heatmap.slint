// ==================== Habit Heatmap ====================
// Premium Fintech UI - GitHub-style yearly contribution heatmap
// Horizontal scroll only, 7 rows for days of week

import { Palette, HabitAdapter, HeatmapWeek, HeatmapDay } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component HeatmapCell inherits Rectangle {
    in property <int> level;
    
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: level == 0 ? Palette.surface-hover :
                level == 1 ? #3b2f5f :
                level == 2 ? #6b4f9f :
                level == 3 ? #8b5cf6 :
                level == 4 ? #a78bfa : Palette.surface-hover;
    border-width: level > 0 ? 0px : 1px;
    border-color: Palette.border;

    // Glow for high activity
    if level >= 3: Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: 4px;
        background: level == 3 ? #8b5cf6 : #a78bfa;
        opacity: 0.3;
    }

    TouchArea {
        mouse-cursor: pointer;
    }
}

export component HabitHeatmap inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Legend (overlay) - keeps the grid centered vertically in the card
    HorizontalLayout {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: 12px;
        alignment: end;
        spacing: 6px;

        Text {
            text: "Less";
            color: Palette.text-muted;
            font-size: 9px;
            vertical-alignment: center;
        }

        HeatmapCell { level: 0; }
        HeatmapCell { level: 1; }
        HeatmapCell { level: 2; }
        HeatmapCell { level: 3; }
        HeatmapCell { level: 4; }

        Text {
            text: "More";
            color: Palette.text-muted;
            font-size: 9px;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 0px;

        // Heatmap Grid Container
        Rectangle {
            vertical-stretch: 1;
            clip: true; // Prevent overflow overlapping

            // Heatmap Grid - horizontal scroll only
            heatmap-scroll := Flickable {
                height: 7 * 12px + 6 * 4px; // 108px content
                y: (parent.height - self.height) / 2; // Center vertically
                horizontal-stretch: 1;
                interactive: true;
                viewport-width: HabitAdapter.heatmap-data.length * 16px;
                
                // Auto-scroll to current week if available
                viewport-x: -1 * max(0px, ((HabitAdapter.current-week-int - 4) * 16px));

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for week in HabitAdapter.heatmap-data: VerticalLayout {
                        spacing: 4px;
                        for day in week.days: HeatmapCell {
                            level: day.level;
                        }
                    }
                }
            }

            // Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: heatmap-scroll.viewport-width;
                viewport-x: heatmap-scroll.viewport-x;
            }
        }
    }
}
