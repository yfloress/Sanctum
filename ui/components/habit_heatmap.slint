// ==================== Habit Heatmap ====================
// Premium Fintech UI - GitHub-style yearly contribution heatmap
// Horizontal scroll only, 7 rows for days of week

import { Palette, HabitAdapter, HeatmapWeek, HeatmapDay } from "../globals.slint";
import { CustomScrollbar } from "../widgets.slint";

component Tooltip inherits Rectangle {
    in property <string> text;
    in property <int> count;
    
    width: 120px;
    height: 40px;
    z: 1000; // Relative to parent (Cell)
    
    // Position relative to the cell (top-left of cell is 0,0)
    // Cell is 14x14. We want tooltip above and centered.
    // Center of cell x: 7px. Center of tooltip x: 60px.
    // x = 7 - 60 = -53px.
    x: -53px; 
    y: -45px; 
    
    background: #1e1e1e;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 4px;
    
    // Shadow
    Rectangle {
        z: -1;
        width: 100%;
        height: 100%;
        background: black;
        opacity: 0.5;
        x: 2px;
        y: 2px;
        border-radius: 4px;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text { 
            text: root.text; 
            color: Palette.text-primary; 
            font-size: 11px; 
            font-weight: 600;
            overflow: elide;
        }
        Text { 
            text: root.count == 1 ? "1 contribution" : root.count + " contributions"; 
            color: Palette.text-secondary; 
            font-size: 10px; 
            overflow: elide;
        }
    }
}

component HeatmapCell inherits Rectangle {
    in property <int> level;
    in property <string> date: "";
    in property <int> count: 0;
    
    width: 14px;
    height: 14px;
    border-radius: 3px;
    
    // Elevate when hovered to show tooltip above neighbors
    z: ta.has-hover ? 100 : 0;

    background: level == 0 ? Palette.surface-hover :
                level == 1 ? #3b2f5f :
                level == 2 ? #6b4f9f :
                level == 3 ? #8b5cf6 :
                level == 4 ? #a78bfa : Palette.surface-hover;
    border-width: level > 0 ? 0px : 1px;
    border-color: Palette.border;

    // Glow for high activity
    if level >= 3: Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: 4px;
        background: level == 3 ? #8b5cf6 : #a78bfa;
        opacity: 0.3;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
    }
    
    if ta.has-hover && root.date != "": Tooltip {
        text: root.date;
        count: root.count;
    }
}

export component HabitHeatmap inherits Rectangle {
    width: 100%;
    height: 100%; // Toma toda la altura del contenedor padre
    background: transparent;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 20px; // Espacio entre legend y heatmap

        // Legend
        HorizontalLayout {
            height: 16px; // Altura fija para la leyenda
            alignment: end;
            spacing: 6px;
            
            Text {
                text: "Less";
                color: Palette.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }

            HeatmapCell { level: 0; }
            HeatmapCell { level: 1; }
            HeatmapCell { level: 2; }
            HeatmapCell { level: 3; }
            HeatmapCell { level: 4; }

            Text {
                text: "More";
                color: Palette.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        // Heatmap Grid Container
        grid-container := Rectangle {
            vertical-stretch: 1; // Ocupa el espacio restante
            clip: false; // Allow tooltip to overflow container

            // Heatmap Grid
            heatmap-scroll := Flickable {
                // Altura del contenido: 7 filas * 14px + 6 espacios * 4px = 122px
                height: 122px;
                // Centrado vertical
                y: (parent.height - self.height) / 2;
                width: parent.width;
                interactive: true;
                viewport-width: HabitAdapter.heatmap-data.length * 18px;
                
                // Auto-scroll logic
                viewport-x: -1 * max(0px, ((HabitAdapter.current-week-int - 4) * 18px));
                
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    for week in HabitAdapter.heatmap-data: VerticalLayout {
                        spacing: 4px;
                        for day in week.days: HeatmapCell {
                            level: day.level;
                            date: day.date;
                            count: day.count;
                        }
                    }
                }
            }

            // Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: heatmap-scroll.viewport-width;
                viewport-x: heatmap-scroll.viewport-x;
            }
        }
    }
}
