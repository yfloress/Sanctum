// ==================== Habit Heatmap ====================
// Premium Fintech UI - GitHub-style yearly contribution heatmap

import { Palette, HabitAdapter, HeatmapWeek, HeatmapDay } from "../globals.slint";

component HeatmapCell inherits Rectangle {
    in property <int> level;
    
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: level == 0 ? Palette.surface-hover :
                level == 1 ? #3b2f5f :
                level == 2 ? #6b4f9f :
                level == 3 ? #8b5cf6 :
                level == 4 ? #a78bfa : Palette.surface-hover;
    border-width: level > 0 ? 0px : 1px;
    border-color: Palette.border;

    // Glow for high activity
    if level >= 3: Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: 4px;
        background: level == 3 ? #8b5cf6 : #a78bfa;
        opacity: 0.3;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    // Hover effect
    states [
        hover when touch.has-hover: {
            opacity: 0.8;
        }
    ]
}

export component HabitHeatmap inherits Rectangle {
    height: 130px;
    background: transparent;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Legend
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Text {
                text: "Less";
                color: Palette.text-muted;
                font-size: 9px;
                vertical-alignment: center;
            }

            HeatmapCell { level: 0; }
            HeatmapCell { level: 1; }
            HeatmapCell { level: 2; }
            HeatmapCell { level: 3; }
            HeatmapCell { level: 4; }

            Text {
                text: "More";
                color: Palette.text-muted;
                font-size: 9px;
                vertical-alignment: center;
            }
        }

        // Heatmap Grid
        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            interactive: true;
            viewport-width: (HabitAdapter.heatmap-data.length * 16px);

            HorizontalLayout {
                spacing: 4px;
                padding: 4px;
                alignment: start;

                for week in HabitAdapter.heatmap-data: VerticalLayout {
                    spacing: 4px;
                    for day in week.days: HeatmapCell {
                        level: day.level;
                    }
                }
            }
        }
    }
}
