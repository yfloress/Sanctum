// ==================== Habit Heatmap ====================
// Premium Fintech UI - GitHub-style yearly contribution heatmap
// Horizontal scroll only, 7 rows for days of week

import { HabitAdapter, HeatmapWeek, HeatmapDay } from "../globals.slint";
import { Translations } from "../translations.slint";
import { CustomScrollbar } from "../widgets.slint";
import { Theme } from "../theme.slint";

component Tooltip inherits Rectangle {
    in property <string> text; // Kept for interface compatibility, but unused
    in property <int> count;

    width: 24px;
    height: 22px;
    z: 1000;

    // Position relative to the cell
    // Shift left to avoid overlapping the next column (which is drawn on top)
    x: -8px;
    y: -28px;

    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 4px;

    Text {
        text: "\{root.count}";
        color: Theme.text;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeatmapCell inherits Rectangle {
    in property <int> level;
    in property <string> date: "";
    in property <int> count: 0;

    width: 14px;
    height: 14px;
    border-radius: 3px;
    clip: false; // Ensure tooltip can overflow

    // Level -1 = padding day (outside year), make invisible
    visible: level >= 0;

    background: level == 0 ? Theme.heatmap-level-0 : level == 1 ? Theme.heatmap-level-1 : level == 2 ? Theme.heatmap-level-2 : level == 3 ? Theme.heatmap-level-3 : level == 4 ? Theme.heatmap-level-4 : Theme.heatmap-level-0;
    border-width: level > 0 ? 0px : 1px;
    border-color: Theme.border;

    // Glow for high activity
    if level >= 3: Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: 4px;
        background: level == 3 ? Theme.heatmap-level-3 : Theme.heatmap-level-4;
        opacity: 0.3;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
    }

    // Tooltip shown above cell
    if ta.has-hover && root.date != "": Tooltip {
        text: root.date;
        count: root.count;
    }
}

export component HabitHeatmap inherits Rectangle {
    width: 100%;
    height: 100%; // Takes full height of parent container
    background: transparent;

    // Auto-scroll properties
    property <length> scroll-x: 0px;
    property <int> current-week: HabitAdapter.current-week-int;
    property <int> data-length: HabitAdapter.heatmap-data.length;

    function calculate-scroll-target() -> length {
        if data-length == 0 {
            return 0px;
        }
        // Scroll so current week is ~4 columns from left, each column is 18px
        let target = (current-week - 4) * 18px;
        let max-scroll = (data-length - 1) * 18px;
        let clamped = max(0px, min(target, max-scroll));
        // Negate: scroll left means negative viewport-x
        return 0px - clamped;
    }

    function update-scroll() {
        scroll-x = calculate-scroll-target();
    }

    init => {
        update-scroll();
    }
    changed current-week => {
        update-scroll();
    }
    changed data-length => {
        update-scroll();
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 20px;
        spacing: 12px; // Space between legend and heatmap

        // Legend
        HorizontalLayout {
            height: 16px; // Fixed height for legend
            alignment: end;
            spacing: 6px;

            Text {
                text: Translations.heatmap-less;
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }

            HeatmapCell {
                level: 0;
            }

            HeatmapCell {
                level: 1;
            }

            HeatmapCell {
                level: 2;
            }

            HeatmapCell {
                level: 3;
            }

            HeatmapCell {
                level: 4;
            }

            Text {
                text: Translations.heatmap-more;
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
        }

        // Heatmap Grid Container
        grid-container := Rectangle {
            vertical-stretch: 1; // Takes remaining space
            clip: false; // Allow tooltip to overflow container

            // Heatmap Grid
            heatmap-scroll := Flickable {
                // Content height: 7 rows * 14px + 6 spaces * 4px = 122px
                // + 30px padding top = 152px minimum
                height: 160px;
                // Vertically centered
                y: (parent.height - self.height) / 2;
                width: parent.width;
                interactive: true;
                viewport-width: HabitAdapter.heatmap-data.length * 18px;

                // Two-way binding for auto-scroll
                viewport-x <=> root.scroll-x;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    padding-top: 30px;

                    for week in HabitAdapter.heatmap-data: VerticalLayout {
                        spacing: 4px;
                        for day in week.days: HeatmapCell {
                            level: day.level;
                            date: day.date;
                            count: day.count;
                        }
                    }
                }
            }

            // Scrollbar
            CustomScrollbar {
                width: parent.width;
                y: parent.height - self.height;
                visible-width: parent.width;
                viewport-width: heatmap-scroll.viewport-width;
                viewport-x: heatmap-scroll.viewport-x;
            }
        }
    }
}
