// ==================== Notification Toast ====================
// Premium Fintech UI - Floating temporary message

import { Theme } from "../theme.slint";

export struct NotificationData {
    message: string,
    is-error: bool,
    visible: bool,
}

export component NotificationToast inherits Rectangle {
    in property <string> message: "";
    in property <bool> is-error: false;
    in property <bool> active: false;

    width: 360px;
    height: active ? max(64px, message-text.height + 36px) : 0px;
    opacity: active ? 1.0 : 0.0;

    background: @linear-gradient(135deg,
        Theme.bg-sidebar 0%,
        is-error ? Theme.notify-error-bg : Theme.notify-success-bg 100%
    );
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: is-error ? Theme.notify-error-border : Theme.notify-success-border;
    drop-shadow-blur: 20px;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 4px;
    
    // Animation
    animate height { duration: 250ms; easing: ease-out-back; }
    animate opacity { duration: 200ms; easing: ease-out; }

    // Left accent bar
    Rectangle {
        x: 0;
        width: 4px;
        height: 100%;
        background: is-error 
            ? @linear-gradient(180deg, Theme.danger 0%, Theme.danger-strong 100%)
            : @linear-gradient(180deg, Theme.success 0%, Theme.success-strong 100%);
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        
        // Icon with glow
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: is-error ? Theme.icon-error-bg : Theme.icon-success-bg;
                border-width: 1px;
                border-color: is-error ? Theme.icon-error-border : Theme.icon-success-border;

                // Glow
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 13px;
                    background: is-error ? Theme.danger : Theme.success;
                    opacity: 0.2;
                }

                Image {
                    source: is-error ? @image-url("../assets/icons/x.svg") : @image-url("../assets/icons/check.svg");
                    width: 16px;
                    height: 16px;
                    colorize: is-error ? Theme.danger : Theme.success;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        
        // Message
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;

            Text {
                text: is-error ? "Error" : "Success";
                color: is-error ? Theme.danger : Theme.success;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1px;
            }

            message-text := Text {
                text: root.message;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 400;
                wrap: word-wrap;
                horizontal-stretch: 1;
                height: self.preferred-height;
            }
        }
    }
}
