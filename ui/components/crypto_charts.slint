import { CryptoDistributionSlice } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";

// ==================== Portfolio Distribution Chart ====================
export component PortfolioDistributionChart inherits Rectangle {
    in property <image> image;
    in property <bool> has-data: false;
    in property <[CryptoDistributionSlice]> slices: [];

    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: Translations.crypto-portfolio-distribution;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        Rectangle {
            height: 300px;
            border-radius: 14px;
            background: @linear-gradient(180deg, Theme.crypto-chart-bg-start, Theme.crypto-chart-bg-end);
            border-width: 1px;
            border-color: Theme.border-subtle;
            clip: true;

            if root.has-data: HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;

                Rectangle {
                    width: parent.width * 0.48;
                    height: parent.height;
                    background: transparent;

                    if root.has-data: Image {
                        source: root.image;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                }

                Rectangle {
                    width: parent.width * 0.52;
                    height: parent.height;
                    background: transparent;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        property <length> legend-content-height: (root.slices.length * 36px) + 20px;
                        property <length> legend-padding: max(4px, (self.height - legend-content-height) / 2);
                        viewport-height: max(self.height, legend-content-height + 8px);

                        VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            padding-top: legend-padding;
                            padding-bottom: legend-padding;

                            Text {
                                text: Translations.crypto-assets;
                                color: Theme.text-secondary;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 2px;
                            }

                            for slice[index] in root.slices: HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 3px;
                                    background: slice.color;
                                    y: 5px;
                                }

                                Text {
                                    text: slice.label;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    width: 80px;
                                    horizontal-alignment: left;
                                }

                                Text {
                                    text: slice.percent;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
            }

            if !root.has-data: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: Translations.crypto-no-priced-assets;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.crypto-sync-to-see;
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// ==================== Portfolio Trend Chart ====================
export component PortfolioTrendChart inherits Rectangle {
    in property <image> image;
    in property <bool> has-data: false;

    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 12px;

            Text {
                text: Translations.crypto-portfolio-trend;
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 2px;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.crypto-chart-value;
                    y: 6px;
                }

                Text {
                    text: Translations.crypto-value-label;
                    color: Theme.text-secondary;
                    font-size: 9px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.crypto-chart-cost;
                    y: 6px;
                }

                Text {
                    text: Translations.crypto-cost-label;
                    color: Theme.text-secondary;
                    font-size: 9px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 240px;
            border-radius: 14px;
            background: @linear-gradient(180deg, Theme.crypto-chart-bg-start, Theme.crypto-chart-bg-end);
            border-width: 1px;
            border-color: Theme.border-subtle;
            clip: true;

            if root.has-data: Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.has-data: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: Translations.crypto-no-trend;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.crypto-sync-daily;
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
