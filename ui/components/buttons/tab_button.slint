// Shared TabButton component for page navigation tabs

import { Theme } from "../../theme.slint";

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    min-width: 80px;
    height: 36px;
    border-radius: 18px;
    background: active ? @linear-gradient(135deg, Theme.surface-hover 0%, Theme.surface 100%) : transparent;
    border-width: 1px;
    border-color: active ? Theme.border-light : transparent;

    animate background { duration: 250ms; easing: ease-out; }
    animate border-color { duration: 250ms; easing: ease-out; }

    // Subtle glow when active
    if active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 20px;
        background: Theme.accent;
        opacity: 0.1;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;

        Text {
            text: root.text;
            color: active ? Theme.text-primary : Theme.text-muted;
            font-size: 11px;
            font-weight: active ? 600 : 500;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
