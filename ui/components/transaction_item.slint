// ==================== Transaction Item ====================
// Premium Fintech UI - Single transaction row for list view

import { Palette, TransactionData } from "../globals.slint";

// Category icon mapping
component CategoryIcon inherits Rectangle {
    in property <string> category;
    in property <bool> is-expense;
    in property <bool> is-transfer;

    width: 40px;
    height: 40px;
    border-radius: 12px;

    // Clean, subtle backgrounds
    background: is-transfer ? Palette.surface
        : (is-expense ? #1c1520 : #0f1a14);
    border-width: 1px;
    border-color: is-transfer ? Palette.border
        : (is-expense ? Palette.danger.with-alpha(0.2) : Palette.success.with-alpha(0.2));

    // Inner glow effect
    Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        background: @radial-gradient(circle,
            is-transfer ? transparent : (is-expense ? Palette.danger.with-alpha(0.08) : Palette.success.with-alpha(0.08)),
            transparent
        );
    }

    // Direction indicator
    Text {
        text: is-transfer ? "⇄" : (is-expense ? "↓" : "↑");
        color: is-transfer ? Palette.text-muted
            : (is-expense ? Palette.danger.with-alpha(0.6) : Palette.success.with-alpha(0.6));
        font-size: 11px;
        font-weight: 600;
        x: 4px;
        y: 2px;
    }

    // Category icon
    Text {
        text: root.category == "TRANSFER" ? "↔" :
              root.category == "FOOD" ? "🍽" :
              root.category == "TRANSPORT" ? "🚗" :
              root.category == "SHOPPING" ? "🛍" :
              root.category == "ENTERTAINMENT" ? "🎬" :
              root.category == "HEALTH" ? "💊" :
              root.category == "UTILITIES" ? "📄" :
              root.category == "EDUCATION" ? "📚" :
              root.category == "TRAVEL" ? "✈" :
              root.category == "SALARY" ? "💰" :
              root.category == "INVESTMENT" ? "📈" :
              root.category == "FREELANCE" ? "💼" :
              root.category == "GIFT" ? "🎁" :
              root.category == "OTHER" ? "📌" : "•";
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TransactionItem inherits Rectangle {
    in property <TransactionData> transaction;
    in property <bool> is-last: false;
    in property <bool> show-delete: true;

    callback clicked();
    callback delete-clicked();

    height: 64px;
    background: touch.has-hover ? Palette.surface-hover : transparent;
    border-radius: 8px;

    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    // Main touch area (background)
    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    // Content layout
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;

        // Category Icon
        VerticalLayout {
            alignment: center;
            CategoryIcon {
                category: transaction.category-raw;
                is-expense: transaction.is-expense;
                is-transfer: transaction.is-transfer;
            }
        }

        // Description and category (left)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: transaction.description != "" ? transaction.description : transaction.category;
                color: Palette.text-primary;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: transaction.date;
                    color: Palette.text-muted;
                    font-size: 10px;
                    font-weight: 400;
                    letter-spacing: 0.3px;
                }

                if transaction.description != "": Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Palette.text-subtle;
                    y: (parent.height - self.height) / 2;
                }

                if transaction.description != "": Text {
                    text: transaction.category;
                    color: Palette.text-subtle;
                    font-size: 10px;
                    font-weight: 400;
                    letter-spacing: 0.5px;
                }
            }
        }

        // Amount (right)
        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // Sign indicator
                Text {
                    text: transaction.is-transfer ? "" : (transaction.is-expense ? "−" : "+");
                    color: transaction.is-transfer ? transparent
                        : (transaction.is-expense ? Palette.danger : Palette.success);
                    font-size: 14px;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                // Amount value
                Text {
                    text: transaction.amount;
                    color: transaction.is-transfer ? Palette.text-secondary
                        : (transaction.is-expense ? Palette.danger : Palette.success);
                    font-size: 14px;
                    font-weight: 600;
                    letter-spacing: -0.3px;
                    vertical-alignment: center;
                }
            }
        }

    }

    // Delete button - separate layer on top to ensure clickability
    if show-delete: Rectangle {
        x: parent.width - 40px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: delete-touch.has-hover ? #3d2020 : transparent;
        border-width: delete-touch.has-hover ? 1px : 0px;
        border-color: Palette.danger;

        animate background { duration: 150ms; }

        Text {
            text: "×";
            color: delete-touch.has-hover ? Palette.danger : Palette.text-muted;
            font-size: 18px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color { duration: 150ms; }
        }

        delete-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.delete-clicked();
            }
        }
    }

    // Bottom border (except for last item)
    if !is-last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        x: 64px;
        width: parent.width - 76px;
        background: Palette.border-subtle;
        opacity: 0.5;
    }
}
