// ==================== Asset Detail Panel ====================
// Noir Fintech - Premium asset details drawer

import { Palette, CryptoAdapter, AppState, NotificationAdapter } from "../globals.slint";

// ==================== Section Header ====================
component SectionHeader inherits Rectangle {
    in property <string> title;
    
    height: 32px;
    background: transparent;
    
    HorizontalLayout {
        spacing: 12px;
        
        Rectangle {
            width: 3px;
            height: 16px;
            border-radius: 1px;
            background: Palette.accent;
            y: (parent.height - self.height) / 2;
        }
        
        Text { 
            text: root.title; 
            color: Palette.text-muted; 
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px; 
            vertical-alignment: center;
        }
    }
}

// ==================== Wallet Breakdown Row ====================
component WalletBreakdownRow inherits Rectangle {
    in property <string> wallet-name;
    in property <string> amount;
    in property <string> value;
    
    height: 56px;
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border-subtle;
    
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;
        
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Palette.background;
                border-width: 1px;
                border-color: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
                
                Text {
                    text: "💼";
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            
            Text { 
                text: root.wallet-name; 
                color: Palette.text-primary; 
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center; 
            }
        }
        
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            
            Text { 
                text: root.amount; 
                color: Palette.text-primary; 
                font-size: 13px;
                font-weight: 500;
                horizontal-alignment: right; 
            }
            Text { 
                text: root.value; 
                color: Palette.text-muted; 
                font-size: 11px; 
                horizontal-alignment: right; 
            }
        }
    }
}

// ==================== Transaction Row ====================
component TransactionRow inherits Rectangle {
    in property <string> tx-id;
    in property <string> tx-type;
    in property <string> tx-date;
    in property <string> tx-amount;
    in property <string> tx-price;
    in property <string> tx-fee;
    in property <string> tx-notes;
    in property <bool> is-last: false;
    in-out property <bool> confirm-mode: false;
    
    callback delete-clicked(string);
    callback edit-clicked(string);

    height: 64px;
    background: transparent;

    // Reset delete confirm when clicking away from the delete button.
    touch-area := TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && !del-touch.has-hover) {
                root.confirm-mode = false;
            }
        }
    }
    
    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;
        
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;
            
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: 
                    root.tx-type == "BUY" ? Palette.success.with-alpha(0.1) : 
                    root.tx-type == "SELL" ? Palette.danger.with-alpha(0.1) :
                    root.tx-type == "SWAP" ? Palette.primary.with-alpha(0.1) :
                    Palette.text-muted.with-alpha(0.1);
                border-width: 1px;
                border-color: 
                    root.tx-type == "BUY" ? Palette.success.with-alpha(0.2) : 
                    root.tx-type == "SELL" ? Palette.danger.with-alpha(0.2) :
                    root.tx-type == "SWAP" ? Palette.primary.with-alpha(0.2) :
                    Palette.border;
                y: (parent.height - self.height) / 2;
                
                Text {
                    text: 
                        root.tx-type == "BUY" ? "▲" : 
                        root.tx-type == "SELL" ? "▼" :
                        root.tx-type == "SWAP" ? "⇄" : "•";
                    color: 
                        root.tx-type == "BUY" ? Palette.success : 
                        root.tx-type == "SELL" ? Palette.danger :
                        root.tx-type == "SWAP" ? Palette.primary :
                        Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                
                Text { 
                    text: root.tx-type; 
                    color: Palette.text-primary; 
                    font-size: 12px; 
                    font-weight: 500; 
                }
                Text { 
                    text: root.tx-date; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                }
                if root.tx-notes != "": Text { 
                    text: root.tx-notes; 
                    color: Palette.text-subtle; 
                    font-size: 9px; 
                }
            }
        }
        
        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                
                Text { 
                    text: root.tx-amount; 
                    color: Palette.text-primary; 
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: right; 
                }
                Text { 
                    text: "@ " + root.tx-price; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                    horizontal-alignment: right; 
                }
                if root.tx-fee != "": Text { 
                    text: "Fee " + root.tx-fee; 
                    color: Palette.text-subtle; 
                    font-size: 9px; 
                    horizontal-alignment: right; 
                }
            }

            // Delete Button
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: edit-touch.has-hover ? Palette.surface-hover : transparent;
                y: (parent.height - self.height) / 2;

                animate background { duration: 150ms; }

                Text {
                    text: "✎";
                    color: edit-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                edit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit-clicked(root.tx-id); }
                }
            }

            Rectangle {
                width: root.confirm-mode ? 52px : 28px;
                height: 28px;
                border-radius: 6px;
                background: root.confirm-mode ? Palette.danger : (del-touch.has-hover ? Palette.danger.with-alpha(0.1) : transparent);
                y: (parent.height - self.height) / 2;

                animate background { duration: 150ms; }
                animate width { duration: 150ms; }

                Text {
                    text: root.confirm-mode ? "SURE?" : "×";
                    color: root.confirm-mode ? #ffffff : (del-touch.has-hover ? Palette.danger : Palette.text-muted);
                    font-size: root.confirm-mode ? 9px : 16px;
                    font-weight: root.confirm-mode ? 700 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                del-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { 
                        if (root.confirm-mode) {
                            root.delete-clicked(root.tx-id);
                        } else {
                            root.confirm-mode = true;
                        }
                    }
                }
            }
        }
    }
    
    if !root.is-last: Rectangle { 
        height: 1px; 
        width: parent.width; 
        background: Palette.border-subtle; 
        y: parent.height - 1px; 
    }
}

// ==================== Main Panel ====================
export component AssetDetailPanel inherits Rectangle {
    width: 420px;
    height: 100%;
    background: @linear-gradient(180deg, #0a0a10 0%, #080810 100%);
    
    // Left border accent
    Rectangle {
        width: 1px;
        height: 100%;
        x: 0;
        background: Palette.border;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header
        Rectangle {
            height: 100px;
            background: Palette.surface;
            
            HorizontalLayout {
                padding-left: 28px;
                padding-right: 28px;
                spacing: 16px;
                
                // Asset Icon
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: @linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    y: (parent.height - self.height) / 2;
                    
                    Text { 
                        text: CryptoAdapter.selected-asset.symbol; 
                        color: Palette.text-primary; 
                        font-size: 16px; 
                        font-weight: 600;
                        letter-spacing: 0.5px;
                        vertical-alignment: center; 
                        horizontal-alignment: center; 
                    }
                }
                
                // Asset Info
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    
                    Text { 
                        text: CryptoAdapter.selected-asset.name; 
                        color: Palette.text-primary; 
                        font-size: 18px; 
                        font-weight: 400; 
                        letter-spacing: 0.5px; 
                    }
                    
                    HorizontalLayout {
                        spacing: 10px;
                        
                        Text { 
                            text: CryptoAdapter.selected-asset.price == "N/A" ? "---" : CryptoAdapter.selected-asset.price; 
                            color: Palette.text-secondary; 
                            font-size: 13px; 
                        }
                        
                        // Change badge
                        if CryptoAdapter.selected-asset.price != "N/A": Rectangle {
                            width: 60px;
                            height: 20px;
                            border-radius: 4px;
                            background: CryptoAdapter.selected-asset.is-positive ? 
                                Palette.success.with-alpha(0.1) : Palette.danger.with-alpha(0.1);
                            
                            Text {
                                text: CryptoAdapter.selected-asset.change-24h;
                                color: CryptoAdapter.selected-asset.is-positive ? Palette.success : Palette.danger;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                
                // Close Button
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;
                    y: (parent.height - self.height) / 2;
                    
                    animate background { duration: 150ms; }
                    
                    Text { 
                        text: "✕"; 
                        color: Palette.text-muted; 
                        font-size: 16px; 
                        vertical-alignment: center; 
                        horizontal-alignment: center; 
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { CryptoAdapter.show-asset-detail = false; } 
                    }
                }
            }
            
            // Bottom border
            Rectangle {
                height: 1px;
                width: parent.width;
                background: Palette.border;
                y: parent.height - 1px;
            }
        }
        
        // Content
        VerticalLayout {
            padding: 28px;
            spacing: 24px;
            
            // Holdings Card
            Rectangle {
                height: 120px;
                background: @linear-gradient(135deg, #111118 0%, #0d0d14 100%);
                border-radius: 12px;
                border-width: 1px;
                border-color: Palette.border-subtle;
                
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: center;
                    
                    Text { 
                        text: "TOTAL HOLDINGS"; 
                        color: Palette.text-muted; 
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 2px; 
                        horizontal-alignment: center; 
                    }
                    
                    Text { 
                        text: CryptoAdapter.selected-asset.amount; 
                        color: Palette.text-primary; 
                        font-size: 28px; 
                        font-weight: 300;
                        letter-spacing: -0.5px;
                        horizontal-alignment: center; 
                    }
                    
                    Text { 
                        text: "≈ " + (CryptoAdapter.selected-asset.price == "N/A" ? "---" : CryptoAdapter.selected-asset.value); 
                        color: Palette.text-secondary; 
                        font-size: 14px; 
                        horizontal-alignment: center; 
                    }
                }
            }
            
            // Wallet Breakdown Section
            VerticalLayout {
                spacing: 12px;
                
                SectionHeader { title: "WALLET BREAKDOWN"; }
                
                if CryptoAdapter.asset-wallets.length == 0: Rectangle {
                    height: 48px;
                    background: Palette.surface.with-alpha(0.3);
                    border-radius: 8px;
                    
                    Text { 
                        text: "No wallet data available"; 
                        color: Palette.text-subtle; 
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                
                for item in CryptoAdapter.asset-wallets: WalletBreakdownRow {
                    wallet-name: item.wallet-name;
                    amount: item.amount;
                    value: item.value;
                }
            }
            
            // History Section
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                
                SectionHeader { title: "TRANSACTION HISTORY"; }
                
                if CryptoAdapter.asset-history.length == 0: Rectangle {
                    height: 48px;
                    background: Palette.surface.with-alpha(0.3);
                    border-radius: 8px;
                    
                    Text { 
                        text: "No transactions found"; 
                        color: Palette.text-subtle; 
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: CryptoAdapter.asset-history.length * 64px;
                    
                    VerticalLayout {
                        for tx[index] in CryptoAdapter.asset-history: TransactionRow {
                            tx-id: tx.id;
                            tx-type: tx.type;
                            tx-date: tx.date;
                            tx-amount: tx.amount;
                            tx-price: tx.price;
                            tx-fee: tx.fee;
                            tx-notes: tx.notes;
                            is-last: index == CryptoAdapter.asset-history.length - 1;
                            
                            delete-clicked(id) => {
                                CryptoAdapter.delete-crypto-transaction(id);
                            }
                            edit-clicked(id) => {
                                let result = CryptoAdapter.load-edit-transaction(id);
                                if (result == "") {
                                    AppState.show-edit-crypto = true;
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
