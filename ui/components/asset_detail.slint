// ==================== Asset Detail Panel ====================
// Slide-over drawer for asset drill-down

import { Palette, CryptoAdapter } from "../globals.slint";

export component AssetDetailPanel inherits Rectangle {
    width: 400px;
    height: 100%;
    background: Palette.sidebar-bg;
    
    // Border left
    Rectangle {
        width: 1px;
        height: 100%;
        x: 0;
        background: Palette.border;
    }

    VerticalLayout {
        padding: 24px;
        spacing: 24px;

        // Header
        HorizontalLayout {
            spacing: 12px;
            
            Rectangle {
                width: 40px; height: 40px; border-radius: 20px; background: Palette.surface;
                Text { text: CryptoAdapter.selected-asset.symbol; color: Palette.text-primary; font-size: 14px; font-weight: 500; vertical-alignment: center; horizontal-alignment: center; }
            }
            
            VerticalLayout {
                alignment: center;
                Text { text: CryptoAdapter.selected-asset.name; color: Palette.text-primary; font-size: 18px; font-weight: 300; letter-spacing: 1px; }
                Text { text: CryptoAdapter.selected-asset.price; color: Palette.text-muted; font-size: 12px; }
            }
            
            Rectangle { horizontal-stretch: 1; }
            
            // Close Button
            Rectangle {
                width: 32px; height: 32px;
                Text { text: "×"; color: Palette.text-muted; font-size: 24px; vertical-alignment: center; horizontal-alignment: center; }
                TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { CryptoAdapter.show-asset-detail = false; } 
                }
            }
        }
        
        // Summary Card
        Rectangle {
            height: 100px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            
            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: center;
                
                Text { text: "TOTAL HOLDINGS"; color: Palette.text-muted; font-size: 10px; letter-spacing: 2px; horizontal-alignment: center; }
                Text { text: CryptoAdapter.selected-asset.amount; color: Palette.text-primary; font-size: 24px; font-weight: 300; horizontal-alignment: center; }
                Text { text: CryptoAdapter.selected-asset.value; color: Palette.text-secondary; font-size: 14px; horizontal-alignment: center; }
            }
        }
        
        // Section: Wallet Breakdown
        VerticalLayout {
            spacing: 12px;
            Text { text: "WALLET BREAKDOWN"; color: Palette.text-muted; font-size: 10px; letter-spacing: 2px; }
            
            if CryptoAdapter.asset-wallets.length == 0: Text { text: "No data"; color: Palette.text-subtle; font-size: 12px; font-italic: true; }
            
            for item in CryptoAdapter.asset-wallets: Rectangle {
                height: 48px;
                background: Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border-subtle;
                
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    alignment: space-between;
                    Text { text: item.wallet-name; color: Palette.text-primary; font-size: 12px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: item.amount; color: Palette.text-primary; font-size: 12px; horizontal-alignment: right; }
                        Text { text: item.value; color: Palette.text-muted; font-size: 10px; horizontal-alignment: right; }
                    }
                }
            }
        }
        
        // Section: History
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            Text { text: "HISTORY"; color: Palette.text-muted; font-size: 10px; letter-spacing: 2px; }
            
            if CryptoAdapter.asset-history.length == 0: Text { text: "No transactions found"; color: Palette.text-subtle; font-size: 12px; font-italic: true; }

            Flickable {
                viewport-height: CryptoAdapter.asset-history.length * 48px;
                VerticalLayout {
                    for tx in CryptoAdapter.asset-history: Rectangle {
                        height: 48px;
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                Text { text: tx.type; color: Palette.text-primary; font-size: 12px; font-weight: 500; }
                                Text { text: tx.date; color: Palette.text-muted; font-size: 10px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: tx.amount; color: Palette.text-primary; font-size: 12px; horizontal-alignment: right; }
                                Text { text: "@ " + tx.price; color: Palette.text-muted; font-size: 10px; horizontal-alignment: right; }
                            }
                        }
                        Rectangle { height: 1px; width: parent.width; background: Palette.border-subtle; y: parent.height - 1px; }
                    }
                }
            }
        }
    }
}
