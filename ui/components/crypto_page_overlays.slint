import { CryptoAdapter, NotificationAdapter } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { AssetDetailPanel } from "./asset_detail.slint";
import { WalletDetailPanel } from "./wallet_detail.slint";

export component CryptoPageOverlays inherits Rectangle {
    in-out property <bool> show-delete-wallet-confirm;
    in-out property <string> delete-wallet-id;
    in-out property <string> delete-wallet-name;

    // ==================== DETAIL OVERLAY ====================
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // Backdrop
        Rectangle {
            background: Theme.overlay-bg-strong;

            animate background { duration: 200ms; }
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CryptoAdapter.show-asset-detail = false;
                    }
                }
            }

            AssetDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== WALLET DETAIL OVERLAY ====================
    if CryptoAdapter.show-wallet-detail: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // Backdrop
        Rectangle {
            background: Theme.overlay-bg-strong;

            animate background { duration: 200ms; }
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CryptoAdapter.show-wallet-detail = false;
                    }
                }
            }

            WalletDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== DELETE WALLET CONFIRM ====================
    if show-delete-wallet-confirm: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        z: 1200;

        Rectangle {
            background: Theme.overlay-bg-strong;
            TouchArea {
                clicked => {
                    show-delete-wallet-confirm = false;
                    delete-wallet-id = "";
                    delete-wallet-name = "";
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: Translations.crypto-delete-wallet;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.crypto-delete-wallet-confirm-prefix + delete-wallet-name + Translations.crypto-delete-wallet-confirm-suffix;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.action-cancel;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                show-delete-wallet-confirm = false;
                                delete-wallet-id = "";
                                delete-wallet-name = "";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Theme.delete-bg-active : Theme.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.delete-border;

                        Text {
                            text: Translations.action-delete;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let result = CryptoAdapter.delete-wallet(delete-wallet-id);
                                if (result == "") {
                                    show-delete-wallet-confirm = false;
                                    delete-wallet-id = "";
                                    delete-wallet-name = "";
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== LOADING OVERLAY ====================
    if CryptoAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background.with-alpha(0.95);
        z: 999;
        opacity: 1.0;

        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Theme.surface;
                border-width: 3px;
                border-color: Theme.accent;

                animate border-color {
                    duration: 1s;
                    iteration-count: -1;
                    easing: ease-in-out;
                }

                Image {
                    source: @image-url("../assets/icons/coins.svg");
                    width: 28px;
                    height: 28px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: Translations.crypto-loading-portfolio;
                color: Theme.text-secondary;
                font-size: 14px;
                font-weight: 500;
            }
        }
    }

    // ==================== SYNCING OVERLAY ====================
    if CryptoAdapter.is-refreshing && !CryptoAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg-soft;
        z: 998;
        opacity: 1.0;

        animate opacity {
            duration: 150ms;
            easing: ease-out;
        }

        Rectangle {
            width: 300px;
            height: 100px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;
            opacity: 1.0;

            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: center;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.accent.with-alpha(0.1);
                    border-width: 2px;
                    border-color: Theme.accent;

                    animate border-color {
                        duration: 1.5s;
                        iteration-count: -1;
                        easing: ease-in-out;
                    }

                    Image {
                        source: @image-url("../assets/icons/refresh-cw.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: Translations.crypto-syncing-prices;
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    Text {
                        text: Translations.crypto-syncing-wait;
                        color: Theme.text-muted;
                        font-size: 10px;
                    }
                }
            }
        }
    }
}
