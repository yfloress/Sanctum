// ==================== Tactical Grid Background ====================
// A sophisticated dark background with subtle grid lines and radial gradient

import { Palette } from "../globals.slint";

export component TacticalGrid inherits Rectangle {
    in property <int> grid-cols: 20;
    in property <int> grid-rows: 12;
    in property <bool> show-background: true;

    // Fill the parent
    width: 100%;
    height: 100%;
    
    // Base radial gradient: "Focal point"
    // Only show if show-background is true
    background: root.show-background ? @radial-gradient(circle, #1a1a1a 0%, #050505 60%, #000000 100%) : transparent;

    // Grid Container
    Rectangle {
        width: 100%;
        height: 100%;
        opacity: 0.04; // Very subtle

        // Vertical lines
        for i in root.grid-cols : Rectangle {
            x: (parent.width / root.grid-cols) * i;
            y: 0;
            width: 1px;
            height: 100%;
            background: #ffffff;
        }

        // Horizontal lines
        for i in root.grid-rows : Rectangle {
            x: 0;
            y: (parent.height / root.grid-rows) * i;
            width: 100%;
            height: 1px;
            background: #ffffff;
        }
    }
    
    // Optional: Vignette overlay (corner darkness)
    if root.show-background : Rectangle {
        background: @radial-gradient(circle, transparent 50%, #000000 100%);
    }
}
