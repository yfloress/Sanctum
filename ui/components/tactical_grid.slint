// ==================== Tactical Grid Background ====================
// A sophisticated dark background with subtle grid lines and radial gradient

import { Palette } from "../globals.slint";

export component TacticalGrid inherits Rectangle {
    // Fill the parent
    width: 100%;
    height: 100%;
    
    // Base radial gradient: "Focal point"
    background: @radial-gradient(circle, #1a1a1a 0%, #050505 60%, #000000 100%);

    // Grid Container
    Rectangle {
        width: 100%;
        height: 100%;
        opacity: 0.04; // Very subtle

        // Since Slint doesn't support tiled images or complex repeating gradients easily yet,
        // we can simulate a grid using a repeated linear gradient for CSS-like backends,
        // or just use a few strategically placed lines. 
        
        // However, standard Slint doesn't have `repeating-linear-gradient`.
        // We will create a loop of lines. This is computationally fine for ~20-30 lines.
        
        // Vertical lines
        for i in 20 : Rectangle {
            x: (parent.width / 20) * i;
            y: 0;
            width: 1px;
            height: 100%;
            background: #ffffff;
        }

        // Horizontal lines
        for i in 12 : Rectangle {
            x: 0;
            y: (parent.height / 12) * i;
            width: 100%;
            height: 1px;
            background: #ffffff;
        }
    }
    
    // Optional: Vignette overlay (corner darkness)
    Rectangle {
        background: @radial-gradient(circle, transparent 50%, #000000 100%);
    }
}
