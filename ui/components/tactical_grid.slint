// ==================== Tactical Grid Background ====================
// A sophisticated dark background with subtle grid lines and radial gradient

import { Palette } from "../globals.slint";

export component TacticalGrid inherits Rectangle {
    in property <int> grid-cols: 20;
    in property <int> grid-rows: 12;
    in property <bool> show-background: true;

    // Fill the parent
    width: 100%;
    height: 100%;

    // Smooth purple gradient background
    background: root.show-background ? @radial-gradient(circle, #1a1a28 0%, #0f0f18 50%, #000000 100%) : transparent;
}
