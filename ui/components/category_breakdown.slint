// ==================== Category Breakdown ====================
// Noir Fintech - Premium spending visualization

import { Palette, CategoryData } from "../globals.slint";
import { Theme } from "../theme.slint";

component CategoryItem inherits Rectangle {
    in property <CategoryData> category;
    in property <bool> is-last: false;
    
    height: 64px;
    background: transparent;
    
    HorizontalLayout {
        spacing: 16px;
        
        // Color indicator
        Rectangle {
            width: 4px;
            height: 40px;
            border-radius: 2px;
            background: category.color;
            y: (parent.height - self.height) / 2;
            
            // Glow effect
            Rectangle {
                x: -3px;
                y: -3px;
                width: 10px;
                height: parent.height + 6px;
                border-radius: 5px;
                background: category.color.with-alpha(0.2);
            }
        }
        
        // Content
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;
            
            // Header row
            HorizontalLayout {
                alignment: space-between;
                
                Text {
                    text: category.name;
                    color: Palette.text-primary;
                    font-size: 13px;
                    font-weight: 500;
                    letter-spacing: 0.5px;
                }
                
                Text {
                    text: category.amount;
                    color: Palette.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
            
            // Progress bar
            Rectangle {
                height: 6px;
                background: Palette.background;
                border-radius: 3px;
                clip: true;
                
                // Fill
                Rectangle {
                    x: 0;
                    width: parent.width * category.percentage;
                    height: 100%;
                    border-radius: 3px;
                    background: @linear-gradient(90deg, category.color.with-alpha(0.8) 0%, category.color 100%);
                    
                    animate width { duration: 800ms; easing: ease-out-expo; }
                    
                    // Shine effect
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 50%;
                        background: @linear-gradient(180deg, Theme.text.with-alpha(0.13) 0%, transparent 100%);
                        border-radius: 3px;
                    }
                }
            }
            
            // Percentage text
            Text {
                text: round(category.percentage * 100) + "% of total";
                color: Palette.text-muted;
                font-size: 10px;
                letter-spacing: 0.5px;
            }
        }
    }
    
    // Bottom separator
    if !is-last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width - 20px;
        x: 20px;
        background: Palette.border-subtle;
    }
}

export component CategoryBreakdown inherits VerticalLayout {
    in property <[CategoryData]> categories;
    spacing: 0px;
    
    if categories.length == 0: Rectangle {
        height: 120px;
        
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Palette.surface-hover;
                x: (parent.width - self.width) / 2;
                
                Text {
                    text: "📊";
                    font-size: 20px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            
            Text {
                text: "No expenses recorded";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }

    for category[index] in categories: CategoryItem {
        category: category;
        is-last: index == categories.length - 1;
    }
}
