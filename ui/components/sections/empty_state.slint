// Shared EmptyState component for empty list displays

import { Theme } from "../../theme.slint";

export component EmptyState inherits Rectangle {
    in property <image> icon: @image-url("../../assets/icons/folder.svg");
    in property <string> title: "No data";
    in property <string> description: "Get started by adding your first entry";

    height: 160px;
    background: @linear-gradient(135deg, Theme.surface 0%, Theme.surface-deep 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: Theme.surface-hover;
            x: (parent.width - self.width) / 2;

            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 27px;
                background: Theme.accent;
                opacity: 0.2;
            }

            Image {
                source: root.icon;
                width: 22px;
                height: 22px;
                colorize: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 400;
            horizontal-alignment: center;
        }
    }
}
