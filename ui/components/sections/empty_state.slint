// Shared EmptyState component for empty list displays

import { Palette } from "../../globals.slint";

export component EmptyState inherits Rectangle {
    in property <string> icon: "📊";
    in property <string> title: "No data";
    in property <string> description: "Get started by adding your first entry";

    height: 160px;
    background: @linear-gradient(135deg, Palette.surface 0%, #1a1a2e 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: Palette.surface-hover;
            x: (parent.width - self.width) / 2;

            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 27px;
                background: Palette.accent;
                opacity: 0.2;
            }

            Text {
                text: root.icon;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            horizontal-alignment: center;
        }
    }
}
