// Shared SectionHeader component for section titles with accent line

import { Theme } from "../../theme.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> action-text: "";
    callback action-clicked;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;

            // Accent line
            Rectangle {
                width: 3px;
                height: 20px;
                border-radius: 2px;
                background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent-indigo 100%);
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
        }

        if action-text != "": Rectangle {
            width: 100px;

            Text {
                text: action-text;
                color: action-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1px;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate color { duration: 150ms; }
            }

            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }
            }
        }
    }
}
