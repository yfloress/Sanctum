// Shared SectionHeader component for section titles with accent line

import { Palette } from "../../globals.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        // Accent line
        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}
