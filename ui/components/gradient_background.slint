// ==================== Auth Background ====================
// Full-bleed background image with dark overlay for authentication screens


export component GradientBackground inherits Rectangle {
    in property <bool> show-background: true;
    in property <image> background-image: @image-url("../assets/backgrounds/login_default.jpg");
    in property <bool> use-custom-image: false;
    in property <image> custom-image;
    in property <color> overlay-color: #000000b3;

    width: 100%;
    height: 100%;

    if root.show-background: Image {
        width: 100%;
        height: 100%;
        source: root.use-custom-image ? root.custom-image : root.background-image;
        image-fit: cover;
    }

    if root.show-background: Rectangle {
        width: 100%;
        height: 100%;
        background: root.overlay-color;
    }
}
