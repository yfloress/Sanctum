// ==================== Gradient Background ====================
// Smooth purple to black radial gradient for authentication screens

import { Theme } from "../theme.slint";

export component GradientBackground inherits Rectangle {
    in property <bool> show-background: true;

    width: 100%;
    height: 100%;

    // Smooth purple to black radial gradient with multiple stops for seamless transition
    background: root.show-background
        ? @radial-gradient(
            circle,
            Theme.auth-bg-1 0%,
            Theme.auth-bg-2 15%,
            Theme.auth-bg-3 30%,
            Theme.auth-bg-4 45%,
            Theme.auth-bg-5 60%,
            Theme.auth-bg-6 75%,
            Theme.auth-bg-7 88%,
            Theme.auth-bg-8 100%
        )
        : transparent;
}
