// History Tab Component
// Shows achievements/trophies gallery of completed rewards and goals

import { Theme } from "../../theme.slint";
import { Translations } from "../../translations.slint";
import { RewardsAdapter } from "../../globals.slint";
import { AchievementCard } from "achievement_card.slint";
import { SectionHeader } from "../sections/section_header.slint";
import { EmptyState } from "../sections/empty_state.slint";

export component HistoryTab inherits Rectangle {
    background: transparent;

    property <int> total-achievements: RewardsAdapter.achievements.length;

    VerticalLayout {
        spacing: 16px;

        SectionHeader {
            title: Translations.history-achievements-section;
        }

        if total-achievements > 0: Rectangle {
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            vertical-stretch: 1;
            min-height: 300px;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                // Stats summary
                HorizontalLayout {
                    spacing: 24px;
                    height: 48px;

                    // Total achievements
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.warning.transparentize(0.85);

                            Image {
                                source: @image-url("../../assets/icons/trophy.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Theme.warning;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: total-achievements;
                                color: Theme.text-primary;
                                font-size: 18px;
                                font-weight: 600;
                            }

                            Text {
                                text: Translations.history-total-achievements;
                                color: Theme.text-muted;
                                font-size: 9px;
                                font-weight: 600;
                                letter-spacing: 1px;
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Achievement grid - using Flickable with GridBox-style layout via for loop
                Flickable {
                    vertical-stretch: 1;
                    min-height: 160px;

                    // Wrap content in a container that flows items
                    Rectangle {
                        // Calculate grid dimensions
                        property <int> cards-per-row: 4;
                        property <length> card-width: 140px;
                        property <length> card-height: 140px;
                        property <length> spacing: 12px;
                        property <int> row-count: (total-achievements + cards-per-row - 1) / cards-per-row;

                        width: parent.width;
                        height: row-count * (card-height + spacing);

                        for achievement[idx] in RewardsAdapter.achievements: AchievementCard {
                            achievement: achievement;
                            x: mod(idx, 4) * (card-width + spacing);
                            y: floor(idx / 4) * (card-height + spacing);
                        }
                    }
                }
            }
        }

        if total-achievements == 0: EmptyState {
            icon: @image-url("../../assets/icons/trophy.svg");
            title: Translations.history-no-achievements;
            description: Translations.history-complete-to-earn;
        }
    }
}
