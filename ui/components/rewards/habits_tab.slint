// Habits Tab Component
// Extracted habits list content for use with tabbed interface

import { Theme } from "../../theme.slint";
import { HabitAdapter, NotificationAdapter } from "../../globals.slint";
import { HabitRow } from "../habit_row.slint";
import { HabitHeatmap } from "../habit_heatmap.slint";
import {
    HabitRadarChart,
    WeekdayEfficiencyChart,
    InsightCard,
} from "../analytics_charts.slint";
import { SectionHeader } from "../sections/section_header.slint";
import { EmptyState } from "../sections/empty_state.slint";

component NavButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover && enabled ? Theme.border-light : transparent;
    opacity: enabled ? 1.0 : 0.3;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Text {
        text: root.icon;
        color: Theme.text-secondary;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if enabled {
                root.clicked();
            }
        }
    }
}

component SummaryItem inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <string> value: "";
    in property <string> note: "";

    background: transparent;
    height: 56px;

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: Theme.text-primary;
                vertical-alignment: center;
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if root.note != "": Text {
            text: root.note;
            color: Theme.text-muted;
            font-size: 11px;
        }
    }
}

export component HabitsTab inherits Rectangle {
    in-out property <bool> show-delete-habit-confirm: false;
    in-out property <string> delete-habit-id: "";
    in-out property <string> delete-habit-name: "";
    callback delete-confirmed(string);

    background: transparent;

    VerticalLayout {
        spacing: 24px;

        // Yearly Overview Section
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                SectionHeader {
                    title: "YEARLY OVERVIEW";
                }

                // Year Navigation
                HorizontalLayout {
                    spacing: 8px;

                    NavButton {
                        icon: "←";
                        clicked => {
                            HabitAdapter.prev-heatmap-year();
                        }
                    }

                    Rectangle {
                        width: 60px;
                        height: 28px;
                        background: Theme.surface;
                        border-radius: 6px;

                        Text {
                            text: HabitAdapter.heatmap-year;
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    NavButton {
                        icon: "→";
                        clicked => {
                            HabitAdapter.next-heatmap-year();
                        }
                    }
                }
            }

            // Heatmap container
            Rectangle {
                height: 200px;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;

                HabitHeatmap { }
            }
        }

        // Habits List Section
        VerticalLayout {
            spacing: 12px;

            SectionHeader {
                title: "MY HABITS";
            }

            if HabitAdapter.habits.length > 0: Rectangle {
                height: HabitAdapter.habits.length * Theme.habit-row-height;
                background: Theme.surface;
                clip: true;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 8px;
                    spacing: 0px;

                    for habit in HabitAdapter.habits: HabitRow {
                        habit: habit;
                        toggle(date) => {
                            HabitAdapter.toggle-habit(habit.id, date);
                        }
                        delete(id, name) => {
                            root.delete-habit-id = id;
                            root.delete-habit-name = name;
                            root.show-delete-habit-confirm = true;
                        }
                        edit(id) => {
                            HabitAdapter.edit-id = habit.id;
                            HabitAdapter.edit-name = habit.name;
                            HabitAdapter.edit-description = habit.description;
                            HabitAdapter.edit-color-hex = habit.color-hex;
                            HabitAdapter.edit-color-index = habit.color-index;
                            HabitAdapter.edit-category = habit.category;
                        }
                        select(id) => {
                            HabitAdapter.select-habit(id);
                        }
                    }
                }
            }

            if HabitAdapter.habits.length == 0: EmptyState {
                icon: @image-url("../../assets/icons/check.svg");
                title: "No habits tracked this month";
                description: "Create a habit to start building consistency";
            }
        }

        // Analytics Section
        if HabitAdapter.habits.length > 0: VerticalLayout {
            spacing: 16px;

            SectionHeader {
                title: "ANALYTICS";
            }

            HorizontalLayout {
                spacing: 16px;

                HabitRadarChart {
                    horizontal-stretch: 1;
                    image: HabitAdapter.habits-radar-chart-image;
                    has-data: HabitAdapter.habits-radar-has-data;
                }

                WeekdayEfficiencyChart {
                    horizontal-stretch: 1;
                    image: HabitAdapter.habits-weekday-chart-image;
                    has-data: HabitAdapter.habits-weekday-has-data;
                }
            }

            InsightCard {
                horizontal-stretch: 1;
                title: "WEEKLY REPORT";
                line1: HabitAdapter.habits-weekly-primary;
                line2: HabitAdapter.habits-weekly-secondary;
            }

            InsightCard {
                horizontal-stretch: 1;
                title: "INSIGHTS";
                line1: HabitAdapter.habits-insight-primary;
                line2: HabitAdapter.habits-insight-secondary;
            }
        }

        // Summary Section
        if HabitAdapter.habits.length > 0: VerticalLayout {
            spacing: 12px;

            SectionHeader {
                title: "HABIT SUMMARY";
            }

            Rectangle {
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: "SELECTED HABIT";
                        color: Theme.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 4px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, HabitAdapter.summary-habit-color 0%, HabitAdapter.summary-habit-color.darker(0.2) 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: HabitAdapter.summary-habit-name;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;

                        SummaryItem {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/trending-up.svg");
                            label: "CURRENT STREAK";
                            value: HabitAdapter.summary-current-streak + " days";
                        }

                        SummaryItem {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/star.svg");
                            label: "BEST STREAK (365D)";
                            value: HabitAdapter.summary-best-streak + " days";
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;

                        SummaryItem {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/percent.svg");
                            label: "COMPLETION RATE";
                            value: HabitAdapter.summary-completion-rate + "%";
                            note: HabitAdapter.summary-completion-note;
                        }

                        SummaryItem {
                            horizontal-stretch: 1;
                            icon: @image-url("../../assets/icons/check.svg");
                            label: "COMPLETIONS (30D)";
                            value: HabitAdapter.summary-last-30 + "";
                            note: HabitAdapter.summary-best-day;
                        }
                    }
                }
            }
        }

        // Bottom spacer
        Rectangle {
            height: 32px;
        }
    }
}
