// Achievement Card Component
// Displays an unlocked achievement/trophy in the history view

import { Theme } from "../../theme.slint";
import { AchievementData } from "../../globals.slint";

export component AchievementCard inherits Rectangle {
    in property <AchievementData> achievement;

    width: 140px;
    height: 140px;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-light : Theme.border;
    clip: true;

    animate border-color { duration: 150ms; }

    // Subtle shine effect on hover
    if touch.has-hover: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: @linear-gradient(135deg, Theme.accent 0%, transparent 50%);
        opacity: 0.05;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: center;

        // Icon container - fixed size circle with icon
        Rectangle {
            width: 40px;
            height: 40px;
            x: (parent.width - self.width) / 2;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: achievement.achievement-type == "streak" ? Theme.warning : Theme.success;
                opacity: 0.15;
            }

            // Use fallback icon (trophy for streak, target for goal) when no icon loaded
            Image {
                source: achievement.achievement-type == "streak" ? @image-url("../../assets/icons/trophy.svg") : @image-url("../../assets/icons/target.svg");
                width: 20px;
                height: 20px;
                colorize: achievement.achievement-type == "streak" ? Theme.warning : Theme.success;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // Title - single line with ellipsis
        Text {
            text: achievement.title;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
            max-width: 116px;
        }

        // Description - max 2 lines
        Rectangle {
            height: 24px;
            clip: true;

            Text {
                width: 116px;
                text: achievement.description;
                color: Theme.text-muted;
                font-size: 9px;
                horizontal-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // Date achieved - compact format
        Rectangle {
            height: 16px;

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                Image {
                    source: @image-url("../../assets/icons/calendar.svg");
                    width: 10px;
                    height: 10px;
                    colorize: Theme.text-subtle;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: achievement.achieved-at;
                    color: Theme.text-subtle;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}
