// Rewards Tab Component
// Shows streak rewards and goals sections with add buttons

import { Theme } from "../../theme.slint";
import {
    RewardsAdapter,
    AppState,
    NotificationAdapter,
    HabitAdapter,
} from "../../globals.slint";
import { StreakRewardCard } from "streak_reward_card.slint";
import { GoalCard } from "goal_card.slint";
import { SectionHeader } from "../sections/section_header.slint";
import { EmptyState } from "../sections/empty_state.slint";
import { ActionButton } from "../../widgets.slint";

export component RewardsTab inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 24px;

        // ==================== STREAK REWARDS SECTION ====================
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                SectionHeader {
                    title: "STREAK REWARDS";
                }

                ActionButton {
                    text: "+ REWARD";
                    primary: false;
                    clicked => {
                        AppState.show-add-reward = true;
                    }
                }
            }

            if RewardsAdapter.streak-rewards.length > 0: VerticalLayout {
                spacing: 12px;

                for reward[idx] in RewardsAdapter.streak-rewards: StreakRewardCard {
                    reward: reward;
                    edit(id) => {
                        // Load reward data into edit properties
                        RewardsAdapter.edit-reward-id = id;
                        RewardsAdapter.edit-reward-habit-id = reward.habit-id;
                        RewardsAdapter.edit-reward-habit-index = HabitAdapter.find-habit-index(reward.habit-id);
                        RewardsAdapter.edit-reward-is-consecutive = reward.is-consecutive;
                        RewardsAdapter.edit-reward-target-days = reward.target-days;
                        RewardsAdapter.edit-reward-target-total = reward.target-total;
                        // Load milestones
                        RewardsAdapter.edit-reward-milestone-count = reward.milestones.length;
                        if reward.milestones.length >= 1 {
                            RewardsAdapter.edit-reward-m1-days = reward.milestones[0].target-days;
                            RewardsAdapter.edit-reward-m1-text = reward.milestones[0].reward-text;
                        }
                        if reward.milestones.length >= 2 {
                            RewardsAdapter.edit-reward-m2-days = reward.milestones[1].target-days;
                            RewardsAdapter.edit-reward-m2-text = reward.milestones[1].reward-text;
                        }
                        if reward.milestones.length >= 3 {
                            RewardsAdapter.edit-reward-m3-days = reward.milestones[2].target-days;
                            RewardsAdapter.edit-reward-m3-text = reward.milestones[2].reward-text;
                        }
                        AppState.show-edit-reward = true;
                    }
                    delete(id) => {
                        RewardsAdapter.delete-streak-reward(id);
                    }
                }
            }

            if RewardsAdapter.streak-rewards.length == 0: EmptyState {
                icon: @image-url("../../assets/icons/flame.svg");
                title: "No streak rewards yet";
                description: "Link a habit and set milestone rewards to stay motivated";
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== GOALS SECTION ====================
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                SectionHeader {
                    title: "GOALS";
                }

                ActionButton {
                    text: "+ GOAL";
                    primary: false;
                    clicked => {
                        AppState.show-add-goal = true;
                    }
                }
            }

            if RewardsAdapter.goals.length > 0: VerticalLayout {
                spacing: 12px;

                for goal in RewardsAdapter.goals: GoalCard {
                    goal: goal;
                    edit(id) => {
                        // Load goal data into edit properties
                        RewardsAdapter.edit-goal-id = id;
                        RewardsAdapter.edit-goal-name = goal.name;
                        RewardsAdapter.edit-goal-description = goal.description;
                        RewardsAdapter.edit-goal-reward = goal.reward-text;
                        RewardsAdapter.edit-goal-deadline = goal.deadline;
                        RewardsAdapter.edit-goal-checkpoint-count = goal.checkpoints.length;
                        // Load checkpoints
                        if goal.checkpoints.length >= 1 {
                            RewardsAdapter.edit-goal-cp1-id = goal.checkpoints[0].id;
                            RewardsAdapter.edit-goal-cp1-text = goal.checkpoints[0].description;
                        }
                        if goal.checkpoints.length >= 2 {
                            RewardsAdapter.edit-goal-cp2-id = goal.checkpoints[1].id;
                            RewardsAdapter.edit-goal-cp2-text = goal.checkpoints[1].description;
                        }
                        if goal.checkpoints.length >= 3 {
                            RewardsAdapter.edit-goal-cp3-id = goal.checkpoints[2].id;
                            RewardsAdapter.edit-goal-cp3-text = goal.checkpoints[2].description;
                        }
                        if goal.checkpoints.length >= 4 {
                            RewardsAdapter.edit-goal-cp4-id = goal.checkpoints[3].id;
                            RewardsAdapter.edit-goal-cp4-text = goal.checkpoints[3].description;
                        }
                        AppState.show-edit-goal = true;
                    }
                    delete(id) => {
                        RewardsAdapter.delete-goal(id);
                    }
                    archive(id) => {
                        RewardsAdapter.archive-goal(id);
                    }
                    toggle-checkpoint(goal-id, checkpoint-id) => {
                        let result = RewardsAdapter.toggle-checkpoint(goal-id, checkpoint-id);
                        if (result != "") {
                            NotificationAdapter.show(result, true);
                        }
                    }
                }
            }

            if RewardsAdapter.goals.length == 0: EmptyState {
                icon: @image-url("../../assets/icons/target.svg");
                title: "No goals set";
                description: "Create a goal with checkpoints to track your progress";
            }
        }
    }
}
