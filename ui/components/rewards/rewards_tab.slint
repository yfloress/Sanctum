// Rewards Tab Component
// Shows streak rewards and goals sections with add buttons

import { Theme } from "../../theme.slint";
import { RewardsAdapter, AppState } from "../../globals.slint";
import { StreakRewardCard } from "streak_reward_card.slint";
import { GoalCard } from "goal_card.slint";
import { SectionHeader } from "../sections/section_header.slint";
import { EmptyState } from "../sections/empty_state.slint";
import { ActionButton } from "../../widgets.slint";

export component RewardsTab inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 24px;

        // ==================== STREAK REWARDS SECTION ====================
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                SectionHeader {
                    title: "STREAK REWARDS";
                }

                ActionButton {
                    text: "+ REWARD";
                    primary: false;
                    clicked => {
                        AppState.show-add-reward = true;
                    }
                }
            }

            if RewardsAdapter.streak-rewards.length > 0: VerticalLayout {
                spacing: 12px;

                for reward in RewardsAdapter.streak-rewards: StreakRewardCard {
                    reward: reward;
                    edit(id) => {
                        RewardsAdapter.edit-reward-id = id;
                        AppState.show-edit-reward = true;
                    }
                    delete(id) => {
                        RewardsAdapter.delete-streak-reward(id);
                    }
                }
            }

            if RewardsAdapter.streak-rewards.length == 0: EmptyState {
                icon: @image-url("../../assets/icons/flame.svg");
                title: "No streak rewards yet";
                description: "Link a habit and set milestone rewards to stay motivated";
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== GOALS SECTION ====================
        VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                SectionHeader {
                    title: "GOALS";
                }

                ActionButton {
                    text: "+ GOAL";
                    primary: false;
                    clicked => {
                        AppState.show-add-goal = true;
                    }
                }
            }

            if RewardsAdapter.goals.length > 0: VerticalLayout {
                spacing: 12px;

                for goal in RewardsAdapter.goals: GoalCard {
                    goal: goal;
                    edit(id) => {
                        RewardsAdapter.edit-goal-id = id;
                        AppState.show-edit-goal = true;
                    }
                    delete(id) => {
                        RewardsAdapter.delete-goal(id);
                    }
                    toggle-checkpoint(goal-id, checkpoint-id) => {
                        RewardsAdapter.toggle-checkpoint(goal-id, checkpoint-id);
                    }
                }
            }

            if RewardsAdapter.goals.length == 0: EmptyState {
                icon: @image-url("../../assets/icons/target.svg");
                title: "No goals set";
                description: "Create a goal with checkpoints to track your progress";
            }
        }
    }
}

