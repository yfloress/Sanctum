// ==================== SanctumChart ====================
// Path-based line chart with gradient fill

import { Palette } from "../globals.slint";

export component SanctumChart inherits Rectangle {
    in property <string> commands: "M 0 50 L 100 50";

    background: Palette.background;

    // Fill (closed path)
    Path {
        commands: commands + " L 100 100 L 0 100 Z";
        fill: @linear-gradient(0deg, Palette.accent-muted, #00000000);
        stroke-width: 0px;
    }

    // Line
    Path {
        commands: commands;
        stroke: Palette.accent;
        stroke-width: 2px;
        fill: transparent;
    }
}
