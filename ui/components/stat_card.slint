// Stat card for displaying labeled values with accent indicator

import { Theme } from "../theme.slint";

export component StatCard inherits Rectangle {
    in property <string> value;
    in property <bool> positive: true;
    in property <bool> show-arrow: false;
    in property <string> label;
    in property <color> accent-color: positive ? Theme.success : Theme.danger;

    width: 160px;
    height: 72px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    HorizontalLayout {
        padding: 16px;
        spacing: 12px;

        // Indicator
        Rectangle {
            width: 3px;
            height: 40px;
            border-radius: 2px;
            background: accent-color;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: label;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1.5px;
            }

            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                if show-arrow: Text {
                    text: positive ? "▲" : "▼";
                    color: accent-color;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: value;
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}
