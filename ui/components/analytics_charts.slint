                        horizontal-alignment: center;
                    }
                }

                // Thursday
                VerticalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 1;

                    Rectangle {
                        height: 80px;
                        VerticalLayout {
                            alignment: end;
