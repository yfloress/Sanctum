// ==================== Analytics Charts ====================
// Custom charts for Habit Analytics

import { Palette } from "../globals.slint";

export component DayEfficiencyChart inherits Rectangle {
    in property <[float]> data; // Normalized 0.0 - 1.0
    in property <int> best-day-index: 4;
    property <[string]> day-labels: ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"];
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Day Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Container
        // Direct HorizontalLayout with simple spacer/bar/label stack per day
        HorizontalLayout {
            spacing: 10px;
            padding: 10px;

            for val[i] in root.data: VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                // 1. Spacer to push bar down
                Rectangle { vertical-stretch: 1; background: transparent; }

                // 2. The Bar
                Rectangle {
                    width: 20px;
                    height: 100px * (val < 0.0 ? 0.0 : val > 1.0 ? 1.0 : val);
                    background: i == root.best-day-index ? #3B82F6 : #333333;
                    border-radius: 4px;
                }

                // 3. The Label
                Text {
                    text: root.day-labels.length > i ? root.day-labels[i] : "";
                    horizontal-alignment: center;
                    color: #888888;
                    font-size: 9px;
                }
            }
        }
    }
}

export component MonthEfficiencyChart inherits Rectangle {
    in property <[float]> data; 
    in property <string> path-command;
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Month Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        plot := Rectangle {
            vertical-stretch: 1;
            clip: true;
            property <float> denom: root.data.length > 1 ? (root.data.length - 1) * 1.0 : 1.0;
            
            // Grid Lines
            VerticalLayout {
                alignment: space-between;
                for i in 3: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: 0.5;
                }
            }
            
            // Path Line (viewbox: 0..100)
            if root.path-command != "": Path {
                commands: root.path-command;
                stroke: #A855F7;
                stroke-width: 2px;
                stroke-line-cap: round;
                fill: transparent;
                viewbox-width: 100;
                viewbox-height: 100;
            }

            // Gradient Fill
            if root.path-command != "": Path {
                commands: root.path-command + " L 100 100 L 0 100 Z";
                fill: @linear-gradient(180deg, #A855F733 0%, transparent 100%);
                stroke-width: 0px;
                viewbox-width: 100;
                viewbox-height: 100;
            }

            // Dots overlay
            // EXACT SAME mapping as the Path (just scaled to pixels):
            // x = (index / (total_points - 1)) * plot.width
            // y = plot.height - (value * plot.height)
            for val[i] in root.data: Rectangle {
                property <float> pct: val < 0.0 ? 0.0 : val > 1.0 ? 1.0 : val;
                property <float> t: root.data.length > 1 ? (i * 1.0) / plot.denom : 0.0;

                x: (t * plot.width) - 2.5px;
                y: (plot.height - (pct * plot.height)) - 2.5px;
                
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: #A855F7;
                border-width: 1px;
                border-color: Palette.surface;
            }
        }
    }
}
