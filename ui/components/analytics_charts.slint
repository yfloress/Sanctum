// ==================== Habit Analytics Charts ====================
// Bar chart for weekday efficiency and line chart for monthly trend

import { Palette, WeekdayEfficiencyData, MonthlyTrendData } from "../globals.slint";

// ==================== Weekly Efficiency Bar Chart ====================
// Shows average habits completed per day of the week

export component WeeklyBarChart inherits Rectangle {
    in property <[WeekdayEfficiencyData]> data;
    in property <image> image;

    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Title
        Text {
            text: "WEEKLY EFFICIENCY";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.5px;
        }

        // Chart area - fixed height
        Rectangle {
            height: 200px;
            border-radius: 12px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
    }
}

// ==================== Monthly Trend Line Chart ====================
// Shows habit trend over the last months

export component MonthlyLineChart inherits Rectangle {
    in property <[MonthlyTrendData]> data;
    in property <string> path;
    in property <image> image;

    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Title
        Text {
            text: "MONTHLY TREND";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.5px;
        }

        // Chart area - fixed height
        Rectangle {
            height: 200px;
            border-radius: 12px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Subtle top glow
            Rectangle {
                width: 100%;
                height: 48px;
                background: @linear-gradient(180deg, #00000066 0%, transparent 100%);
            }

            // Top badges
            HorizontalLayout {
                x: parent.width - self.width - 12px;
                y: 10px;
                spacing: 8px;

                Rectangle {
                    height: 20px;
                    width: 54px;
                    border-radius: 10px;
                    background: @linear-gradient(90deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
                    Text {
                        text: "LIVE";
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 20px;
                    width: 64px;
                    border-radius: 10px;
                    background: Palette.surface-hover;
                    border-width: 1px;
                    border-color: Palette.border-light;
                    Text {
                        text: "TREND";
                        color: Palette.text-secondary;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Bottom month chips overlay (for quick glance)
            HorizontalLayout {
                y: parent.height - 28px;
                height: 22px;
                spacing: 8px;
                padding-left: 12px;
                padding-right: 12px;

                for point in data: Rectangle {
                    height: 22px;
                    border-radius: 11px;
                    background: Palette.surface-hover;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: point.month-name;
                            color: Palette.text-muted;
                            font-size: 10px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
