// ==================== Analytics Charts ====================
// Custom charts for Habit Analytics

import { Palette } from "../globals.slint";

export component DayEfficiencyChart inherits Rectangle {
    in property <[float]> data: [0.3, 0.5, 0.8, 0.4, 0.9, 0.2, 0.6]; // Normalized 0.0 - 1.0
    in property <int> best-day-index: 4; // Index to highlight (e.g. 4 = Friday)
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            text: "Day Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        Rectangle {
            vertical-stretch: 1;
            
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                // Bars
                for val[i] in root.data: VerticalLayout {
                    alignment: end;
                    spacing: 8px;

                    // Bar container
                    Rectangle {
                        width: 8px;
                        height: 100%; 
                        
                        // The actual bar (variable height)
                        Rectangle {
                            y: parent.height - self.height;
                            width: 100%;
                            height: val * parent.height; // Scale by value
                            border-radius: 4px;
                            
                            // Highlight best day
                            background: i == root.best-day-index ? #3b82f6 : #333333;
                            
                            // Animation
                            animate height { duration: 400ms; easing: ease-out; }
                        }
                    }

                    // Label
                    Text {
                        text: i == 0 ? "M" : i == 1 ? "T" : i == 2 ? "W" : i == 3 ? "T" : i == 4 ? "F" : i == 5 ? "S" : "S";
                        color: i == root.best-day-index ? Palette.text-primary : Palette.text-muted;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component MonthEfficiencyChart inherits Rectangle {
    in property <[float]> data: [0.2, 0.4, 0.3, 0.6, 0.5, 0.8, 0.7, 0.9, 0.6, 0.4]; // Normalized 0.0 - 1.0
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true; // Clip the chart content

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            text: "Month Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        Rectangle {
            vertical-stretch: 1;
            
            // Grid Lines (Dashed)
            VerticalLayout {
                alignment: space-between;
                for i in 3: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: 0.5;
                }
            }
            
            // The Line Path
            // We use a custom path based on the data points. 
            // Since we can't dynamically generate SVG path strings easily in pure Slint without backend,
            // we will simulate the "continuous look" by placing small connected line segments 
            // OR ideally, we assume the backend provides the path string.
            // BUT, the prompt said "Use the Path element to draw the line." and "Replicate... using Slint's vector primitives".
            
            // Strategy: The backend will provide a "path-command" string for the smooth line.
            // But for the "dots", we can iterate over the data in Slint.
            
            // Wait, I can't iterate to create a Path command in Slint markup easily.
            // I'll assume the backend provides the `path_command` string for the line, similar to the main chart.
            // AND I will overlay dots.
            
            Path {
                commands: root.path-command;
                stroke: Palette.primary; // Purple
                stroke-width: 2px;
                fill: transparent;
            }
            
            // Gradient Fill (Optional, for "Efficiency" look)
            Path {
                commands: root.path-command + " L 100 100 L 0 100 Z";
                fill: @linear-gradient(180deg, Palette.primary.with-alpha(0.2) 0%, transparent 100%);
                stroke-width: 0px;
            }

            // Dots (Markers)
            // We can't easily place dots exactly on the path without X/Y coordinates for each point.
            // If `data` is just floats, we can compute Y, but X depends on spacing.
            // Let's assume we can calculate X based on index.
            
            for val[i] in root.data: Rectangle {
                // Calculate position
                // x = i / (count - 1) * width
                // y = (1 - val) * height
                
                x: (i / (root.data.length - 1)) * parent.width - 2px; // Center the 4px dot
                y: (1.0 - val) * parent.height - 2px;
                
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Palette.primary;
                border-width: 1px;
                border-color: Palette.surface;
            }
        }
    }
    
    // Property to receive the pre-calculated path from backend (or we could try to approximate it)
    // For "Month Efficiency", a smooth curve is best generated by Rust.
    in property <string> path-command: "M 0 100 L 100 100";
}
