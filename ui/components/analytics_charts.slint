// ==================== Habit Analytics Charts ====================
// Radar chart + insight cards

import { Palette } from "../globals.slint";

export component HabitRadarChart inherits Rectangle {
    in property <image> image;
    in property <bool> has-data: false;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "LIFE BALANCE (LAST 30 DAYS)";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: Palette.chart-min-height-md;
            border-radius: 16px;
            background: @linear-gradient(180deg, #0a0a0a, #0f0f0f);
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: true;

            if root.has-data: Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.has-data: VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "The chart is empty, but your potential is full.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Your legend will appear here. Start writing it today.";
                    color: Palette.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component WeekdayEfficiencyChart inherits Rectangle {
    in property <image> image;
    in property <bool> has-data: false;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "WEEKDAY EFFICIENCY";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: Palette.chart-min-height-sm;
            border-radius: 16px;
            background: @linear-gradient(180deg, #0a0a0a, #0f0f0f);
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: true;

            if root.has-data: Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.has-data: VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "Complete habits to see your weekly pattern.";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Discover which days you're most consistent.";
                    color: Palette.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component InsightCard inherits Rectangle {
    in property <string> title;
    in property <string> line1;
    in property <string> line2;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        if root.line1 != "": Text {
            text: root.line1;
            color: Palette.text-primary;
            font-size: 13px;
            font-weight: 600;
            wrap: word-wrap;
        }

        if root.line2 != "": Text {
            text: root.line2;
            color: Palette.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
