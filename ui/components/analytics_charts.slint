                    border-radius: 11px;
                    background: @linear-gradient(90deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
                    Text {
                        text: "LIVE";
                        color: #ffffff;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 22px;
                    width: 68px;
                    border-radius: 11px;
                    background: #1a1a1acc;
                    border-width: 1px;
                    border-color: Palette.border;
                    Text {
                        text: "TREND";
                        color: Palette.text-secondary;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Bottom month chips overlay
            if data.length > 0: HorizontalLayout {
                y: parent.height - 32px;
                height: 24px;
                spacing: 6px;
