// ==================== Analytics Charts ====================
// Custom charts for Habit Analytics

import { Palette } from "../globals.slint";

export component DayEfficiencyChart inherits Rectangle {
    in property <[float]> data; // Normalized 0.0 - 1.0
    in property <int> best-day-index: 4;
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Day Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Container
        Rectangle {
            vertical-stretch: 1;
            
            HorizontalLayout {
                spacing: 4px;
                padding: 0px;

                // Iterate bars with even distribution
                for val[i] in root.data: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    spacing: 8px;

                    // Bar Area (takes available height minus text)
                    Rectangle {
                        vertical-stretch: 1; 
                        
                        // The Bar itself
                        Rectangle {
                            width: 20px;
                            height: val * parent.height;
                            y: parent.height - self.height;
                            x: (parent.width - self.width) / 2; // Center in column
                            
                            border-radius: 4px;
                            background: i == root.best-day-index ? #3b82f6 : #333333;
                            
                            animate height { duration: 400ms; easing: ease-out; }
                        }
                    }

                    // Label
                    Text {
                        text: i == 0 ? "MON" : i == 1 ? "TUE" : i == 2 ? "WED" : i == 3 ? "THU" : i == 4 ? "FRI" : i == 5 ? "SAT" : "SUN";
                        color: i == root.best-day-index ? Palette.text-primary : Palette.text-muted;
                        font-size: 9px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component MonthEfficiencyChart inherits Rectangle {
    in property <[float]> data; 
    in property <string> path-command;
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Month Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        Rectangle {
            vertical-stretch: 1;
            
            // Grid Lines
            VerticalLayout {
                alignment: space-between;
                for i in 3: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: 0.5;
                }
            }
            
            // Path Line
            // viewbox maps logical 0..100 coordinates to actual width/height
            Path {
                width: 100%;
                height: 100%;
                commands: root.path-command;
                stroke: #A855F7;
                stroke-width: 2px;
                fill: transparent;
                viewbox-width: 100;
                viewbox-height: 100;
            }
            
            // Gradient Fill
            Path {
                width: 100%;
                height: 100%;
                commands: root.path-command + " L 100 100 L 0 100 Z";
                fill: @linear-gradient(180deg, #A855F733 0%, transparent 100%);
                stroke-width: 0px;
                viewbox-width: 100;
                viewbox-height: 100;
            }

            // Dots overlay
            // Position matches viewbox logic: 
            // x (0..100) -> 0..parent.width
            // y (0..100) -> 0..parent.height
            for val[i] in root.data: Rectangle {
                x: (i / (root.data.length - 1)) * parent.width - 2.5px; 
                y: (1.0 - val) * parent.height - 2.5px;
                
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: #A855F7;
                border-width: 1px;
                border-color: Palette.surface;
            }
        }
    }
}