// ==================== Habit Analytics Charts ====================
// Bar chart for weekday efficiency and line chart for monthly trend

import { Palette, WeekdayEfficiencyData, MonthlyTrendData } from "../globals.slint";

// ==================== Weekly Efficiency Bar Chart ====================
// Shows average habits completed per day of the week

export component WeeklyBarChart inherits Rectangle {
    in property <[WeekdayEfficiencyData]> data;
    in property <image> image;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Title
        Text {
            text: "WEEKLY EFFICIENCY";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        // Chart area
        Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            border-radius: 8px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: true;

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }

        // Range note
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: "Data window: last 365 days";
                color: Palette.text-muted;
                font-size: 9px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}

// ==================== Monthly Trend Line Chart ====================
// Shows habit trend over the last months

export component MonthlyLineChart inherits Rectangle {
    in property <[MonthlyTrendData]> data;
    in property <string> path;
    in property <image> image;

    private property <int> active-point-index: -1;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Title
        Text {
            text: "MONTHLY TREND (LAST 12 MONTHS)";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        // Chart area
        chart-area := Rectangle {
            vertical-stretch: 1;
            min-height: 240px;
            border-radius: 8px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: false; // Allow tooltip to overflow if needed

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Interactive Tooltip Overlay
            ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: crosshair;

                moved => {
                    if (root.data.length > 1) {
                        // Calculate closest index based on mouse X
                        // Points are evenly distributed from 0 to width
                        // index = (x / width) * (N - 1)
                        let raw-idx = (self.mouse-x / self.width) * (root.data.length - 1);
                        root.active-point-index = max(0, min(root.data.length - 1, round(raw-idx)));
                    }
                }
            }

            // Tooltip Line
            if ta.has-hover && root.active-point-index >= 0: Rectangle {
                x: parent.width * (root.data[root.active-point-index].x-percent / 100) - 1px;
                width: 2px;
                height: parent.height;
                background: Palette.border-light;
                opacity: 0.5;
            }

            // Tooltip Bubble
            if ta.has-hover && root.active-point-index >= 0: Rectangle {
                // Position tooltip above the point if possible, or follow mouse X
                x: min(parent.width - self.width, max(0px, (parent.width * (root.data[root.active-point-index].x-percent / 100)) - self.width / 2));
                y: -35px; // Float above the chart area
                width: 100px;
                height: 45px;
                background: Palette.surface-hover;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                z: 100;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    
                    Text {
                        text: root.data[root.active-point-index].month-name;
                        color: Palette.text-secondary;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    
                    Text {
                        text: "Avg: " + root.data[root.active-point-index].avg-per-day; // Formatted number would be better but simple float is ok
                        color: Palette.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Range note
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: "Data window: last 365 days";
                color: Palette.text-muted;
                font-size: 9px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}
