// ==================== Analytics Charts ====================
// Custom charts for Habit Analytics

import { Palette } from "../globals.slint";

export component DayEfficiencyChart inherits Rectangle {
    in property <[float]> data: [0.3, 0.5, 0.8, 0.4, 0.9, 0.2, 0.6]; // Normalized 0.0 - 1.0
    in property <int> best-day-index: 4; // Index to highlight (e.g. 4 = Friday)
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            text: "Day Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        Rectangle {
            vertical-stretch: 1;
            
            HorizontalLayout {
                spacing: 2px; 
                
                // Bars
                for val[i] in root.data: VerticalLayout {
                    horizontal-stretch: 1; // Distribute evenly
                    alignment: end;
                    spacing: 8px;

                    // Bar container
                    Rectangle {
                        width: 100%;
                        height: 100%; 
                        
                        // The actual bar (variable height)
                        Rectangle {
                            y: parent.height - self.height;
                            width: 20px; // Chunky bars
                            height: val * parent.height; // Scale by value
                            border-radius: 4px;
                            x: (parent.width - self.width) / 2; // Center in the distributed slot
                            
                            // Highlight best day
                            background: i == root.best-day-index ? #3b82f6 : #333333;
                            
                            // Animation
                            animate height { duration: 400ms; easing: ease-out; }
                        }
                    }

                    // Label
                    Text {
                        text: i == 0 ? "MON" : i == 1 ? "TUE" : i == 2 ? "WED" : i == 3 ? "THU" : i == 4 ? "FRI" : i == 5 ? "SAT" : "SUN";
                        color: i == root.best-day-index ? Palette.text-primary : Palette.text-muted;
                        font-size: 9px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component MonthEfficiencyChart inherits Rectangle {
    in property <[float]> data: [0.2, 0.4, 0.3, 0.6, 0.5, 0.8, 0.7, 0.9, 0.6, 0.4]; // Normalized 0.0 - 1.0
    
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true; // Clip the chart content

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            text: "Month Efficiency";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        // Chart Area
        Rectangle {
            vertical-stretch: 1;
            
            // Grid Lines (Dashed)
            VerticalLayout {
                alignment: space-between;
                for i in 3: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: 0.5;
                }
            }
            
            Path {
                commands: root.path-command;
                stroke: #A855F7; // Fixed Purple as requested
                stroke-width: 2px;
                fill: transparent;
                viewbox-width: 100;
                viewbox-height: 100;
            }
            
            // Gradient Fill
            Path {
                commands: root.path-command + " L 100 100 L 0 100 Z";
                fill: @linear-gradient(180deg, #A855F733 0%, transparent 100%);
                stroke-width: 0px;
                viewbox-width: 100;
                viewbox-height: 100;
            }

            // Dots (Markers)
            for val[i] in root.data: Rectangle {
                // Calculate position matching the path generation logic (0..100 based)
                x: (i / (root.data.length - 1)) * parent.width - 2.5px; 
                y: (1.0 - val) * parent.height - 2.5px;
                
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: #A855F7; // Match line color
                border-width: 1px;
                border-color: Palette.surface;
            }
        }
    }
    
    in property <string> path-command: "M 0 100 L 100 100";
}
