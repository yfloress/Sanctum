                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                    Text {
                        text: "THU";
                        color: root.best-day-index == 3 ? #3B82F6 : #888888;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.data[3] * 100.0) + "%";
                        color: Palette.text-muted;
                        font-size: 8px;
                        horizontal-alignment: center;
                    }
                }

                // Friday
                VerticalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 1;

                    Rectangle {
                        height: 80px;
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 100%;
                                max-width: 32px;
                                height: 80px * Math.max(0.0, Math.min(1.0, root.data[4]));
                                background: root.best-day-index == 4 ? #3B82F6 : #555555;
                                border-radius: 4px;
                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                    Text {
                        text: "FRI";
                        color: root.best-day-index == 4 ? #3B82F6 : #888888;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.data[4] * 100.0) + "%";
                        color: Palette.text-muted;
                        font-size: 8px;
                        horizontal-alignment: center;
                    }
                }

                // Saturday
                VerticalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 1;

                    Rectangle {
                        height: 80px;
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 100%;
                                max-width: 32px;
                                height: 80px * Math.max(0.0, Math.min(1.0, root.data[5]));
                                background: root.best-day-index == 5 ? #3B82F6 : #555555;
                                border-radius: 4px;
                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                    Text {
                        text: "SAT";
                        color: root.best-day-index == 5 ? #3B82F6 : #888888;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.data[5] * 100.0) + "%";
                        color: Palette.text-muted;
                        font-size: 8px;
                        horizontal-alignment: center;
                    }
                }

                // Sunday
                VerticalLayout {
                    spacing: 4px;
                    alignment: end;
                    horizontal-stretch: 1;

                    Rectangle {
                        height: 80px;
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 100%;
                                max-width: 32px;
                                height: 80px * Math.max(0.0, Math.min(1.0, root.data[6]));
                                background: root.best-day-index == 6 ? #3B82F6 : #555555;
                                border-radius: 4px;
                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                    Text {
                        text: "SUN";
                        color: root.best-day-index == 6 ? #3B82F6 : #888888;
                        font-size: 9px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.data[6] * 100.0) + "%";
                        color: Palette.text-muted;
                        font-size: 8px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// Line chart for monthly efficiency
export component MonthEfficiencyChart inherits Rectangle {
    in property <[float]> data;
    in property <string> path-command;
    in property <float> min-val: 0.0;
    in property <float> max-val: 0.0;
    in property <float> avg-val: 0.0;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header
        Text {
            text: "Monthly Efficiency";
            color: Palette.text-primary;
            font-size: 13px;
            font-weight: 600;
        }

        // Chart area
        chart-container := Rectangle {
            vertical-stretch: 1;
            clip: true;
            min-height: 100px;

            // Grid lines
            VerticalLayout {
                alignment: space-between;
                for i in 5: Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                    opacity: 0.3;
                }
            }

            // Chart content
            if root.data.length > 0 && root.path-command != "": Rectangle {
                width: 100%;
                height: 100%;

                // Fill gradient
                Path {
                    commands: root.path-command + " L 100 100 L 0 100 Z";
                    fill: @linear-gradient(180deg, #A855F744 0%, #A855F711 50%, transparent 100%);
                    stroke-width: 0px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 100;
                    viewbox-height: 100;
                }

                // Line
                Path {
                    commands: root.path-command;
                    stroke: #A855F7;
                    stroke-width: 2px;
                    fill: transparent;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 100;
                    viewbox-height: 100;
                }

                // Data points
                for val[i] in root.data: Rectangle {
                    property <float> norm-val: Math.max(0.0, Math.min(1.0, val));
                    property <float> x-pos: root.data.length > 1 ? (i * 1.0) / (root.data.length - 1.0) : 0.5;

                    x: (x-pos * chart-container.width) - 3px;
                    y: ((1.0 - norm-val) * chart-container.height) - 3px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: #A855F7;
                    opacity: norm-val > 0.0 ? 1.0 : 0.3;
                }
            }

            // Empty state
            if root.data.length == 0: Text {
                text: "No data for this month";
                color: Palette.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Stats footer
        if root.data.length > 0: HorizontalLayout {
            spacing: 16px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "MIN";
                    color: Palette.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                }
                Text {
                    text: Math.round(root.min-val * 100.0) + "%";
                    color: Palette.text-secondary;
                    font-size: 9px;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "AVG";
                    color: Palette.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                }
                Text {
                    text: Math.round(root.avg-val * 100.0) + "%";
                    color: #A855F7;
                    font-size: 9px;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: "MAX";
                    color: Palette.text-muted;
                    font-size: 9px;
                    font-weight: 600;
                }
                Text {
                    text: Math.round(root.max-val * 100.0) + "%";
                    color: #4ADE80;
                    font-size: 9px;
                    font-weight: 600;
                }
            }
        }
    }
}
