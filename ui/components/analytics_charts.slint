// ==================== Habit Analytics Charts ====================
// Bar chart for weekday efficiency and line chart for monthly trend

import { Palette, WeekdayEfficiencyData, MonthlyTrendData } from "../globals.slint";

// ==================== Weekly Efficiency Bar Chart ====================
// Shows average habits completed per day of the week

export component WeeklyBarChart inherits Rectangle {
    in property <[WeekdayEfficiencyData]> data;
    in property <image> image;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Title
        Text {
            text: "WEEKLY EFFICIENCY";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        // Chart area
        Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            border-radius: 8px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: true;

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Subtle top overlay
            Rectangle {
                width: 100%;
                height: 60px;
                background: @linear-gradient(180deg, #00000088 0%, transparent 100%);
            }

            // Top badges
            HorizontalLayout {
                x: parent.width - self.width - 16px;
                y: 12px;
                spacing: 6px;

                Rectangle {
                    height: 22px;
                    width: 56px;
                    border-radius: 11px;
                    background: @linear-gradient(90deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
                    Text {
                        text: "LIVE";
                        color: #ffffff;
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 22px;
                    width: 76px;
                    border-radius: 11px;
                    background: #1a1a1acc;
                    border-width: 1px;
                    border-color: Palette.border;
                    Text {
                        text: "WEEKLY";
                        color: Palette.text-secondary;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Bottom day chips overlay
            if data.length > 0: HorizontalLayout {
                y: parent.height - 32px;
                height: 24px;
                spacing: 6px;
                padding-left: 16px;
                padding-right: 16px;

                for point in data: Rectangle {
                    height: 24px;
                    border-radius: 12px;
                    background: #1a1a1acc;
                    border-width: 1px;
                    border-color: Palette.border-subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: point.day-short;
                            color: Palette.text-secondary;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Range note
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: "Data window: last 180 days";
                color: Palette.text-muted;
                font-size: 9px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}

// ==================== Monthly Trend Line Chart ====================
// Shows habit trend over the last months

export component MonthlyLineChart inherits Rectangle {
    in property <[MonthlyTrendData]> data;
    in property <string> path;
    in property <image> image;

    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Title
        Text {
            text: "MONTHLY TREND";
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        // Chart area
        Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            border-radius: 8px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: Palette.border-subtle;
            clip: true;

            Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Subtle top overlay
            Rectangle {
                width: 100%;
                height: 60px;
