                    border-color: Palette.border-subtle;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: point.month-name;
                            color: Palette.text-secondary;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Range note
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Rectangle {
                width: 2px;
                height: 12px;
                border-radius: 1px;
                background: Palette.border-subtle;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: "Data window: last 180 days";
                color: Palette.text-muted;
                font-size: 9px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}
