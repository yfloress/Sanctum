// ==================== Charts ====================
// Noir Minimalist line chart

import { Palette } from "../globals.slint";

export component SanctumLineChart inherits Rectangle {
    in property <string> path: "M 0 50 L 100 50";
    in property <string> min-label: "";
    in property <string> max-label: "";

    background: transparent;
    clip: true;

    // Labels
    if max-label != "": Text {
        x: 16px; y: 16px;
        text: max-label;
        color: Palette.text-muted;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 1px;
    }

    if min-label != "": Text {
        x: 16px; y: parent.height - 24px;
        text: min-label;
        color: Palette.text-muted;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 1px;
    }

    // Chart content
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        // Gradient Fill
        Path {
            commands: path + " L 100 100 L 0 100 Z";
            fill: @linear-gradient(180deg, Palette.accent-muted, #00000000);
            stroke-width: 0px;
            opacity: 0.5; // Slight transparency for the fill
        }

        // Line Stroke
        Path {
            commands: path;
            stroke: Palette.accent;
            stroke-width: 3px; // Thicker line
            fill: transparent;
        }
        
        // Glow effect (duplicate line with blur)
        Path {
            commands: path;
            stroke: Palette.accent;
            stroke-width: 6px;
            fill: transparent;
            opacity: 0.15;
        }
    }
}
