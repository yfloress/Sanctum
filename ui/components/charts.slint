// ==================== Charts ====================
// Noir Fintech - Premium chart visualizations

import { Theme } from "../theme.slint";

// Chart card for displaying rendered chart images with labels
export component ChartCard inherits Rectangle {
    in property <string> min-label;
    in property <string> max-label;
    in property <image> chart-image;

    height: 320px;
    background: @linear-gradient(180deg, Theme.chart-bg-start, Theme.chart-bg-end);
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Chart image
    Image {
        width: 100%;
        height: 100%;
        source: root.chart-image;
        image-fit: contain;
    }

    // Y-Axis Labels overlay
    VerticalLayout {
        x: 20px;
        y: 0;
        width: 80px;
        height: parent.height;
        padding-top: 36px;
        padding-bottom: 36px;
        alignment: space-between;

        if max-label != "": Rectangle {
            height: 24px;
            background: Theme.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;

            Text {
                text: max-label;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        if min-label != "": Rectangle {
            height: 24px;
            background: Theme.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;

            Text {
                text: min-label;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    // Top accent line
    Rectangle {
        y: 0;
        width: 100%;
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.border-light.with-alpha(0.2) 50%, transparent 100%);
    }
}

export component SanctumLineChart inherits Rectangle {
    in property <string> path: "M 0 50 L 100 50";
    in property <string> min-label: "";
    in property <string> max-label: "";

    background: transparent;
    clip: true;

    // Horizontal grid lines
    VerticalLayout {
        padding: 40px;
        alignment: space-between;
        
        for i in 5: Rectangle {
            height: 1px;
            background: Theme.border-subtle;
            opacity: i == 2 ? 0.4 : 0.15;
        }
    }

    // Y-Axis Labels
    VerticalLayout {
        x: 20px;
        y: 0;
        width: 80px;
        height: parent.height;
        padding-top: 36px;
        padding-bottom: 36px;
        alignment: space-between;
        
        if max-label != "": Rectangle {
            height: 24px;
            background: Theme.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;
            
            Text {
                text: max-label;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        
        Rectangle { vertical-stretch: 1; }
        
        if min-label != "": Rectangle {
            height: 24px;
            background: Theme.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;
            
            Text {
                text: min-label;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    // Chart area
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        // Gradient Fill (area under curve)
        Path {
            commands: path + " L 100 100 L 0 100 Z";
            fill: @linear-gradient(180deg, Theme.chart-stroke.with-alpha(0.09) 0%, Theme.chart-stroke.with-alpha(0.02) 40%, transparent 100%);
            stroke-width: 0px;
        }

        // Glow effect (outer)
        Path {
            commands: path;
            stroke: Theme.chart-stroke;
            stroke-width: 12px;
            fill: transparent;
            opacity: 0.05;
        }

        // Glow effect (middle)
        Path {
            commands: path;
            stroke: Theme.chart-stroke;
            stroke-width: 6px;
            fill: transparent;
            opacity: 0.1;
        }

        // Main line stroke
        Path {
            commands: path;
            stroke: @linear-gradient(90deg, Theme.chart-stroke 0%, Theme.chart-stroke-mid 50%, Theme.chart-stroke 100%);
            stroke-width: 2.5px;
            fill: transparent;
        }
    }
    
    // Decorative corner accents
    Rectangle {
        x: 16px;
        y: 16px;
        width: 24px;
        height: 1px;
        background: Theme.border-light.with-alpha(0.3);
    }
    Rectangle {
        x: 16px;
        y: 16px;
        width: 1px;
        height: 24px;
        background: Theme.border-light.with-alpha(0.3);
    }
    Rectangle {
        x: parent.width - 40px;
        y: parent.height - 17px;
        width: 24px;
        height: 1px;
        background: Theme.border-light.with-alpha(0.3);
    }
    Rectangle {
        x: parent.width - 17px;
        y: parent.height - 40px;
        width: 1px;
        height: 24px;
        background: Theme.border-light.with-alpha(0.3);
    }
}
