// ==================== Charts ====================
// Noir Minimalist line and donut charts

import { Palette, PieSegment } from "../globals.slint";

export component SanctumLineChart inherits Rectangle {
    in property <string> path: "M 0 50 L 100 50";
    in property <string> min-label: "";
    in property <string> max-label: "";

    background: Palette.surface;
    clip: true;

    // Grid
    VerticalLayout {
        padding: 20px;
        alignment: space-between;
        Rectangle { height: 1px; background: Palette.border-subtle; opacity: 0.3; }
        Rectangle { height: 1px; background: Palette.border-subtle; opacity: 0.2; }
        Rectangle { height: 1px; background: Palette.border-subtle; opacity: 0.3; }
    }

    if max-label != "": Text {
        x: 12px; y: 10px;
        text: max-label;
        color: Palette.text-secondary;
        font-size: 10px;
    }

    if min-label != "": Text {
        x: 12px; y: parent.height - 18px;
        text: min-label;
        color: Palette.text-secondary;
        font-size: 10px;
    }

    // Chart content
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        Path {
            commands: path + " L 100 100 L 0 100 Z";
            fill: @linear-gradient(180deg, Palette.accent-muted, #00000000);
            stroke-width: 0px;
        }

        Path {
            commands: path;
            stroke: Palette.accent;
            stroke-width: 2px;
            fill: transparent;
        }
    }
}

export component SanctumDonutChart inherits Rectangle {
    in property <[PieSegment]> segments: [];

    background: Palette.surface;
    clip: true;

    Rectangle {
        width: 100%;
        height: 100%;
        for segment in segments: Path {
            commands: segment.path;
            fill: segment.color;
            stroke: segment.color;
            stroke-width: 0px;
        }
    }

    if segments.length == 0: Text {
        text: "No expenses";
        color: Palette.text-muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
