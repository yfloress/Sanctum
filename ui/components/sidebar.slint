// ==================== Sanctum Sidebar ====================
// Premium Fintech UI - Navigation sidebar with collapse support

import { AppState, AuthAdapter, SettingsAdapter } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";

// ==================== SidebarItem ====================

component SidebarItem inherits Rectangle {
    in property <string> label: Translations.label-none;
    in property <image> icon-source;
    in property <string> page-id: "";
    in property <bool> is-active: AppState.active-page == page-id;
    in property <bool> collapsed: false;

    callback clicked();

    height: 48px;
    background: is-active ? Theme.surface : (touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: 0px;

    animate background {
        duration: 150ms;
        easing: ease-out;
    }
    animate border-radius { duration: 200ms; easing: ease-out; }

    // Active indicator (left border)
    Rectangle {
        x: 0;
        width: 3px;
        height: 100%;
        background: is-active ? @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%) : transparent;

        animate background { duration: 150ms; }
    }

    // Active glow for collapsed mode
    // Removed to keep selection background identical in compact mode.

    HorizontalLayout {
        spacing: 0px;

        // Icon Area (always visible, centered in collapsed mode)
        Rectangle {
            width: collapsed ? parent.width : 54px;
            animate width { duration: 250ms; easing: ease-in-out; }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: is-active ? Theme.surface-hover : transparent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Image {
                    source: root.icon-source;
                    width: 18px;
                    height: 18px;
                    colorize: is-active ? Theme.text-primary : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate colorize { duration: 150ms; }
                }
            }
        }

        // Label Area (fade out when collapsed)
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            opacity: collapsed ? 0.0 : 1.0;

            animate opacity { duration: 200ms; easing: ease-out; }

            Text {
                text: root.label;
                color: is-active ? Theme.text-primary : Theme.text-muted;
                font-size: 11px;
                font-weight: is-active ? 600 : 400;
                letter-spacing: 2px;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            AppState.active-page = root.page-id;
            root.clicked();
        }
    }
}

// ==================== SanctumSidebar ====================

export component SanctumSidebar inherits Rectangle {
    in-out property <bool> collapsed: false;

    width: collapsed ? 72px : 220px;
    background: Theme.sidebar-bg;

    animate width {
        duration: 250ms;
        easing: ease-in-out;
    }

    // Right border with gradient
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: @linear-gradient(180deg, Theme.border-light 0%, Theme.sidebar-border 50%, Theme.border-light 100%);
    }

    VerticalLayout {
        spacing: 0px;

        // Logo/Brand Area
        Rectangle {
            height: 80px;
            clip: true;

            HorizontalLayout {
                padding-left: 0px;
                alignment: center;

                // Logo container
                if collapsed: Rectangle {
                    width: 48px;
                    height: 48px;
                    background: transparent;
                    y: (parent.height - self.height) / 2; // Center vertically

                    Image {
                        source: @image-url("../assets/logo/sanctum_logo.svg");
                        width: 32px;
                        height: 32px;
                        colorize: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !collapsed: HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        width: 48px;
                        height: 48px;
                        background: transparent;
                        y: (parent.height - self.height) / 2; // Center vertically

                        Image {
                            source: @image-url("../assets/logo/sanctum_logo.svg");
                            width: 32px;
                            height: 32px;
                            colorize: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border 50%, transparent 100%);
            opacity: 0.5;
        }

        Rectangle {
            height: 16px;
        }

        // Navigation Items
        VerticalLayout {
            padding-left: 0px;
            padding-right: 0px;
            spacing: 0px;

            SidebarItem {
                label: Translations.nav-dashboard;
                icon-source: @image-url("../assets/icons/layout-dashboard.svg");
                page-id: "dashboard";
                collapsed: root.collapsed;
            }

            SidebarItem {
                label: Translations.nav-finances;
                icon-source: @image-url("../assets/icons/wallet.svg");
                page-id: "finances";
                collapsed: root.collapsed;
            }

            SidebarItem {
                label: Translations.nav-crypto;
                icon-source: @image-url("../assets/icons/bitcoin.svg");
                page-id: "crypto";
                collapsed: root.collapsed;
            }

            SidebarItem {
                label: Translations.nav-habits;
                icon-source: @image-url("../assets/icons/check.svg");
                page-id: "habits";
                collapsed: root.collapsed;
            }

            SidebarItem {
                label: Translations.nav-settings;
                icon-source: @image-url("../assets/icons/settings.svg");
                page-id: "settings";
                collapsed: root.collapsed;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        // Divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border 50%, transparent 100%);
            opacity: 0.3;
        }

        // Lock Button
        Rectangle {
            height: 56px;
            background: lock-touch.has-hover ? Theme.surface-hover : transparent;

            animate background { duration: 150ms; }

            HorizontalLayout {
                padding-left: 0px;
                alignment: center;

                // Icon only visible when collapsed
                if collapsed: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: lock-touch.has-hover ? Theme.notify-error-bg : transparent;
                    y: (parent.height - self.height) / 2 + 2px; // Centered + slight nudge down

                    Image {
                        source: @image-url("../assets/icons/lock.svg");
                        width: 14px;
                        height: 14px;
                        colorize: lock-touch.has-hover ? Theme.danger : Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !collapsed: Text {
                    text: Translations.nav-lock;
                    color: lock-touch.has-hover ? Theme.danger : Theme.text-muted;
                    font-size: 11px;
                    font-weight: 500;
                    letter-spacing: 2px;
                    vertical-alignment: center;

                    animate color { duration: 150ms; }
                }
            }

            lock-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    AuthAdapter.lock-vault();
                    AppState.is-logged-in = false;
                }
            }
        }

        // Collapse Toggle
        Rectangle {
            height: 48px;
            background: toggle-touch.has-hover ? Theme.surface-hover : transparent;

            animate background { duration: 150ms; }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: toggle-touch.has-hover ? Theme.surface : transparent;
                border-width: toggle-touch.has-hover ? 1px : 0px;
                border-color: Theme.border;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.collapsed ? "»" : "«";
                    color: Theme.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            toggle-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.collapsed = !root.collapsed;
                    SettingsAdapter.set-sidebar-collapsed(root.collapsed);
                }
            }
        }
    }
}
