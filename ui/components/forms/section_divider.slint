// SectionDivider - Visual section separator with icon and label
// Used in form modals to group related fields into logical sections.

import { Theme } from "../../theme.slint";

export component SectionDivider inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> show-icon: true;

    height: 28px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        if root.show-icon: Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            Image {
                source: root.icon;
                width: 12px;
                height: 12px;
                colorize: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.6px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            y: (parent.height - self.height) / 2;
            background: Theme.border-subtle;
            opacity: 0.6;
        }
    }
}
