// ==================== Habit Dropdown Component ====================
// Dropdown selector for choosing a habit using PopupWindow

import { Theme } from "../../theme.slint";
import { Translations } from "../../translations.slint";
import { HabitData } from "../../globals.slint";

export component HabitDropdown inherits Rectangle {
    in property <[HabitData]> habits;
    in-out property <int> selected-index: -1;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: Translations.form-habit;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;

                if selected-index >= 0 && selected-index < habits.length: Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 3px;
                    background: habits[selected-index].color;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    horizontal-stretch: 1;
                    text: selected-index >= 0 && selected-index < habits.length ? habits[selected-index].name : Translations.habits-select-placeholder;
                    color: selected-index >= 0 ? Theme.text-primary : Theme.text-subtle;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Image {
                    source: @image-url("../../assets/icons/chevron-down.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-muted;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(habits.length * 40px + 8px, 160px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: habits.length * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for habit[idx] in habits: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 3px;
                                background: habit.color;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: habit.name;
                                color: idx == selected-index ? Theme.text-primary : Theme.text-secondary;
                                font-size: 13px;
                                font-weight: idx == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if idx == selected-index: Image {
                                source: @image-url("../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = idx;
                            }
                        }
                    }
                }
            }
        }
    }
}
