// ==================== Shared Form Components ====================
// Reusable form fields for modals

import { Theme } from "../../theme.slint";

// ==================== FormField ====================
export component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }
    }
}

// ==================== NumberField ====================
export component NumberField inherits Rectangle {
    in property <string> label: "";
    in-out property <int> value: 0;
    in property <int> min-value: 1;
    in property <int> max-value: 999;
    in property <int> step: 1;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                // Decrease button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: dec-touch.has-hover ? Theme.surface-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "−";
                        color: root.value <= root.min-value ? Theme.text-subtle : Theme.text-secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    dec-touch := TouchArea {
                        mouse-cursor: root.value > root.min-value ? pointer : default;
                        clicked => {
                            if (root.value > root.min-value) {
                                root.value -= root.step;
                            }
                        }
                    }
                }

                // Value display
                Text {
                    horizontal-stretch: 1;
                    text: root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // Increase button
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: inc-touch.has-hover ? Theme.surface-hover : transparent;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "+";
                        color: root.value >= root.max-value ? Theme.text-subtle : Theme.text-secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    inc-touch := TouchArea {
                        mouse-cursor: root.value < root.max-value ? pointer : default;
                        clicked => {
                            if (root.value < root.max-value) {
                                root.value += root.step;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== DateField ====================
export component DateField inherits Rectangle {
    in property <string> label: "";
    in-out property <string> value: "";  // YYYY-MM-DD format

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;

                if root.value == "" && !input.has-focus: Text {
                    horizontal-stretch: 1;
                    text: "YYYY-MM-DD";
                    color: Theme.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    horizontal-stretch: 1;
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }

                Image {
                    source: @image-url("../../assets/icons/calendar.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }
    }
}
