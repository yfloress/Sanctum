// CollapsibleSection - Expandable/collapsible section with animated toggle
// Used in form modals to hide advanced or optional fields behind a clickable header.

import { Theme } from "../../theme.slint";

export component CollapsibleSection inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> show-icon: true;
    in-out property <bool> expanded: false;

    // The total height is the header (32px) plus content when expanded.
    // The parent must use `if root.expanded` guards on child content
    // placed after this component in the layout.
    height: 32px;
    background: transparent;

    Rectangle {
        width: parent.width;
        height: 32px;
        background: header-touch.has-hover ? Theme.surface-hover.with-alpha(0.4) : transparent;
        border-radius: 8px;

        animate background { duration: 150ms; }

        header-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.expanded = !root.expanded;
            }
        }

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 4px;
            spacing: 8px;
            alignment: start;

            // Chevron indicator
            Rectangle {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../../assets/icons/chevron-right.svg");
                    width: 10px;
                    height: 10px;
                    colorize: root.expanded ? Theme.accent : Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    transform-rotation: root.expanded ? 90deg : 0deg;

                    animate transform-rotation { duration: 200ms; easing: ease-in-out; }
                    animate colorize { duration: 150ms; }
                }
            }

            if root.show-icon: Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: root.icon;
                    width: 12px;
                    height: 12px;
                    colorize: root.expanded ? Theme.accent : Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    animate colorize { duration: 150ms; }
                }
            }

            Text {
                text: root.label;
                color: root.expanded ? Theme.accent : Theme.text-muted;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.6px;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 1px;
                y: (parent.height - self.height) / 2;
                background: root.expanded ? Theme.accent.with-alpha(0.2) : Theme.border-subtle;
                opacity: 0.6;

                animate background { duration: 150ms; }
            }
        }
    }
}
