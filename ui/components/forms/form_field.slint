// FormField - Reusable text input with label

import { Palette } from "../../globals.slint";

export component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;
    in property <bool> show-refresh: false;
    in property <bool> show-all-button: false;
    callback edited(string);
    callback refresh();
    callback submit-shortcut();
    callback all-clicked();

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.label;
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1.5px;
                horizontal-stretch: 1;
            }

            if root.show-refresh: Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);

                Text {
                    text: "↻";
                    color: Palette.text-primary;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh(); }
                }
            }

            if root.show-all-button: Rectangle {
                height: 20px;
                border-radius: 6px;
                background: all-touch.has-hover
                    ? Palette.accent.with-alpha(0.2)
                    : Palette.surface-hover;
                border-width: 1px;
                border-color: Palette.accent;

                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: "ALL";
                        color: Palette.accent;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                all-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.all-clicked(); }
                }
            }
        }

        Rectangle {
            height: large ? 56px : 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                    edited => { root.edited(root.value); }

                    key-pressed(event) => {
                        if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                            root.submit-shortcut();
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}
