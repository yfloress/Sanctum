// FormField - Reusable text input with label

import { Theme } from "../../theme.slint";

export component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> enabled: true;
    in property <bool> large: false;
    in property <bool> show-refresh: false;
    in property <bool> show-all-button: false;
    callback edited(string);
    callback refresh();
    callback submit-shortcut();
    callback all-clicked();

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1.5px;
                horizontal-stretch: 1;
            }

            if root.show-refresh: Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);

                Text {
                    text: "↻";
                    color: Theme.text-primary;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh(); }
                }
            }

            if root.show-all-button: Rectangle {
                height: 20px;
                border-radius: 6px;
                background: all-touch.has-hover
                    ? Theme.accent.with-alpha(0.2)
                    : Theme.surface-hover;
                border-width: 1px;
                border-color: Theme.accent;

                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: "ALL";
                        color: Theme.accent;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                all-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.all-clicked(); }
                }
            }
        }

        Rectangle {
            height: large ? 56px : 40px;
            background: root.enabled ? Theme.surface : Theme.surface-hover;
            border-radius: 8px;
            border-width: input.has-focus && root.enabled ? 2px : 1px;
            border-color: input.has-focus && root.enabled ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: root.enabled ? Theme.text-subtle : Theme.text-muted;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: root.enabled ? Theme.text-primary : Theme.text-muted;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                    enabled: root.enabled;
                    edited => { root.edited(root.value); }

                    key-pressed(event) => {
                        if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                            root.submit-shortcut();
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            TouchArea {
                enabled: root.enabled;
                clicked => { input.focus(); }
            }
        }
    }
}
