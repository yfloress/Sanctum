// ==================== Settings Page ====================
// Premium Fintech UI - Application Settings

import { SettingsAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { FormField } from "../components/forms/form_field.slint";

component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> toggle-value: false;
    callback toggled(bool);

    height: 72px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;
        
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text { 
                text: root.title; 
                color: Theme.text-primary; 
                font-size: 14px; 
                font-weight: 500;
                letter-spacing: 0.3px;
            }

            Text { 
                text: root.description; 
                color: Theme.text-muted; 
                font-size: 11px;
                font-weight: 400;
            }
        }
        
        // Toggle Switch
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 52px;
                height: 28px;
                border-radius: 14px;
                background: toggle-value 
                    ? @linear-gradient(135deg, Theme.success 0%, Theme.success-strong 100%)
                    : Theme.surface-hover;
                border-width: 1px;
                border-color: toggle-value ? transparent : Theme.border;
                
                animate background { duration: 250ms; easing: ease-out; }
                
                // Knob
                Rectangle {
                    x: toggle-value ? 26px : 2px;
                    y: 2px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: @linear-gradient(135deg, Theme.text 0%, Theme.text-light 100%);
                    drop-shadow-blur: 4px;
                    drop-shadow-color: Theme.bg.with-alpha(0.2);
                    drop-shadow-offset-y: 2px;

                    animate x { duration: 250ms; easing: ease-out; }
                }
                
                toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggled(!toggle-value);
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!toggle-value); }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    
    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent-indigo 100%);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component InfoCard inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 64px;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;
        
        Text { 
            text: root.label; 
            color: Theme.text-muted; 
            font-size: 12px; 
            font-weight: 400;
            vertical-alignment: center;
        }

        Text { 
            text: root.value; 
            color: Theme.text-primary; 
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

component SettingSelector inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> selected-value;
    in property <[string]> options;
    in property <[string]> option-labels;
    callback value-selected(string);

    height: 72px;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 500;
                letter-spacing: 0.3px;
            }

            Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 400;
            }
        }

        // Dropdown
        VerticalLayout {
            alignment: center;
            width: 140px;

            selector-box := Rectangle {
                height: 36px;
                background: selector-touch.has-hover ? Theme.surface-hover : Theme.surface-deep;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: root.selected-value;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "▼";
                        color: Theme.text-muted;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                selector-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { dropdown.show(); }
                }
            }
        }
    }

    dropdown := PopupWindow {
        x: root.width - 164px;
        y: selector-box.y + selector-box.height + 4px;
        width: 140px;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(root.options.length * 36px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: root.options.length * 36px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in root.options: Rectangle {
                        height: 36px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: index < root.option-labels.length ? root.option-labels[index] : option;
                                color: option == root.selected-value ? Theme.text-primary : Theme.text-secondary;
                                font-size: 12px;
                                font-weight: option == root.selected-value ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if option == root.selected-value: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.value-selected(option);
                                dropdown.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 100px;
            background: @linear-gradient(180deg, Theme.modal-bg-end 0%, Theme.background 100%);
            
            // Decorative accent
            Rectangle {
                width: 100%;
                height: 2px;
                y: parent.height - 2px;
                background: @linear-gradient(90deg, transparent 0%, Theme.accent 20%, Theme.accent 80%, transparent 100%);
                opacity: 0.1;
            }

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                alignment: start;
                
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Text { 
                            text: "SETTINGS"; 
                            color: Theme.text-primary; 
                            font-size: 24px; 
                            font-weight: 300; 
                            letter-spacing: 6px;
                            vertical-alignment: center;
                        }

                        // Settings icon
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.surface;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../assets/icons/settings.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "Configure your Sanctum experience";
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 0.5px;
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT ====================
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Appearance Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "APPEARANCE";
                    }

                    SettingCard {
                        title: "Dark Mode";
                        description: "Switch between dark and light (cream/gold) themes";
                        toggle-value: SettingsAdapter.dark-mode;
                        toggled(value) => {
                            SettingsAdapter.set-dark-mode(value);
                            SettingsAdapter.dark-mode = value;
                        }
                    }
                }

                // Regional Settings Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "REGIONAL";
                    }

                    SettingSelector {
                        title: "Preferred Currency";
                        description: "Base currency for displaying amounts (UI only)";
                        selected-value: SettingsAdapter.preferred-currency;
                        options: ["USD", "CLP"];
                        option-labels: ["USD ($)", "CLP ($)"];
                        value-selected(value) => {
                            SettingsAdapter.set-preferred-currency(value);
                            SettingsAdapter.preferred-currency = value;
                        }
                    }

                    SettingSelector {
                        title: "Language";
                        description: "Application interface language (UI only)";
                        selected-value: SettingsAdapter.preferred-language;
                        options: ["en", "es"];
                        option-labels: ["English", "Español"];
                        value-selected(value) => {
                            SettingsAdapter.set-preferred-language(value);
                            SettingsAdapter.preferred-language = value;
                        }
                    }

                    Rectangle {
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 12px;

                            Text {
                                text: "⚠ Currency and language changes are not yet implemented. These are UI-only settings.";
                                color: Theme.warning;
                                font-size: 10px;
                                font-weight: 400;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Security Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "SECURITY";
                    }

                    SettingSelector {
                        title: "Session Timeout";
                        description: "Auto-lock vault after inactivity";
                        selected-value: SettingsAdapter.session-timeout == 300 ? "5 min" :
                                       SettingsAdapter.session-timeout == 900 ? "15 min" :
                                       SettingsAdapter.session-timeout == 1800 ? "30 min" :
                                       SettingsAdapter.session-timeout == 3600 ? "1 hour" :
                                       SettingsAdapter.session-timeout == -1 ? "Never" : "15 min";
                        options: ["300", "900", "1800", "3600", "-1"];
                        option-labels: ["5 min", "15 min", "30 min", "1 hour", "Never"];
                        value-selected(value) => {
                            SettingsAdapter.set-session-timeout(value.to-float());
                            SettingsAdapter.session-timeout = value.to-float();
                        }
                    }

                    Rectangle {
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 12px;

                            Text {
                                text: "⚠ Timeout changes will apply on next vault open.";
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 400;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Data Settings Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "DATA & SYNC";
                    }

                    SettingCard {
                        title: "Auto-fetch Crypto Prices";
                        description: "Refresh prices every minute while app is running (uses network)";
                        toggle-value: SettingsAdapter.auto-fetch-enabled;
                        toggled(value) => {
                            SettingsAdapter.set-auto-fetch(value);
                            SettingsAdapter.auto-fetch-enabled = value;
                        }
                    }

                    SettingCard {
                        title: "Use Network Proxy";
                        description: "Route crypto price requests through a proxy (optional)";
                        toggle-value: SettingsAdapter.proxy-enabled;
                        toggled(value) => {
                            SettingsAdapter.set-proxy-enabled(value);
                            SettingsAdapter.proxy-enabled = value;
                        }
                    }

                    FormField {
                        label: "PROXY URL";
                        placeholder: "http://127.0.0.1:8080 or socks5h://127.0.0.1:9050";
                        value: SettingsAdapter.proxy-url;
                        enabled: SettingsAdapter.proxy-enabled;
                        edited(value) => {
                            SettingsAdapter.set-proxy-url(value);
                            SettingsAdapter.proxy-url = value;
                        }
                    }

                    Text {
                        text: "Tip: socks5h:// routes DNS through the proxy for better privacy.";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 400;
                        letter-spacing: 0.3px;
                    }
                }

                // About Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "ABOUT";
                    }

                    InfoCard {
                        label: "Version";
                        value: "1.0.0";
                    }

                    InfoCard {
                        label: "Encryption";
                        value: "AES-256-GCM";
                    }

                    InfoCard {
                        label: "Database";
                        value: "SQLite (Encrypted)";
                    }
                }

                // Security Note
                Rectangle {
                    height: 80px;
                    background: @linear-gradient(135deg, Theme.surface-deep 0%, Theme.surface 100%);
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;

                        // Shield icon
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.surface-hover;

                            Rectangle {
                                x: -2px;
                                y: -2px;
                                width: parent.width + 4px;
                                height: parent.height + 4px;
                                border-radius: 22px;
                                background: Theme.success;
                                opacity: 0.2;
                            }

                            Image {
                                source: @image-url("../assets/icons/shield-check.svg");
                                width: 20px;
                                height: 20px;
                                colorize: Theme.success;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Your data is encrypted locally";
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 500;
                            }

                            Text {
                                text: "All sensitive information is protected with military-grade encryption";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-weight: 400;
                            }
                        }
                    }
                }

                // Reset Button
                Rectangle {
                    height: 56px;
                    background: transparent;

                    HorizontalLayout {
                        alignment: center;

                        reset-btn := Rectangle {
                            width: 200px;
                            height: 44px;
                            border-radius: 8px;
                            background: reset-touch.has-hover ? Theme.danger.darker(0.2) : Theme.danger;
                            border-width: 1px;
                            border-color: Theme.danger-strong;

                            animate background { duration: 150ms; }

                            Text {
                                text: "RESET TO DEFAULTS";
                                color: Theme.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            reset-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    SettingsAdapter.reset-settings();
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 32px; }
            }
        }
    }
}
