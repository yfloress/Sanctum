// ==================== Settings Page ====================
// Premium Fintech UI - Application Settings

import { Palette, SettingsAdapter } from "../globals.slint";
import { FormField } from "../components/forms/form_field.slint";

component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> toggle-value: false;
    callback toggled(bool);

    height: 72px;
    background: touch.has-hover ? Palette.surface-hover : Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;
        
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text { 
                text: root.title; 
                color: Palette.text-primary; 
                font-size: 14px; 
                font-weight: 500;
                letter-spacing: 0.3px;
            }

            Text { 
                text: root.description; 
                color: Palette.text-muted; 
                font-size: 11px;
                font-weight: 400;
            }
        }
        
        // Toggle Switch
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 52px;
                height: 28px;
                border-radius: 14px;
                background: toggle-value 
                    ? @linear-gradient(135deg, Palette.success 0%, #059669 100%)
                    : Palette.surface-hover;
                border-width: 1px;
                border-color: toggle-value ? transparent : Palette.border;
                
                animate background { duration: 250ms; easing: ease-out; }
                
                // Knob
                Rectangle {
                    x: toggle-value ? 26px : 2px;
                    y: 2px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: @linear-gradient(135deg, #ffffff 0%, #f0f0f0 100%);
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000033;
                    drop-shadow-offset-y: 2px;
                    
                    animate x { duration: 250ms; easing: ease-out; }
                }
                
                toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggled(!toggle-value);
                    }
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!toggle-value); }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    
    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component InfoCard inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 64px;
    background: Palette.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;
        
        Text { 
            text: root.label; 
            color: Palette.text-muted; 
            font-size: 12px; 
            font-weight: 400;
            vertical-alignment: center;
        }

        Text { 
            text: root.value; 
            color: Palette.text-primary; 
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

export component SettingsPage inherits Rectangle {
    background: Palette.background;

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 100px;
            background: @linear-gradient(180deg, #0f0f1a 0%, Palette.background 100%);
            
            // Decorative accent
            Rectangle {
                width: 100%;
                height: 2px;
                y: parent.height - 2px;
                background: @linear-gradient(90deg, transparent 0%, Palette.accent 20%, Palette.accent 80%, transparent 100%);
                opacity: 0.1;
            }

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                alignment: start;
                
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Text { 
                            text: "SETTINGS"; 
                            color: Palette.text-primary; 
                            font-size: 24px; 
                            font-weight: 300; 
                            letter-spacing: 6px;
                            vertical-alignment: center;
                        }

                        // Settings icon
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: Palette.surface;
                            y: (parent.height - self.height) / 2;

                            Text {
                                text: "⚙";
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "Configure your Sanctum experience";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 0.5px;
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT ====================
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Data Settings Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "DATA & SYNC";
                    }

                    SettingCard {
                        title: "Auto-fetch Crypto Prices";
                        description: "Automatically update prices when app starts (uses network data)";
                        toggle-value: SettingsAdapter.auto-fetch-enabled;
                        toggled(value) => {
                            SettingsAdapter.set-auto-fetch(value);
                            SettingsAdapter.auto-fetch-enabled = value;
                        }
                    }

                    SettingCard {
                        title: "Use Network Proxy";
                        description: "Route crypto price requests through a proxy (optional)";
                        toggle-value: SettingsAdapter.proxy-enabled;
                        toggled(value) => {
                            SettingsAdapter.set-proxy-enabled(value);
                            SettingsAdapter.proxy-enabled = value;
                        }
                    }

                    FormField {
                        label: "PROXY URL";
                        placeholder: "http://127.0.0.1:8080 or socks5h://127.0.0.1:9050";
                        value: SettingsAdapter.proxy-url;
                        enabled: SettingsAdapter.proxy-enabled;
                        edited(value) => {
                            SettingsAdapter.set-proxy-url(value);
                            SettingsAdapter.proxy-url = value;
                        }
                    }

                    Text {
                        text: "Tip: socks5h:// routes DNS through the proxy for better privacy.";
                        color: Palette.text-muted;
                        font-size: 10px;
                        font-weight: 400;
                        letter-spacing: 0.3px;
                    }
                }

                // About Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "ABOUT";
                    }

                    InfoCard {
                        label: "Version";
                        value: "1.0.0";
                    }

                    InfoCard {
                        label: "Encryption";
                        value: "AES-256-GCM";
                    }

                    InfoCard {
                        label: "Database";
                        value: "SQLite (Encrypted)";
                    }
                }

                // Security Note
                Rectangle {
                    height: 80px;
                    background: @linear-gradient(135deg, #1a1a2e 0%, Palette.surface 100%);
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;

                        // Shield icon
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Palette.surface-hover;

                            Rectangle {
                                x: -2px;
                                y: -2px;
                                width: parent.width + 4px;
                                height: parent.height + 4px;
                                border-radius: 22px;
                                background: Palette.success;
                                opacity: 0.2;
                            }

                            Text {
                                text: "🔐";
                                font-size: 18px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: "Your data is encrypted locally";
                                color: Palette.text-primary;
                                font-size: 13px;
                                font-weight: 500;
                            }

                            Text {
                                text: "All sensitive information is protected with military-grade encryption";
                                color: Palette.text-muted;
                                font-size: 11px;
                                font-weight: 400;
                            }
                        }
                    }
                }

                Rectangle { height: 32px; }
            }
        }
    }
}
