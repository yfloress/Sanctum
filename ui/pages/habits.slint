// ==================== Habits Page ====================
// Premium Fintech UI - Habit tracking with rewards and achievements

import {
    HabitAdapter,
    AppState,
    NotificationAdapter,
    RewardsAdapter,
} from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { TabButton } from "../components/buttons/tab_button.slint";
import { ActionButton } from "../widgets.slint";
import { AddHabitModal } from "../modals/add_habit.slint";
import { AddRewardModal } from "../modals/add_reward.slint";
import { AddGoalModal } from "../modals/add_goal.slint";
import { HabitsTab } from "../components/habits/habits_tab.slint";
import { RewardsTab } from "../components/rewards/rewards_tab.slint";
import { HistoryTab } from "../components/rewards/history_tab.slint";

component NavButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover && enabled ? Theme.border-light : transparent;
    opacity: enabled ? 1.0 : 0.3;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if enabled {
                root.clicked();
            }
        }
    }
}

export component HabitsPage inherits Rectangle {
    background: Theme.background;
    in-out property <string> active-tab: "habits";
    property <bool> show-delete-habit-confirm: false;
    property <string> delete-habit-id: "";
    property <string> delete-habit-name: "";

    init => {
        HabitAdapter.auto-scroll-habits = true;
        HabitAdapter.load-initial-data();
        HabitAdapter.fetch-heatmap-data();
        HabitAdapter.fetch-habit-analytics();
    }

    // Load rewards data when switching to rewards/history tabs (lazy loading)
    changed active-tab => {
        if active-tab == "rewards" {
            RewardsAdapter.fetch-rewards();
            RewardsAdapter.fetch-goals();
        } else if active-tab == "history" {
            RewardsAdapter.fetch-achievements();
        }
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 100px;
            background: @linear-gradient(180deg, Theme.modal-bg-end 0%, Theme.background 100%);

            Rectangle {
                width: 100%;
                height: 3px;
                y: 0;
                background: @linear-gradient(90deg, transparent 0%, Theme.action-gradient-start 20%, Theme.action-gradient-end 80%, transparent 100%);
                opacity: 0.28;
            }

            // Decorative pattern
            Rectangle {
                width: 100%;
                height: 100%;
                opacity: 0.02;
                background: @linear-gradient(45deg, Theme.accent 25%, transparent 25%);
            }

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                alignment: space-between;

                // Left: Title & Month Navigation
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text {
                        text: Translations.habits-title;
                        color: Theme.text-primary;
                        font-size: 24px;
                        font-weight: 300;
                        letter-spacing: 6px;
                    }

                    // Month selector (only visible on habits tab)
                    if root.active-tab == "habits": HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        NavButton {
                            icon: @image-url("../assets/icons/arrow-left.svg");
                            clicked => {
                                HabitAdapter.prev-month();
                            }
                        }

                        Rectangle {
                            width: 140px;
                            height: 28px;
                            background: Theme.surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;

                            Text {
                                text: HabitAdapter.current-month-name + " " + HabitAdapter.current-year;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 500;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        NavButton {
                            icon: @image-url("../assets/icons/arrow-right.svg");
                            clicked => {
                                HabitAdapter.next-month();
                            }
                        }
                    }
                }

                // Right: Tabs
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    // Tabs container
                    Rectangle {
                        height: 44px;
                        background: Theme.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            alignment: center;

                            TabButton {
                                text: Translations.habits-title;
                                active: root.active-tab == "habits";
                                clicked => {
                                    root.active-tab = "habits";
                                }
                            }

                            TabButton {
                                text: Translations.habits-rewards;
                                active: root.active-tab == "rewards";
                                clicked => {
                                    root.active-tab = "rewards";
                                }
                            }

                            TabButton {
                                text: Translations.habits-history;
                                active: root.active-tab == "history";
                                clicked => {
                                    root.active-tab = "history";
                                }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: Theme.background;

            // TAB: HABITS
            if root.active-tab == "habits": Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;

                    habits-tab := HabitsTab {
                        show-delete-habit-confirm <=> root.show-delete-habit-confirm;
                        delete-habit-id <=> root.delete-habit-id;
                        delete-habit-name <=> root.delete-habit-name;
                    }
                }
            }

            // TAB: REWARDS
            if root.active-tab == "rewards": Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;

                    RewardsTab { }
                }
            }

            // TAB: HISTORY
            if root.active-tab == "history": Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;

                    HistoryTab { }
                }
            }
        }
    }

    // ==================== MODALS ====================
    if AppState.show-add-habit: AddHabitModal {
        close => {
            AppState.show-add-habit = false;
        }
    }

    if AppState.show-edit-habit: AddHabitModal {
        editing: true;
        close => {
            AppState.show-edit-habit = false;
        }
    }

    // Delete habit confirmation dialog
    if root.show-delete-habit-confirm: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        z: 1200;

        Rectangle {
            background: Theme.overlay-bg-strong;

            TouchArea {
                clicked => {
                    root.show-delete-habit-confirm = false;
                    root.delete-habit-id = "";
                    root.delete-habit-name = "";
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: Translations.confirm-delete-title + "?";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.confirm-delete-generic + " \"" + root.delete-habit-name + "\". " + Translations.confirm-delete-message;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.action-cancel;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-habit-confirm = false;
                                root.delete-habit-id = "";
                                root.delete-habit-name = "";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Theme.delete-bg-active : Theme.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.delete-border;

                        Text {
                            text: Translations.action-delete;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                HabitAdapter.delete-habit(root.delete-habit-id);
                                root.show-delete-habit-confirm = false;
                                root.delete-habit-id = "";
                                root.delete-habit-name = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // Reward and Goal modals
    if AppState.show-add-reward: AddRewardModal {
        close => {
            AppState.show-add-reward = false;
        }
    }

    if AppState.show-edit-reward: AddRewardModal {
        editing: true;
        close => {
            AppState.show-edit-reward = false;
            RewardsAdapter.edit-reward-id = "";
        }
    }

    if AppState.show-add-goal: AddGoalModal {
        close => {
            AppState.show-add-goal = false;
        }
    }

    if AppState.show-edit-goal: AddGoalModal {
        editing: true;
        close => {
            AppState.show-edit-goal = false;
            RewardsAdapter.edit-goal-id = "";
        }
    }
}
