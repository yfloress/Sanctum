import { Palette, HabitAdapter, AppState } from "../globals.slint";
import { HabitRow } from "../components/habit_row.slint";
import { HabitHeatmap } from "../components/habit_heatmap.slint";
import { HabitBarChart } from "../components/habit_barchart.slint";
import { TextButton } from "../widgets.slint";
import { AddHabitModal } from "../modals/add_habit.slint";

export component HabitsPage inherits Rectangle {
    background: Palette.background;

    init => {
        HabitAdapter.load-initial-data();
        HabitAdapter.fetch-heatmap-data();
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 0px;

        // Header
        HorizontalLayout {
            height: 48px;
            alignment: space-between;

            // Month Navigation
            HorizontalLayout {
                spacing: 16px;
                
                Text {
                    text: "←";
                    color: Palette.text-muted;
                    font-size: 18px;
                    vertical-alignment: center;
                    TouchArea { mouse-cursor: pointer; clicked => { HabitAdapter.prev-month(); } }
                }
                
                Text {
                    text: HabitAdapter.current-month-name + " " + HabitAdapter.current-year;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 500;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                    width: 160px;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "→";
                    color: Palette.text-muted;
                    font-size: 18px;
                    vertical-alignment: center;
                    TouchArea { mouse-cursor: pointer; clicked => { HabitAdapter.next-month(); } }
                }
            }

            // Add Button
            Rectangle {
                width: 120px;
                TextButton {
                    text: "+ HABIT";
                    clicked => { AppState.show-add-habit = true; }
                }
            }
        }

        Rectangle { height: 32px; }

        // Heatmap Header
        HorizontalLayout {
            height: 32px;
            alignment: start;
            spacing: 16px;
            
            Text {
                text: "YEARLY OVERVIEW";
                color: Palette.text-secondary;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Year Navigation
            HorizontalLayout {
                spacing: 12px;
                
                Text {
                    text: "←";
                    color: Palette.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                    TouchArea { mouse-cursor: pointer; clicked => { HabitAdapter.prev-heatmap-year(); } }
                }
                
                Text {
                    text: HabitAdapter.heatmap-year;
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                
                Text {
                    text: "→";
                    color: Palette.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                    TouchArea { mouse-cursor: pointer; clicked => { HabitAdapter.next-heatmap-year(); } }
                }
            }
        }
        
        Rectangle { height: 8px; }

        // Heatmap
        HabitHeatmap {
            height: 120px;
        }

        // Habits List
        if HabitAdapter.habits.length > 0 : Flickable {
            viewport-height: HabitAdapter.habits.length * 64px;
            VerticalLayout {
                for habit in HabitAdapter.habits : HabitRow {
                    habit: habit;
                    toggle(date) => { HabitAdapter.toggle-habit(habit.id, date); }
                    delete(id) => { HabitAdapter.delete-habit(id); }
                }
            }
        }
        
        if HabitAdapter.habits.length == 0 : Rectangle {
            vertical-stretch: 1;
            Text {
                text: "No habits tracked this month.";
                color: Palette.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 32px; }
        
        // Bar Chart
        HabitBarChart {}
        
        Rectangle { height: 32px; }
    }
    
    if AppState.show-add-habit : AddHabitModal {
        close => { AppState.show-add-habit = false; }
    }
}
