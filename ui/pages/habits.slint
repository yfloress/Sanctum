// ==================== Habits Page ====================
// Premium Fintech UI - Habit tracking with visual analytics

import { HabitAdapter, AppState, NotificationAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { HabitRow } from "../components/habit_row.slint";
import { HabitHeatmap } from "../components/habit_heatmap.slint";
import { HabitRadarChart, WeekdayEfficiencyChart, InsightCard } from "../components/analytics_charts.slint";
import { TextButton, ActionButton } from "../widgets.slint";
import { SectionHeader } from "../components/sections/section_header.slint";
import { EmptyState } from "../components/sections/empty_state.slint";
import { AddHabitModal } from "../modals/add_habit.slint";

component NavButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover && enabled ? Theme.border-light : transparent;
    opacity: enabled ? 1.0 : 0.3;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Text {
        text: root.icon;
        color: Theme.text-secondary;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
}

component SummaryItem inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <string> value: "";
    in property <string> note: "";

    background: transparent;
    height: 56px;

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: Theme.text-primary;
                vertical-alignment: center;
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if root.note != "": Text {
            text: root.note;
            color: Theme.text-muted;
            font-size: 11px;
        }
    }
}

export component HabitsPage inherits Rectangle {
    background: Theme.background;
    property <bool> show-delete-habit-confirm: false;
    property <string> delete-habit-id: "";
    property <string> delete-habit-name: "";

    init => {
        HabitAdapter.auto-scroll-habits = true;
        HabitAdapter.load-initial-data();
        HabitAdapter.fetch-heatmap-data();
        HabitAdapter.fetch-habit-analytics();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 100px;
            background: @linear-gradient(180deg, Theme.modal-bg-end 0%, Theme.background 100%);
            
            // Decorative pattern
            Rectangle {
                width: 100%;
                height: 100%;
                opacity: 0.02;
                background: @linear-gradient(45deg, Theme.accent 25%, transparent 25%);
            }

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                alignment: space-between;
                
                // Left: Title & Month Navigation
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    Text { 
                        text: "HABITS"; 
                        color: Theme.text-primary; 
                        font-size: 24px; 
                        font-weight: 300; 
                        letter-spacing: 6px;
                    }

                    // Month selector
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        
                        NavButton {
                            icon: "←";
                            clicked => { HabitAdapter.prev-month(); }
                        }
                        
                        Rectangle {
                            width: 140px;
                            height: 28px;
                            background: Theme.surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;

                            Text {
                                text: HabitAdapter.current-month-name + " " + HabitAdapter.current-year;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 500;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        NavButton {
                            icon: "→";
                            clicked => { HabitAdapter.next-month(); }
                        }
                    }
                }

                // Right: Add button
                VerticalLayout {
                    alignment: center;

                    ActionButton {
                        text: "+ HABIT";
                        primary: true;
                        clicked => { AppState.show-add-habit = true; }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT ====================
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Yearly Overview Section
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;

                        SectionHeader {
                            title: "YEARLY OVERVIEW";
                        }

                        // Year Navigation
                        HorizontalLayout {
                            spacing: 8px;
                            
                            NavButton {
                                icon: "←";
                                clicked => { HabitAdapter.prev-heatmap-year(); }
                            }
                            
                            Rectangle {
                                width: 60px;
                                height: 28px;
                                background: Theme.surface;
                                border-radius: 6px;

                                Text {
                                    text: HabitAdapter.heatmap-year;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            
                            NavButton {
                                icon: "→";
                                clicked => { HabitAdapter.next-heatmap-year(); }
                            }
                        }
                    }

                    // Heatmap container
                    Rectangle {
                        height: 200px;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;

                        HabitHeatmap {}
                    }
                }

                // Habits List Section
                VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "MY HABITS";
                    }

                    if HabitAdapter.habits.length > 0: Rectangle {
                        height: HabitAdapter.habits.length * Theme.habit-row-height;
                        background: Theme.surface;
                        clip: true;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 0px;

                            for habit in HabitAdapter.habits: HabitRow {
                                habit: habit;
                                toggle(date) => { HabitAdapter.toggle-habit(habit.id, date); }
                                delete(id, name) => {
                                    root.delete-habit-id = id;
                                    root.delete-habit-name = name;
                                    root.show-delete-habit-confirm = true;
                                }
                                edit(id) => {
                                    HabitAdapter.edit-id = habit.id;
                                    HabitAdapter.edit-name = habit.name;
                                    HabitAdapter.edit-description = habit.description;
                                    HabitAdapter.edit-color-hex = habit.color-hex;
                                    HabitAdapter.edit-color-index = habit.color-index;
                                    HabitAdapter.edit-category = habit.category;
                                    AppState.show-edit-habit = true;
                                }
                                select(id) => { HabitAdapter.select-habit(id); }
                            }
                        }
                    }
                    
                    if HabitAdapter.habits.length == 0: EmptyState {
                        icon: @image-url("../assets/icons/check.svg");
                        title: "No habits tracked this month";
                        description: "Create a habit to start building consistency";
                    }
                }

                // Analytics Section
                if HabitAdapter.habits.length > 0: VerticalLayout {
                    spacing: 16px;

                    SectionHeader {
                        title: "ANALYTICS";
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        HabitRadarChart {
                            horizontal-stretch: 1;
                            image: HabitAdapter.habits-radar-chart-image;
                            has-data: HabitAdapter.habits-radar-has-data;
                        }

                        WeekdayEfficiencyChart {
                            horizontal-stretch: 1;
                            image: HabitAdapter.habits-weekday-chart-image;
                            has-data: HabitAdapter.habits-weekday-has-data;
                        }
                    }

                    InsightCard {
                        horizontal-stretch: 1;
                        title: "WEEKLY REPORT";
                        line1: HabitAdapter.habits-weekly-primary;
                        line2: HabitAdapter.habits-weekly-secondary;
                    }

                    InsightCard {
                        horizontal-stretch: 1;
                        title: "INSIGHTS";
                        line1: HabitAdapter.habits-insight-primary;
                        line2: HabitAdapter.habits-insight-secondary;
                    }
                }

                // Summary Section
                if HabitAdapter.habits.length > 0: VerticalLayout {
                    spacing: 12px;

                    SectionHeader {
                        title: "HABIT SUMMARY";
                    }

                    Rectangle {
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 16px;

                            Text {
                                text: "SELECTED HABIT";
                                color: Theme.text-muted;
                                font-size: 9px;
                                font-weight: 600;
                                letter-spacing: 1px;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                Rectangle {
                                    width: 4px;
                                    height: 18px;
                                    border-radius: 2px;
                                    background: @linear-gradient(180deg, HabitAdapter.summary-habit-color 0%, HabitAdapter.summary-habit-color.darker(0.2) 100%);
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: HabitAdapter.summary-habit-name;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 24px;

                                SummaryItem {
                                    horizontal-stretch: 1;
                                    icon: @image-url("../assets/icons/trending-up.svg");
                                    label: "CURRENT STREAK";
                                    value: HabitAdapter.summary-current-streak + " days";
                                }

                                SummaryItem {
                                    horizontal-stretch: 1;
                                    icon: @image-url("../assets/icons/star.svg");
                                    label: "BEST STREAK (365D)";
                                    value: HabitAdapter.summary-best-streak + " days";
                                }
                            }

                            HorizontalLayout {
                                spacing: 24px;

                                SummaryItem {
                                    horizontal-stretch: 1;
                                    icon: @image-url("../assets/icons/percent.svg");
                                    label: "COMPLETION RATE";
                                    value: HabitAdapter.summary-completion-rate + "%";
                                    note: HabitAdapter.summary-completion-note;
                                }

                                SummaryItem {
                                    horizontal-stretch: 1;
                                    icon: @image-url("../assets/icons/check.svg");
                                    label: "COMPLETIONS (30D)";
                                    value: HabitAdapter.summary-last-30 + "";
                                    note: HabitAdapter.summary-best-day;
                                }
                            }
                        }
                    }
                }

                // Bottom spacer
                Rectangle { height: 32px; }
            }
        }
    }
    
    if AppState.show-add-habit: AddHabitModal {
        close => { AppState.show-add-habit = false; }
    }

    if AppState.show-edit-habit: AddHabitModal {
        editing: true;
        close => { AppState.show-edit-habit = false; }
    }

    if root.show-delete-habit-confirm: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        z: 1200;

        Rectangle {
            background: Theme.overlay-bg-strong;
            TouchArea {
                clicked => {
                    root.show-delete-habit-confirm = false;
                    root.delete-habit-id = "";
                    root.delete-habit-name = "";
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Delete Habit?";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "This will permanently delete \"" + root.delete-habit-name + "\" and all its logs.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: "Cancel";
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-habit-confirm = false;
                                root.delete-habit-id = "";
                                root.delete-habit-name = "";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Theme.delete-bg-active : Theme.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.delete-border;

                        Text {
                            text: "Delete";
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let result = HabitAdapter.delete-habit(root.delete-habit-id);
                                if (result == "") {
                                    root.show-delete-habit-confirm = false;
                                    root.delete-habit-id = "";
                                    root.delete-habit-name = "";
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
