// ==================== Analytics Page ====================
// Noir Minimalist - Net worth chart

import { Palette, AnalyticsAdapter } from "../globals.slint";
import { SanctumChart } from "../components/chart.slint";

export component AnalyticsPage inherits Rectangle {
    background: Palette.background;

    init => {
        AnalyticsAdapter.fetch-analytics();
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 0px;

        // Header
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "NET WORTH";
                color: Palette.text-muted;
                font-size: 11px;
                font-weight: 400;
                letter-spacing: 3px;
            }

            Text {
                text: AnalyticsAdapter.net-worth;
                color: Palette.text-primary;
                font-size: 32px;
                font-weight: 400;
                font-family: "monospace";
            }
        }

        Rectangle {
            height: 24px;
        }

        // Chart
        Rectangle {
            height: 320px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            SanctumChart {
                width: 100%;
                height: 100%;
                commands: AnalyticsAdapter.chart-path;
            }
        }

        Rectangle {
            height: 24px;
        }

        // Footer placeholders
        VerticalLayout {
            spacing: 6px;

            Text {
                text: "HIGHEST INCOME (MONTH): --";
                color: Palette.text-secondary;
                font-size: 12px;
                font-weight: 400;
            }

            Text {
                text: "HIGHEST EXPENSE (MONTH): --";
                color: Palette.text-secondary;
                font-size: 12px;
                font-weight: 400;
            }
        }
    }
}
