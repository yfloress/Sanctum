// ==================== Analytics Page ====================
// Noir Minimalist - Net worth + Expenses

import { Palette, AnalyticsAdapter } from "../globals.slint";
import { SanctumLineChart } from "../components/charts.slint";
import { CategoryBreakdown } from "../components/category_breakdown.slint";
import { TacticalGrid } from "../components/tactical_grid.slint";
import { BorderButton } from "../widgets.slint";

component MiniStat inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <color> accent: Palette.text-secondary;

    min-width: 140px;
    height: 60px;
    background: Palette.surface;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 16px;
            font-weight: 500;
        }
    }
}

export component AnalyticsPage inherits Rectangle {
    background: Palette.background;

    init => {
        AnalyticsAdapter.fetch-analytics("1M");
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 20px;

        // Header compact
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "ANALYTICS";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                Text {
                    text: AnalyticsAdapter.summary.net_worth;
                    color: Palette.text-primary;
                    font-size: 32px;
                    font-weight: 400;
                    font-family: "monospace";
                }

                Text {
                    text: "Range " + AnalyticsAdapter.active-range;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    font-weight: 400;
                }
            }

            HorizontalLayout {
                spacing: 12px;

                // Range selector
                Rectangle {
                    background: Palette.surface;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.border;
                    height: 32px;

                    HorizontalLayout {
                        spacing: 0px;

                        for range in ["1M", "3M", "6M", "1Y", "ALL"] : Rectangle {
                            width: 54px;
                            background: AnalyticsAdapter.active-range == range ? Palette.border : transparent;

                            Text {
                                text: range;
                                color: AnalyticsAdapter.active-range == range ? Palette.text-primary : Palette.text-secondary;
                                font-size: 11px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    AnalyticsAdapter.active-range = range;
                                    AnalyticsAdapter.fetch-analytics(range);
                                }
                            }
                        }
                    }
                }

                BorderButton {
                    text: "REFRESH";

                    clicked => {
                        AnalyticsAdapter.fetch-analytics(AnalyticsAdapter.active-range);
                    }
                }
            }
        }

        // Inline stats
        HorizontalLayout {
            spacing: 12px;

            MiniStat {
                label: "RANGE";
                value: AnalyticsAdapter.active-range;
                accent: Palette.text-primary;
            }

            MiniStat {
                label: "HIGH";
                value: AnalyticsAdapter.summary.max_value;
                accent: Palette.success;
            }

            MiniStat {
                label: "LOW";
                value: AnalyticsAdapter.summary.min_value;
                accent: Palette.danger;
            }
        }

        // Net worth trend
        Rectangle {
            height: 360px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "NET WORTH TREND";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                SanctumLineChart {
                    width: 100%;
                    height: 100%;
                    path: AnalyticsAdapter.summary.chart_path;
                    min-label: AnalyticsAdapter.summary.min_value;
                    max-label: AnalyticsAdapter.summary.max_value;
                }
            }
        }

        // Expenses Breakdown
        Rectangle {
            height: 360px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                vertical-stretch: 1;

                Text {
                    text: "EXPENSES BY CATEGORY";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                Flickable {
                    viewport-height: 300px;

                    CategoryBreakdown {
                        categories: AnalyticsAdapter.summary.expense_breakdown;
                    }
                }
            }
        }
    }
}
