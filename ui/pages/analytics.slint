// ==================== Analytics Page ====================
// Noir Minimalist - Net worth chart

import { Palette, AnalyticsAdapter } from "../globals.slint";
import { SanctumChart } from "../components/chart.slint";
import { CategoryBreakdown } from "../components/category_breakdown.slint";

export component AnalyticsPage inherits Rectangle {
    background: Palette.background;

    init => {
        AnalyticsAdapter.fetch-analytics("1M");
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 0px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "NET WORTH";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                Text {
                    text: AnalyticsAdapter.net-worth;
                    color: Palette.text-primary;
                    font-size: 32px;
                    font-weight: 400;
                    font-family: "monospace";
                }
            }
            
            // Range Selector
            Rectangle {
                background: Palette.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                height: 32px;
                
                HorizontalLayout {
                    spacing: 0px;
                    
                    for range in ["1M", "3M", "6M", "1Y", "ALL"] : Rectangle {
                        width: 48px;
                        background: AnalyticsAdapter.active-range == range ? Palette.border : transparent;
                        
                        Text {
                            text: range;
                            color: AnalyticsAdapter.active-range == range ? Palette.text-primary : Palette.text-secondary;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        
                        TouchArea {
                            clicked => {
                                AnalyticsAdapter.active-range = range;
                                AnalyticsAdapter.fetch-analytics(range);
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px;
        }

        // Chart
        Rectangle {
            height: 320px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            SanctumChart {
                width: 100%;
                height: 100%;
                commands: AnalyticsAdapter.chart-path;
                min-label: AnalyticsAdapter.min-value;
                max-label: AnalyticsAdapter.max-value;
            }
        }

        Rectangle {
            height: 32px;
        }

        // Expenses Breakdown
        Text {
            text: "EXPENSES BY CATEGORY";
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 3px;
        }

        Rectangle {
            height: 16px;
        }

        Rectangle {
            vertical-stretch: 1;
            
            Flickable {
                viewport-height: AnalyticsAdapter.expense-breakdown.length * 56px;
                
                CategoryBreakdown {
                    categories: AnalyticsAdapter.expense-breakdown;
                }
            }
        }
    }
}
