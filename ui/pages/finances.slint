// ==================== Finances Page ====================
// Premium Fintech UI - Unified view for Transactions and Accounts

import {
    Palette,
    TransactionAdapter,
    AccountAdapter,
    AccountData,
    AppState
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton, ActionButton } from "../widgets.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 110px;
    height: 36px;
    border-radius: 18px;
    background: active ? @linear-gradient(135deg, Palette.surface-hover 0%, Palette.surface 100%) : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-light : transparent;

    animate background { duration: 250ms; easing: ease-out; }
    animate border-color { duration: 250ms; easing: ease-out; }

    // Subtle glow when active
    if active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 20px;
        background: Palette.accent;
        opacity: 0.1;
    }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: active ? 600 : 500;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    
    height: 48px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        // Accent line
        Rectangle {
            width: 3px;
            height: 24px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: 0.5px;
            }

            if subtitle != "": Text {
                text: root.subtitle;
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 400;
            }
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> icon: "📊";
    in property <string> title: "No data";
    in property <string> description: "Get started by adding your first entry";

    height: 200px;
    background: @linear-gradient(135deg, Palette.surface 0%, #1a1a2e 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        alignment: center;
        spacing: 16px;

        // Icon container with glow
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: Palette.surface-hover;
            x: (parent.width - self.width) / 2;

            // Glow
            Rectangle {
                x: -4px;
                y: -4px;
                width: parent.width + 8px;
                height: parent.height + 8px;
                border-radius: 36px;
                background: Palette.accent;
                opacity: 0.15;
            }

            Text {
                text: root.icon;
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Palette.text-muted;
            font-size: 12px;
            font-weight: 400;
            horizontal-alignment: center;
        }
    }
}

export component FinancesPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "activity";

    init => {
        TransactionAdapter.fetch-transactions();
        AccountAdapter.fetch-accounts();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 100px;
            background: @linear-gradient(180deg, #0f0f1a 0%, Palette.background 100%);
            
            // Decorative accent
            Rectangle {
                width: 100%;
                height: 2px;
                y: parent.height - 2px;
                background: @linear-gradient(90deg, transparent 0%, Palette.accent 20%, Palette.accent 80%, transparent 100%);
                opacity: 0.1;
            }

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                alignment: space-between;
                
                // Left: Title & Status
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Text { 
                            text: "FINANCES"; 
                            color: Palette.text-primary; 
                            font-size: 24px; 
                            font-weight: 300; 
                            letter-spacing: 6px;
                            vertical-alignment: center;
                        }

                        // Status badge
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;

                            // Pulse animation
                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: Palette.success;
                                opacity: 0.3;
                            }
                        }
                    }

                    Text {
                        text: "Manage your accounts and transactions";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 0.5px;
                    }
                }

                // Right: Navigation Tabs
                VerticalLayout {
                    alignment: center;
                    
                    Rectangle {
                        height: 44px;
                        background: Palette.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            
                            TabButton {
                                text: "ACTIVITY";
                                active: root.active-tab == "activity";
                                clicked => { root.active-tab = "activity"; }
                            }

                            TabButton {
                                text: "ACCOUNTS";
                                active: root.active-tab == "accounts";
                                clicked => { root.active-tab = "accounts"; }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // TAB: ACTIVITY
            if root.active-tab == "activity": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 48px;
                    alignment: space-between;

                    SectionHeader {
                        title: "Recent Transactions";
                        subtitle: TransactionAdapter.transactions.length == 1 ? "1 entry" : TransactionAdapter.transactions.length + " entries";
                    }

                    ActionButton {
                        text: "+ NEW ENTRY";
                        primary: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.show-add-transaction = true;
                        }
                    }
                }

                // Transaction list
                if TransactionAdapter.transactions.length > 0: Rectangle {
                    vertical-stretch: 1;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    Flickable {
                        viewport-height: TransactionAdapter.transactions.length * 64px;

                        VerticalLayout {
                            spacing: 0px;
                            padding: 8px;

                            for transaction[index] in TransactionAdapter.transactions: TransactionItem {
                                transaction: transaction;
                                is-last: index == TransactionAdapter.transactions.length - 1;
                                show-delete: true;

                                clicked => {
                                    // TODO: Open transaction details
                                }

                                delete-clicked => {
                                    let result = TransactionAdapter.delete-transaction(transaction.id);
                                    if (result == "") {
                                        TransactionAdapter.fetch-transactions();
                                        AccountAdapter.fetch-accounts();
                                    }
                                }
                            }
                        }
                    }
                }

                // Empty state
                if TransactionAdapter.transactions.length == 0: EmptyState {
                    icon: "📝";
                    title: "No transactions yet";
                    description: "Add your first entry to start tracking your finances";
                }
            }

            // TAB: ACCOUNTS
            if root.active-tab == "accounts": Flickable {
                width: parent.width;
                height: parent.height;

                content := VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;
                    spacing: 24px;

                    // Header actions
                    HorizontalLayout {
                        height: 48px;
                        alignment: space-between;

                        SectionHeader {
                            title: "My Accounts";
                            subtitle: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                text: "TRANSFER";
                                primary: false;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.show-transfer-modal = true;
                                }
                            }

                            ActionButton {
                                text: "+ NEW ACCOUNT";
                                primary: true;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.account-edit-mode = false;
                                    AppState.selected-account-index = 0;
                                    AppState.show-add-account = true;
                                }
                            }
                        }
                    }

                    // Accounts list
                    if AccountAdapter.accounts.length > 0: VerticalLayout {
                        spacing: 12px;
                        for account[index] in AccountAdapter.accounts: AccountItem {
                            account: account;
                            is-last: false;

                            clicked => {
                                AppState.account-edit-mode = true;
                                AppState.selected-account-index = index;
                                AppState.show-add-account = true;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length == 0: EmptyState {
                        icon: "🏦";
                        title: "No accounts configured";
                        description: "Create an account to manage your funds";
                    }
                }
            }
        }
    }
}
