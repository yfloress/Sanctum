// ==================== Finances Page ====================
// Premium Fintech UI - Unified view for Transactions and Accounts

import {
    TransactionAdapter,
    CategoryAdapter,
    AccountAdapter,
    AccountData,
    AppState,
    NotificationAdapter,
} from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { AccountItem } from "../components/account_item.slint";
import { AccountDetailPanel } from "../components/account_detail.slint";
import { TabButton } from "../components/buttons/tab_button.slint";
import { SectionHeader } from "../components/sections/section_header.slint";
import { EmptyState } from "../components/sections/empty_state.slint";
import { FilterInput } from "../components/filters/filter_input.slint";
import { TextButton, ActionButton } from "../widgets.slint";

component AccountFilterSelect inherits Rectangle {
    in-out property <int> selected-index: 0;

    height: 56px;
    background: transparent;

    function selected_label() -> string {
        if selected-index == 0 {
            return "All accounts";
        }
        if AccountAdapter.accounts.length == 0 {
            return "All accounts";
        }
        let safe_index = selected-index - 1;
        if safe_index >= 0 && safe_index < AccountAdapter.accounts.length {
            return AccountAdapter.accounts[safe_index].name;
        }
        return "All accounts";
    }

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: Translations.finances-account;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        input-box := Rectangle {
            height: 40px;
            width: root.width;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: selected_label();
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: input-box.y + input-box.height - 4px;
        width: root.width;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min((AccountAdapter.accounts.length + 1) * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: (AccountAdapter.accounts.length + 1) * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    Rectangle {
                        height: 40px;
                        background: option-touch-all.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: Translations.finances-all-accounts;
                                color: selected-index == 0 ? Theme.text-primary : Theme.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == 0 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == 0: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-all := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = 0;
                            }
                        }
                    }

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name;
                                color: selected-index == index + 1 ? Theme.text-primary : Theme.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == index + 1 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == index + 1: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index + 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

component CategoryFilterSelect inherits Rectangle {
    in-out property <int> selected-index: 0;
    property <bool> popup-open: false;

    height: 56px;
    background: transparent;

    function selected_label() -> string {
        if selected-index == 0 {
            return "All categories";
        }
        let expense_len = CategoryAdapter.expense-categories.length;
        let income_len = CategoryAdapter.income-categories.length;
        let transfer_index = 1 + expense_len + income_len;
        if selected-index == transfer_index {
            return "Transfers";
        }
        if selected-index > 0 && selected-index <= expense_len {
            return "Expense · " + CategoryAdapter.expense-categories[selected-index - 1].name;
        }
        if selected-index > expense_len && selected-index < transfer_index {
            return "Income · " + CategoryAdapter.income-categories[selected-index - 1 - expense_len].name;
        }
        return "All categories";
    }

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Text {
            text: Translations.label-category;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        input-box := Rectangle {
            height: 40px;
            width: root.width;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                width: parent.width;
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: selected_label();
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.popup-open = !root.popup-open;
                }
            }
        }
    }

    if popup-open: Rectangle {
        x: 0;
        y: input-box.y + input-box.height - 4px;
        width: root.width;
        height: min((CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length + 4) * 40px + 8px, 280px);
        z: 1200;
        background: Theme.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        Flickable {
            viewport-height: (CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length + 4) * 40px + 8px;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                Rectangle {
                    height: 40px;
                    background: option-touch-all.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: Translations.finances-all-categories;
                            color: selected-index == 0 ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            font-weight: selected-index == 0 ? 500 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if selected-index == 0: Image {
                            source: @image-url("../assets/icons/check.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    option-touch-all := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = 0;
                            root.popup-open = false;
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: transparent;

                    Text {
                        text: Translations.finances-expense;
                        color: Theme.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        x: 12px;
                    }
                }

                for cat[index] in CategoryAdapter.expense-categories: Rectangle {
                    height: 40px;
                    background: option-touch-expense.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: cat.name;
                            color: selected-index == index + 1 ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            font-weight: selected-index == index + 1 ? 500 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if selected-index == index + 1: Image {
                            source: @image-url("../assets/icons/check.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    option-touch-expense := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = index + 1;
                            root.popup-open = false;
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: transparent;

                    Text {
                        text: Translations.finances-income;
                        color: Theme.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        x: 12px;
                    }
                }

                for cat[index] in CategoryAdapter.income-categories: Rectangle {
                    height: 40px;
                    background: option-touch-income.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: cat.name;
                            color: selected-index == index + 1 + CategoryAdapter.expense-categories.length ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            font-weight: selected-index == index + 1 + CategoryAdapter.expense-categories.length ? 500 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if selected-index == index + 1 + CategoryAdapter.expense-categories.length: Image {
                            source: @image-url("../assets/icons/check.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    option-touch-income := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = index + 1 + CategoryAdapter.expense-categories.length;
                            root.popup-open = false;
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    background: option-touch-transfer.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            text: Translations.finances-transfer;
                            color: selected-index == 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            font-weight: selected-index == 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length ? 500 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if selected-index == 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length: Image {
                            source: @image-url("../assets/icons/check.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    option-touch-transfer := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length;
                            root.popup-open = false;
                        }
                    }
                }
            }
        }
    }
}

export component FinancesPage inherits Rectangle {
    background: Theme.background;
    in-out property <string> active-tab: "activity";
    property <bool> show-delete-confirm: false;
    property <string> delete-transaction-id: "";
    property <string> delete-transaction-desc: "";
    property <string> filter-query: "";
    property <int> filter-account-index: 0;
    property <int> filter-category-index: 0;
    property <bool> filters-ready: false;

    defocus-scope := FocusScope {
        width: 0px;
        height: 0px;
    }

    init => {
        TransactionAdapter.is-loading = true;
        AccountAdapter.is-loading = true;
        CategoryAdapter.load-categories();
        TransactionAdapter.filter-query = filter-query;
        TransactionAdapter.filter-account-id = "";
        TransactionAdapter.filter-category = "";
        TransactionAdapter.display-limit = 100;
        TransactionAdapter.fetch-transactions();
        AccountAdapter.fetch-accounts();
        filters-ready = true;
    }

    function account_filter_id() -> string {
        if filter-account-index <= 0 {
            return "";
        }
        if AccountAdapter.accounts.length == 0 {
            return "";
        }
        let idx = filter-account-index - 1;
        if idx >= 0 && idx < AccountAdapter.accounts.length {
            return AccountAdapter.accounts[idx].id;
        }
        return "";
    }

    function category_filter_name() -> string {
        if filter-category-index == 0 {
            return "";
        }
        let expense_len = CategoryAdapter.expense-categories.length;
        let income_len = CategoryAdapter.income-categories.length;
        let transfer_index = 1 + expense_len + income_len;
        if filter-category-index == transfer_index {
            return "TRANSFER";
        }
        if filter-category-index > 0 && filter-category-index <= expense_len {
            return CategoryAdapter.expense-categories[filter-category-index - 1].name;
        }
        if filter-category-index > expense_len && filter-category-index < transfer_index {
            return CategoryAdapter.income-categories[filter-category-index - 1 - expense_len].name;
        }
        return "";
    }

    function apply-filters() {
        if !filters-ready {
            return;
        }
        if filter-account-index > AccountAdapter.accounts.length {
            filter-account-index = 0;
        }
        let max-category-index = 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length;
        if filter-category-index > max-category-index {
            filter-category-index = 0;
        }
        TransactionAdapter.filter-query = filter-query;
        TransactionAdapter.filter-account-id = account_filter_id();
        TransactionAdapter.filter-category = category_filter_name();
        TransactionAdapter.display-limit = 100;
        TransactionAdapter.is-loading = true;
        TransactionAdapter.fetch-transactions();
    }

    function clear-filters() {
        filter-query = "";
        filter-account-index = 0;
        filter-category-index = 0;
        apply-filters();
    }

    function has-active-filters() -> bool {
        return filter-query != "" || filter-account-index > 0 || filter-category-index > 0;
    }

    changed filter-query => {
        apply-filters();
    }
    changed filter-account-index => {
        apply-filters();
    }
    changed filter-category-index => {
        apply-filters();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 160px;
            background: @linear-gradient(180deg, Theme.modal-bg-end 0%, Theme.background 100%);

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 24px;
                padding-bottom: 16px;
                alignment: space-between;

                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent-indigo 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: Translations.finances-title;
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        // Total Value
                        Text {
                            text: AccountAdapter.total-balance;
                            color: Theme.text-primary;
                            font-size: 48px;
                            font-weight: 300;
                            letter-spacing: -1px;
                        }

                        // Subtitle
                        Text {
                            text: Translations.dashboard-total-balance;
                            color: Theme.text-muted;
                            font-size: 12px;
                            font-weight: 400;
                        }
                    }
                }

                // Right: Navigation Tabs
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 44px;
                        background: Theme.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;

                            TabButton {
                                text: Translations.finances-activity;
                                active: root.active-tab == "activity";
                                clicked => {
                                    root.active-tab = "activity";
                                }
                            }

                            TabButton {
                                text: Translations.finances-accounts;
                                active: root.active-tab == "accounts";
                                clicked => {
                                    root.active-tab = "accounts";
                                }
                            }

                            TabButton {
                                text: Translations.nav-settings;
                                active: root.active-tab == "settings";
                                clicked => {
                                    root.active-tab = "settings";
                                }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    defocus-scope.focus();
                }
            }

            // TAB: ACTIVITY
            if root.active-tab == "activity": VerticalLayout {
                horizontal-stretch: 1;
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    SectionHeader {
                        title: "RECENT TRANSACTIONS";
                    }

                    ActionButton {
                        text: "+ NEW ENTRY";
                        primary: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            CategoryAdapter.load-categories();
                            AppState.transaction-edit-mode = false;
                            AppState.selected-transaction-index = 0;
                            AppState.show-add-transaction = true;
                        }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    width: parent.width;
                    spacing: 12px;
                    alignment: start;
                    z: 1200;

                    FilterInput {
                        horizontal-stretch: 1;
                        min-width: 300px;
                        label: "SEARCH";
                        placeholder: "Search by description, category, date...";
                        value <=> root.filter-query;
                    }

                    AccountFilterSelect {
                        width: 120px;
                        selected-index <=> root.filter-account-index;
                    }

                    CategoryFilterSelect {
                        width: 120px;
                        selected-index <=> root.filter-category-index;
                    }

                    Rectangle {
                        width: 72px;
                        height: 56px;

                        VerticalLayout {
                            spacing: 6px;

                            Rectangle {
                                height: 14px;
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: has-active-filters() ? (touch.has-hover ? Theme.surface-hover : Theme.surface) : transparent;
                                border-width: has-active-filters() ? 1px : 0px;
                                border-color: has-active-filters() ? Theme.border-light : transparent;
                                opacity: has-active-filters() ? 1.0 : 0.0;

                                animate background {
                                    duration: 200ms;
                                    easing: ease-out;
                                }
                                animate opacity {
                                    duration: 150ms;
                                    easing: ease-out;
                                }

                                Image {
                                    source: @image-url("../assets/icons/x.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: Theme.text-primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    opacity: has-active-filters() ? 1.0 : 0.0;
                                }

                                touch := TouchArea {
                                    mouse-cursor: has-active-filters() ? pointer : default;
                                    clicked => {
                                        if has-active-filters() {
                                            root.clear-filters();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Transaction list
                if TransactionAdapter.transactions.length > 0: Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;

                    Flickable {
                        viewport-height: TransactionAdapter.transactions.length * 64px + (TransactionAdapter.has-more ? 56px : 0px);

                        VerticalLayout {
                            spacing: 0px;
                            padding: 8px;

                            for transaction[index] in TransactionAdapter.transactions: TransactionItem {
                                transaction: transaction;
                                is-last: index == TransactionAdapter.transactions.length - 1;
                                show-delete: true;

                                clicked => {
                                    if (transaction.is-transfer) {
                                        AccountAdapter.fetch-accounts();
                                        AppState.transfer-edit-mode = true;
                                        AppState.selected-transfer-index = index;
                                        AppState.show-transfer-modal = true;
                                    } else {
                                        CategoryAdapter.load-categories();
                                        AccountAdapter.fetch-accounts();
                                        AppState.transaction-edit-mode = true;
                                        AppState.selected-transaction-index = index;
                                        AppState.show-add-transaction = true;
                                    }
                                }

                                delete-clicked => {
                                    root.delete-transaction-id = transaction.id;
                                    root.delete-transaction-desc = transaction.description != "" ? transaction.description : transaction.category;
                                    root.show-delete-confirm = true;
                                }
                            }

                            if TransactionAdapter.has-more: Rectangle {
                                height: 48px;
                                background: transparent;

                                HorizontalLayout {
                                    alignment: center;

                                    ActionButton {
                                        text: Translations.finances-load-more;
                                        primary: false;
                                        clicked => {
                                            TransactionAdapter.display-limit += 100;
                                            TransactionAdapter.is-loading = true;
                                            TransactionAdapter.fetch-transactions();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Empty state
                if TransactionAdapter.transactions.length == 0: EmptyState {
                    icon: @image-url("../assets/icons/file-text.svg");
                    title: has-active-filters() ? "No matching transactions" : "No transactions yet";
                    description: has-active-filters() ? "Try clearing or adjusting your filters" : "Add your first entry to start tracking your finances";
                }
            }

            // TAB: ACCOUNTS
            if root.active-tab == "accounts": Flickable {
                width: parent.width;
                height: parent.height;

                content := VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;
                    spacing: 24px;

                    // Header actions
                    HorizontalLayout {
                        height: 32px;
                        alignment: space-between;

                        SectionHeader {
                            title: "MY ACCOUNTS";
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                text: Translations.action-transfer;
                                primary: false;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.show-transfer-modal = true;
                                }
                            }

                            ActionButton {
                                text: "+ NEW ACCOUNT";
                                primary: true;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.account-edit-mode = false;
                                    AppState.selected-account-index = 0;
                                    AppState.show-add-account = true;
                                }
                            }
                        }
                    }

                    // Accounts list
                    if AccountAdapter.accounts.length > 0: VerticalLayout {
                        spacing: 12px;
                        for account[index] in AccountAdapter.accounts: AccountItem {
                            account: account;
                            is-last: false;

                            clicked => {
                                AppState.selected-account-index = index;
                                AccountAdapter.fetch-account-details(account.id);
                                AccountAdapter.show-account-detail = true;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length == 0: EmptyState {
                        icon: @image-url("../assets/icons/building-2.svg");
                        title: "No accounts configured";
                        description: "Create an account to manage your funds";
                    }
                }
            }

            // TAB: SETTINGS
            if root.active-tab == "settings": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    SectionHeader {
                        title: "FINANCE SETTINGS";
                    }
                }

                // Categories Section
                Rectangle {
                    height: 120px;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding: 24px;
                        spacing: 24px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: Translations.finances-transaction-categories;
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: Translations.finances-manage-categories;
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            ActionButton {
                                text: Translations.finances-configure;
                                primary: false;
                                clicked => {
                                    CategoryAdapter.load-categories();
                                    AppState.show-configure-categories = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== ACCOUNT DETAIL OVERLAY ====================
    if AccountAdapter.show-account-detail: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        Rectangle {
            background: Theme.overlay-bg-strong;
            animate background { duration: 200ms; }
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AccountAdapter.show-account-detail = false;
                    }
                }
            }

            AccountDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== DELETE CONFIRMATION MODAL ====================
    if root.show-delete-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        TouchArea {
            clicked => {
                root.show-delete-confirm = false;
            }
        }

        Rectangle {
            width: 420px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: Theme.shadow-modal;

            // Block clicks on modal background from closing
            TouchArea { }

            VerticalLayout {
                padding: 32px;
                spacing: 24px;

                // Header
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: Translations.finances-delete-transaction;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: Translations.finances-delete-confirm + " \"" + root.delete-transaction-desc + "\"?";
                        color: Theme.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                // Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    cancel-btn := Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.action-cancel;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-confirm = false;
                            }
                        }
                    }

                    delete-btn := Rectangle {
                        width: 100px;
                        height: 36px;
                        border-radius: 8px;
                        background: delete-touch.has-hover ? Theme.danger.darker(0.2) : Theme.danger;

                        Text {
                            text: Translations.action-delete;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        delete-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let result = TransactionAdapter.delete-transaction(root.delete-transaction-id);
                                if (result == "") {
                                    TransactionAdapter.is-loading = true;
                                    AccountAdapter.is-loading = true;
                                    TransactionAdapter.fetch-transactions();
                                    AccountAdapter.fetch-accounts();
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                                root.show-delete-confirm = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== LOADING OVERLAY ====================
    if TransactionAdapter.is-loading || AccountAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background.with-alpha(0.95);
        z: 999;
        opacity: 1.0;

        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Theme.surface;
                border-width: 3px;
                border-color: Theme.accent;

                animate border-color {
                    duration: 1s;
                    iteration-count: -1;
                    easing: ease-in-out;
                }

                Image {
                    source: @image-url("../assets/icons/credit-card.svg");
                    width: 28px;
                    height: 28px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: Translations.label-loading;
                color: Theme.text-secondary;
                font-size: 14px;
                font-weight: 500;
            }
        }
    }
}
