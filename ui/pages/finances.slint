// ==================== Finances Page ====================
// Premium Fintech UI - Unified view for Transactions and Accounts

import {
    Palette,
    TransactionAdapter,
    CategoryAdapter,
    AccountAdapter,
    AccountData,
    AppState
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton, ActionButton } from "../widgets.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 110px;
    height: 36px;
    border-radius: 18px;
    background: active ? @linear-gradient(135deg, Palette.surface-hover 0%, Palette.surface 100%) : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-light : transparent;

    animate background { duration: 250ms; easing: ease-out; }
    animate border-color { duration: 250ms; easing: ease-out; }

    // Subtle glow when active
    if active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 20px;
        background: Palette.accent;
        opacity: 0.1;
    }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: active ? 600 : 500;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        // Accent line
        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> icon: "📊";
    in property <string> title: "No data";
    in property <string> description: "Get started by adding your first entry";

    height: 160px;
    background: @linear-gradient(135deg, Palette.surface 0%, #1a1a2e 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: Palette.surface-hover;
            x: (parent.width - self.width) / 2;

            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 27px;
                background: Palette.accent;
                opacity: 0.2;
            }

            Text {
                text: root.icon;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            horizontal-alignment: center;
        }
    }
}

export component FinancesPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "activity";
    property <bool> show-delete-confirm: false;
    property <string> delete-transaction-id: "";
    property <string> delete-transaction-desc: "";

    init => {
        TransactionAdapter.fetch-transactions();
        AccountAdapter.fetch-accounts();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 160px;
            background: @linear-gradient(180deg, #0f0f1a 0%, Palette.background 100%);

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 24px;
                padding-bottom: 16px;
                alignment: space-between;

                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "FINANCES";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }

                        // Status badge
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: Palette.success;
                                opacity: 0.3;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        // Total Value
                        Text {
                            text: AccountAdapter.total-balance;
                            color: Palette.text-primary;
                            font-size: 48px;
                            font-weight: 300;
                            letter-spacing: -1px;
                        }

                        // Subtitle
                        Text {
                            text: "Total Balance";
                            color: Palette.text-muted;
                            font-size: 12px;
                            font-weight: 400;
                        }
                    }
                }

                // Right: Navigation Tabs
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 44px;
                        background: Palette.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;

                            TabButton {
                                text: "ACTIVITY";
                                active: root.active-tab == "activity";
                                clicked => { root.active-tab = "activity"; }
                            }

                            TabButton {
                                text: "ACCOUNTS";
                                active: root.active-tab == "accounts";
                                clicked => { root.active-tab = "accounts"; }
                            }

                            TabButton {
                                text: "SETTINGS";
                                active: root.active-tab == "settings";
                                clicked => { root.active-tab = "settings"; }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // TAB: ACTIVITY
            if root.active-tab == "activity": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    SectionHeader {
                        title: "RECENT TRANSACTIONS";
                    }

                    ActionButton {
                        text: "+ NEW ENTRY";
                        primary: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.show-add-transaction = true;
                        }
                    }
                }

                // Transaction list
                if TransactionAdapter.transactions.length > 0: Rectangle {
                    vertical-stretch: 1;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    Flickable {
                        viewport-height: TransactionAdapter.transactions.length * 64px;

                        VerticalLayout {
                            spacing: 0px;
                            padding: 8px;

                            for transaction[index] in TransactionAdapter.transactions: TransactionItem {
                                transaction: transaction;
                                is-last: index == TransactionAdapter.transactions.length - 1;
                                show-delete: true;

                                delete-clicked => {
                                    root.delete-transaction-id = transaction.id;
                                    root.delete-transaction-desc = transaction.description != "" ? transaction.description : transaction.category;
                                    root.show-delete-confirm = true;
                                }
                            }
                        }
                    }
                }

                // Empty state
                if TransactionAdapter.transactions.length == 0: EmptyState {
                    icon: "📝";
                    title: "No transactions yet";
                    description: "Add your first entry to start tracking your finances";
                }
            }

            // TAB: ACCOUNTS
            if root.active-tab == "accounts": Flickable {
                width: parent.width;
                height: parent.height;

                content := VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;
                    spacing: 24px;

                    // Header actions
                    HorizontalLayout {
                        height: 32px;
                        alignment: space-between;

                        SectionHeader {
                            title: "MY ACCOUNTS";
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                text: "TRANSFER";
                                primary: false;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.show-transfer-modal = true;
                                }
                            }

                            ActionButton {
                                text: "+ NEW ACCOUNT";
                                primary: true;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.account-edit-mode = false;
                                    AppState.selected-account-index = 0;
                                    AppState.show-add-account = true;
                                }
                            }
                        }
                    }

                    // Accounts list
                    if AccountAdapter.accounts.length > 0: VerticalLayout {
                        spacing: 12px;
                        for account[index] in AccountAdapter.accounts: AccountItem {
                            account: account;
                            is-last: false;

                            clicked => {
                                AppState.account-edit-mode = true;
                                AppState.selected-account-index = index;
                                AppState.show-add-account = true;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length == 0: EmptyState {
                        icon: "🏦";
                        title: "No accounts configured";
                        description: "Create an account to manage your funds";
                    }
                }
            }

            // TAB: SETTINGS
            if root.active-tab == "settings": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    SectionHeader {
                        title: "FINANCE SETTINGS";
                    }
                }

                // Categories Section
                Rectangle {
                    height: 120px;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding: 24px;
                        spacing: 24px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "Transaction Categories";
                                color: Palette.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Manage income and expense categories";
                                color: Palette.text-muted;
                                font-size: 12px;
                            }
                        }

                        ActionButton {
                            text: "CONFIGURE";
                            primary: false;
                            clicked => {
                                CategoryAdapter.load-categories();
                                AppState.show-configure-categories = true;
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== DELETE CONFIRMATION MODAL ====================
    if root.show-delete-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => { root.show-delete-confirm = false; }
        }

        Rectangle {
            width: 420px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 32px;
                spacing: 24px;

                // Header
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Delete Transaction";
                        color: Palette.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Are you sure you want to delete \"" + root.delete-transaction-desc + "\"?";
                        color: Palette.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                // Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    ActionButton {
                        text: "CANCEL";
                        primary: false;
                        clicked => { root.show-delete-confirm = false; }
                    }

                    ActionButton {
                        text: "DELETE";
                        primary: true;
                        clicked => {
                            let result = TransactionAdapter.delete-transaction(root.delete-transaction-id);
                            if (result == "") {
                                TransactionAdapter.fetch-transactions();
                                AccountAdapter.fetch-accounts();
                            }
                            root.show-delete-confirm = false;
                        }
                    }
                }
            }

            TouchArea {} // Prevent click-through
        }
    }
}
