// ==================== Finances Page ====================
// Unified view for Transactions and Accounts
// Based on "Sanctum Command" Architecture

import {
    Palette,
    TransactionAdapter,
    AccountAdapter,
    AccountData,
    AppState
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton } from "../widgets.slint";

export component FinancesPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "activity"; // activity, accounts

    init => {
        TransactionAdapter.fetch-transactions();
        AccountAdapter.fetch-accounts();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== HEADER (Tabs) ====================
        Rectangle {
            height: 100px;
            background: Palette.background;
            
            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-top: 24px;
                padding-bottom: 24px;
                alignment: space-between;
                spacing: 24px;
                
                // Left: Title / Summary Area
                VerticalLayout {
                    alignment: center;
                    Text { 
                        text: "FINANCIAL OVERVIEW"; 
                        color: Palette.text-muted; 
                        font-size: 11px; 
                        font-weight: 600; 
                        letter-spacing: 2px; 
                        vertical-alignment: center;
                    }
                }

                // Right: Navigation Tabs (Segmented Control style)
                VerticalLayout {
                    alignment: center;
                    
                    Rectangle {
                        height: 44px;
                        width: 240px;
                        border-radius: 8px;
                        background: Palette.surface;
                        clip: true;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 0px;
                            
                            // Tab 1: ACTIVITY
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: root.active-tab == "activity" ? Palette.background : transparent;
                                border-width: root.active-tab == "activity" ? 1px : 0px;
                                border-color: Palette.border.with-alpha(0.5);
                                drop-shadow-blur: root.active-tab == "activity" ? 4px : 0px;
                                drop-shadow-color: #00000040;
                                
                                animate background { duration: 150ms; }

                                Text { 
                                    text: "ACTIVITY"; 
                                    color: root.active-tab == "activity" ? Palette.text-primary : Palette.text-muted; 
                                    font-size: 11px; font-weight: 600; 
                                    vertical-alignment: center; horizontal-alignment: center; 
                                }
                                TouchArea { clicked => { root.active-tab = "activity"; } }
                            }

                            // Tab 2: ACCOUNTS
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: root.active-tab == "accounts" ? Palette.background : transparent;
                                border-width: root.active-tab == "accounts" ? 1px : 0px;
                                border-color: Palette.border.with-alpha(0.5);
                                drop-shadow-blur: root.active-tab == "accounts" ? 4px : 0px;
                                drop-shadow-color: #00000040;

                                animate background { duration: 150ms; }

                                Text { 
                                    text: "ACCOUNTS"; 
                                    color: root.active-tab == "accounts" ? Palette.text-primary : Palette.text-muted; 
                                    font-size: 11px; font-weight: 600; 
                                    vertical-alignment: center; horizontal-alignment: center; 
                                }
                                TouchArea { clicked => { root.active-tab = "accounts"; } }
                            }
                        }
                    }
                }
            }
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // TAB: ACTIVITY (Content from transactions.slint)
            if root.active-tab == "activity": VerticalLayout {
                padding: 48px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 0px;

                // Header section
                HorizontalLayout {
                    height: 48px;
                    spacing: 0px;

                    // Title
                    Text {
                        text: "RECENT TRANSACTIONS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Add transaction button
                    Rectangle {
                        width: 120px;

                        TextButton {
                            text: "+ ADD";
                            enabled: true;

                            clicked => {
                                AccountAdapter.fetch-accounts();
                                AppState.show-add-transaction = true;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle {
                    height: 24px;
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Transaction list
                if TransactionAdapter.transactions.length > 0: Rectangle {
                    vertical-stretch: 1;

                    Flickable {
                        viewport-height: TransactionAdapter.transactions.length * 56px;

                        VerticalLayout {
                            spacing: 0px;

                            for transaction[index] in TransactionAdapter.transactions: TransactionItem {
                                transaction: transaction;
                                is-last: index == TransactionAdapter.transactions.length - 1;
                                show-delete: true;

                                clicked => {
                                    // TODO: Open transaction details
                                }

                                delete-clicked => {
                                    let result = TransactionAdapter.delete-transaction(transaction.id);
                                    if (result == "") {
                                        TransactionAdapter.fetch-transactions();
                                        AccountAdapter.fetch-accounts();
                                    }
                                }
                            }
                        }
                    }
                }

                // Empty state
                if TransactionAdapter.transactions.length == 0: Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        Text {
                            text: "No transactions yet";
                            color: Palette.text-muted;
                            font-size: 14px;
                            font-weight: 300;
                            font-italic: true;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Add your first entry to start tracking";
                            color: Palette.text-subtle;
                            font-size: 12px;
                            font-weight: 400;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Footer
                Rectangle {
                    height: 48px;

                    HorizontalLayout {
                        alignment: start;

                        Text {
                            text: TransactionAdapter.transactions.length == 1 ? "1 entry" : TransactionAdapter.transactions.length + " entries";
                            color: Palette.text-subtle;
                            font-size: 10px;
                            font-weight: 400;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // TAB: ACCOUNTS (Content from accounts.slint)
            if root.active-tab == "accounts": Flickable {
                width: parent.width;
                height: parent.height;

                content := VerticalLayout {
                    width: parent.width;
                    padding: 48px;
                    padding-left: 64px;
                    padding-right: 64px;
                    spacing: 16px;

                    // Header actions
                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "ACCOUNTS";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 400;
                            letter-spacing: 3px;
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            TextButton {
                                text: "TRANSFER";
                                enabled: AccountAdapter.accounts.length > 1;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.show-transfer-modal = true;
                                }
                            }

                            TextButton {
                                text: "+ NEW";
                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.account-edit-mode = false;
                                    AppState.selected-account-index = 0;
                                    AppState.show-add-account = true;
                                }
                            }
                        }
                    }

                    // List container
                    Rectangle {
                        background: Palette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "ACCOUNT LIST";
                                    color: Palette.text-muted;
                                    font-size: 11px;
                                    font-weight: 400;
                                    letter-spacing: 3px;
                                }

                                Text {
                                    text: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                                    color: Palette.text-secondary;
                                    font-size: 12px;
                                    font-weight: 400;
                                }
                            }

                            if AccountAdapter.accounts.length == 0: Rectangle {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 14px;

                                    Text {
                                        text: "No accounts yet";
                                        color: Palette.text-muted;
                                        font-size: 14px;
                                        font-weight: 300;
                                        font-italic: true;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Create your first account to start tracking.";
                                        color: Palette.text-secondary;
                                        font-size: 12px;
                                        font-weight: 400;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if AccountAdapter.accounts.length > 0: Rectangle {
                                Flickable {
                                    height: AccountAdapter.accounts.length * 70px < 360px ? AccountAdapter.accounts.length * 70px : 360px;
                                    viewport-height: AccountAdapter.accounts.length * 70px;

                                    VerticalLayout {
                                        spacing: 0px;
                                        preferred-height: AccountAdapter.accounts.length * 70px;

                                        for account[index] in AccountAdapter.accounts: AccountItem {
                                            account: account;
                                            is-last: index == AccountAdapter.accounts.length - 1;

                                            clicked => {
                                                AppState.account-edit-mode = true;
                                                AppState.selected-account-index = index;
                                                AppState.show-add-account = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
