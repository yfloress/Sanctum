// ==================== Finances Page ====================
// Premium Fintech UI - Unified view for Transactions and Accounts

import {
    Palette,
    TransactionAdapter,
    CategoryAdapter,
    AccountAdapter,
    AccountData,
    AppState,
    NotificationAdapter
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton, ActionButton } from "../widgets.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 110px;
    height: 36px;
    border-radius: 18px;
    background: active ? @linear-gradient(135deg, Palette.surface-hover 0%, Palette.surface 100%) : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-light : transparent;

    animate background { duration: 250ms; easing: ease-out; }
    animate border-color { duration: 250ms; easing: ease-out; }

    // Subtle glow when active
    if active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 20px;
        background: Palette.accent;
        opacity: 0.1;
    }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: active ? 600 : 500;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        // Accent line
        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> icon: "📊";
    in property <string> title: "No data";
    in property <string> description: "Get started by adding your first entry";

    height: 160px;
    background: @linear-gradient(135deg, Palette.surface 0%, #1a1a2e 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: Palette.surface-hover;
            x: (parent.width - self.width) / 2;

            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: 27px;
                background: Palette.accent;
                opacity: 0.2;
            }

            Text {
                text: root.icon;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.title;
            color: Palette.text-secondary;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            horizontal-alignment: center;
        }
    }
}

component FilterInput inherits Rectangle {
    in property <string> label: "SEARCH";
    in property <string> placeholder: "Search...";
    in-out property <string> value: "";

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "🔎";
                    color: Palette.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

component AccountFilterSelect inherits Rectangle {
    in-out property <int> selected-index: 0;

    height: 56px;
    background: transparent;

    function selected_label() -> string {
        if selected-index == 0 {
            return "All accounts";
        }
        if AccountAdapter.accounts.length == 0 {
            return "All accounts";
        }
        let safe_index = selected-index - 1;
        if safe_index >= 0 && safe_index < AccountAdapter.accounts.length {
            return AccountAdapter.accounts[safe_index].name;
        }
        return "All accounts";
    }

    VerticalLayout {
        spacing: 6px;

        Text {
            text: "ACCOUNT";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: selected_label();
                    color: Palette.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 56px;
        width: root.width;

        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min((AccountAdapter.accounts.length + 1) * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: (AccountAdapter.accounts.length + 1) * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    Rectangle {
                        height: 40px;
                        background: option-touch-all.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: "All accounts";
                                color: selected-index == 0 ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == 0 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == 0: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-all := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = 0; }
                        }
                    }

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name;
                                color: selected-index == index + 1 ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == index + 1 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == index + 1: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index + 1; }
                        }
                    }
                }
            }
        }
    }
}

component CategoryFilterSelect inherits Rectangle {
    in-out property <int> selected-index: 0;

    height: 56px;
    background: transparent;

    function selected_label() -> string {
        if selected-index == 0 {
            return "All categories";
        }
        if selected-index == 1 {
            return "Transfers";
        }
        let expense_len = CategoryAdapter.expense-categories.length;
        let idx = selected-index - 2;
        if idx >= 0 && idx < expense_len {
            return CategoryAdapter.expense-categories[idx].name;
        }
        let income_idx = idx - expense_len;
        if income_idx >= 0 && income_idx < CategoryAdapter.income-categories.length {
            return CategoryAdapter.income-categories[income_idx].name;
        }
        return "All categories";
    }

    VerticalLayout {
        spacing: 6px;

        Text {
            text: "CATEGORY";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: selected_label();
                    color: Palette.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 56px;
        width: root.width;

        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min((CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length + 2) * 40px + 8px, 280px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: (CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length + 2) * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    Rectangle {
                        height: 40px;
                        background: option-touch-all.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: "All categories";
                                color: selected-index == 0 ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == 0 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == 0: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-all := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = 0; }
                        }
                    }

                    Rectangle {
                        height: 40px;
                        background: option-touch-transfer.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: "Transfers";
                                color: selected-index == 1 ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == 1 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == 1: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-transfer := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = 1; }
                        }
                    }

                    for cat[index] in CategoryAdapter.expense-categories: Rectangle {
                        height: 40px;
                        background: option-touch-expense.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: cat.name;
                                color: selected-index == index + 2 ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == index + 2 ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == index + 2: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-expense := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index + 2; }
                        }
                    }

                    for cat[index] in CategoryAdapter.income-categories: Rectangle {
                        height: 40px;
                        background: option-touch-income.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: cat.name;
                                color: selected-index == index + 2 + CategoryAdapter.expense-categories.length ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: selected-index == index + 2 + CategoryAdapter.expense-categories.length ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if selected-index == index + 2 + CategoryAdapter.expense-categories.length: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch-income := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index + 2 + CategoryAdapter.expense-categories.length; }
                        }
                    }
                }
            }
        }
    }
}

export component FinancesPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "activity";
    property <bool> show-delete-confirm: false;
    property <string> delete-transaction-id: "";
    property <string> delete-transaction-desc: "";
    property <string> filter-query: "";
    property <int> filter-account-index: 0;
    property <int> filter-category-index: 0;
    property <bool> filters-ready: false;

    init => {
        TransactionAdapter.is-loading = true;
        AccountAdapter.is-loading = true;
        CategoryAdapter.load-categories();
        TransactionAdapter.filter-query = filter-query;
        TransactionAdapter.filter-account-id = "";
        TransactionAdapter.filter-category = "";
        TransactionAdapter.display-limit = 100;
        TransactionAdapter.fetch-transactions();
        AccountAdapter.fetch-accounts();
        filters-ready = true;
    }

    function account_filter_id() -> string {
        if filter-account-index <= 0 {
            return "";
        }
        if AccountAdapter.accounts.length == 0 {
            return "";
        }
        let idx = filter-account-index - 1;
        if idx >= 0 && idx < AccountAdapter.accounts.length {
            return AccountAdapter.accounts[idx].id;
        }
        return "";
    }

    function category_filter_name() -> string {
        if filter-category-index == 0 {
            return "";
        }
        if filter-category-index == 1 {
            return "TRANSFER";
        }
        let expense_len = CategoryAdapter.expense-categories.length;
        let idx = filter-category-index - 2;
        if idx >= 0 && idx < expense_len {
            return CategoryAdapter.expense-categories[idx].name;
        }
        let income_idx = idx - expense_len;
        if income_idx >= 0 && income_idx < CategoryAdapter.income-categories.length {
            return CategoryAdapter.income-categories[income_idx].name;
        }
        return "";
    }

    function apply-filters() {
        if !filters-ready {
            return;
        }
        if filter-account-index > AccountAdapter.accounts.length {
            filter-account-index = 0;
        }
        let max-category-index = 1 + CategoryAdapter.expense-categories.length + CategoryAdapter.income-categories.length;
        if filter-category-index > max-category-index {
            filter-category-index = 0;
        }
        TransactionAdapter.filter-query = filter-query;
        TransactionAdapter.filter-account-id = account_filter_id();
        TransactionAdapter.filter-category = category_filter_name();
        TransactionAdapter.display-limit = 100;
        TransactionAdapter.is-loading = true;
        TransactionAdapter.fetch-transactions();
    }

    function clear-filters() {
        filter-query = "";
        filter-account-index = 0;
        filter-category-index = 0;
        apply-filters();
    }

    function has-active-filters() -> bool {
        return filter-query != "" || filter-account-index > 0 || filter-category-index > 0;
    }

    changed filter-query => { apply-filters(); }
    changed filter-account-index => { apply-filters(); }
    changed filter-category-index => { apply-filters(); }

    VerticalLayout {
        spacing: 0px;

        // ==================== HERO HEADER ====================
        Rectangle {
            height: 160px;
            background: @linear-gradient(180deg, #0f0f1a 0%, Palette.background 100%);

            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 24px;
                padding-bottom: 16px;
                alignment: space-between;

                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "FINANCES";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }

                        // Status badge
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: Palette.success;
                                opacity: 0.3;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        // Total Value
                        Text {
                            text: AccountAdapter.total-balance;
                            color: Palette.text-primary;
                            font-size: 48px;
                            font-weight: 300;
                            letter-spacing: -1px;
                        }

                        // Subtitle
                        Text {
                            text: "Total Balance";
                            color: Palette.text-muted;
                            font-size: 12px;
                            font-weight: 400;
                        }
                    }
                }

                // Right: Navigation Tabs
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 44px;
                        background: Palette.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;

                            TabButton {
                                text: "ACTIVITY";
                                active: root.active-tab == "activity";
                                clicked => { root.active-tab = "activity"; }
                            }

                            TabButton {
                                text: "ACCOUNTS";
                                active: root.active-tab == "accounts";
                                clicked => { root.active-tab = "accounts"; }
                            }

                            TabButton {
                                text: "SETTINGS";
                                active: root.active-tab == "settings";
                                clicked => { root.active-tab = "settings"; }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // TAB: ACTIVITY
            if root.active-tab == "activity": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;

                        SectionHeader {
                            title: "RECENT TRANSACTIONS";
                        }

                        if has-active-filters(): Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Palette.accent;

                            Text {
                                text: (filter-query != "" ? 1 : 0) + (filter-account-index > 0 ? 1 : 0) + (filter-category-index > 0 ? 1 : 0);
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    ActionButton {
                        text: "+ NEW ENTRY";
                        primary: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            CategoryAdapter.load-categories();
                            AppState.transaction-edit-mode = false;
                            AppState.selected-transaction-index = 0;
                            AppState.show-add-transaction = true;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    FilterInput {
                        horizontal-stretch: 1;
                        label: "SEARCH";
                        placeholder: "Search by description, category, date...";
                        value <=> root.filter-query;
                    }

                    AccountFilterSelect {
                        width: 160px;
                        selected-index <=> root.filter-account-index;
                    }

                    CategoryFilterSelect {
                        width: 160px;
                        selected-index <=> root.filter-category-index;
                    }

                    if has-active-filters(): Rectangle {
                        width: 72px;
                        height: 56px;

                        VerticalLayout {
                            spacing: 6px;

                            Rectangle {
                                height: 14px;
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: touch.has-hover ? Palette.surface-hover : Palette.surface;
                                border-width: 1px;
                                border-color: Palette.border-light;

                                animate background { duration: 200ms; easing: ease-out; }

                                Text {
                                    text: "✕";
                                    color: Palette.text-primary;
                                    font-size: 16px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-filters(); }
                                }
                            }
                        }
                    }
                }

                // Transaction list
                if TransactionAdapter.transactions.length > 0: Rectangle {
                    vertical-stretch: 1;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    Flickable {
                        viewport-height: TransactionAdapter.transactions.length * 64px
                            + (TransactionAdapter.has-more ? 56px : 0px);

                        VerticalLayout {
                            spacing: 0px;
                            padding: 8px;

                            for transaction[index] in TransactionAdapter.transactions: TransactionItem {
                                transaction: transaction;
                                is-last: index == TransactionAdapter.transactions.length - 1;
                                show-delete: true;

                                clicked => {
                                    if (transaction.is-transfer) {
                                        AccountAdapter.fetch-accounts();
                                        AppState.transfer-edit-mode = true;
                                        AppState.selected-transfer-index = index;
                                        AppState.show-transfer-modal = true;
                                    } else {
                                        CategoryAdapter.load-categories();
                                        AccountAdapter.fetch-accounts();
                                        AppState.transaction-edit-mode = true;
                                        AppState.selected-transaction-index = index;
                                        AppState.show-add-transaction = true;
                                    }
                                }

                                delete-clicked => {
                                    root.delete-transaction-id = transaction.id;
                                    root.delete-transaction-desc = transaction.description != "" ? transaction.description : transaction.category;
                                    root.show-delete-confirm = true;
                                }
                            }

                            if TransactionAdapter.has-more: Rectangle {
                                height: 48px;
                                background: transparent;

                                HorizontalLayout {
                                    alignment: center;

                                    ActionButton {
                                        text: "LOAD MORE";
                                        primary: false;
                                        clicked => {
                                            TransactionAdapter.display-limit += 100;
                                            TransactionAdapter.is-loading = true;
                                            TransactionAdapter.fetch-transactions();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Empty state
                if TransactionAdapter.transactions.length == 0: EmptyState {
                    icon: "📝";
                    title: has-active-filters() ? "No matching transactions" : "No transactions yet";
                    description: has-active-filters() ? "Try clearing or adjusting your filters" : "Add your first entry to start tracking your finances";
                }
            }

            // TAB: ACCOUNTS
            if root.active-tab == "accounts": Flickable {
                width: parent.width;
                height: parent.height;

                content := VerticalLayout {
                    width: parent.width;
                    padding: 32px;
                    padding-left: 64px;
                    padding-right: 64px;
                    spacing: 24px;

                    // Header actions
                    HorizontalLayout {
                        height: 32px;
                        alignment: space-between;

                        SectionHeader {
                            title: "MY ACCOUNTS";
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                text: "TRANSFER";
                                primary: false;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.show-transfer-modal = true;
                                }
                            }

                            ActionButton {
                                text: "+ NEW ACCOUNT";
                                primary: true;

                                clicked => {
                                    AccountAdapter.fetch-accounts();
                                    AppState.account-edit-mode = false;
                                    AppState.selected-account-index = 0;
                                    AppState.show-add-account = true;
                                }
                            }
                        }
                    }

                    // Accounts list
                    if AccountAdapter.accounts.length > 0: VerticalLayout {
                        spacing: 12px;
                        for account[index] in AccountAdapter.accounts: AccountItem {
                            account: account;
                            is-last: false;

                            clicked => {
                                AppState.account-edit-mode = true;
                                AppState.selected-account-index = index;
                                AppState.show-add-account = true;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length == 0: EmptyState {
                        icon: "🏦";
                        title: "No accounts configured";
                        description: "Create an account to manage your funds";
                    }
                }
            }

            // TAB: SETTINGS
            if root.active-tab == "settings": VerticalLayout {
                padding: 32px;
                padding-left: 64px;
                padding-right: 64px;
                spacing: 24px;

                // Header section
                HorizontalLayout {
                    height: 32px;
                    alignment: space-between;

                    SectionHeader {
                        title: "FINANCE SETTINGS";
                    }
                }

                // Categories Section
                Rectangle {
                    height: 120px;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding: 24px;
                        spacing: 24px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: "Transaction Categories";
                                color: Palette.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Manage income and expense categories";
                                color: Palette.text-muted;
                                font-size: 12px;
                            }
                        }

                        ActionButton {
                            text: "CONFIGURE";
                            primary: false;
                            clicked => {
                                CategoryAdapter.load-categories();
                                AppState.show-configure-categories = true;
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== DELETE CONFIRMATION MODAL ====================
    if root.show-delete-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => { root.show-delete-confirm = false; }
        }

        Rectangle {
            width: 420px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 32px;
                spacing: 24px;

                // Header
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Delete Transaction";
                        color: Palette.text-primary;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Are you sure you want to delete \"" + root.delete-transaction-desc + "\"?";
                        color: Palette.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                // Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    ActionButton {
                        text: "CANCEL";
                        primary: false;
                        clicked => { root.show-delete-confirm = false; }
                    }

                    ActionButton {
                        text: "DELETE";
                        primary: true;
                        clicked => {
                            let result = TransactionAdapter.delete-transaction(root.delete-transaction-id);
                            if (result == "") {
                                TransactionAdapter.is-loading = true;
                                AccountAdapter.is-loading = true;
                                TransactionAdapter.fetch-transactions();
                                AccountAdapter.fetch-accounts();
                            } else {
                                NotificationAdapter.show(result, true);
                            }
                            root.show-delete-confirm = false;
                        }
                    }
                }
            }

            TouchArea {} // Prevent click-through
        }
    }

    // ==================== LOADING OVERLAY ====================
    if TransactionAdapter.is-loading || AccountAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background.with-alpha(0.95);
        z: 999;
        opacity: 1.0;

        animate opacity { duration: 200ms; easing: ease-out; }

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Palette.surface;
                border-width: 3px;
                border-color: Palette.accent;

                animate border-color {
                    duration: 1s;
                    iteration-count: -1;
                    easing: ease-in-out;
                }

                Text {
                    text: "💳";
                    font-size: 28px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "Loading finances...";
                color: Palette.text-secondary;
                font-size: 14px;
                font-weight: 500;
            }
        }
    }
}
