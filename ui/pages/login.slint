// ==================== Login Page ====================
// Noir Minimalist - Elegant authentication with smooth gradient background and refined typography

import { AuthAdapter, AppState, NotificationAdapter, VaultAdapter } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { TextButton } from "../widgets.slint";
import { GradientBackground } from "../components/gradient_background.slint";

// ==================== PasswordInput ====================
// Custom password input with visibility toggle

component PasswordInput inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> enabled: true;

    callback accepted(string);

    height: 48px;
    background: transparent;

    property <bool> show-password: false;

    // Main vertical layout (centered)
    VerticalLayout {
        spacing: 0px;

        // Input area
        Rectangle {
            height: 36px;

            // Placeholder (shown when empty and not focused)
            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Theme.text-muted;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                horizontal-alignment: left;
                letter-spacing: 1px;
            }

            input := TextInput {
                text <=> root.text;
                input-type: root.show-password ? InputType.text : InputType.password;
                enabled: root.enabled;
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                letter-spacing: 0.5px;

                accepted => {
                    root.accepted(root.text);
                }
            }

            // Click to focus
            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        // Underline with gradient (full width, centered with container)
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? @linear-gradient(90deg, transparent 0%, Theme.accent-indigo 20%, Theme.text-primary 50%, Theme.accent-indigo 80%, transparent 100%) : @linear-gradient(90deg, transparent 0%, Theme.border 50%, transparent 100%);

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }

    // Visibility toggle button (positioned absolutely to the right)
    Rectangle {
        x: parent.width + 16px;
        y: 0px;
        width: 44px;
        height: 36px;

        Text {
            text: root.show-password ? Translations.login-hide : Translations.login-show;
            color: toggle-touch.has-hover ? Theme.text-primary : Theme.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color {
                duration: 150ms;
                easing: ease-out;
            }
        }

        toggle-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                root.show-password = !root.show-password;
            }
        }
    }
}

export component LoginPage inherits Rectangle {
    // Smooth gradient background
    GradientBackground { }

    // Internal state
    in-out property <string> password-text: "";
    in-out property <bool> vault-exists: false;
    property <string> weak-warning: "";
    property <bool> weak-confirmed: false;
    in-out property <bool> is-loading: false;
    in property <string> title-text: "SANCTUM";

    // Check vault status on init
    init => {
        vault-exists = AuthAdapter.check-vault-exists();
    }

    changed password-text => {
        weak-confirmed = false;
        if (!vault-exists && password-text != "") {
            weak-warning = AuthAdapter.check-password-strength(password-text);
        } else {
            weak-warning = "";
        }
    }

    // Full screen centered layout
    VerticalLayout {
        alignment: center;
        spacing: 0px;

        // Top spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Main content
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 320px;

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;

                    // Title
                    Text {
                        text: root.title-text;
                        color: Theme.text-primary;
                        font-size: 42px;
                        font-weight: 300;
                        letter-spacing: 12px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 16px;
                    }

                    // Subtitle with elegant styling
                    Text {
                        text: Translations.login-subtitle;
                        color: @linear-gradient(90deg, Theme.text-muted 0%, Theme.text-secondary 50%, Theme.text-muted 100%);
                        font-size: 13px;
                        font-weight: 200;
                        font-italic: true;
                        letter-spacing: 2.5px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 64px;
                    }

                    // Password input with toggle
                    PasswordInput {
                        placeholder: vault-exists ? Translations.login-password-placeholder : Translations.login-password-create-placeholder;
                        text <=> password-text;
                        enabled: !is-loading;
                        horizontal-stretch: 1;

                        accepted(text) => {
                            if (password-text != "") {
                                if (vault-exists) {
                                    root.handle-unlock();
                                } else {
                                    root.handle-create();
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 12px;
                    }

                    // Password hint for new vault
                    if !vault-exists && weak-warning != "": Rectangle {
                        height: 32px;
                        background: Theme.warning.with-alpha(0.12);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.warning.with-alpha(0.35);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            Rectangle {
                                width: 4px;
                                height: 16px;
                                border-radius: 2px;
                                background: Theme.warning;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: weak-confirmed ? Translations.login-weak-password-confirm : weak-warning;
                                color: Theme.warning;
                                font-size: 10px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 48px;
                    }

                    // Action button
                    TextButton {
                        text: vault-exists ? (is-loading ? Translations.login-unlocking : Translations.login-unlock) : (is-loading ? Translations.login-creating : Translations.login-create);
                        enabled: password-text != "" && !is-loading;

                        clicked => {
                            if (vault-exists) {
                                root.handle-unlock();
                            } else {
                                root.handle-create();
                            }
                        }
                    }

                    // Restore from backup link (only when vault exists)
                    if vault-exists: Rectangle {
                        height: 36px;

                        HorizontalLayout {
                            alignment: end;

                            restore-link := Rectangle {
                                width: 180px;
                                height: 28px;

                                Text {
                                    text: Translations.vault-restore-from-backup;
                                    color: restore-touch.has-hover ? Theme.accent.darker(0.2) : Theme.accent;
                                    font-size: 11px;
                                    font-weight: 500;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                animate opacity { duration: 200ms; }

                                states [
                                    hover when restore-touch.has-hover: {
                                        opacity: 0.8;
                                    }
                                ]

                                restore-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppState.show-restore-vault = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer
        Rectangle {
            height: 60px;

            Text {
                text: Translations.login-encryption-note;
                color: Theme.text-subtle;
                font-size: 9px;
                font-weight: 500;
                letter-spacing: 3px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Handler: Create new vault
    function handle-create() {
        if (password-text == "") {
            NotificationAdapter.show(Translations.login-password-required, true);
            return;
        }
        if (weak-warning != "" && !weak-confirmed) {
            weak-confirmed = true;
            NotificationAdapter.show(
                weak-warning + ". Click create again to confirm.",
                true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.create-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
        weak-confirmed = false;
    }

    // Handler: Unlock existing vault
    function handle-unlock() {
        if (password-text == "") {
            NotificationAdapter.show(Translations.login-password-required, true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.unlock-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
    }
}
