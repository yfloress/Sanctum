// ==================== Login Page ====================
// Noir Minimalist - Elegant authentication with smooth gradient background and refined typography

import { Palette, AuthAdapter, AppState, NotificationAdapter } from "../globals.slint";
import { TextButton } from "../widgets.slint";
import { TacticalGrid } from "../components/tactical_grid.slint";

// ==================== PasswordInput ====================
// Custom password input with visibility toggle

component PasswordInput inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> enabled: true;

    callback accepted(string);

    height: 48px;
    background: transparent;

    property <bool> show-password: false;

    // Main vertical layout (centered)
    VerticalLayout {
        spacing: 0px;

        // Input area
        Rectangle {
            height: 36px;

            // Placeholder (shown when empty and not focused)
            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-muted;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                horizontal-alignment: left;
                letter-spacing: 1px;
            }

            input := TextInput {
                text <=> root.text;
                input-type: root.show-password ? InputType.text : InputType.password;
                enabled: root.enabled;
                color: Palette.text-primary;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                letter-spacing: 0.5px;

                accepted => {
                    root.accepted(root.text);
                }
            }

            // Click to focus
            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        // Underline with gradient (full width, centered with container)
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus
                ? @linear-gradient(90deg, transparent 0%, #6366f1 20%, #ffffff 50%, #6366f1 80%, transparent 100%)
                : @linear-gradient(90deg, transparent 0%, Palette.border 50%, transparent 100%);

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }

    // Visibility toggle button (positioned absolutely to the right)
    Rectangle {
        x: parent.width + 16px;
        y: 0px;
        width: 44px;
        height: 36px;

        Text {
            text: root.show-password ? "HIDE" : "SHOW";
            color: toggle-touch.has-hover ? Palette.text-primary : Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color {
                duration: 150ms;
                easing: ease-out;
            }
        }

        toggle-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                root.show-password = !root.show-password;
            }
        }
    }
}

export component LoginPage inherits Rectangle {
    // Use TacticalGrid for sophisticated background
    TacticalGrid {}

    // Internal state
    in-out property <string> password-text: "";
    in-out property <bool> vault-exists: false;
    in-out property <bool> is-loading: false;
    in property <string> title-text: "SANCTUM";

    // Check vault status on init
    init => {
        vault-exists = AuthAdapter.check-vault-exists();
    }

    // Full screen centered layout
    VerticalLayout {
        alignment: center;
        spacing: 0px;

        // Top spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Main content
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 320px;

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;

                    // Title
                    Text {
                        text: root.title-text;
                        color: Palette.text-primary;
                        font-size: 42px;
                        font-weight: 300;
                        letter-spacing: 12px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 16px;
                    }

                    // Subtitle with elegant styling
                    Text {
                        text: "Personal Financial Fortress";
                        color: @linear-gradient(90deg, Palette.text-muted 0%, Palette.text-secondary 50%, Palette.text-muted 100%);
                        font-size: 13px;
                        font-weight: 200;
                        font-italic: true;
                        letter-spacing: 2.5px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 64px;
                    }

                    // Password input with toggle
                    PasswordInput {
                        placeholder: vault-exists ? "password" : "create password";
                        text <=> password-text;
                        enabled: !is-loading;
                        horizontal-stretch: 1;

                        accepted(text) => {
                            if (password-text != "") {
                                if (vault-exists) {
                                    root.handle-unlock();
                                } else {
                                    root.handle-create();
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 12px;
                    }

                    // Password hint for new vault
                    if !vault-exists: Text {
                        text: password-text.character-count < 8 ? "minimum 8 characters" : "";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 300;
                        horizontal-alignment: left;
                        opacity: password-text.character-count > 0 && password-text.character-count < 8 ? 1.0 : 0.0;

                        animate opacity { duration: 150ms; }
                    }

                    // Spacer
                    Rectangle {
                        height: 48px;
                    }

                    // Action button
                    TextButton {
                        text: vault-exists ? (is-loading ? "UNLOCKING..." : "UNLOCK VAULT") : (is-loading ? "CREATING..." : "CREATE VAULT");
                        enabled: password-text != "" && (!vault-exists ? password-text.character-count >= 8 : true) && !is-loading;

                        clicked => {
                            if (vault-exists) {
                                root.handle-unlock();
                            } else {
                                root.handle-create();
                            }
                        }
                    }
                }
            }
        }

        // Bottom spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer with security badge
        Rectangle {
            height: 60px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                // Security icon
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.success;
                    background: transparent;
                }

                Text {
                    text: "AES-256 ENCRYPTED";
                    color: Palette.text-subtle;
                    font-size: 9px;
                    font-weight: 500;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                }
            }
        }
    }


    // Handler: Create new vault
    function handle-create() {
        if (password-text == "") {
            NotificationAdapter.show("Password required", true);
            return;
        }
        if (password-text.character-count < 8) {
            NotificationAdapter.show("Password too short", true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.create-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
    }

    // Handler: Unlock existing vault
    function handle-unlock() {
        if (password-text == "") {
            NotificationAdapter.show("Password required", true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.unlock-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
    }
}
