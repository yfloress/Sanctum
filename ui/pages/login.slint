// ==================== Login Page ====================
// Noir Minimalist - Elegant authentication with smooth gradient background and refined typography

import { AuthAdapter, AppState, NotificationAdapter, VaultAdapter } from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import { GradientBackground } from "../components/gradient_background.slint";

// ==================== PasswordInput ====================
// Custom password input with visibility toggle

component PasswordInput inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> enabled: true;

    callback accepted(string);

    height: 48px;
    background: transparent;

    property <bool> show-password: false;

    // Main vertical layout (centered)
    VerticalLayout {
        spacing: 0px;

        // Input area
        Rectangle {
            height: 36px;

            // Placeholder (shown when empty and not focused)
            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Theme.text-secondary;
                font-size: 16px;
                font-weight: 400;
                vertical-alignment: center;
                horizontal-alignment: left;
                letter-spacing: 1px;
            }

            input := TextInput {
                text <=> root.text;
                input-type: root.show-password ? InputType.text : InputType.password;
                enabled: root.enabled;
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 400;
                vertical-alignment: center;
                letter-spacing: 0.5px;

                accepted => {
                    root.accepted(root.text);
                }
            }

            // Click to focus
            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        // Underline with gradient (full width, centered with container)
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Theme.text-primary : @linear-gradient(90deg, transparent 0%, Theme.border 50%, transparent 100%);

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }

    // Visibility toggle button (positioned absolutely to the right)
    Rectangle {
        x: parent.width + 16px;
        y: 0px;
        width: 44px;
        height: 36px;

        Text {
            text: root.show-password ? Translations.login-hide : Translations.login-show;
            color: toggle-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color {
                duration: 150ms;
                easing: ease-out;
            }
        }

        toggle-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                root.show-password = !root.show-password;
            }
        }
    }
}

export component LoginPage inherits Rectangle {
    // Smooth gradient background
    GradientBackground { }

    // Internal state
    in-out property <string> password-text: "";
    in-out property <bool> vault-exists: false;
    property <string> weak-warning: "";
    property <bool> weak-confirmed: false;
    in-out property <bool> is-loading: false;
    in property <string> title-text: "SANCTUM";

    // Check vault status on init
    init => {
        vault-exists = AuthAdapter.check-vault-exists();
    }

    changed password-text => {
        weak-confirmed = false;
        if (!vault-exists && password-text != "") {
            weak-warning = AuthAdapter.check-password-strength(password-text);
        } else {
            weak-warning = "";
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 0px;

        // Top spacer for main content
        Rectangle {
            vertical-stretch: 1;
        }

        // Main content
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 320px;

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;

                        Image {
                            source: @image-url("../assets/logo/sanctum_logo.svg");
                            width: 58px;
                            height: 58px;
                        }
                    }

                    Rectangle {
                        height: 14px;
                    }

                    // Title
                    Text {
                        text: root.title-text;
                        color: Theme.text-primary;
                        font-size: 44px;
                        font-weight: 700;
                        letter-spacing: 12px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 16px;
                    }

                    // Subtitle with elegant styling
                    Text {
                        text: Translations.login-subtitle;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 400;
                        font-italic: false;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 64px;
                    }

                    // Password input with toggle
                    PasswordInput {
                        placeholder: vault-exists ? Translations.login-password-placeholder : Translations.login-password-create-placeholder;
                        text <=> password-text;
                        enabled: !is-loading;
                        horizontal-stretch: 1;

                        accepted(text) => {
                            if (password-text != "") {
                                if (vault-exists) {
                                    root.handle-unlock();
                                } else {
                                    root.handle-create();
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 12px;
                    }

                    // Password hint for new vault
                    if !vault-exists && weak-warning != "": Rectangle {
                        height: 32px;
                        background: Theme.warning.with-alpha(0.12);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.warning.with-alpha(0.35);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            Rectangle {
                                width: 4px;
                                height: 16px;
                                border-radius: 2px;
                                background: Theme.warning;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: weak-confirmed ? Translations.login-weak-password-confirm : weak-warning;
                                color: Theme.warning;
                                font-size: 10px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 48px;
                    }

                    // Action button
                    Rectangle {
                        width: parent.width;
                        height: 46px;
                        border-radius: 10px;
                        background: Theme.primary;
                        opacity: submit-touch.enabled ? (submit-touch.has-hover ? 0.95 : 1.0) : 0.45;
                        drop-shadow-blur: submit-touch.has-hover ? 14px : 8px;
                        drop-shadow-color: Theme.shadow;

                        Text {
                            text: vault-exists ? (is-loading ? Translations.login-unlocking : Translations.login-unlock) : (is-loading ? Translations.login-creating : Translations.login-create);
                            color: Theme.text-light;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 2px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        animate opacity { duration: 150ms; easing: ease-out; }
                        animate drop-shadow-blur { duration: 150ms; easing: ease-out; }

                        submit-touch := TouchArea {
                            enabled: password-text != "" && !is-loading;
                            mouse-cursor: submit-touch.enabled ? pointer : default;

                            clicked => {
                                if (vault-exists) {
                                    root.handle-unlock();
                                } else {
                                    root.handle-create();
                                }
                            }
                        }
                    }

                    if vault-exists: Rectangle {
                        height: 22px;
                    }

                    if vault-exists: Text {
                        text: Translations.vault-restore-from-backup;
                        color: restore-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        letter-spacing: 0.6px;
                        horizontal-alignment: center;

                        restore-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                VaultAdapter.restore-vault();
                            }
                        }
                    }
                }
            }
        }

        // Bottom spacer
        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 32px;
        }
    }

    // Handler: Create new vault
    function handle-create() {
        if (password-text == "") {
            NotificationAdapter.show(Translations.login-password-required, true);
            return;
        }
        if (weak-warning != "" && !weak-confirmed) {
            weak-confirmed = true;
            NotificationAdapter.show(
                weak-warning + ". Click create again to confirm.",
                true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.create-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
        weak-confirmed = false;
    }

    // Handler: Unlock existing vault
    function handle-unlock() {
        if (password-text == "") {
            NotificationAdapter.show(Translations.login-password-required, true);
            return;
        }
        is-loading = true;
        let result = AuthAdapter.unlock-vault(password-text);

        if (result == "") {
            AppState.is-logged-in = true;
        } else {
            NotificationAdapter.show(result, true);
        }
        is-loading = false;
    }
}
