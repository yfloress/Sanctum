// ==================== Login Page ====================
// Noir Minimalist - Elegant, luxury-inspired authentication

import { Palette, AuthAdapter, AppState } from "../globals.slint";
import { TextButton } from "../widgets.slint";

// ==================== PasswordInput ====================
// Custom password input with visibility toggle

component PasswordInput inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> enabled: true;

    callback accepted(string);

    height: 48px;
    background: transparent;

    property <bool> show-password: false;

    // Main vertical layout (centered)
    VerticalLayout {
        spacing: 0px;

        // Input area
        Rectangle {
            height: 36px;

            // Placeholder (shown when empty and not focused)
            if root.text == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-muted;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                horizontal-alignment: left;
                letter-spacing: 1px;
            }

            input := TextInput {
                text <=> root.text;
                input-type: root.show-password ? InputType.text : InputType.password;
                enabled: root.enabled;
                color: Palette.text-primary;
                font-size: 16px;
                font-weight: 300;
                vertical-alignment: center;
                letter-spacing: 0.5px;

                accepted => {
                    root.accepted(root.text);
                }
            }

            // Click to focus
            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        // Underline (full width, centered with container)
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.border-light : Palette.border;

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }

    // Visibility toggle button (positioned absolutely to the right)
    Rectangle {
        x: parent.width + 16px;
        y: 0px;
        width: 44px;
        height: 36px;

        Text {
            text: root.show-password ? "HIDE" : "SHOW";
            color: toggle-touch.has-hover ? Palette.text-primary : Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 1.5px;
            horizontal-alignment: center;
            vertical-alignment: center;

            animate color {
                duration: 150ms;
                easing: ease-out;
            }
        }

        toggle-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                root.show-password = !root.show-password;
            }
        }
    }
}

export component LoginPage inherits Rectangle {
    background: Palette.background;

    // Internal state
    in-out property <string> password-text: "";
    in-out property <string> error-message: "";
    in-out property <bool> vault-exists: false;
    in-out property <bool> is-loading: false;

    // Check vault status on init
    init => {
        vault-exists = AuthAdapter.check-vault-exists();
    }

    // Full screen centered layout
    VerticalLayout {
        alignment: center;
        spacing: 0px;

        // Top spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Main content
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 320px;

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;

                    // Title
                    Text {
                        text: "SANCTUM";
                        color: Palette.text-primary;
                        font-size: 42px;
                        font-weight: 300;
                        letter-spacing: 12px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 16px;
                    }

                    // Subtitle
                    Text {
                        text: "Personal Financial Fortress";
                        color: Palette.text-muted;
                        font-size: 13px;
                        font-weight: 300;
                        font-italic: true;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                    }

                    // Spacer
                    Rectangle {
                        height: 64px;
                    }

                    // Error message (if any)
                    if error-message != "": Rectangle {
                        height: 32px;

                        Text {
                            text: error-message;
                            color: Palette.danger;
                            font-size: 12px;
                            font-weight: 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Spacer after error
                    if error-message != "": Rectangle {
                        height: 16px;
                    }

                    // Password input with toggle
                    PasswordInput {
                        placeholder: vault-exists ? "password" : "create password";
                        text <=> password-text;
                        enabled: !is-loading;
                        horizontal-stretch: 1;

                        accepted(text) => {
                            if (password-text != "") {
                                if (vault-exists) {
                                    root.handle-unlock();
                                } else {
                                    root.handle-create();
                                }
                            }
                        }
                    }

                    // Spacer
                    Rectangle {
                        height: 12px;
                    }

                    // Password hint for new vault
                    if !vault-exists: Text {
                        text: password-text.character-count < 8 ? "minimum 8 characters" : "";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 300;
                        horizontal-alignment: left;
                        opacity: password-text.character-count > 0 && password-text.character-count < 8 ? 1.0 : 0.0;

                        animate opacity { duration: 150ms; }
                    }

                    // Spacer
                    Rectangle {
                        height: 48px;
                    }

                    // Action button
                    TextButton {
                        text: vault-exists ? (is-loading ? "UNLOCKING..." : "UNLOCK VAULT") : (is-loading ? "CREATING..." : "CREATE VAULT");
                        enabled: password-text != "" && (!vault-exists ? password-text.character-count >= 8 : true) && !is-loading;

                        clicked => {
                            if (vault-exists) {
                                root.handle-unlock();
                            } else {
                                root.handle-create();
                            }
                        }
                    }
                }
            }
        }

        // Bottom spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer
        Rectangle {
            height: 60px;

            Text {
                text: "AES-256 encrypted";
                color: Palette.text-subtle;
                font-size: 10px;
                font-weight: 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Handler: Create new vault
    function handle-create() {
        error-message = "";

        if (password-text == "") {
            error-message = "Password required";
            return;
        }
        if (password-text.character-count < 8) {
            error-message = "Password too short";
            return;
        }
        is-loading = true;
        error-message = AuthAdapter.create-vault(password-text);

        if (error-message == "") {
            AppState.is-logged-in = true;
        }
        is-loading = false;
    }

    // Handler: Unlock existing vault
    function handle-unlock() {
        error-message = "";

        if (password-text == "") {
            error-message = "Password required";
            return;
        }
        is-loading = true;
        error-message = AuthAdapter.unlock-vault(password-text);

        if (error-message == "") {
            AppState.is-logged-in = true;
        }
        is-loading = false;
    }
}
