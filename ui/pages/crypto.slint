// ==================== Crypto Page ====================
// Noir Fintech - Premium Crypto Portfolio Management

import {
    CryptoAdapter,
    AppState,
} from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";
import {
    TickerItem,
    CryptoCard,
    GhostButton,
} from "../components/crypto_widgets.slint";
import {
    PortfolioDistributionChart,
    PortfolioTrendChart,
} from "../components/crypto_charts.slint";
import { TabButton } from "../components/buttons/tab_button.slint";
import { CryptoTaxTab } from "../components/crypto_tax.slint";
import { CryptoWalletsTab } from "../components/crypto_wallets_tab.slint";
import { CryptoPageOverlays } from "../components/crypto_page_overlays.slint";
import {
    ActionButton,
    CustomVScrollbar,
} from "../widgets.slint";

// ==================== Main Page ====================
export component CryptoPage inherits Rectangle {
    background: Theme.background;
    in-out property <string> active-tab: "portfolio";
    property <bool> show-delete-wallet-confirm: false;
    property <string> delete-wallet-id: "";
    property <string> delete-wallet-name: "";

    init => {
        CryptoAdapter.is-loading = true;
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
        CryptoAdapter.load-tax-settings();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== TICKER BAR ====================
        Rectangle {
            height: Theme.crypto-ticker-height;
            background: @linear-gradient(90deg, Theme.crypto-ticker-gradient-start 0%, Theme.crypto-ticker-gradient-mid 50%, Theme.crypto-ticker-gradient-end 100%);

            Rectangle {
                width: 100%;
                height: 3px;
                y: 0;
                background: @linear-gradient(90deg, transparent 0%, Theme.action-gradient-start 20%, Theme.action-gradient-end 80%, transparent 100%);
                opacity: 0.25;
            }

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;
                padding-right: Theme.crypto-ticker-settings-width;

                // FX Rate Badge
                Rectangle {
                    width: Theme.crypto-clp-badge-width;
                    background: Theme.surface;
                    border-radius: 0px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.success;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: CryptoAdapter.fx-rate-label;
                                color: Theme.text-muted;
                                font-size: 9px;
                                font-weight: 600;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: CryptoAdapter.clp-rate;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                    }

                    // Right separator
                    Rectangle {
                        width: 1px;
                        height: 32px;
                        background: Theme.border-subtle;
                        x: parent.width - 1px;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Ticker Scroll Area
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: transparent;

                    Flickable {
                        horizontal-stretch: 1;
                        height: parent.height;
                        viewport-width: (CryptoAdapter.market-tickers.length * Theme.crypto-ticker-width) + Theme.spacing-xl;
                        interactive: true;

                        HorizontalLayout {
                            padding-left: 16px;
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                icon: ticker.icon;
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }
            }

            // Settings Button (pinned to top-right)
            Rectangle {
                width: Theme.crypto-ticker-settings-width;
                height: parent.height;
                x: parent.width - self.width;
                y: 0;
                background: Theme.surface;

                Rectangle {
                    width: 1px;
                    height: 32px;
                    background: Theme.border-subtle;
                    x: 0;
                    y: (parent.height - self.height) / 2;
                }

                Rectangle {
                    width: Theme.spacing-xl;
                    height: Theme.spacing-xl;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: settings-touch.has-hover ? Theme.surface-hover : transparent;

                    Image {
                        source: @image-url("../assets/icons/settings.svg");
                        width: 16px;
                        height: 16px;
                        colorize: settings-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        animate colorize { duration: 150ms; }
                    }
                }

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.show-configure-ticker = true;
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        // ==================== HERO SECTION ====================
        Rectangle {
            height: Theme.crypto-hero-height;
            background: @linear-gradient(180deg, Theme.crypto-hero-gradient-start 0%, Theme.background 100%);

            HorizontalLayout {
                padding-left: Theme.spacing-3xl;
                padding-right: Theme.spacing-3xl;
                padding-top: Theme.spacing-xl;
                padding-bottom: Theme.spacing-lg;
                alignment: space-between;

                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;

                    // Header
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent-indigo 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: Translations.crypto-portfolio-title;
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }

                    }

                    VerticalLayout {
                        spacing: 6px;

                        // Total Value
                        Text {
                            text: CryptoAdapter.total-value;
                            color: Theme.text-primary;
                            font-size: 48px;
                            font-weight: 300;
                            letter-spacing: -1px;
                        }
                    }

                    // Subtitle Area
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: CryptoAdapter.portfolio.length > 0 ? CryptoAdapter.portfolio.length + " assets across " + CryptoAdapter.wallets.length + " wallets" : Translations.crypto-start-adding;
                            color: Theme.text-subtle;
                            font-size: 12px;
                            font-weight: 400;
                        }

                        if CryptoAdapter.limit-reached: Rectangle {
                            height: 20px;
                            background: Theme.danger.with-alpha(0.1);
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Image {
                                    source: @image-url("../assets/icons/info.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.danger;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: Translations.crypto-coin-limit;
                                    color: Theme.danger;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if CryptoAdapter.limit-excluded != "": Text {
                            text: Translations.crypto-skipped + ": " + CryptoAdapter.limit-excluded;
                            color: Theme.text-muted;
                            font-size: 10px;
                        }
                    }
                }

                // Right: Controls
                VerticalLayout {
                    alignment: center;
                    spacing: 20px;

                    // Tabs
                    Rectangle {
                        height: 44px;
                        background: Theme.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            alignment: end;

                            TabButton {
                                text: Translations.crypto-assets;
                                active: root.active-tab == "portfolio";
                                clicked => {
                                    root.active-tab = "portfolio";
                                }
                            }

                            TabButton {
                                text: Translations.crypto-wallets;
                                active: root.active-tab == "wallets";
                                clicked => {
                                    root.active-tab = "wallets";
                                }
                            }

                            TabButton {
                                text: Translations.crypto-tax-tab;
                                active: root.active-tab == "tax";
                                clicked => {
                                    root.active-tab = "tax";
                                }
                            }
                        }
                    }

                    // Action Button
                    HorizontalLayout {
                        alignment: end;

                        ActionButton {
                            text: root.active-tab == "portfolio" ? Translations.button-add-transaction-short : Translations.crypto-add-wallet-button;
                            primary: true;
                            clicked => {
                                if (root.active-tab == "portfolio") {
                                    AppState.show-add-crypto = true;
                                } else {
                                    AppState.show-add-wallet = true;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;

                        GhostButton {
                            text: CryptoAdapter.is-refreshing ? Translations.button-syncing : Translations.button-sync;
                            enabled: !CryptoAdapter.is-refreshing;
                            clicked => {
                                CryptoAdapter.refresh-prices();
                            }
                        }

                        GhostButton {
                            text: "?";
                            icon-mode: true;
                            enabled: true;
                            clicked => {
                                CryptoAdapter.show-last-updated-info();
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Theme.border-light 50%, transparent 100%);
        }

        if root.active-tab == "portfolio": Rectangle {
            height: 72px;
            background: Theme.background;

            HorizontalLayout {
                padding-left: Theme.spacing-3xl;
                padding-right: Theme.spacing-3xl;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                Rectangle {
                    property <bool> available: CryptoAdapter.total-pnl != "N/A";
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    background: available ? (CryptoAdapter.total-pnl-positive ? Theme.success.with-alpha(0.10) : Theme.danger.with-alpha(0.10)) : Theme.surface;
                    border-color: available ? (CryptoAdapter.total-pnl-positive ? Theme.success.with-alpha(0.2) : Theme.danger.with-alpha(0.2)) : Theme.border;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 0px;

                        Text {
                            text: Translations.crypto-unrealized;
                            color: Theme.text-subtle;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.total-pnl;
                            color: available ? (CryptoAdapter.total-pnl-positive ? Theme.success : Theme.danger) : Theme.text-muted;
                            font-size: 13px;
                            font-weight: 700;
                        }
                    }
                }

                Rectangle {
                    property <bool> available: CryptoAdapter.total-realized != "N/A";
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    background: available ? (CryptoAdapter.total-realized-positive ? Theme.success.with-alpha(0.10) : Theme.danger.with-alpha(0.10)) : Theme.surface;
                    border-color: available ? (CryptoAdapter.total-realized-positive ? Theme.success.with-alpha(0.2) : Theme.danger.with-alpha(0.2)) : Theme.border;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 0px;

                        Text {
                            text: Translations.crypto-realized-ytd;
                            color: Theme.text-subtle;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.total-realized;
                            color: available ? (CryptoAdapter.total-realized-positive ? Theme.success : Theme.danger) : Theme.text-muted;
                            font-size: 13px;
                            font-weight: 700;
                        }
                    }
                }

                Rectangle {
                    width: 140px;
                    border-radius: 8px;
                    border-width: 1px;
                    background: Theme.surface;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 0px;

                        Text {
                            text: Translations.crypto-roi;
                            color: Theme.text-subtle;
                            font-size: 9px;
                            font-weight: 600;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: CryptoAdapter.total-roi;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                        }
                    }
                }
            }
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: Theme.background;

            // TAB: PORTFOLIO
            if root.active-tab == "portfolio": portfolio-scroll := Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;
                property <length> cards-height: CryptoAdapter.portfolio.length > 4 ? Theme.crypto-card-grid-height : Theme.crypto-card-scroll-height;
                property <length> content-height: CryptoAdapter.portfolio.length > 0 ? cards-height + 820px : 520px;

                portfolio-content := VerticalLayout {
                    padding-left: Theme.spacing-3xl;
                    padding-right: Theme.spacing-3xl;
                    padding-bottom: Theme.spacing-xl;
                    spacing: 0px;
                    width: parent.width;
                    height: content-height;

                    Rectangle {
                        height: 12px;
                    }

                    // Empty State
                    if CryptoAdapter.portfolio.length == 0: Rectangle {
                        height: 360px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            Rectangle {
                                width: 80px;
                                height: 80px;
                                border-radius: 40px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                x: (parent.width - self.width) / 2;

                                Image {
                                    source: @image-url("../assets/icons/trending-up.svg");
                                    width: 32px;
                                    height: 32px;
                                    colorize: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            Text {
                                text: Translations.crypto-no-assets-yet;
                                color: Theme.text-secondary;
                                font-size: 16px;
                                font-weight: 400;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: Translations.crypto-create-wallet-first;
                                color: Theme.text-muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Portfolio Cards
                    if CryptoAdapter.portfolio.length > 0: VerticalLayout {
                        spacing: 24px;

                        // Section title
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 3px;
                                height: 18px;
                                border-radius: 2px;
                                background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent-indigo 100%);
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: Translations.crypto-your-holdings;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                        }

                        // Cards horizontal scroll
                        Flickable {
                            property <length> card-step: Theme.crypto-card-step;
                            property <length> row-step: Theme.crypto-card-row-step;
                            property <bool> two-rows: CryptoAdapter.portfolio.length > 4;
                            property <int> columns: two-rows ? ((CryptoAdapter.portfolio.length + 1) / 2) : CryptoAdapter.portfolio.length;

                            height: two-rows ? Theme.crypto-card-grid-height : Theme.crypto-card-scroll-height;
                            viewport-width: (columns * card-step);

                            if !two-rows: HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;

                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }

                            if two-rows: Rectangle {
                                width: columns * card-step;
                                height: Theme.crypto-card-grid-height;
                                background: transparent;

                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    x: Math.floor(index / 2) * card-step;
                                    y: Math.mod(index, 2) * row-step;
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;

                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }
                        }

                        PortfolioTrendChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-trend-ready;
                            image: CryptoAdapter.portfolio-trend-image;
                        }

                        PortfolioDistributionChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-chart-ready;
                            image: CryptoAdapter.portfolio-chart-image;
                            slices: CryptoAdapter.portfolio-distribution;
                        }
                    }

                    Rectangle {
                        height: 24px;
                    }
                }

                viewport-height: max(self.height, content-height);

                CustomVScrollbar {
                    x: parent.width - self.width - 6px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: content-height;
                    viewport-y: portfolio-scroll.viewport-y;
                }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": CryptoWalletsTab {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                delete-wallet-id <=> root.delete-wallet-id;
                delete-wallet-name <=> root.delete-wallet-name;
                show-delete-wallet-confirm <=> root.show-delete-wallet-confirm;
            }

            // TAB: TAX
            if root.active-tab == "tax": Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding-left: Theme.spacing-3xl;
                    padding-right: Theme.spacing-3xl;
                    padding-top: Theme.spacing-lg;
                    padding-bottom: Theme.spacing-xl;

                    CryptoTaxTab {
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }

    // ==================== DETAIL OVERLAY ====================

    CryptoPageOverlays {
        width: 100%;
        height: 100%;
        show-delete-wallet-confirm <=> root.show-delete-wallet-confirm;
        delete-wallet-id <=> root.delete-wallet-id;
        delete-wallet-name <=> root.delete-wallet-name;
    }
}
