// ==================== Crypto Page ====================
// Noir Minimalist - Crypto Portfolio & Wallets
// Refactored for "Sanctum Command" Architecture

import {
    Palette,
    CryptoAdapter,
    AppState
} from "../globals.slint";
import { CryptoRow, WalletRow, TickerItem, CryptoCard } from "../components/crypto_widgets.slint";
import { AssetDetailPanel } from "../components/asset_detail.slint";
import { TextButton, BorderButton } from "../widgets.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 100px;
    height: 32px;
    border-radius: 16px;
    background: active ? Palette.surface-hover : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-light : transparent;

    animate background { duration: 200ms; easing: ease-out; }
    animate border-color { duration: 200ms; easing: ease-out; }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component CryptoPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "portfolio"; // portfolio, wallets

    init => {
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== ZONA 1: TOP BAR (Ticker + Config) ====================
        Rectangle {
            height: 48px; // Fixed height
            background: Palette.surface;
            z: 10; // Ensure it stays on top if needed
            
            HorizontalLayout {
                spacing: 0px;

                // 1. CLP Rate (Fixed Width, Solid Background)
                Rectangle {
                    width: 140px; 
                    background: Palette.surface; // Solid background covers ticker
                    z: 2; // Above ticker

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        
                        Text { 
                            text: "USD/CLP"; 
                            color: Palette.text-muted; 
                            font-size: 10px; 
                            font-weight: 700; 
                            vertical-alignment: center; 
                        }
                        
                        Text { 
                            text: CryptoAdapter.clp-rate; 
                            color: Palette.text-primary; 
                            font-size: 11px; 
                            font-weight: 500; 
                            vertical-alignment: center; 
                        }
                    }
                    
                    // Separator
                    Rectangle { 
                        width: 1px; 
                        height: 24px; 
                        background: Palette.border-subtle; 
                        x: parent.width - 1px; 
                        y: 12px;
                    }
                }

                // 2. Ticker (Stretches)
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true; // CRITICAL: Prevent overflow text drawing
                    background: transparent;
                    z: 1;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: (CryptoAdapter.market-tickers.length * 200px); // Adjusted for wider items
                        interactive: true;
                        
                        HorizontalLayout {
                            padding-left: 16px;
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }

                // 3. Settings Button (Fixed Width)
                Rectangle {
                    width: 48px;
                    background: Palette.surface; // Solid background
                    z: 2;

                    // Left separator
                    Rectangle { 
                        width: 1px; 
                        height: 24px; 
                        background: Palette.border-subtle; 
                        x: 0; 
                        y: 12px;
                    }

                    Text {
                        text: "⚙";
                        color: settings-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 14px;
                        vertical-alignment: center; horizontal-alignment: center;
                        animate color { duration: 150ms; }
                    }

                    settings-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppState.active-page = "settings"; }
                    }
                }
            }
            
            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Palette.border-subtle;
            }
        }

        // ==================== ZONA 2: HERO & CONTROLS ====================
        Rectangle {
            height: 180px; // Taller for vertical layout
            background: Palette.background;
            
            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 32px;
                padding-bottom: 32px;
                alignment: space-between;
                
                // Left: Portfolio Value (Vertical Layout to avoid overlap)
                VerticalLayout {
                    alignment: center;
                    spacing: 12px; // Clear spacing
                    
                    // Row 1: Title + Refresh
                    HorizontalLayout {
                        spacing: 12px;
                        Text { 
                            text: "CRYPTO PORTFOLIO"; 
                            color: Palette.text-muted; 
                            font-size: 11px; 
                            font-weight: 600; 
                            letter-spacing: 3px; 
                            vertical-alignment: center;
                        }
                        
                        BorderButton {
                            text: "REFRESH";
                            clicked => { CryptoAdapter.refresh-prices(); }
                        }
                    }

                    // Row 2: Big Number
                    Text { 
                        text: CryptoAdapter.total-value; 
                        color: Palette.text-primary; 
                        font-size: 48px; 
                        font-weight: 300; 
                        letter-spacing: -1px; 
                    }
                    
                    // Row 3: Badge
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 24px;
                            width: 100px;
                            border-radius: 4px;
                            background: CryptoAdapter.total-pnl-positive ? Palette.success.with-alpha(0.1) : Palette.danger.with-alpha(0.1);
                            
                            Text { 
                                text: (CryptoAdapter.total-pnl-positive ? "▲ " : "▼ ") + CryptoAdapter.total-pnl; 
                                color: CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger; 
                                font-size: 11px; 
                                font-weight: 600;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Right: Controls
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;
                    
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        
                        TabButton {
                            text: "ASSETS";
                            active: root.active-tab == "portfolio";
                            clicked => { root.active-tab = "portfolio"; }
                        }

                        TabButton {
                            text: "WALLETS";
                            active: root.active-tab == "wallets";
                            clicked => { root.active-tab = "wallets"; }
                        }
                    }
                    
                    // Add Button aligned right
                    HorizontalLayout {
                        alignment: end;
                        TextButton {
                            text: root.active-tab == "portfolio" ? "+ ADD ASSET" : "+ ADD WALLET";
                            clicked => {
                                if (root.active-tab == "portfolio") {
                                    AppState.show-add-crypto = true;
                                } else {
                                    AppState.show-add-wallet = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==================== ZONA 3: LISTADO ====================
        Rectangle {
            vertical-stretch: 1;

            // TAB: PORTFOLIO (Card View)
            if root.active-tab == "portfolio": VerticalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-bottom: 24px;
                spacing: 0px;

                // Spacer
                Rectangle { height: 32px; }

                if CryptoAdapter.portfolio.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 16px;
                    Text { 
                        text: "No assets tracked"; 
                        color: Palette.text-muted; font-size: 16px; font-weight: 300;
                        horizontal-alignment: center; 
                    }
                }

                if CryptoAdapter.portfolio.length > 0: Flickable {
                    height: 180px; // Card height (160) + margins
                    viewport-width: (CryptoAdapter.portfolio.length * 236px); // 220px card + 16px spacing
                    
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        
                        for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                            name: asset.name;
                            symbol: asset.symbol;
                            price: asset.price;
                            amount: asset.amount;
                            value: asset.value;
                            change: asset.change-24h;
                            is-positive: asset.is-positive;
                            
                            clicked => {
                                CryptoAdapter.fetch-asset-details(asset.id);
                                CryptoAdapter.show-asset-detail = true;
                            }
                        }
                    }
                }
                
                // Flexible spacer
                Rectangle { vertical-stretch: 1; }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": VerticalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-bottom: 24px;
                spacing: 0px;

                // Headers
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        Text { width: 300px; text: "WALLET"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; }
                        Text { width: 100px; text: "ASSETS"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { width: 150px; text: "VALUE"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                        Rectangle { width: 32px; }
                    }
                }

                Rectangle { height: 8px; }

                if CryptoAdapter.wallets.length == 0: VerticalLayout {
                    alignment: center;
                    Text { 
                        text: "No wallets"; 
                        color: Palette.text-muted; font-size: 16px; font-weight: 300;
                        horizontal-alignment: center; 
                    }
                }

                if CryptoAdapter.wallets.length > 0: Flickable {
                    viewport-height: CryptoAdapter.wallets.length * 68px;
                    VerticalLayout {
                        spacing: 4px;
                        for wallet[index] in CryptoAdapter.wallets: Rectangle {
                            height: 64px;
                            background: Palette.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            
                            WalletRow {
                                name: wallet.name;
                                category: wallet.category;
                                balance: wallet.balance;
                                count: wallet.asset-count;
                                id: wallet.id;
                                is-last: false;
                                delete => {
                                    CryptoAdapter.delete-wallet(wallet.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // DETAIL OVERLAY
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { background: #00000090; animate background { duration: 200ms; } }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { clicked => { CryptoAdapter.show-asset-detail = false; } }
            }

            AssetDetailPanel {
                height: parent.height;
            }
        }
    }
}