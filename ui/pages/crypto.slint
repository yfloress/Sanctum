// ==================== Crypto Page ====================
// Noir Fintech - Premium Crypto Portfolio Management

import {
    Palette,
    CryptoAdapter,
    AppState,
    NotificationAdapter
} from "../globals.slint";
import { CryptoRow, WalletRow, TickerItem, CryptoCard, GhostButton } from "../components/crypto_widgets.slint";
import { AssetDetailPanel } from "../components/asset_detail.slint";
import { WalletDetailPanel } from "../components/wallet_detail.slint";
import { PortfolioDistributionChart, PortfolioTrendChart } from "../components/crypto_charts.slint";
import { TabButton } from "../components/buttons/tab_button.slint";
import { TextButton, BorderButton, ActionButton, CustomVScrollbar } from "../widgets.slint";

// ==================== Main Page ====================
export component CryptoPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "portfolio";
    property <bool> show-delete-wallet-confirm: false;
    property <string> delete-wallet-id: "";
    property <string> delete-wallet-name: "";

    init => {
        CryptoAdapter.is-loading = true;
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== TICKER BAR ====================
        Rectangle {
            height: Palette.crypto-ticker-height;
            background: @linear-gradient(
                90deg,
                Palette.crypto-ticker-gradient-start 0%,
                Palette.crypto-ticker-gradient-mid 50%,
                Palette.crypto-ticker-gradient-end 100%
            );
            
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;
                padding-right: Palette.crypto-ticker-settings-width;

                // CLP Rate Badge
                Rectangle {
                    width: Palette.crypto-clp-badge-width;
                    background: Palette.surface;
                    border-radius: 0px;
                    
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;
                        }
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { 
                                text: "USD/CLP"; 
                                color: Palette.text-muted; 
                                font-size: 9px; 
                                font-weight: 600;
                                letter-spacing: 1px;
                            }
                            Text { 
                                text: CryptoAdapter.clp-rate; 
                                color: Palette.text-primary; 
                                font-size: 12px; 
                                font-weight: 600;
                            }
                        }
                    }
                    
                    // Right separator
                    Rectangle { 
                        width: 1px; 
                        height: 32px; 
                        background: Palette.border-subtle; 
                        x: parent.width - 1px; 
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Ticker Scroll Area
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: transparent;

                    Flickable {
                        horizontal-stretch: 1;
                        height: parent.height;
                        viewport-width: (CryptoAdapter.market-tickers.length * Palette.crypto-ticker-width) + Palette.spacing-xl;
                        interactive: true;
                        
                        HorizontalLayout {
                            padding-left: 16px;
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                icon: ticker.icon;
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }
            }

            // Settings Button (pinned to top-right)
            Rectangle {
                width: Palette.crypto-ticker-settings-width;
                height: parent.height;
                x: parent.width - self.width;
                y: 0;
                background: Palette.surface;
                
                Rectangle { 
                    width: 1px; 
                    height: 32px; 
                    background: Palette.border-subtle; 
                    x: 0; 
                    y: (parent.height - self.height) / 2;
                }

                Rectangle {
                    width: Palette.spacing-xl;
                    height: Palette.spacing-xl;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: settings-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text {
                        text: "⚙";
                        color: settings-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 16px;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                        animate color { duration: 150ms; }
                    }
                }

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppState.show-configure-ticker = true; }
                }
            }
            
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== HERO SECTION ====================
        Rectangle {
            height: Palette.crypto-hero-height;
            background: @linear-gradient(180deg, Palette.crypto-hero-gradient-start 0%, Palette.background 100%);
            
            HorizontalLayout {
                padding-left: Palette.spacing-3xl;
                padding-right: Palette.spacing-3xl;
                padding-top: Palette.spacing-xl;
                padding-bottom: Palette.spacing-lg;
                alignment: space-between;
                
                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;
                    
                    // Header
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 3px;
                            height: 18px;
                            border-radius: 2px;
                            background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
                            y: (parent.height - self.height) / 2;
                        }

                        Text { 
                            text: "CRYPTO PORTFOLIO"; 
                            color: Palette.text-muted; 
                            font-size: 11px; 
                            font-weight: 600; 
                            letter-spacing: 3px; 
                            vertical-alignment: center;
                        }
                        
                        GhostButton {
                            text: CryptoAdapter.is-refreshing ? "SYNCING..." : "↻ SYNC";
                            enabled: !CryptoAdapter.is-refreshing;
                            clicked => { CryptoAdapter.refresh-prices(); }
                        }

                        Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;

                                Text {
                                    text: "Last updated: " + CryptoAdapter.last-updated;
                                    color: Palette.text-subtle;
                                    font-size: 10px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        // Total Value
                        Text {
                            text: CryptoAdapter.total-value;
                            color: Palette.text-primary;
                            font-size: 48px;
                            font-weight: 300;
                            letter-spacing: -1px;
                        }

                        // PnL Badge
                        Rectangle {
                            property <bool> pnl_available: CryptoAdapter.total-pnl != "N/A";

                            height: 28px;
                            min-width: 90px;
                            border-radius: 6px;
                            background: pnl_available
                                ? (CryptoAdapter.total-pnl-positive ?
                                    Palette.success.with-alpha(0.12) :
                                    Palette.danger.with-alpha(0.12))
                                : Palette.surface;
                            border-width: 1px;
                            border-color: pnl_available
                                ? (CryptoAdapter.total-pnl-positive ?
                                    Palette.success.with-alpha(0.2) :
                                    Palette.danger.with-alpha(0.2))
                                : Palette.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: pnl_available ? (CryptoAdapter.total-pnl-positive ? "▲" : "▼") : "•";
                                    color: pnl_available
                                        ? (CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger)
                                        : Palette.text-muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: CryptoAdapter.total-pnl;
                                    color: pnl_available
                                        ? (CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger)
                                        : Palette.text-muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    
                    // Subtitle Area
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: CryptoAdapter.portfolio.length > 0 ? 
                                CryptoAdapter.portfolio.length + " assets across " + CryptoAdapter.wallets.length + " wallets" :
                                "Start by adding a wallet and your first asset";
                            color: Palette.text-subtle;
                            font-size: 12px;
                            font-weight: 400;
                        }

                        if CryptoAdapter.limit-reached: Rectangle {
                            height: 20px;
                            background: Palette.danger.with-alpha(0.1);
                            border-radius: 4px;
                            
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: "⚠"; color: Palette.danger; font-size: 10px; vertical-alignment: center; }
                                Text { 
                                    text: "Coin limit reached (50). Some assets may not update."; 
                                    color: Palette.danger; 
                                    font-size: 10px; 
                                    font-weight: 600;
                                    vertical-alignment: center; 
                                }
                            }
                        }

                        if CryptoAdapter.limit-excluded != "": Text {
                            text: "Skipped: " + CryptoAdapter.limit-excluded;
                            color: Palette.text-muted;
                            font-size: 10px;
                        }
                    }
                }

                // Right: Controls
                VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    
                    // Tabs
                    Rectangle {
                        height: 44px;
                        background: Palette.surface;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Palette.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            alignment: end;

                            TabButton {
                                text: "ASSETS";
                                active: root.active-tab == "portfolio";
                                clicked => { root.active-tab = "portfolio"; }
                            }

                            TabButton {
                                text: "WALLETS";
                                active: root.active-tab == "wallets";
                                clicked => { root.active-tab = "wallets"; }
                            }
                        }
                    }
                    
                    // Action Button
                    HorizontalLayout {
                        alignment: end;
                        
                        ActionButton {
                            text: root.active-tab == "portfolio" ? "+ ADD TRANSACTION" : "+ NEW WALLET";
                            primary: true;
                            clicked => {
                                if (root.active-tab == "portfolio") {
                                    AppState.show-add-crypto = true;
                                } else {
                                    AppState.show-add-wallet = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Gradient divider
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, Palette.border-light 50%, transparent 100%);
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: Palette.background;

            // TAB: PORTFOLIO
            if root.active-tab == "portfolio": portfolio-scroll := Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;
                property <length> cards-height: CryptoAdapter.portfolio.length > 4
                    ? Palette.crypto-card-grid-height
                    : Palette.crypto-card-scroll-height;
                property <length> content-height: CryptoAdapter.portfolio.length > 0
                    ? cards-height + 820px
                    : 520px;

                portfolio-content := VerticalLayout {
                    padding-left: Palette.spacing-3xl;
                    padding-right: Palette.spacing-3xl;
                    padding-bottom: Palette.spacing-xl;
                    spacing: 0px;
                    width: parent.width;
                    height: content-height;

                    Rectangle { height: 12px; }

                    // Empty State
                    if CryptoAdapter.portfolio.length == 0: Rectangle {
                        height: 360px;
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;
                            
                            Rectangle {
                                width: 80px;
                                height: 80px;
                                border-radius: 40px;
                                background: Palette.surface;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                x: (parent.width - self.width) / 2;
                                
                                Text {
                                    text: "📈";
                                    font-size: 32px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                            
                            Text { 
                                text: "No assets tracked yet"; 
                                color: Palette.text-secondary; 
                                font-size: 16px; 
                                font-weight: 400;
                                horizontal-alignment: center; 
                            }
                            
                            Text { 
                                text: "Create a wallet first, then add your crypto holdings"; 
                                color: Palette.text-muted; 
                                font-size: 13px;
                                horizontal-alignment: center; 
                            }
                        }
                    }

                    // Portfolio Cards
                    if CryptoAdapter.portfolio.length > 0: VerticalLayout {
                        spacing: 24px;
                        
                        // Section title
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 3px;
                                height: 18px;
                                border-radius: 2px;
                                background: @linear-gradient(180deg, Palette.accent 0%, #6366f1 100%);
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "YOUR HOLDINGS";
                                color: Palette.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                        }
                        
                        // Cards horizontal scroll
                        Flickable {
                            property <length> card-step: Palette.crypto-card-step;
                            property <length> row-step: Palette.crypto-card-row-step;
                            property <bool> two-rows: CryptoAdapter.portfolio.length > 4;
                            property <int> columns: two-rows 
                                ? ((CryptoAdapter.portfolio.length + 1) / 2) 
                                : CryptoAdapter.portfolio.length;

                            height: two-rows ? Palette.crypto-card-grid-height : Palette.crypto-card-scroll-height;
                            viewport-width: (columns * card-step);
                            
                            if !two-rows: HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                
                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;
                                    
                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }

                            if two-rows: Rectangle {
                                width: columns * card-step;
                                height: Palette.crypto-card-grid-height;
                                background: transparent;
                                
                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    x: Math.floor(index / 2) * card-step;
                                    y: Math.mod(index, 2) * row-step;
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;
                                    
                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }
                        }

                        PortfolioTrendChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-trend-ready;
                            image: CryptoAdapter.portfolio-trend-image;
                        }

                        PortfolioDistributionChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-chart-ready;
                            image: CryptoAdapter.portfolio-chart-image;
                            slices: CryptoAdapter.portfolio-distribution;
                        }
                    }
                    
                    Rectangle { height: 24px; }
                }

                viewport-height: max(self.height, content-height);

                CustomVScrollbar {
                    x: parent.width - self.width - 6px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: content-height;
                    viewport-y: portfolio-scroll.viewport-y;
                }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": VerticalLayout {
                padding-left: Palette.spacing-3xl;
                padding-right: Palette.spacing-3xl;
                padding-bottom: Palette.spacing-xl;
                spacing: 0px;

                // Headers
                Rectangle {
                    height: 48px;
                    
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        
                        Text { 
                            width: Palette.wallet-info-width; 
                            text: "WALLET"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                        }
                        Text { 
                            width: 100px; 
                            text: "ASSETS"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                            horizontal-alignment: center; 
                        }
                        Text { 
                            width: 150px; 
                            text: "VALUE"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                            horizontal-alignment: right; 
                        }
                        Rectangle { width: 40px; }
                    }
                    
                    // Bottom border
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: 100%;
                        background: Palette.border-subtle;
                    }
                }

                // Empty State
                if CryptoAdapter.wallets.length == 0: Rectangle {
                    vertical-stretch: 1;
                    
                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        
                        Rectangle {
                            width: 80px;
                            height: 80px;
                            border-radius: 40px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            x: (parent.width - self.width) / 2;
                            
                            Text {
                                text: "💼";
                                font-size: 32px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        
                        Text { 
                            text: "No wallets created"; 
                            color: Palette.text-secondary; 
                            font-size: 16px; 
                            font-weight: 400;
                            horizontal-alignment: center; 
                        }
                        
                        Text { 
                            text: "Add your first wallet to start tracking your crypto"; 
                            color: Palette.text-muted; 
                            font-size: 13px;
                            horizontal-alignment: center; 
                        }
                    }
                }

                // Wallets List
                if CryptoAdapter.wallets.length > 0: Flickable {
                    vertical-stretch: 1;
                    viewport-height: CryptoAdapter.wallets.length * 80px;
                    
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 8px;
                        
                        for wallet[index] in CryptoAdapter.wallets: Rectangle {
                            height: 72px;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            
                                WalletRow {
                                    name: wallet.name;
                                    category: wallet.category;
                                    balance: wallet.balance;
                                    count: wallet.asset-count;
                                    id: wallet.id;
                                    is-last: index == CryptoAdapter.wallets.length - 1;
                                    delete => {
                                        root.delete-wallet-id = wallet.id;
                                        root.delete-wallet-name = wallet.name;
                                        root.show-delete-wallet-confirm = true;
                                    }
                                    clicked => {
                                        CryptoAdapter.fetch-wallet-details(wallet.id);
                                        CryptoAdapter.show-wallet-detail = true;
                                    }
                                }
                            }
                        }
                    }
                }
        }
    }
    
    // ==================== DETAIL OVERLAY ====================
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { 
            background: Palette.overlay-bg-strong;
            
            animate background { duration: 200ms; } 
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { CryptoAdapter.show-asset-detail = false; } 
                }
            }

            AssetDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== WALLET DETAIL OVERLAY ====================
    if CryptoAdapter.show-wallet-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { 
            background: Palette.overlay-bg-strong;
            
            animate background { duration: 200ms; } 
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { CryptoAdapter.show-wallet-detail = false; } 
                }
            }

            WalletDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== DELETE WALLET CONFIRM ====================
    if root.show-delete-wallet-confirm: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        z: 1200;

        Rectangle {
            background: Palette.overlay-bg-strong;
            TouchArea {
                clicked => {
                    root.show-delete-wallet-confirm = false;
                    root.delete-wallet-id = "";
                    root.delete-wallet-name = "";
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Palette.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Delete Wallet?";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "This will permanently delete \"" + root.delete-wallet-name + "\" and all its transaction history.";
                    color: Palette.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Palette.surface-hover : Palette.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.border;

                        Text {
                            text: "Cancel";
                            color: Palette.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-wallet-confirm = false;
                                root.delete-wallet-id = "";
                                root.delete-wallet-name = "";
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Palette.delete-bg-active : Palette.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.delete-border;

                        Text {
                            text: "Delete";
                            color: Palette.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let result = CryptoAdapter.delete-wallet(root.delete-wallet-id);
                                if (result == "") {
                                    root.show-delete-wallet-confirm = false;
                                    root.delete-wallet-id = "";
                                    root.delete-wallet-name = "";
                                } else {
                                    NotificationAdapter.show(result, true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== LOADING OVERLAY ====================
    if CryptoAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background.with-alpha(0.95);
        z: 999;
        opacity: 1.0;

        animate opacity { duration: 200ms; easing: ease-out; }

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Palette.surface;
                border-width: 3px;
                border-color: Palette.accent;

                animate border-color {
                    duration: 1s;
                    iteration-count: -1;
                    easing: ease-in-out;
                }

                Text {
                    text: "💰";
                    font-size: 28px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "Loading portfolio...";
                color: Palette.text-secondary;
                font-size: 14px;
                font-weight: 500;
            }
        }
    }

    // ==================== SYNCING OVERLAY ====================
    if CryptoAdapter.is-refreshing && !CryptoAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.overlay-bg-soft;
        z: 998;
        opacity: 1.0;

        animate opacity { duration: 150ms; easing: ease-out; }

        Rectangle {
            width: 300px;
            height: 100px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Palette.shadow-color;
            opacity: 1.0;

            animate opacity { duration: 200ms; easing: ease-out; }

            HorizontalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: center;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Palette.accent.with-alpha(0.1);
                    border-width: 2px;
                    border-color: Palette.accent;

                    animate border-color {
                        duration: 1.5s;
                        iteration-count: -1;
                        easing: ease-in-out;
                    }

                    Text {
                        text: "↻";
                        color: Palette.accent;
                        font-size: 20px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Syncing prices...";
                        color: Palette.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    Text {
                        text: "This may take a few seconds";
                        color: Palette.text-muted;
                        font-size: 10px;
                    }
                }
            }
        }
    }
}
