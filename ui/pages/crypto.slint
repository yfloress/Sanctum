// ==================== Crypto Page ====================
// Noir Minimalist - Crypto Portfolio & Wallets
// Refactored for "Sanctum Command" Architecture

import {
    Palette,
    CryptoAdapter,
    AppState
} from "../globals.slint";
import { CryptoRow, WalletRow, TickerItem } from "../components/crypto_widgets.slint";
import { AssetDetailPanel } from "../components/asset_detail.slint";
import { TextButton } from "../widgets.slint";

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 100px;
    height: 32px;
    border-radius: 16px;
    background: active ? Palette.surface-hover : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-light : transparent;

    animate background { duration: 200ms; easing: ease-out; }
    animate border-color { duration: 200ms; easing: ease-out; }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component CryptoPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "portfolio"; // portfolio, wallets

    init => {
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== ZONA 1: MARKET TICKER ====================
        Rectangle {
            height: 40px;
            background: Palette.surface;
            
            HorizontalLayout {
                // Exchange Rate Badge
                Rectangle {
                    width: 120px;
                    background: transparent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        
                        Text { 
                            text: "USD/CLP"; 
                            color: Palette.text-muted; 
                            font-size: 10px; 
                            font-weight: 700; 
                            vertical-alignment: center; 
                        }
                        
                        Text { 
                            text: CryptoAdapter.clp-rate; 
                            color: Palette.text-primary; 
                            font-size: 11px; 
                            font-weight: 500; 
                            vertical-alignment: center; 
                        }
                    }
                    
                    // Separator
                    Rectangle { 
                        width: 1px; 
                        height: 16px; 
                        background: Palette.border-subtle; 
                        x: parent.width - 1px; 
                        y: 12px;
                    }
                }

                // Ticker Deslizante
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    clip: true;

                    Flickable {
                        horizontal-stretch: 1;
                        height: parent.height;
                        viewport-width: (CryptoAdapter.market-tickers.length * 160px);
                        interactive: true;
                        
                        HorizontalLayout {
                            padding-left: 16px;
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }
            }
            
            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Palette.border-subtle;
            }
        }

        // ==================== ZONA 2: SUMMARY & CONTROLS ====================
        Rectangle {
            height: 160px;
            background: Palette.background;
            
            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 32px;
                padding-bottom: 32px;
                alignment: space-between;
                
                // Left: Portfolio Value
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    
                    HorizontalLayout {
                        spacing: 8px;
                        Text { 
                            text: "CRYPTO PORTFOLIO"; 
                            color: Palette.text-muted; 
                            font-size: 11px; 
                            font-weight: 600; 
                            letter-spacing: 3px; 
                            vertical-alignment: center;
                        }
                        
                        // Refrescar
                        Rectangle {
                            height: 16px; width: 16px;
                            Text {
                                text: "↻";
                                color: refresh-touch.has-hover ? Palette.accent : Palette.text-muted;
                                font-size: 12px;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                            refresh-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { CryptoAdapter.refresh-prices(); }
                            }
                        }
                    }

                    Text { 
                        text: CryptoAdapter.total-value; 
                        color: Palette.text-primary; 
                        font-size: 48px; 
                        font-weight: 300; 
                        letter-spacing: -1px; 
                    }
                    
                    HorizontalLayout {
                        spacing: 8px;
                        Text { 
                            text: CryptoAdapter.total-pnl-positive ? "▲" : "▼";
                            color: CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Text { 
                            text: CryptoAdapter.total-pnl + " (24h)"; 
                            color: CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger; 
                            font-size: 12px; 
                            font-weight: 500;
                            vertical-alignment: center; 
                        }
                    }
                }

                // Right: Controls
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;
                    
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        
                        TabButton {
                            text: "ASSETS";
                            active: root.active-tab == "portfolio";
                            clicked => { root.active-tab = "portfolio"; }
                        }

                        TabButton {
                            text: "WALLETS";
                            active: root.active-tab == "wallets";
                            clicked => { root.active-tab = "wallets"; }
                        }
                    }
                    
                    // Add Button aligned right
                    HorizontalLayout {
                        alignment: end;
                        TextButton {
                            text: root.active-tab == "portfolio" ? "+ ADD ASSET" : "+ ADD WALLET";
                            clicked => {
                                if (root.active-tab == "portfolio") {
                                    AppState.show-add-crypto = true;
                                } else {
                                    AppState.show-add-wallet = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==================== ZONA 3: LISTADO ====================
        Rectangle {
            vertical-stretch: 1;

            // TAB: PORTFOLIO
            if root.active-tab == "portfolio": VerticalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-bottom: 24px;
                spacing: 0px;

                // Headers
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        Text { width: 240px; text: "ASSET"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; }
                        Text { width: 140px; text: "PRICE"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                        Text { width: 140px; text: "HOLDINGS"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                        Text { width: 140px; text: "VALUE"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                        Rectangle { width: 20px; }
                        Text { width: 100px; text: "24H CHANGE"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: center; }
                    }
                }
                
                Rectangle { height: 8px; }

                if CryptoAdapter.portfolio.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 16px;
                    Text { 
                        text: "No assets tracked"; 
                        color: Palette.text-muted; font-size: 16px; font-weight: 300;
                        horizontal-alignment: center; 
                    }
                }

                if CryptoAdapter.portfolio.length > 0: Flickable {
                    viewport-height: CryptoAdapter.portfolio.length * 60px;
                    
                    VerticalLayout {
                        spacing: 4px;
                        for asset[index] in CryptoAdapter.portfolio: Rectangle {
                            height: 56px;
                            background: Palette.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            
                            CryptoRow {
                                name: asset.name;
                                symbol: asset.symbol;
                                price: asset.price;
                                amount: asset.amount;
                                value: asset.value;
                                change: asset.change-24h;
                                is-positive: asset.is-positive;
                                is-last: false;
                                clicked => {
                                    CryptoAdapter.fetch-asset-details(asset.id);
                                    CryptoAdapter.show-asset-detail = true;
                                }
                            }
                        }
                    }
                }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": VerticalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-bottom: 24px;
                spacing: 0px;

                // Headers
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        Text { width: 300px; text: "WALLET"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; }
                        Text { width: 100px; text: "ASSETS"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: center; }
                        Text { width: 150px; text: "VALUE"; color: Palette.text-subtle; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                        Rectangle { width: 32px; }
                    }
                }

                Rectangle { height: 8px; }

                if CryptoAdapter.wallets.length == 0: VerticalLayout {
                    alignment: center;
                    Text { 
                        text: "No wallets"; 
                        color: Palette.text-muted; font-size: 16px; font-weight: 300;
                        horizontal-alignment: center; 
                    }
                }

                if CryptoAdapter.wallets.length > 0: Flickable {
                    viewport-height: CryptoAdapter.wallets.length * 68px;
                    VerticalLayout {
                        spacing: 4px;
                        for wallet[index] in CryptoAdapter.wallets: Rectangle {
                            height: 64px;
                            background: Palette.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            
                            WalletRow {
                                name: wallet.name;
                                category: wallet.category;
                                balance: wallet.balance;
                                count: wallet.asset-count;
                                id: wallet.id;
                                is-last: false;
                                delete => {
                                    CryptoAdapter.delete-wallet(wallet.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // DETAIL OVERLAY
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: #000000cc;

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { clicked => { CryptoAdapter.show-asset-detail = false; } }
            }

            AssetDetailPanel {
                height: parent.height;
            }
        }
    }
}