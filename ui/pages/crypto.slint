// ==================== Crypto Page ====================
// Noir Fintech - Premium Crypto Portfolio Management

import {
    Palette,
    CryptoAdapter,
    AppState
} from "../globals.slint";
import { CryptoRow, WalletRow, TickerItem, CryptoCard, GhostButton } from "../components/crypto_widgets.slint";
import { AssetDetailPanel } from "../components/asset_detail.slint";
import { WalletDetailPanel } from "../components/wallet_detail.slint";
import { PortfolioDistributionChart, PortfolioTrendChart } from "../components/crypto_charts.slint";
import { TextButton, BorderButton, ActionButton, CustomVScrollbar } from "../widgets.slint";

// ==================== Tab Button ====================
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 110px;
    height: 36px;
    border-radius: 8px;
    background: active ? Palette.surface : transparent;
    border-width: 1px;
    border-color: active ? Palette.border-subtle : transparent;

    animate background { duration: 200ms; easing: ease-out; }
    animate border-color { duration: 200ms; easing: ease-out; }

    Text {
        text: root.text;
        color: active ? Palette.text-primary : Palette.text-muted;
        font-size: 11px;
        font-weight: active ? 600 : 500;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }

    TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

// ==================== Main Page ====================
export component CryptoPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "portfolio";

    init => {
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== TICKER BAR ====================
        Rectangle {
            height: 52px;
            background: @linear-gradient(90deg, #0a0a0f 0%, #0d0d14 50%, #0a0a0f 100%);
            
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;
                padding-right: 52px;

                // CLP Rate Badge
                Rectangle {
                    width: 150px;
                    background: Palette.surface;
                    border-radius: 0px;
                    
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;
                        }
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { 
                                text: "USD/CLP"; 
                                color: Palette.text-muted; 
                                font-size: 9px; 
                                font-weight: 600;
                                letter-spacing: 1px;
                            }
                            Text { 
                                text: CryptoAdapter.clp-rate; 
                                color: Palette.text-primary; 
                                font-size: 12px; 
                                font-weight: 600;
                            }
                        }
                    }
                    
                    // Right separator
                    Rectangle { 
                        width: 1px; 
                        height: 32px; 
                        background: Palette.border-subtle; 
                        x: parent.width - 1px; 
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Ticker Scroll Area
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: transparent;

                    Flickable {
                        horizontal-stretch: 1;
                        height: parent.height;
                        viewport-width: (CryptoAdapter.market-tickers.length * 180px) + 32px;
                        interactive: true;
                        
                        HorizontalLayout {
                            padding-left: 16px;
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                icon: ticker.icon;
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }
            }

            // Settings Button (pinned to top-right)
            Rectangle {
                width: 52px;
                height: parent.height;
                x: parent.width - self.width;
                y: 0;
                background: Palette.surface;
                
                Rectangle { 
                    width: 1px; 
                    height: 32px; 
                    background: Palette.border-subtle; 
                    x: 0; 
                    y: (parent.height - self.height) / 2;
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: settings-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text {
                        text: "⚙";
                        color: settings-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 16px;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                        animate color { duration: 150ms; }
                    }
                }

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppState.show-configure-ticker = true; }
                }
            }
            
            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Palette.border-subtle;
            }
        }

        // ==================== HERO SECTION ====================
        Rectangle {
            height: 200px;
            background: @linear-gradient(180deg, #080810 0%, Palette.background 100%);
            
            HorizontalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-top: 32px;
                padding-bottom: 24px;
                alignment: space-between;
                
                // Left: Portfolio Value
                VerticalLayout {
                    alignment: start;
                    spacing: 16px;
                    
                    // Header
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        
                        Text { 
                            text: "CRYPTO PORTFOLIO"; 
                            color: Palette.text-muted; 
                            font-size: 11px; 
                            font-weight: 600; 
                            letter-spacing: 3px; 
                            vertical-alignment: center;
                        }
                        
                        GhostButton {
                            text: "↻ SYNC";
                            clicked => { CryptoAdapter.refresh-prices(); }
                        }

                        Text { 
                            text: "Last updated: " + CryptoAdapter.last-updated; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            vertical-alignment: center;
                        }
                    }

                    // Total Value
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        
                        Text { 
                            text: CryptoAdapter.total-value; 
                            color: Palette.text-primary; 
                            font-size: 48px; 
                            font-weight: 300; 
                            letter-spacing: -1px;
                            vertical-alignment: bottom;
                        }
                        
                        // PnL Badge
                        Rectangle {
                            property <bool> pnl_available: CryptoAdapter.total-pnl != "N/A";

                            y: (parent.height - self.height) / 2 + 8px;
                            height: 28px;
                            width: 110px;
                            border-radius: 6px;
                            background: pnl_available
                                ? (CryptoAdapter.total-pnl-positive ?
                                    Palette.success.with-alpha(0.12) :
                                    Palette.danger.with-alpha(0.12))
                                : Palette.surface;
                            border-width: 1px;
                            border-color: pnl_available
                                ? (CryptoAdapter.total-pnl-positive ?
                                    Palette.success.with-alpha(0.2) :
                                    Palette.danger.with-alpha(0.2))
                                : Palette.border;
                            
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                
                                Text { 
                                    text: pnl_available ? (CryptoAdapter.total-pnl-positive ? "▲" : "▼") : "•"; 
                                    color: pnl_available
                                        ? (CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger)
                                        : Palette.text-muted; 
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text { 
                                    text: CryptoAdapter.total-pnl; 
                                    color: pnl_available
                                        ? (CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger)
                                        : Palette.text-muted; 
                                    font-size: 12px; 
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    
                    // Subtitle Area
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: CryptoAdapter.portfolio.length > 0 ? 
                                CryptoAdapter.portfolio.length + " assets across " + CryptoAdapter.wallets.length + " wallets" :
                                "Start by adding a wallet and your first asset";
                            color: Palette.text-subtle;
                            font-size: 12px;
                            font-weight: 400;
                        }

                        if CryptoAdapter.limit-reached: Rectangle {
                            height: 20px;
                            background: Palette.danger.with-alpha(0.1);
                            border-radius: 4px;
                            
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text { text: "⚠"; color: Palette.danger; font-size: 10px; vertical-alignment: center; }
                                Text { 
                                    text: "Coin limit reached (50). Some assets may not update."; 
                                    color: Palette.danger; 
                                    font-size: 10px; 
                                    font-weight: 600;
                                    vertical-alignment: center; 
                                }
                            }
                        }

                        if CryptoAdapter.limit-excluded != "": Text {
                            text: "Skipped: " + CryptoAdapter.limit-excluded;
                            color: Palette.text-muted;
                            font-size: 10px;
                        }
                    }
                }

                // Right: Controls
                VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    
                    // Tabs
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        
                        TabButton {
                            text: "ASSETS";
                            active: root.active-tab == "portfolio";
                            clicked => { root.active-tab = "portfolio"; }
                        }

                        TabButton {
                            text: "WALLETS";
                            active: root.active-tab == "wallets";
                            clicked => { root.active-tab = "wallets"; }
                        }
                    }
                    
                    // Action Button
                    HorizontalLayout {
                        alignment: end;
                        
                        ActionButton {
                            text: root.active-tab == "portfolio" ? "+ ADD TRANSACTION" : "+ NEW WALLET";
                            primary: true;
                            clicked => {
                                if (root.active-tab == "portfolio") {
                                    AppState.show-add-crypto = true;
                                } else {
                                    AppState.show-add-wallet = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==================== CONTENT AREA ====================
        Rectangle {
            vertical-stretch: 1;
            background: Palette.background;

            // TAB: PORTFOLIO
            if root.active-tab == "portfolio": portfolio-scroll := Flickable {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;
                property <length> cards-height: CryptoAdapter.portfolio.length > 4 ? 388px : 200px;
                property <length> content-height: CryptoAdapter.portfolio.length > 0
                    ? cards-height + 820px
                    : 520px;

                portfolio-content := VerticalLayout {
                    padding-left: 64px;
                    padding-right: 64px;
                    padding-bottom: 32px;
                    spacing: 0px;
                    width: parent.width;
                    height: content-height;

                    Rectangle { height: 12px; }

                    // Empty State
                    if CryptoAdapter.portfolio.length == 0: Rectangle {
                        height: 360px;
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;
                            
                            Rectangle {
                                width: 80px;
                                height: 80px;
                                border-radius: 40px;
                                background: Palette.surface;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                x: (parent.width - self.width) / 2;
                                
                                Text {
                                    text: "📈";
                                    font-size: 32px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                            
                            Text { 
                                text: "No assets tracked yet"; 
                                color: Palette.text-secondary; 
                                font-size: 16px; 
                                font-weight: 400;
                                horizontal-alignment: center; 
                            }
                            
                            Text { 
                                text: "Create a wallet first, then add your crypto holdings"; 
                                color: Palette.text-muted; 
                                font-size: 13px;
                                horizontal-alignment: center; 
                            }
                        }
                    }

                    // Portfolio Cards
                    if CryptoAdapter.portfolio.length > 0: VerticalLayout {
                        spacing: 24px;
                        
                        // Section title
                        Text {
                            text: "YOUR HOLDINGS";
                            color: Palette.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 2px;
                        }
                        
                        // Cards horizontal scroll
                        Flickable {
                            property <bool> two-rows: CryptoAdapter.portfolio.length > 4;
                            property <int> columns: two-rows 
                                ? ((CryptoAdapter.portfolio.length + 1) / 2) 
                                : CryptoAdapter.portfolio.length;

                            height: two-rows ? 388px : 200px;
                            viewport-width: (columns * 256px);
                            
                            if !two-rows: HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                
                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;
                                    
                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }

                            if two-rows: Rectangle {
                                width: columns * 256px;
                                height: 388px;
                                background: transparent;
                                
                                for asset[index] in CryptoAdapter.portfolio: CryptoCard {
                                    x: Math.floor(index / 2) * 256px;
                                    y: Math.mod(index, 2) * 196px;
                                    name: asset.name;
                                    symbol: asset.symbol;
                                    icon: asset.icon;
                                    price: asset.price;
                                    amount: asset.amount;
                                    value: asset.value;
                                    change: asset.change-24h;
                                    is-positive: asset.is-positive;
                                    
                                    clicked => {
                                        CryptoAdapter.fetch-asset-details(asset.id);
                                        CryptoAdapter.show-asset-detail = true;
                                    }
                                }
                            }
                        }

                        PortfolioTrendChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-trend-ready;
                            image: CryptoAdapter.portfolio-trend-image;
                        }

                        PortfolioDistributionChart {
                            horizontal-stretch: 1;
                            has-data: CryptoAdapter.portfolio-chart-ready;
                            image: CryptoAdapter.portfolio-chart-image;
                            slices: CryptoAdapter.portfolio-distribution;
                        }
                    }
                    
                    Rectangle { height: 24px; }
                }

                viewport-height: max(self.height, content-height);

                CustomVScrollbar {
                    x: parent.width - self.width - 6px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: content-height;
                    viewport-y: portfolio-scroll.viewport-y;
                }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": VerticalLayout {
                padding-left: 64px;
                padding-right: 64px;
                padding-bottom: 32px;
                spacing: 0px;

                // Headers
                Rectangle {
                    height: 48px;
                    
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        
                        Text { 
                            width: 300px; 
                            text: "WALLET"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                        }
                        Text { 
                            width: 100px; 
                            text: "ASSETS"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                            horizontal-alignment: center; 
                        }
                        Text { 
                            width: 150px; 
                            text: "VALUE"; 
                            color: Palette.text-subtle; 
                            font-size: 10px; 
                            font-weight: 600; 
                            letter-spacing: 2px; 
                            vertical-alignment: center; 
                            horizontal-alignment: right; 
                        }
                        Rectangle { width: 40px; }
                    }
                    
                    // Bottom border
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: 100%;
                        background: Palette.border-subtle;
                    }
                }

                // Empty State
                if CryptoAdapter.wallets.length == 0: Rectangle {
                    vertical-stretch: 1;
                    
                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        
                        Rectangle {
                            width: 80px;
                            height: 80px;
                            border-radius: 40px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            x: (parent.width - self.width) / 2;
                            
                            Text {
                                text: "💼";
                                font-size: 32px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        
                        Text { 
                            text: "No wallets created"; 
                            color: Palette.text-secondary; 
                            font-size: 16px; 
                            font-weight: 400;
                            horizontal-alignment: center; 
                        }
                        
                        Text { 
                            text: "Add your first wallet to start tracking your crypto"; 
                            color: Palette.text-muted; 
                            font-size: 13px;
                            horizontal-alignment: center; 
                        }
                    }
                }

                // Wallets List
                if CryptoAdapter.wallets.length > 0: Flickable {
                    vertical-stretch: 1;
                    viewport-height: CryptoAdapter.wallets.length * 80px;
                    
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 8px;
                        
                        for wallet[index] in CryptoAdapter.wallets: Rectangle {
                            height: 72px;
                            background: Palette.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            
                                WalletRow {
                                    name: wallet.name;
                                    category: wallet.category;
                                    balance: wallet.balance;
                                    count: wallet.asset-count;
                                    id: wallet.id;
                                    is-last: index == CryptoAdapter.wallets.length - 1;
                                    delete => {
                                        CryptoAdapter.delete-wallet(wallet.id);
                                    }
                                    clicked => {
                                        CryptoAdapter.fetch-wallet-details(wallet.id);
                                        CryptoAdapter.show-wallet-detail = true;
                                    }
                                }
                            }
                        }
                    }
                }
        }
    }
    
    // ==================== DETAIL OVERLAY ====================
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { 
            background: #000000.with-alpha(0.85);
            
            animate background { duration: 200ms; } 
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { CryptoAdapter.show-asset-detail = false; } 
                }
            }

            AssetDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }

    // ==================== WALLET DETAIL OVERLAY ====================
    if CryptoAdapter.show-wallet-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { 
            background: #000000.with-alpha(0.85);
            
            animate background { duration: 200ms; } 
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { CryptoAdapter.show-wallet-detail = false; } 
                }
            }

            WalletDetailPanel {
                width: min(420px, parent.width);
                height: parent.height;
            }
        }
    }
}
