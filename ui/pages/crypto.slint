// ==================== Crypto Page ====================
// Noir Minimalist - Crypto Portfolio & Wallets
// Refactored for "Sanctum Command" Architecture

import {
    Palette,
    CryptoAdapter,
    AppState
} from "../globals.slint";
import { CryptoRow, WalletRow, TickerItem } from "../components/crypto_widgets.slint";
import { AssetDetailPanel } from "../components/asset_detail.slint";

export component CryptoPage inherits Rectangle {
    background: Palette.background;
    in-out property <string> active-tab: "portfolio"; // portfolio, wallets

    init => {
        CryptoAdapter.fetch-portfolio();
        CryptoAdapter.fetch-wallets();
        CryptoAdapter.refresh-prices(); // Fetch ticker prices
    }

    VerticalLayout {
        spacing: 0px;

        // ==================== ZONA 1: EL RADAR (Ticker Tape) ====================
        Rectangle {
            height: 40px;
            background: Palette.surface;
            
            HorizontalLayout {
                // Fixed Element (CLP Rate)
                Rectangle {
                    width: 120px;
                    background: transparent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: "CLP"; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                        Text { text: CryptoAdapter.clp-rate; color: Palette.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                    }
                }

                // Separator
                Rectangle { width: 1px; background: Palette.border-subtle; }

                // Sliding Ticker
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    clip: true;

                    Flickable {
                        horizontal-stretch: 1;
                        height: parent.height;
                        viewport-width: (CryptoAdapter.market-tickers.length * 160px); // 160px per item
                        interactive: true;
                        
                        HorizontalLayout {
                            for ticker in CryptoAdapter.market-tickers: TickerItem {
                                symbol: ticker.symbol;
                                price: ticker.price;
                                change: ticker.change-24h;
                                is-positive: ticker.is-positive;
                            }
                        }
                    }
                }
            }
            
            // Bottom border for Radar
            Rectangle { 
                height: 1px; 
                width: parent.width; 
                background: Palette.border-subtle; 
                y: parent.height - 1px; 
            }
        }

        // ==================== ZONA 2: EL CONTROL (Summary & Navigation) ====================
        Rectangle {
            height: 100px;
            background: Palette.background;
            
            HorizontalLayout {
                y: (parent.height - self.height) / 2;
                padding-left: 48px;
                padding-right: 48px;
                alignment: space-between;
                
                // Left: Summary
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: "NET ASSET VALUE"; color: Palette.text-muted; font-size: 10px; font-weight: 500; letter-spacing: 2px; }
                    HorizontalLayout {
                        spacing: 16px;
                        Text { text: CryptoAdapter.total-value; color: Palette.text-primary; font-size: 32px; font-weight: 300; letter-spacing: -1px; }
                        Rectangle {
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            background: CryptoAdapter.total-pnl-positive ? Palette.success.with-alpha(0.1) : Palette.danger.with-alpha(0.1);
                            border-radius: 4px;
                            
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { 
                                    text: CryptoAdapter.total-pnl; 
                                    color: CryptoAdapter.total-pnl-positive ? Palette.success : Palette.danger; 
                                    font-size: 12px; 
                                    font-weight: 600;
                                    vertical-alignment: center; 
                                }
                            }
                        }
                    }
                }

                // Right: Tabs
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    
                    Rectangle {
                        width: 120px; height: 36px;
                        background: root.active-tab == "portfolio" ? Palette.surface : transparent;
                        border-radius: 4px;
                        border-width: root.active-tab == "portfolio" ? 1px : 0px;
                        border-color: Palette.border-subtle;
                        
                        Text { 
                            text: "PORTFOLIO"; 
                            color: root.active-tab == "portfolio" ? Palette.text-primary : Palette.text-muted; 
                            font-size: 11px; font-weight: 600; 
                            vertical-alignment: center; horizontal-alignment: center; 
                        }
                        TouchArea { clicked => { root.active-tab = "portfolio"; } }
                    }

                    Rectangle { width: 1px; height: 16px; background: Palette.border-subtle; y: (parent.height - self.height) / 2; }

                    Rectangle {
                        width: 120px; height: 36px;
                        background: root.active-tab == "wallets" ? Palette.surface : transparent;
                        border-radius: 4px;
                        border-width: root.active-tab == "wallets" ? 1px : 0px;
                        border-color: Palette.border-subtle;

                        Text { 
                            text: "WALLETS"; 
                            color: root.active-tab == "wallets" ? Palette.text-primary : Palette.text-muted; 
                            font-size: 11px; font-weight: 600; 
                            vertical-alignment: center; horizontal-alignment: center; 
                        }
                        TouchArea { clicked => { root.active-tab = "wallets"; } }
                    }
                }
            }

            // Divider
            Rectangle { height: 1px; width: parent.width; background: Palette.border-subtle; y: parent.height - 1px; }
        }

        // ==================== ZONA 3: EL CAMPO DE BATALLA (Content) ====================
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 48px;
            padding-right: 48px;
            padding-bottom: 24px;

            // TAB: PORTFOLIO
            if root.active-tab == "portfolio": VerticalLayout {
                spacing: 0px;

                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // Sticky Header
                        Rectangle {
                            height: 44px;
                            background: Palette.surface;
                            HorizontalLayout {
                                spacing: 0px;
                                padding-left: 24px; padding-right: 24px;
                                alignment: start;
                                
                                Text { width: 240px; text: "ASSET"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; }
                                Text { width: 140px; text: "PRICE"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                                Text { width: 140px; text: "HOLDINGS"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                                Text { width: 140px; text: "VALUE"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                                Rectangle { width: 40px; }
                                Text { width: 100px; text: "24H"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: center; }
                            }
                            Rectangle { height: 1px; width: parent.width; background: Palette.border-subtle; y: parent.height - 1px; }
                        }

                        // List
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;
                            
                            if CryptoAdapter.portfolio.length == 0: Text { 
                                text: "No assets found. Start building your empire."; 
                                color: Palette.text-muted; font-size: 14px; font-italic: true; 
                                horizontal-alignment: center; vertical-alignment: center; 
                            }

                            Flickable {
                                width: parent.width;
                                viewport-height: CryptoAdapter.portfolio.length * 56px;
                                VerticalLayout {
                                    for asset[index] in CryptoAdapter.portfolio: CryptoRow {
                                        name: asset.name;
                                        symbol: asset.symbol;
                                        price: asset.price;
                                        amount: asset.amount;
                                        value: asset.value;
                                        change: asset.change-24h;
                                        is-positive: asset.is-positive;
                                        is-last: index == CryptoAdapter.portfolio.length - 1;
                                        clicked => {
                                            CryptoAdapter.fetch-asset-details(asset.id);
                                            CryptoAdapter.show-asset-detail = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // TAB: WALLETS
            if root.active-tab == "wallets": VerticalLayout {
                spacing: 0px;

                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // Header
                        Rectangle {
                            height: 44px;
                            background: Palette.surface;
                            HorizontalLayout {
                                padding-left: 24px; padding-right: 24px;
                                alignment: start;
                                
                                Text { width: 300px; text: "WALLET / SOURCE"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; }
                                Text { width: 100px; text: "ASSETS"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: center; }
                                Text { width: 150px; text: "TOTAL BALANCE"; color: Palette.text-muted; font-size: 10px; font-weight: 600; letter-spacing: 1px; vertical-alignment: center; horizontal-alignment: right; }
                                Rectangle { width: 32px; }
                            }
                            Rectangle { height: 1px; width: parent.width; background: Palette.border-subtle; y: parent.height - 1px; }
                        }

                        // List
                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.surface;

                            if CryptoAdapter.wallets.length == 0: Text { 
                                text: "No wallets connected."; 
                                color: Palette.text-muted; font-size: 14px; font-italic: true; 
                                horizontal-alignment: center; vertical-alignment: center; 
                            }

                            Flickable {
                                width: parent.width;
                                viewport-height: CryptoAdapter.wallets.length * 64px;
                                VerticalLayout {
                                    for wallet[index] in CryptoAdapter.wallets: WalletRow {
                                        name: wallet.name;
                                        category: wallet.category;
                                        balance: wallet.balance;
                                        count: wallet.asset-count;
                                        id: wallet.id;
                                        is-last: index == CryptoAdapter.wallets.length - 1;
                                        delete => {
                                            CryptoAdapter.delete-wallet(wallet.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating Action Button (FAB)
    Rectangle {
        x: parent.width - self.width - 48px;
        y: parent.height - self.height - 48px;
        width: 48px; height: 48px;
        border-radius: 24px;
        background: fab-touch.has-hover ? Palette.accent-hover : Palette.accent;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000080;
        
        Text { 
            text: "+"; 
            color: #000000; 
            font-size: 24px; font-weight: 400; 
            vertical-alignment: center; horizontal-alignment: center; 
            y: -2px; // Visual correction
        }
        
        fab-touch := TouchArea {
            clicked => {
                if (root.active-tab == "portfolio") {
                    AppState.show-add-crypto = true;
                } else {
                    AppState.show-add-wallet = true;
                }
            }
        }
    }
    
    // DETAIL OVERLAY
    if CryptoAdapter.show-asset-detail: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        
        // Backdrop
        Rectangle { background: #00000080; }

        // Layout: close area + drawer so clicks on panel don't close it
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                TouchArea { clicked => { CryptoAdapter.show-asset-detail = false; } }
            }

            AssetDetailPanel {
                // Stick to right edge
                height: parent.height;
            }
        }
    }
}
