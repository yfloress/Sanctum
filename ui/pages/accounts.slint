// ==================== Accounts Page ====================
// Noir Minimalist - Account management view

import {
    Palette,
    AccountAdapter,
    AccountData,
    AppState,
} from "../globals.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton } from "../widgets.slint";

component StatBadge inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    height: 64px;
    min-width: 160px;
    background: Palette.surface-hover;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: label;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Text {
            text: value;
            color: Palette.text-primary;
            font-size: 16px;
            font-weight: 600;
        }
    }
}

export component AccountsPage inherits Rectangle {
    background: Palette.background;

    // Load accounts when page is shown
    init => {
        AccountAdapter.fetch-accounts();
    }

    Flickable {
        width: parent.width;
        height: parent.height;

        content := VerticalLayout {
            width: parent.width;
            padding: 48px;
            padding-left: 64px;
            padding-right: 64px;
            spacing: 20px;

            // Hero
            Rectangle {
                min-height: 200px;
                background: @linear-gradient(135deg, #0c0c0c 0%, #101010 50%, #0c0c0c 100%);
                border-radius: 12px;
                border-width: 1px;
                border-color: Palette.border;
                clip: true;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "ACCOUNTS OVERVIEW";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                    }

                    Text {
                        text: "Control balances, transfers, and custody points.";
                        color: Palette.text-secondary;
                        font-size: 14px;
                        font-weight: 400;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        StatBadge {
                            label: "TOTAL ACCOUNTS";
                            value: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                        }

                        StatBadge {
                            label: "TRANSFER READY";
                            value: AccountAdapter.accounts.length > 1 ? "Yes" : "Add one more";
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        spacing: 12px;

                        TextButton {
                            text: "TRANSFER";
                            enabled: AccountAdapter.accounts.length > 1;

                            clicked => {
                                AccountAdapter.fetch-accounts();
                                AppState.show-transfer-modal = true;
                            }
                        }

                        TextButton {
                            text: "+ NEW";
                            clicked => {
                                AccountAdapter.fetch-accounts();
                                AppState.account-edit-mode = false;
                                AppState.selected-account-index = 0;
                                AppState.show-add-account = true;
                            }
                        }
                    }
                }
            }

            // List container
            Rectangle {
                background: Palette.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "ACCOUNT LIST";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 400;
                            letter-spacing: 3px;
                        }

                        Text {
                            text: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                            color: Palette.text-secondary;
                            font-size: 12px;
                            font-weight: 400;
                        }
                    }

                    if AccountAdapter.accounts.length == 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: 14px;

                            Text {
                                text: "No accounts yet";
                                color: Palette.text-muted;
                                font-size: 14px;
                                font-weight: 300;
                                font-italic: true;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Create your first account to start tracking.";
                                color: Palette.text-secondary;
                                font-size: 12px;
                                font-weight: 400;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length > 0: Rectangle {
                        vertical-stretch: 1;

                        Flickable {
                            viewport-height: AccountAdapter.accounts.length * 70px;

                            VerticalLayout {
                                spacing: 0px;

                                for account[index] in AccountAdapter.accounts: AccountItem {
                                    account: account;
                                    is-last: index == AccountAdapter.accounts.length - 1;

                                    clicked => {
                                        AppState.account-edit-mode = true;
                                        AppState.selected-account-index = index;
                                        AppState.show-add-account = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
