// ==================== Accounts Page ====================
// Noir Minimalist - Account management view

import {
    Palette,
    AccountAdapter,
    AccountData,
    AppState,
} from "../globals.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton } from "../widgets.slint";

export component AccountsPage inherits Rectangle {
    background: Palette.background;

    // Load accounts when page is shown
    init => {
        AccountAdapter.fetch-accounts();
    }

    Flickable {
        width: parent.width;
        height: parent.height;

        content := VerticalLayout {
            width: parent.width;
            padding: 48px;
            padding-left: 64px;
            padding-right: 64px;
            spacing: 16px;

            // Header actions
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "ACCOUNTS";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                HorizontalLayout {
                    spacing: 12px;

                    TextButton {
                        text: "TRANSFER";
                        enabled: AccountAdapter.accounts.length > 1;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.show-transfer-modal = true;
                        }
                    }

                    TextButton {
                        text: "+ NEW";
                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.account-edit-mode = false;
                            AppState.selected-account-index = 0;
                            AppState.show-add-account = true;
                        }
                    }
                }
            }

            // List container
            Rectangle {
                background: Palette.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "ACCOUNT LIST";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 400;
                            letter-spacing: 3px;
                        }

                        Text {
                            text: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                            color: Palette.text-secondary;
                            font-size: 12px;
                            font-weight: 400;
                        }
                    }

                    if AccountAdapter.accounts.length == 0: Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            spacing: 14px;

                            Text {
                                text: "No accounts yet";
                                color: Palette.text-muted;
                                font-size: 14px;
                                font-weight: 300;
                                font-italic: true;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Create your first account to start tracking.";
                                color: Palette.text-secondary;
                                font-size: 12px;
                                font-weight: 400;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if AccountAdapter.accounts.length > 0: Rectangle {
                        Flickable {
                            height: AccountAdapter.accounts.length * 70px < 360px ? AccountAdapter.accounts.length * 70px : 360px;
                            viewport-height: AccountAdapter.accounts.length * 70px;

                            VerticalLayout {
                                spacing: 0px;
                                preferred-height: AccountAdapter.accounts.length * 70px;

                                for account[index] in AccountAdapter.accounts: AccountItem {
                                    account: account;
                                    is-last: index == AccountAdapter.accounts.length - 1;

                                    clicked => {
                                        AppState.account-edit-mode = true;
                                        AppState.selected-account-index = index;
                                        AppState.show-add-account = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
