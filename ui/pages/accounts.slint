// ==================== Accounts Page ====================
// Noir Minimalist - Account management view

import {
    Palette,
    AccountAdapter,
    AccountData,
    AppState,
} from "../globals.slint";
import { AccountItem } from "../components/account_item.slint";
import { TextButton } from "../widgets.slint";

export component AccountsPage inherits Rectangle {
    background: Palette.background;

    // Load accounts when page is shown
    init => {
        AccountAdapter.fetch-accounts();
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 0px;

        // Header section
        HorizontalLayout {
            height: 48px;
            spacing: 0px;

            // Title
            Text {
                text: "ACCOUNTS";
                color: Palette.text-muted;
                font-size: 11px;
                font-weight: 400;
                letter-spacing: 3px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // Actions
            Rectangle {
                width: 260px;

                HorizontalLayout {
                    spacing: 12px;

                    TextButton {
                        text: "TRANSFER";
                        enabled: AccountAdapter.accounts.length > 1;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.show-transfer-modal = true;
                        }
                    }

                    TextButton {
                        text: "+ NEW";
                        enabled: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.account-edit-mode = false;
                            AppState.selected-account-index = 0;
                            AppState.show-add-account = true;
                        }
                    }
                }
            }
        }

        // Spacer
        Rectangle {
            height: 24px;
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        // Account list
        if AccountAdapter.accounts.length > 0: Rectangle {
            vertical-stretch: 1;

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 64px;

                VerticalLayout {
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: AccountItem {
                        account: account;
                        is-last: index == AccountAdapter.accounts.length - 1;

                        clicked => {
                            AppState.account-edit-mode = true;
                            AppState.selected-account-index = index;
                            AppState.show-add-account = true;
                        }
                    }
                }
            }
        }

        // Empty state
        if AccountAdapter.accounts.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Text {
                    text: "No accounts yet";
                    color: Palette.text-muted;
                    font-size: 14px;
                    font-weight: 300;
                    font-italic: true;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Create your first account to start tracking";
                    color: Palette.text-subtle;
                    font-size: 12px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }
            }
        }

        // Footer
        Rectangle {
            height: 48px;

            HorizontalLayout {
                alignment: start;

                Text {
                    text: AccountAdapter.accounts.length == 1 ? "1 account" : AccountAdapter.accounts.length + " accounts";
                    color: Palette.text-subtle;
                    font-size: 10px;
                    font-weight: 400;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
