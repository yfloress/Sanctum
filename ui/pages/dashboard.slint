// ==================== Dashboard Page ====================
// Noir Minimalist - Net worth cockpit Redesign

import {
    Palette,
    DashboardAdapter,
    TransactionAdapter,
    AccountAdapter,
    AnalyticsAdapter,
    CategoryData,
    AppState,
} from "../globals.slint";
import { TacticalGrid } from "../components/tactical_grid.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { TextButton } from "../widgets.slint";
import { SanctumLineChart } from "../components/charts.slint";
import { CategoryBreakdown } from "../components/category_breakdown.slint";

// ==================== Local Components ====================

component RangeSelector inherits Rectangle {
    in property <string> active-range;
    callback range-selected(string);

    height: 32px;
    background: Palette.surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;

        for range in ["1M", "3M", "6M", "1Y", "ALL"] : Rectangle {
            width: 48px;
            border-radius: 14px;
            background: active-range == range ? Palette.surface-hover : transparent;
            
            animate background { duration: 150ms; }

            Text {
                text: range;
                color: active-range == range ? Palette.text-primary : Palette.text-muted;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.range-selected(range); }
            }
        }
    }
}

component ChartSection inherits Rectangle {
    in property <string> min-label;
    in property <string> max-label;
    in property <string> path;

    height: 280px;
    background: @linear-gradient(180deg, #0a0a0a 0%, #050505 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    clip: true;

    // Grid lines visual
    TacticalGrid {
        opacity: 0.1;
        grid-cols: 10;
        grid-rows: 5;
    }

    SanctumLineChart {
        width: 100%;
        height: 100%;
        path: root.path;
        min-label: root.min-label;
        max-label: root.max-label;
    }
}

// ==================== Main Page ====================

export component DashboardPage inherits Rectangle {
    background: Palette.background;

    init => {
        DashboardAdapter.fetch-balance();
        TransactionAdapter.fetch-transactions();
        AnalyticsAdapter.fetch-analytics("1M");
    }

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding-top: 48px;
            padding-bottom: 48px;
            padding-left: 64px;
            padding-right: 64px;
            spacing: 40px;

            // 1. HERO SECTION (Net Worth)
            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Text {
                    text: "TOTAL NET WORTH";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                }

                Text {
                    text: DashboardAdapter.balance.total-balance;
                    color: Palette.text-primary;
                    font-size: 56px;
                    font-weight: 300;
                    letter-spacing: -1px;
                    horizontal-alignment: center;
                }

                // Quick stats row
                HorizontalLayout {
                    alignment: center;
                    spacing: 24px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "▲"; color: Palette.success; font-size: 12px; vertical-alignment: center; }
                        Text { 
                            text: DashboardAdapter.balance.total-income; 
                            color: Palette.text-secondary; 
                            font-size: 13px; 
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { width: 1px; height: 16px; background: Palette.border; }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "▼"; color: Palette.danger; font-size: 12px; vertical-alignment: center; }
                        Text { 
                            text: DashboardAdapter.balance.total-expense; 
                            color: Palette.text-secondary; 
                            font-size: 13px; 
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // 2. CONTROLS & ACTIONS
            HorizontalLayout {
                alignment: space-between;
                height: 32px;

                // Range Selector
                RangeSelector {
                    active-range: AnalyticsAdapter.active-range;
                    range-selected(r) => {
                        AnalyticsAdapter.active-range = r;
                        AnalyticsAdapter.fetch-analytics(r);
                    }
                }

                // Add Button
                TextButton {
                    text: "+ ADD TRANSACTION";
                    clicked => {
                        AccountAdapter.fetch-accounts();
                        AppState.show-add-transaction = true;
                    }
                }
            }

            // 3. CHART VISUALIZATION
            ChartSection {
                path: AnalyticsAdapter.summary.chart_path;
                min-label: AnalyticsAdapter.summary.min_value;
                max-label: AnalyticsAdapter.summary.max_value;
            }

            // 4. SPENDING BREAKDOWN
            if AnalyticsAdapter.summary.expense_breakdown.length > 0 : VerticalLayout {
                spacing: 16px;

                Text {
                    text: "SPENDING FOCUS";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 3px;
                }

                Rectangle {
                    height: 300px;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;
                    clip: true; // Ensure content stays inside

                    Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: max(300px, (AnalyticsAdapter.summary.expense_breakdown.length * 56px) + 48px);

                        VerticalLayout {
                            padding: 24px;
                            alignment: start; // Start from top
                            
                            CategoryBreakdown {
                                categories: AnalyticsAdapter.summary.expense_breakdown;
                            }
                        }
                    }
                }
            }
            
            // Spacer
            Rectangle { height: 24px; }
        }
    }
}
