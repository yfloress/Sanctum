// ==================== Dashboard Page ====================
// Noir Minimalist - Net worth cockpit

import {
    Palette,
    DashboardAdapter,
    TransactionAdapter,
    AccountAdapter,
    AppState,
} from "../globals.slint";
import { TacticalGrid } from "../components/tactical_grid.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { TextButton, BorderButton } from "../widgets.slint";

component StatPill inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <color> accent: Palette.text-secondary;

    min-width: 160px;
    height: 64px;
    background: Palette.surface-hover;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        alignment: center;

        Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 5px;
            background: root.accent;
            opacity: 0.9;
        }

        VerticalLayout {
            spacing: 4px;

            Text {
                text: root.label;
                color: Palette.text-muted;
                font-size: 11px;
                font-weight: 400;
                letter-spacing: 2px;
            }

            Text {
                text: root.value;
                color: root.accent;
                font-size: 16px;
                font-weight: 500;
            }
        }
    }
}

component SummaryCard inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> caption: "";
    in property <color> accent: Palette.text-secondary;

    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 18px;
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 20px;
            font-weight: 500;
        }

        Text {
            text: root.caption;
            color: Palette.text-secondary;
            font-size: 12px;
            font-weight: 400;
        }
    }
}

export component DashboardPage inherits Rectangle {
    background: Palette.background;

    init => {
        DashboardAdapter.fetch-balance();
        DashboardAdapter.fetch-recent();
        TransactionAdapter.fetch-transactions();
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 24px;

        // Hero / net worth
        Rectangle {
            height: 220px;
            background: @linear-gradient(135deg, #0f0f0f 0%, #090909 50%, #0f0f0f 100%);
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;

            TacticalGrid {
                grid-cols: 14;
                grid-rows: 6;
                show-background: false;
                opacity: 0.25;
            }

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                Text {
                    text: "NET WORTH";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                Text {
                    text: DashboardAdapter.balance.total-balance;
                    color: Palette.text-primary;
                    font-size: 42px;
                    font-weight: 400;
                    letter-spacing: -0.5px;
                }

                Text {
                    text: "Sum across all accounts and wallets";
                    color: Palette.text-secondary;
                    font-size: 12px;
                    font-weight: 400;
                }

                HorizontalLayout {
                    spacing: 12px;

                    StatPill {
                        label: "INFLOW";
                        value: DashboardAdapter.balance.total-income;
                        accent: Palette.success;
                    }

                    StatPill {
                        label: "OUTFLOW";
                        value: DashboardAdapter.balance.total-expense;
                        accent: Palette.danger;
                    }

                    StatPill {
                        label: "ACTIVITY";
                        value: DashboardAdapter.recent.length == 1 ? "1 move" : DashboardAdapter.recent.length + " moves";
                        accent: Palette.text-primary;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 12px;

                    BorderButton {
                        text: "VIEW ANALYTICS";

                        clicked => {
                            AppState.active-page = "analytics";
                        }
                    }

                    TextButton {
                        text: "+ ADD TRANSACTION";
                        uppercase: true;

                        clicked => {
                            AccountAdapter.fetch-accounts();
                            AppState.show-add-transaction = true;
                        }
                    }
                }
            }
        }

        // Quick summary row
        HorizontalLayout {
            spacing: 12px;
            height: 110px;

            SummaryCard {
                label: "INFLOW";
                value: DashboardAdapter.balance.total-income;
                caption: "Entradas registradas en el periodo";
                accent: Palette.success;
            }

            SummaryCard {
                label: "OUTFLOW";
                value: DashboardAdapter.balance.total-expense;
                caption: "Gasto total consolidado";
                accent: Palette.danger;
            }

            SummaryCard {
                label: "NET POSITION";
                value: DashboardAdapter.balance.total-balance;
                caption: "Liquidez + inversión disponible";
                accent: Palette.text-primary;
            }
        }

        // Recent transactions
        Rectangle {
            vertical-stretch: 1;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "RECENT ACTIVITY";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        BorderButton {
                            text: "VIEW ALL";

                            clicked => {
                                AppState.active-page = "transactions";
                            }
                        }

                        TextButton {
                            text: "+ ADD";

                            clicked => {
                                AccountAdapter.fetch-accounts();
                                AppState.show-add-transaction = true;
                            }
                        }
                    }
                }

                if DashboardAdapter.recent.length == 0: Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;

                        Text {
                            text: "No transactions yet";
                            color: Palette.text-muted;
                            font-size: 14px;
                            font-weight: 300;
                            font-italic: true;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Registra tu primer movimiento para poblar el panel";
                            color: Palette.text-subtle;
                            font-size: 12px;
                            font-weight: 400;
                            horizontal-alignment: center;
                        }
                    }
                }

                if DashboardAdapter.recent.length > 0: Rectangle {
                    vertical-stretch: 1;

                    Flickable {
                        viewport-height: DashboardAdapter.recent.length * 56px;

                        VerticalLayout {
                            spacing: 0px;

                            for transaction[index] in DashboardAdapter.recent: TransactionItem {
                                transaction: transaction;
                                is-last: index == DashboardAdapter.recent.length - 1;
                                show-delete: false;
                            }
                        }
                    }
                }
            }
        }
    }
}
