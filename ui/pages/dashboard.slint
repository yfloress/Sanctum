// ==================== Dashboard Page ====================
// Noir Fintech - Premium Net Worth Command Center

import {
    Palette,
    DashboardAdapter,
    TransactionAdapter,
    AccountAdapter,
    AnalyticsAdapter,
    CategoryData,
    AppState,
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { TextButton, ActionButton } from "../widgets.slint";
import { CategoryBreakdown } from "../components/category_breakdown.slint";

// ==================== Range Selector ====================
component RangeSelector inherits Rectangle {
    in property <string> active-range;
    callback range-selected(string);

    height: 36px;
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border-subtle;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        for range in ["1M", "3M", "6M", "1Y", "ALL"]: Rectangle {
            width: 52px;
            border-radius: 6px;
            background: active-range == range ? Palette.background : transparent;
            border-width: active-range == range ? 1px : 0px;
            border-color: Palette.border-subtle;
            
            animate background { duration: 200ms; easing: ease-out; }

            Text {
                text: range;
                color: active-range == range ? Palette.text-primary : Palette.text-muted;
                font-size: 11px;
                font-weight: active-range == range ? 600 : 500;
                letter-spacing: 0.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
                
                animate color { duration: 200ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.range-selected(range); }
            }
        }
    }
}

// ==================== Stat Badge ====================
component StatBadge inherits Rectangle {
    in property <string> value;
    in property <bool> positive: true;
    in property <string> label;
    
    width: 160px;
    height: 72px;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border-subtle;
    
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        
        // Indicator
        Rectangle {
            width: 3px;
            height: 40px;
            border-radius: 2px;
            background: positive ? Palette.success : Palette.danger;
            y: (parent.height - self.height) / 2;
        }
        
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            
            Text {
                text: label;
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1.5px;
            }
            
            HorizontalLayout {
                spacing: 6px;
                
                Text { 
                    text: positive ? "▲" : "▼"; 
                    color: positive ? Palette.success : Palette.danger; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
                Text { 
                    text: value; 
                    color: Palette.text-primary; 
                    font-size: 16px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ==================== Chart Card ====================
component ChartCard inherits Rectangle {
    in property <string> min-label;
    in property <string> max-label;
    in property <image> chart-image;

    height: 320px;
    background: @linear-gradient(180deg, Palette.chart-bg-start, Palette.chart-bg-end);
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.border-subtle;
    clip: true;

    // Chart image
    Image {
        width: 100%;
        height: 100%;
        source: root.chart-image;
        image-fit: contain;
    }

    // Y-Axis Labels overlay
    VerticalLayout {
        x: 20px;
        y: 0;
        width: 80px;
        height: parent.height;
        padding-top: 36px;
        padding-bottom: 36px;
        alignment: space-between;

        if max-label != "": Rectangle {
            height: 24px;
            background: Palette.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;

            Text {
                text: max-label;
                color: Palette.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        if min-label != "": Rectangle {
            height: 24px;
            background: Palette.surface.with-alpha(0.8);
            border-radius: 4px;
            width: 70px;

            Text {
                text: min-label;
                color: Palette.text-secondary;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    // Top accent line
    Rectangle {
        y: 0;
        width: 100%;
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, Palette.border-light.with-alpha(0.2) 50%, transparent 100%);
    }
}

// ==================== Section Header ====================
component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> action-text: "";
    callback action-clicked;
    
    height: 24px;
    background: transparent;
    
    HorizontalLayout {
        alignment: space-between;
        
        HorizontalLayout {
            spacing: 12px;
            
            Rectangle {
                width: 3px;
                height: 16px;
                border-radius: 1px;
                background: Palette.accent;
                y: (parent.height - self.height) / 2;
            }
            
            Text {
                text: title;
                color: Palette.text-muted;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
        }
        
        if action-text != "": Rectangle {
            width: 100px;
            
            Text {
                text: action-text;
                color: action-touch.has-hover ? Palette.text-primary : Palette.text-secondary;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1px;
                horizontal-alignment: right;
                vertical-alignment: center;
                animate color { duration: 150ms; }
            }
            
            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }
            }
        }
    }
}



// ==================== Main Page ====================
export component DashboardPage inherits Rectangle {
    background: Palette.background;

    init => {
        DashboardAdapter.fetch-balance();
        DashboardAdapter.fetch-recent();
        TransactionAdapter.fetch-transactions();
        AnalyticsAdapter.fetch-analytics("1M");
    }

    Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding-top: 48px;
            padding-bottom: 64px;
            padding-left: 64px;
            padding-right: 64px;
            spacing: 32px;

            // ==================== HERO SECTION ====================
            Rectangle {
                height: 200px;
                background: @linear-gradient(180deg, #0a0a10 0%, Palette.background 100%);
                border-radius: 20px;
                
                VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding: 32px;

                    // Label
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.success;
                            y: (parent.height - self.height) / 2;
                            
                            // Pulse animation placeholder
                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: Palette.success.with-alpha(0.3);
                            }
                        }
                        
                        Text {
                            text: "TOTAL NET WORTH";
                            color: Palette.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }
                    }

                    // Big number
                    Text {
                        text: DashboardAdapter.balance.total-balance;
                        color: Palette.text-primary;
                        font-size: 56px;
                        font-weight: 300;
                        letter-spacing: -2px;
                        horizontal-alignment: center;
                    }

                    // Stats row
                    HorizontalLayout {
                        alignment: center;
                        spacing: 24px;

                        StatBadge {
                            label: "INCOME";
                            value: DashboardAdapter.balance.total-income;
                            positive: true;
                        }

                        StatBadge {
                            label: "EXPENSES";
                            value: DashboardAdapter.balance.total-expense;
                            positive: false;
                        }
                    }
                }
            }

            // ==================== CONTROLS ROW ====================
            HorizontalLayout {
                alignment: space-between;
                height: 40px;

                RangeSelector {
                    active-range: AnalyticsAdapter.active-range;
                    range-selected(r) => {
                        AnalyticsAdapter.active-range = r;
                        AnalyticsAdapter.fetch-analytics(r);
                    }
                }

                ActionButton {
                    text: "+ ADD TRANSACTION";
                    primary: true;
                    clicked => {
                        AccountAdapter.fetch-accounts();
                        AppState.show-add-transaction = true;
                    }
                }
            }

            // ==================== CHART ====================
            ChartCard {
                chart-image: AnalyticsAdapter.summary.chart_image;
                min-label: AnalyticsAdapter.summary.min_value;
                max-label: AnalyticsAdapter.summary.max_value;
            }

            // ==================== SPENDING BREAKDOWN ====================
            if AnalyticsAdapter.summary.expense_breakdown.length > 0: VerticalLayout {
                spacing: 16px;

                SectionHeader { 
                    title: "SPENDING BREAKDOWN"; 
                }

                Rectangle {
                    height: 340px;
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    clip: true;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: max(320px, (AnalyticsAdapter.summary.expense_breakdown.length * 72px) + 48px);

                        VerticalLayout {
                            padding: 24px;
                            alignment: start;
                            
                            CategoryBreakdown {
                                categories: AnalyticsAdapter.summary.expense_breakdown;
                            }
                        }
                    }
                }
            }

            // ==================== RECENT ACTIVITY ====================
            if DashboardAdapter.recent.length > 0: VerticalLayout {
                spacing: 16px;

                SectionHeader {
                    title: "RECENT ACTIVITY";
                    action-text: "VIEW ALL →";
                    action-clicked => { AppState.active-page = "finances"; }
                }

                Rectangle {
                    background: Palette.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    clip: true;

                    VerticalLayout {
                        for transaction[index] in DashboardAdapter.recent: TransactionItem {
                            transaction: transaction;
                            is-last: index == DashboardAdapter.recent.length - 1;
                            show-delete: false;
                        }
                    }
                }
            }
            
            // Bottom spacer
            Rectangle { height: 32px; }
        }
    }
}
