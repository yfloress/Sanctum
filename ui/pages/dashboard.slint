// ==================== Dashboard Page ====================
// Noir Minimalist - Financial overview and summary

import {
    Palette,
    DashboardAdapter,
    TransactionAdapter,
} from "../globals.slint";
import { TransactionItem } from "../components/transaction_item.slint";

export component DashboardPage inherits Rectangle {
    background: Palette.background;

    init => {
        DashboardAdapter.fetch-balance();
        DashboardAdapter.fetch-recent();
        TransactionAdapter.fetch-transactions();
    }

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        spacing: 0px;

        // Header section
        Rectangle {
            height: 120px;

            VerticalLayout {
                spacing: 12px;
                alignment: start;

                // Label
                Text {
                    text: "NET WORTH";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                // Value
                Text {
                    text: DashboardAdapter.balance.total-balance;
                    color: Palette.text-primary;
                    font-size: 48px;
                    font-weight: 300;
                    letter-spacing: -1px;
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Palette.border;
            horizontal-stretch: 1;
        }

        // Summary cards
        HorizontalLayout {
            height: 80px;
            spacing: 12px;

            // Income Card
            Rectangle {
                horizontal-stretch: 1;
                background: income-area.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: income-area.has-hover ? Palette.border-light : Palette.border;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;

                    Text {
                        text: "INCOME";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 2px;
                    }

                    Text {
                        text: DashboardAdapter.balance.total-income;
                        color: Palette.success;
                        font-size: 18px;
                        font-weight: 500;
                    }
                }

                income-area := TouchArea {}
            }

            // Expense Card
            Rectangle {
                horizontal-stretch: 1;
                background: expense-area.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: expense-area.has-hover ? Palette.border-light : Palette.border;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;

                    Text {
                        text: "EXPENSE";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 2px;
                    }

                    Text {
                        text: DashboardAdapter.balance.total-expense;
                        color: Palette.danger;
                        font-size: 18px;
                        font-weight: 500;
                    }
                }
                
                expense-area := TouchArea {}
            }
        }

        Rectangle {
            height: 24px;
        }

        // Recent transactions
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 12px;

                Text {
                    text: "RECENT ACTIVITY";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                if DashboardAdapter.recent.length == 0: Rectangle {
                    vertical-stretch: 1;

                    Text {
                        text: "No transactions yet";
                        color: Palette.text-muted;
                        font-size: 14px;
                        font-weight: 300;
                        font-italic: true;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                if DashboardAdapter.recent.length > 0: Rectangle {
                    vertical-stretch: 1;

                    Flickable {
                        viewport-height: DashboardAdapter.recent.length * 56px;

                        VerticalLayout {
                            spacing: 0px;

                            for transaction[index] in DashboardAdapter.recent: TransactionItem {
                                transaction: transaction;
                                is-last: index == DashboardAdapter.recent.length - 1;
                                show-delete: false;
                            }
                        }
                    }
                }
            }
        }
    }
}
