// ==================== Dashboard Page ====================
// Premium Net Worth Command Center

import {
    DashboardAdapter,
    TransactionAdapter,
    AccountAdapter,
    AnalyticsAdapter,
    AppState,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { TransactionItem } from "../components/transaction_item.slint";
import { ActionButton } from "../widgets.slint";
import { CategoryBreakdown } from "../components/category_breakdown.slint";
import { SectionHeader } from "../components/sections/section_header.slint";
import { RangeSelector } from "../components/filters/range_selector.slint";
import { StatCard } from "../components/stat_card.slint";
import { ChartCard } from "../components/charts.slint";

// ==================== Main Page ====================
export component DashboardPage inherits Rectangle {
    background: Theme.background;

    init => {
        DashboardAdapter.is-loading = true;
        DashboardAdapter.fetch-balance();
        DashboardAdapter.fetch-recent();
        TransactionAdapter.fetch-transactions();
        AnalyticsAdapter.fetch-analytics("1M");
    }

    // Main content (hidden when loading or error)
    if !DashboardAdapter.is-loading && !DashboardAdapter.has-error: Flickable {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding-top: 48px;
            padding-bottom: 64px;
            padding-left: 64px;
            padding-right: 64px;
            spacing: 32px;

            // ==================== EXCHANGE RATE WARNING ====================
            if DashboardAdapter.missing-exchange-rate: Rectangle {
                height: 48px;
                background: Theme.warning-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.warning-border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "⚠";
                        font-size: 16px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Exchange rate unavailable. CLP balances shown at 1:1 rate.";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            // ==================== HERO SECTION ====================
            Rectangle {
                height: 200px;
                background: @linear-gradient(180deg, Theme.bg-header 0%, Theme.background 100%);
                border-radius: 20px;

                VerticalLayout {
                    alignment: center;
                    spacing: 20px;
                    padding: 32px;

                    // Label
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.success;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: Theme.success.with-alpha(0.3);
                            }
                        }

                        Text {
                            text: "TOTAL NET WORTH";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }
                    }

                    // Big number
                    Text {
                        text: DashboardAdapter.balance.total-balance;
                        color: Theme.text-primary;
                        font-size: 56px;
                        font-weight: 300;
                        letter-spacing: -2px;
                        horizontal-alignment: center;
                    }

                    // Stats row
                    HorizontalLayout {
                        alignment: center;
                        spacing: 24px;

                        StatCard {
                            label: "FIAT";
                            value: DashboardAdapter.balance.fiat-balance;
                            accent-color: Theme.primary;
                        }

                        StatCard {
                            label: "CRYPTO";
                            value: DashboardAdapter.balance.crypto-value;
                            accent-color: Theme.chart-stroke;
                        }
                    }
                }
            }

            // ==================== CONTROLS ROW ====================
            HorizontalLayout {
                alignment: space-between;
                height: 40px;

                RangeSelector {
                    active-range: AnalyticsAdapter.active-range;
                    range-selected(r) => {
                        AnalyticsAdapter.active-range = r;
                        AnalyticsAdapter.fetch-analytics(r);
                    }
                }

                ActionButton {
                    text: "+ ADD TRANSACTION";
                    primary: true;
                    clicked => {
                        AccountAdapter.fetch-accounts();
                        AppState.show-add-transaction = true;
                    }
                }
            }

            // ==================== CHART ====================
            ChartCard {
                chart-image: AnalyticsAdapter.summary.chart_image;
                min-label: AnalyticsAdapter.summary.min_value;
                max-label: AnalyticsAdapter.summary.max_value;
            }

            // ==================== SPENDING BREAKDOWN ====================
            if AnalyticsAdapter.summary.expense_breakdown.length > 0: VerticalLayout {
                spacing: 16px;

                SectionHeader {
                    title: "SPENDING BREAKDOWN";
                }

                Rectangle {
                    height: 340px;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: max(320px, (AnalyticsAdapter.summary.expense_breakdown.length * 72px) + 48px);

                        VerticalLayout {
                            padding: 24px;
                            alignment: start;

                            CategoryBreakdown {
                                categories: AnalyticsAdapter.summary.expense_breakdown;
                            }
                        }
                    }
                }
            }

            // ==================== RECENT ACTIVITY ====================
            if DashboardAdapter.recent.length > 0: VerticalLayout {
                spacing: 16px;

                SectionHeader {
                    title: "RECENT ACTIVITY";
                    action-text: "VIEW ALL →";
                    action-clicked => { AppState.active-page = "finances"; }
                }

                Rectangle {
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    VerticalLayout {
                        for transaction[index] in DashboardAdapter.recent: TransactionItem {
                            transaction: transaction;
                            is-last: index == DashboardAdapter.recent.length - 1;
                            show-delete: false;
                        }
                    }
                }
            }

            // Bottom spacer
            Rectangle { height: 32px; }
        }
    }

    // ==================== LOADING STATE ====================
    if DashboardAdapter.is-loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Theme.surface;
                border-width: 3px;
                border-color: Theme.accent;

                Text {
                    text: "📊";
                    font-size: 28px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "Loading dashboard...";
                color: Theme.text-secondary;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
            }
        }
    }

    // ==================== ERROR STATE ====================
    if DashboardAdapter.has-error: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        VerticalLayout {
            alignment: center;
            spacing: 20px;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Theme.danger.with-alpha(0.1);
                border-width: 2px;
                border-color: Theme.danger.with-alpha(0.3);

                Text {
                    text: "⚠";
                    font-size: 28px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: DashboardAdapter.error-message;
                color: Theme.text-secondary;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 36px;
                width: 120px;
                background: retry-touch.has-hover ? Theme.surface-hover : Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "RETRY";
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                retry-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        DashboardAdapter.is-loading = true;
                        DashboardAdapter.has-error = false;
                        DashboardAdapter.fetch-balance();
                        DashboardAdapter.fetch-recent();
                        AnalyticsAdapter.fetch-analytics(AnalyticsAdapter.active-range);
                    }
                }
            }
        }
    }
}
