// ==================== Dashboard Page ====================
// Noir Minimalist - Financial overview and summary

import { Palette, AppState } from "../globals.slint";

export component DashboardPage inherits Rectangle {
    background: Palette.background;

    VerticalLayout {
        padding: 48px;
        padding-left: 64px;
        spacing: 0px;

        // Header section
        Rectangle {
            height: 120px;

            VerticalLayout {
                spacing: 12px;
                alignment: start;

                // Label
                Text {
                    text: "NET WORTH";
                    color: Palette.text-muted;
                    font-size: 11px;
                    font-weight: 400;
                    letter-spacing: 3px;
                }

                // Value
                Text {
                    text: "$ 0.00";
                    color: Palette.text-primary;
                    font-size: 48px;
                    font-weight: 300;
                    letter-spacing: -1px;
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Palette.border;
            horizontal-stretch: 1;
        }

        // Content area
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                // Empty state message
                Text {
                    text: "No accounts connected";
                    color: Palette.text-muted;
                    font-size: 14px;
                    font-weight: 300;
                    font-italic: true;
                    horizontal-alignment: center;
                }

                // Subtle hint
                Text {
                    text: "Add an account to start tracking your finances";
                    color: Palette.text-subtle;
                    font-size: 12px;
                    font-weight: 400;
                    horizontal-alignment: center;
                }
            }
        }

        // Footer
        Rectangle {
            height: 48px;

            HorizontalLayout {
                alignment: start;

                Text {
                    text: "Last updated: --";
                    color: Palette.text-subtle;
                    font-size: 10px;
                    font-weight: 400;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

