    in-out property <string> finances-add-first-entry: "Add your first entry to start tracking your finances";
    in-out property <string> finances-no-accounts-configured: "No accounts configured";
    in-out property <string> finances-create-account: "Create an account to manage your funds";

    // ==================== Crypto Extended (Buttons) ====================
    in-out property <string> crypto-add-wallet-button: "+ NEW WALLET";

    // ==================== Habits Extended (Summary Labels) ====================
    in-out property <string> habits-current-streak-label: "CURRENT STREAK";
    in-out property <string> habits-best-streak-label: "BEST STREAK (365D)";
    in-out property <string> habits-days-label: "days";
    in-out property <string> habits-completion-rate-label: "COMPLETION RATE";
    in-out property <string> habits-completions-label: "COMPLETIONS (30D)";

    // ==================== Rewards Extended (Sections/Buttons) ====================
    in-out property <string> rewards-streak-rewards-section: "STREAK REWARDS";
    in-out property <string> rewards-add-reward-button: "+ REWARD";
    in-out property <string> rewards-no-streak-rewards: "No streak rewards yet";
    in-out property <string> rewards-link-habit-desc: "Link a habit and set milestone rewards to stay motivated";
    in-out property <string> rewards-goals-section: "GOALS";
    in-out property <string> rewards-add-goal-button: "+ GOAL";
    in-out property <string> rewards-no-goals-set: "No goals set";
    in-out property <string> rewards-create-goal-desc: "Create a goal with checkpoints to track your progress";

    // ==================== Rewards Progress ====================
    in-out property <string> rewards-days-to-go: "days to go";

    // ==================== History Tab ====================
    in-out property <string> history-achievements-section: "ACHIEVEMENTS";
    in-out property <string> history-no-achievements: "No achievements yet";
    in-out property <string> history-complete-to-earn: "Complete goals to earn trophies";

    // ==================== Callback to reload translations ====================
    callback reload-translations();
}
