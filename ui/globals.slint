// ==================== Sanctum Design System - Globals ====================
// Noir Minimalist - Luxury-inspired, terminal elegance

// ==================== Color Palette ====================
// Near-black foundation with elegant whites and grays

export global Palette {
    // Core backgrounds
    out property <color> background: #000000;      // Pure black - Main content
    out property <color> surface: #111111;         // Slightly lighter - Cards
    out property <color> surface-hover: #1a1a1a;   // Hover state

    // Sidebar
    out property <color> sidebar-bg: #050505;      // Near-black sidebar
    out property <color> sidebar-border: #333333;  // Sidebar right border

    // Accent colors
    out property <color> accent: #ffffff;          // Pure white - Primary accent
    out property <color> accent-muted: #ffffff20;  // Transparent white
    out property <color> accent-hover: #ffffffcc;  // Slightly transparent white

    // Semantic colors
    out property <color> success: #22c55e;         // Green
    out property <color> danger: #ef4444;          // Red
    out property <color> warning: #f59e0b;         // Amber

    // Text colors
    out property <color> text-primary: #ffffff;    // Pure white - Titles
    out property <color> text-secondary: #a3a3a3;  // Gray - Body text
    out property <color> text-muted: #666666;      // Dark gray - Inactive items
    out property <color> text-subtle: #333333;     // Very dark - Footer

    // Border colors
    out property <color> border: #333333;          // Dark border
    out property <color> border-light: #ffffff;    // White border/lines
    out property <color> border-focus: #ffffff;    // Focus state
    out property <color> border-subtle: #222222;   // Very subtle borders

    // Spacing scale
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;
    out property <length> spacing-2xl: 48px;

    // Border radius
    out property <length> radius-sm: 2px;
    out property <length> radius-md: 4px;
    out property <length> radius-lg: 6px;

    // Typography
    out property <length> font-size-xs: 10px;
    out property <length> font-size-sm: 12px;
    out property <length> font-size-md: 14px;
    out property <length> font-size-lg: 18px;
    out property <length> font-size-xl: 24px;
    out property <length> font-size-2xl: 32px;
    out property <length> font-size-3xl: 48px;
}

// ==================== Data Structures ====================

export struct AccountData {
    id: string,
    name: string,
    account-type: string,   // "Bank", "Cash", "Credit", etc.
    currency: string,
    balance: string,        // Pre-formatted string e.g. "$ 12,500.00"
}

export struct TransactionData {
    id: string,
    date: string,           // Formatted date e.g. "2024-01-15"
    description: string,
    category: string,
    amount: string,         // Pre-formatted e.g. "- $ 50.00" or "+ $ 100.00"
    is-expense: bool,
}

// ==================== Authentication Adapter ====================
// Bridge between Slint UI and Rust backend

export global AuthAdapter {
    // Check if vault exists on disk
    pure callback check-vault-exists() -> bool;

    // Create new vault - returns "" on success, error message on failure
    callback create-vault(string) -> string;

    // Unlock vault - returns "" on success, error message on failure
    callback unlock-vault(string) -> string;

    // Lock vault - returns "" on success, error message on failure
    callback lock-vault() -> string;
}

// ==================== Account Adapter ====================
// Bridge for account management

export global AccountAdapter {
    // List of accounts (populated from Rust backend)
    in-out property <[AccountData]> accounts: [];

    // Callback to fetch/refresh accounts from Rust backend
    callback fetch-accounts();

    // Callback to create a new account
    callback create-account(string, string, string) -> string; // name, type, currency -> "" or error

    // Callback to delete an account
    callback delete-account(string) -> string; // id -> "" or error
}

// ==================== Transaction Adapter ====================
// Bridge for transaction management

// ==================== Categories ====================
// Predefined list of transaction categories

export global Categories {
    out property <[string]> expense-categories: [
        "FOOD",
        "TRANSPORT",
        "UTILITIES",
        "ENTERTAINMENT",
        "HEALTH",
        "SHOPPING",
        "EDUCATION",
        "OTHER"
    ];

    out property <[string]> income-categories: ["SALARY", "FREELANCE", "INVESTMENT", "GIFT", "OTHER"];
}

export global TransactionAdapter {
    // List of transactions (populated from Rust backend)
    in-out property <[TransactionData]> transactions: [];

    // Callback to fetch/refresh transactions from Rust backend
    callback fetch-transactions();

    // Callback to add a new transaction
    // (account_id, amount, category, description, is_expense) -> "" or error
    callback add-transaction(string, string, string, string, bool) -> string;

    // Callback to delete a transaction
    callback delete-transaction(string) -> string; // id -> "" or error
}

// ==================== Application State ====================
// Global state management

export global AppState {
    // Authentication state
    in-out property <bool> is-logged-in: false;

    // Current active page in sidebar navigation
    in-out property <string> active-page: "dashboard";

    // Loading state
    in-out property <bool> is-loading: false;

    // Modal states
    in-out property <bool> show-add-transaction: false;
    in-out property <bool> show-add-account: false;
}
