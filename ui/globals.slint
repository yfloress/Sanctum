// ==================== Sanctum Globals ====================
// Data structures, adapters and application state
// Colors and design tokens are in theme.slint

import { Theme } from "theme.slint";

// ==================== Data Structures ====================

export struct AccountData {
    id: string,
    name: string,
    account-type: string,   // "Bank", "Cash", "Credit", etc.
    account-type-key: string, // raw key: bank/cash/savings/credit_card/other
    icon: image,
    icon-path: string,
    currency: string,
    balance: string,        // Pre-formatted string e.g. "$ 12,500.00"
    balance-negative: bool,
    initial-balance: string, // Raw decimal string e.g. "12500.00"
    is-archived: bool,
}

export struct TransactionData {
    id: string,
    account-id: string,
    account-index: int,
    transfer-account-id: string,
    transfer-account-index: int,
    date: string,           // Formatted date e.g. "2024-01-15"
    description: string,
    description-raw: string,
    category: string,
    category-raw: string,
    category-index: int,
    amount: string,         // Pre-formatted e.g. "- $ 50.00" or "+ $ 100.00"
    amount-raw: string,
    is-expense: bool,
    is-transfer: bool,
}

export struct ImportErrorData {
    line: int,
    field: string,
    line-label: string,
    field-label: string,
    message: string,
    raw-data: string,
}

export struct ImportPreviewChange {
    change-type: string,
    summary: string,
    details: string,
}

export struct BalanceData {
    total-balance: string,
    fiat-balance: string,
    crypto-value: string,
}

export struct CategoryData {
    name: string,
    amount: string,
    percentage: float,
    color: color,
}

export struct AnalyticsData {
    chart_image: image,
    net_worth: string,
    max_value: string,
    min_value: string,
    expense_breakdown: [CategoryData],
}

// ==================== Analytics Adapter ====================

export global AnalyticsAdapter {
    in-out property <AnalyticsData> summary;
    in-out property <string> active-range: "1M"; // 1M, 6M, 1Y, ALL

    callback fetch-analytics(string); // range
}

// ==================== Habit Adapter ====================

export struct HabitDay {
    day: int,
    completed: bool,
    date: string, // YYYY-MM-DD
    is-future: bool,
}

export struct HeatmapDay {
    date: string,
    count: int,
    level: int, // 0-4 intensity
}

export struct HeatmapWeek {
    days: [HeatmapDay],
}

export struct HabitData {
    id: string,
    name: string,
    description: string,
    color: color,
    color-hex: string,
    color-index: int,
    category: string,
    streak: int,
    best-streak: int,
    completion-rate: int,
    days: [HabitDay], // Array of days for the current month
}

// Habit Analytics Structs
export struct WeekdayEfficiencyData {
    day-name: string,
    day-short: string,
    avg-count: float,
    is-best: bool,
    bar-height-percent: float,
}

export global HabitAdapter {
    in-out property <[HabitData]> habits: [];
    in-out property <string> current-month-name: "";
    in-out property <int> current-year;
    in-out property <int> current-month-index: 1;
    in-out property <string> selected-habit-id: "";
    in-out property <int> selected-habit-index: 0;  // Index of selected habit in habits array
    in-out property <string> summary-habit-name: "";
    in-out property <color> summary-habit-color: Theme.accent;
    in-out property <int> summary-current-streak: 0;
    in-out property <int> summary-best-streak: 0;
    in-out property <int> summary-completion-rate: 0;
    in-out property <string> summary-completion-note: "";
    in-out property <int> summary-last-30: 0;
    in-out property <string> summary-best-day: "";

    // Heatmap
    in-out property <[HeatmapWeek]> heatmap-data: [];
    in-out property <int> heatmap-year;

    // Actions
    callback fetch-habits(int, int); // month (1-12), year
    callback fetch-heatmap-data(); // Load last 365 days
    callback load-initial-data(); // Load current month on startup
    callback create-habit(string, string, string, string) -> string; // name, desc, color, category -> error or ""
    callback update-habit(string, string, string, string, string) -> string; // id, name, desc, color, category -> error or ""
    callback toggle-habit(string, string); // id, date
    callback delete-habit(string) -> string;
    callback select-habit(string); // id
    callback find-habit-index(string) -> int; // habit-id -> index in habits array
    // Edit state
    in-out property <string> edit-id: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-description: "";
    in-out property <string> edit-color-hex: "";
    in-out property <int> edit-color-index: 0;
    in-out property <string> edit-category: "";

    // Navigation
    callback prev-month();
    callback next-month();

    // Auto-scroll context
    in-out property <int> current-day-int: 1; // 1-31 (Real today)
    in-out property <int> current-week-int: 1; // 1-52 (Real current week)
    in-out property <bool> is-viewing-current-month: true; // True if navigating actual current month
    in-out property <bool> auto-scroll-habits: true; // Only auto-center when entering Habits
    in-out property <length> habits-scroll-x: 0px;

    // Heatmap Navigation
    callback prev-heatmap-year();
    callback next-heatmap-year();

    // Habit Analytics
    in-out property <image> habits-radar-chart-image;
    in-out property <bool> habits-radar-has-data: false;
    in-out property <image> habits-weekday-chart-image;
    in-out property <bool> habits-weekday-has-data: false;
    in-out property <string> habits-weekly-primary: "";
    in-out property <string> habits-weekly-secondary: "";
    in-out property <string> habits-insight-primary: "";
    in-out property <string> habits-insight-secondary: "";
    callback fetch-habit-analytics();
}

// ==================== Rewards Adapter ====================

export struct MilestoneData {
    id: string,
    target-days: int,
    reward-text: string,
    unlocked: bool,
    unlocked-at: string,
}

export struct StreakRewardData {
    id: string,
    habit-id: string,
    habit-name: string,
    habit-color: color,
    is-consecutive: bool,       // true = consecutive, false = accumulative
    target-days: int,           // For accumulative: X of Y
    target-total: int,          // For accumulative: Y total days
    current-progress: int,      // Current days completed
    milestones: [MilestoneData],
    next-milestone-days: int,
    next-milestone-reward: string,
    progress-percent: float,
}

export struct CheckpointData {
    id: string,
    description: string,
    completed: bool,
    completed-at: string,
    sort-order: int,
}

export struct GoalData {
    id: string,
    name: string,
    description: string,
    reward-text: string,
    deadline: string,           // ISO date or empty
    checkpoints: [CheckpointData],
    completed-count: int,
    total-count: int,
    progress-percent: float,
    is-completed: bool,
    completed-at: string,
}

export struct AchievementData {
    id: string,
    title: string,
    description: string,
    icon: image,
    achieved-at: string,
    achievement-type: string,   // "streak" | "goal"
}

export global RewardsAdapter {
    // Data
    in-out property <[StreakRewardData]> streak-rewards: [];
    in-out property <[GoalData]> goals: [];
    in-out property <[AchievementData]> achievements: [];

    // UI State
    in-out property <string> active-tab: "rewards";  // "rewards" | "goals" | "history"

    // Streak Reward CRUD
    callback create-streak-reward(string,     // habit-id
        bool,       // is-consecutive
        int,        // target-days (for accumulative)
        int         // target-total (for accumulative)
    ) -> string;
    callback add-milestone(string, int, string) -> string;  // reward-id, days, reward-text
    callback delete-streak-reward(string) -> string;
    // Update reward with milestones: id, habit-id, is-consecutive, target-days, target-total
    // Milestones passed via edit-reward-m1/m2/m3 properties
    callback update-streak-reward(string, string, bool, int, int) -> string;

    // Goal CRUD
    callback create-goal(string, string, string, string) -> string;  // name, description, reward, deadline
    callback update-goal(string, string, string, string, string) -> string;  // id, name, description, reward, deadline
    callback update-goal-with-checkpoints(
        string, // id
        string, // name
        string, // description
        string, // reward
        string, // deadline
        int,    // checkpoint count
        string, // cp1 id
        string, // cp1 text
        string, // cp2 id
        string, // cp2 text
        string, // cp3 id
        string, // cp3 text
        string, // cp4 id
        string  // cp4 text
    ) -> string;
    callback add-checkpoint(string, string) -> string;  // goal-id, description
    callback update-checkpoint(string, string) -> string;  // checkpoint-id, description
    callback delete-checkpoint(string) -> string;  // checkpoint-id
    callback toggle-checkpoint(string, string) -> string;  // goal-id, checkpoint-id
    callback delete-goal(string) -> string;
    callback complete-goal(string) -> string;
    callback archive-goal(string) -> string;  // Archive completed goal (moves to history)

    // Data loading
    callback fetch-rewards();
    callback fetch-goals();
    callback fetch-achievements();

    // Edit state for modals
    in-out property <string> edit-reward-id: "";
    in-out property <string> edit-goal-id: "";

    // Edit data for streak reward
    in-out property <string> edit-reward-habit-id: "";
    in-out property <int> edit-reward-habit-index: -1;
    in-out property <bool> edit-reward-is-consecutive: true;
    in-out property <int> edit-reward-target-days: 0;
    in-out property <int> edit-reward-target-total: 0;
    in-out property <int> edit-reward-m1-days: 7;
    in-out property <string> edit-reward-m1-text: "";
    in-out property <int> edit-reward-m2-days: 0;
    in-out property <string> edit-reward-m2-text: "";
    in-out property <int> edit-reward-m3-days: 0;
    in-out property <string> edit-reward-m3-text: "";
    in-out property <int> edit-reward-milestone-count: 1;

    // Edit data for goal
    in-out property <string> edit-goal-name: "";
    in-out property <string> edit-goal-description: "";
    in-out property <string> edit-goal-reward: "";
    in-out property <string> edit-goal-deadline: "";
    in-out property <int> edit-goal-checkpoint-count: 0;
    in-out property <string> edit-goal-cp1-id: "";
    in-out property <string> edit-goal-cp1-text: "";
    in-out property <string> edit-goal-cp2-id: "";
    in-out property <string> edit-goal-cp2-text: "";
    in-out property <string> edit-goal-cp3-id: "";
    in-out property <string> edit-goal-cp3-text: "";
    in-out property <string> edit-goal-cp4-id: "";
    in-out property <string> edit-goal-cp4-text: "";
}

// ==================== Notification Adapter ====================

export global NotificationAdapter {
    in-out property <string> message: "";
    in-out property <bool> is-error: false;
    in-out property <bool> active: false;

    // Call this to show a message
    callback show(string, bool);
}

// ==================== Authentication Adapter ====================
// Bridge between Slint UI and Rust backend

export global AuthAdapter {
    // Check if vault exists on disk
    pure callback check-vault-exists() -> bool;

    // Create new vault - returns "" on success, error message on failure
    callback create-vault(string) -> string;

    // Returns warning message for weak passwords ("" if strong/ok)
    callback check-password-strength(string) -> string;

    // Unlock vault - returns "" on success, error message on failure
    callback unlock-vault(string) -> string;

    // Lock vault - returns "" on success, error message on failure
    callback lock-vault() -> string;
}

// ==================== Account Adapter ====================
// Bridge for account management

export global AccountAdapter {
    // List of accounts (populated from Rust backend)
    in-out property <[AccountData]> accounts: [];
    in-out property <string> total-balance: "$ 0.00";
    in-out property <bool> total-balance-negative: false;
    in-out property <bool> is-loading: false;
    in-out property <string> edit-account-id: "";
    in-out property <string> edit-account-icon: "";
    in-out property <string> selected-account-id: "";
    in-out property <string> selected-account-name: "";
    in-out property <string> selected-account-type: "";
    in-out property <string> selected-account-currency: "";
    in-out property <string> selected-account-balance: "$ 0.00";
    in-out property <bool> selected-account-balance-negative: false;
    in-out property <image> selected-account-icon;
    in-out property <string> selected-account-icon-path: "";
    in-out property <[TransactionData]> account-history: [];
    in-out property <bool> show-account-detail: false;

    // Callback to fetch/refresh accounts from Rust backend
    callback fetch-accounts();
    callback fetch-account-details(string); // account_id

    // Callback to create a new account
    callback create-account(string, string, string, string) -> string; // name, type, currency, initial -> "" or error

    // Callback to update an account
    callback update-account(string, string, string, string, string) -> string; // id, name, type, currency, initial -> "" or error

    // Callback to delete an account
    callback delete-account(string) -> string; // id -> "" or error
    callback update-account-icon(string, string) -> string; // id, icon_path -> "" or error
    callback update-account-name(string, string) -> string; // id, new_name -> "" or error

    // Transfer funds between accounts
    callback transfer-funds(string, string, string, string, string) -> string; // from, to, amount, description, date
    callback update-transfer(string, string, string, string, string, string) -> string; // id, from, to, amount, description, date
}

// ==================== Settings Adapter ====================

export global SettingsAdapter {
    in-out property <bool> auto-fetch-enabled: false;
    in-out property <bool> proxy-enabled: false;
    in-out property <string> proxy-url: "";
    in-out property <bool> dark-mode: true;  // Default to dark theme
    in-out property <int> session-timeout: 900;  // Default 15 min (in seconds)
    in-out property <string> preferred-currency: "USD";  // Default currency
    in-out property <string> preferred-language: "en";  // Default language (en/es)
    in-out property <string> login-wallpaper-name: "";

    // Callback to load settings from backend
    callback load-settings();

    // Callback to toggle auto-fetch setting
    callback set-auto-fetch(bool);

    // Callback to toggle proxy usage
    callback set-proxy-enabled(bool);

    // Callback to update proxy URL
    callback set-proxy-url(string);

    // Callback to toggle dark mode
    callback set-dark-mode(bool);

    // Callback to set session timeout (in seconds)
    callback set-session-timeout(int);

    // Callback to set preferred currency
    callback set-preferred-currency(string);

    // Callback to set preferred language
    callback set-preferred-language(string);

    // Callback to select login wallpaper
    callback select-login-wallpaper();

    // Callback to reset login wallpaper to default
    callback reset-login-wallpaper();

    // Callback to persist sidebar collapsed state
    callback set-sidebar-collapsed(bool);

    // Callback to reset all settings to defaults
    callback reset-settings();
}

// ==================== Ingestion Adapter ====================

export global IngestionAdapter {
    in-out property <string> import-file-name: "";
    in-out property <string> import-format: "";
    in-out property <string> import-data-type: "";
    in-out property <int> import-total-processed: 0;
    in-out property <int> import-inserted: 0;
    in-out property <int> import-skipped: 0;
    in-out property <int> import-errors: 0;
    in-out property <[ImportErrorData]> import-error-details: [];
    in-out property <[string]> import-skipped-reasons: [];
    in-out property <[ImportPreviewChange]> import-preview-changes: [];

    callback import-data();
    callback confirm-import();
    callback cancel-preview();
    callback reset-results();
}

// ==================== Vault Adapter ====================

export global VaultAdapter {
    in-out property <string> restore-backup-path: "";  // Path to selected backup file
    in-out property <bool> has-pre-restore-backup: false;

    // Callbacks
    callback export-vault();        // Opens file save dialog and exports vault
    callback restore-vault();       // Opens file picker and shows confirmation modal
    callback confirm-restore();     // Actually performs the restore operation
    callback rollback-restore();    // Rollback to pre-restore backup
}

// ==================== Crypto Adapter ====================

export struct CryptoAssetData {
    id: string,
    symbol: string,
    icon: image,
    name: string,
    price: string,          // Formatted "$ 65,000.00"
    amount: string,         // Formatted "0.5 BTC"
    value: string,          // Formatted "$ 32,500.00"
    change-24h: string,     // Formatted "+ 2.5%"
    is-positive: bool,      // For coloring change
    allocation: float,      // 0.0 to 1.0
}

export struct CryptoDistributionSlice {
    label: string,
    value: string,
    percent: string,
    color: color,
}

export struct CryptoWalletData {
    id: string,
    name: string,
    category: string,       // exchange, hardware, software
    icon: image,            // loaded SVG icon
    balance: string,        // Formatted total value
    asset-count: int,
}

export struct WalletSimple {
    id: string,
    name: string,
}

export struct AssetWalletBreakdown {
    wallet-name: string,
    amount: string,
    value: string,
}

export struct AssetTransaction {
    id: string,
    date: string,
    type: string,
    amount: string,
    price: string,
    fee: string,
    notes: string,
    is-swap: bool,
}

export struct TickerOption {
    id: string,
    name: string,
    symbol: string,
    enabled: bool,
    custom: bool,
    visible: bool,
}

export struct CatalogCoin {
    id: string,
    name: string,
    symbol: string,
    custom: bool,
    favorite: bool,
    visible: bool,
    selected: bool,
}

export global CryptoAdapter {
    in-out property <[CryptoAssetData]> portfolio: [];
    in-out property <string> portfolio-summary: "";
    in-out property <[CryptoAssetData]> market-tickers: [];
    in-out property <[CryptoWalletData]> wallets: [];
    in-out property <[WalletSimple]> wallet-list: []; // For dropdowns
    in-out property <[CatalogCoin]> coin-catalog: [];
    in-out property <int> default-wallet-index: 0;
    in-out property <int> default-coin-index: 0;

    // Config
    in-out property <[TickerOption]> ticker-options: [];
    callback load-ticker-options();
    callback save-ticker-options();
    callback filter-ticker-options(string);
    callback load-coin-catalog();
    callback filter-coin-catalog(string);
    callback add-custom-coin(string, string, string) -> string; // id, name, symbol
    callback delete-custom-coin(string) -> string; // id
    callback set-favorite-coin(string, bool) -> string; // id, favorite
    callback select-all-coins();
    callback clear-coin-selection();
    callback delete-selected-coins() -> string;

    // Asset Detail View Data
    in-out property <CryptoAssetData> selected-asset;
    in-out property <[AssetWalletBreakdown]> asset-wallets: [];
    in-out property <[AssetTransaction]> asset-history: [];
    in-out property <bool> show-asset-detail: false;

    // Wallet Detail View Data
    in-out property <string> selected-wallet-id: "";
    in-out property <string> selected-wallet-name: "";
    in-out property <string> selected-wallet-category: "";
    in-out property <string> selected-wallet-balance: "$ 0.00";
    in-out property <[CryptoAssetData]> wallet-holdings: [];
    in-out property <[AssetTransaction]> wallet-history: [];
    in-out property <bool> show-wallet-detail: false;
    in-out property <image> selected-wallet-icon;
    in-out property <string> selected-wallet-category-key: "";
    in-out property <string> selected-wallet-icon-path: "";

    in-out property <string> total-value: "$ 0.00";
    in-out property <string> total-pnl: "+ $ 0.00";
    in-out property <bool> total-pnl-positive: true;
    in-out property <string> clp-rate: "...";
    in-out property <string> last-updated: "Never";
    in-out property <bool> is-refreshing: false;
    in-out property <bool> is-loading: false;
    in-out property <image> portfolio-trend-image;
    in-out property <bool> portfolio-trend-ready: false;
    in-out property <image> portfolio-chart-image;
    in-out property <bool> portfolio-chart-ready: false;
    in-out property <[CryptoDistributionSlice]> portfolio-distribution: [];
    in-out property <bool> limit-reached: false;
    in-out property <string> limit-excluded: "";

    // Edit Transaction State
    in-out property <string> edit-tx-id: "";
    in-out property <string> edit-wallet-id: "";
    in-out property <string> edit-wallet-name: "";
    in-out property <string> edit-coin-id: "";
    in-out property <string> edit-symbol: "";
    in-out property <string> edit-type: "";
    in-out property <string> edit-amount: "";
    in-out property <string> edit-price: "";
    in-out property <string> edit-fee: "";
    in-out property <string> edit-fee-coin-id: "";
    in-out property <string> edit-fee-coin-amount: "";
    in-out property <string> edit-date: "";
    in-out property <string> edit-notes: "";

    // Actions
    callback fetch-portfolio();
    callback fetch-wallets();
    callback fetch-wallet-details(string); // wallet_id
    callback refresh-prices();
    callback refresh-prices-silent(); // auto-fetch without notifications
    callback fetch-asset-details(string); // coin_id
    callback get-last-price(string) -> string; // coin_id -> price string
    callback get-swap-quote(string, string, string) -> string; // from_coin_id, to_coin_id, from_amount -> to_amount
    callback get-available-balance(string, string, string) -> string; // wallet_id, coin_id, date -> balance string
    callback load-edit-transaction(string) -> string; // tx_id -> "" or error

    // (wallet_id, coin_id, symbol, type, amount, price, fee, fee_coin_id, fee_coin_amount, date, notes)
    callback add-transaction(string, string, string, string, string, string, string, string, string, string, string) -> string;
    // (from_wallet_id, to_wallet_id, coin_id, symbol, from_amount, to_amount, fee, fee_coin_id, fee_coin_amount, date, notes)
    callback add-transfer(string, string, string, string, string, string, string, string, string, string, string) -> string;
    // (wallet_id, from_coin_id, from_symbol, from_amount, to_coin_id, to_symbol, to_amount, fee, fee_coin_id, fee_coin_amount, date, notes)
    callback add-swap(string, string, string, string, string, string, string, string, string, string, string, string) -> string;
    // (tx_id, amount, price, fee, fee_coin_id, fee_coin_amount, date, notes)
    callback update-transaction(string, string, string, string, string, string, string, string) -> string;

    // (name, category) -> id or error
    callback create-wallet(string, string) -> string;
    callback create-wallet-with-icon(string, string, string) -> string; // (name, category, icon) -> "" or error
    callback delete-wallet(string) -> string;
    callback update-wallet-name(string, string) -> string; // (wallet_id, new_name) -> "" or error
    callback update-wallet-icon(string, string) -> string; // (wallet_id, icon_path) -> "" or error
    callback delete-crypto-transaction(string) -> string;

    // Wallet icon editor state
    in-out property <string> icon-edit-wallet-id: "";
    in-out property <string> icon-edit-wallet-category: "";
    in-out property <string> icon-edit-wallet-icon: "";
}

// ==================== Transaction Adapter ====================
// Bridge for transaction management

// ==================== Transaction Categories ====================
// Dynamic category management system

export struct TransactionCategoryData {
    id: string,
    name: string,
    is-default: bool,
}

export global CategoryAdapter {
    in-out property <[TransactionCategoryData]> expense-categories: [];
    in-out property <[TransactionCategoryData]> income-categories: [];

    callback load-categories();
    callback add-category(string, string) -> string; // (name, type) -> "" or error
    callback update-category(string, string) -> string; // (id, name) -> "" or error
    callback delete-category(string) -> string; // (id) -> "" or error
}

export global TransactionAdapter {
    // List of transactions (populated from Rust backend)
    in-out property <[TransactionData]> transactions: [];
    in-out property <bool> is-loading: false;
    in-out property <string> filter-query: "";
    in-out property <string> filter-account-id: "";
    in-out property <string> filter-category: "";
    in-out property <int> display-limit: 100;
    in-out property <bool> has-more: false;

    // Callback to fetch/refresh transactions from Rust backend
    callback fetch-transactions();

    // Callback to add a new transaction
    // (account_id, amount, category, description, date, is_expense) -> "" or error
    callback add-transaction(string, string, string, string, string, bool) -> string;

    // Callback to update a transaction
    // (id, account_id, amount, category, description, date, is_expense) -> "" or error
    callback update-transaction(string, string, string, string, string, string, bool) -> string;

    // Callback to delete a transaction
    callback delete-transaction(string) -> string; // id -> "" or error
}

// ==================== Dashboard Adapter ====================
// Balance summary and recent activity

export global DashboardAdapter {
    in-out property <BalanceData> balance: { total-balance: "$ 0.00", fiat-balance: "$ 0.00", crypto-value: "$ 0.00" };
    in-out property <[TransactionData]> recent: [];
    in-out property <bool> is-loading: false;
    in-out property <bool> has-error: false;
    in-out property <string> error-message: "";
    in-out property <bool> missing-exchange-rate: false;

    callback fetch-balance();
    callback fetch-recent();
}

// ==================== Application State ====================
// Global state management

export global AppState {
    // Authentication state
    in-out property <bool> is-logged-in: false;

    // Current active page in sidebar navigation
    in-out property <string> active-page: "dashboard";

    // Loading state
    in-out property <bool> is-loading: false;

    // Modal states
    in-out property <bool> show-add-transaction: false;
    in-out property <bool> transaction-edit-mode: false;
    in-out property <int> selected-transaction-index: 0;
    in-out property <bool> show-add-account: false;
    in-out property <bool> account-edit-mode: false;
    in-out property <int> selected-account-index: 0;
    in-out property <bool> show-transfer-modal: false;
    in-out property <bool> transfer-edit-mode: false;
    in-out property <int> selected-transfer-index: 0;
    in-out property <bool> show-add-habit: false;
    in-out property <bool> show-configure-categories: false;
    in-out property <bool> show-edit-habit: false;
    in-out property <bool> show-add-crypto: false;
    in-out property <bool> show-edit-crypto: false;
    in-out property <bool> show-add-wallet: false;
    in-out property <bool> show-edit-wallet-icon: false;
    in-out property <bool> show-configure-ticker: false;
    in-out property <bool> show-edit-account-icon: false;

    // Rewards modals
    in-out property <bool> show-add-reward: false;
    in-out property <bool> show-edit-reward: false;
    in-out property <bool> show-add-goal: false;
    in-out property <bool> show-edit-goal: false;

    // Vault restore modal
    in-out property <bool> show-restore-vault: false;

    // Import results modal
    in-out property <bool> show-import-preview: false;
    in-out property <bool> show-import-results: false;

    // Current date (YYYY-MM-DD), set from backend to avoid hardcoded defaults
    in-out property <string> current-date: "0000-00-00";

    // Sidebar layout preference
    in-out property <bool> sidebar-collapsed: false;

    // Login wallpaper (optional)
    in-out property <image> login-wallpaper: @image-url("assets/backgrounds/login_default.jpg");
    in-out property <bool> login-wallpaper-custom: false;
}
