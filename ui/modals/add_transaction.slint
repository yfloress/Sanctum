// ==================== Add Transaction Modal ====================
// Premium Fintech UI - Overlay form for adding new transactions

import {
    AppState,
    TransactionAdapter,
    CategoryAdapter,
    TransactionCategoryData,
    AccountAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        // Label
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        // Input container
        Rectangle {
            height: large ? 56px : 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                // Placeholder
                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }
    }
}

// ==================== CategorySelector ====================
component CategorySelector inherits Rectangle {
    in property <string> label: "CATEGORY";
    in property <[TransactionCategoryData]> categories: [];
    in-out property <int> selected-index: 0;
    property <int> safe-index: selected-index < categories.length ? selected-index : 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: categories.length > 0 ? categories[safe-index].name : "Select...";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(categories.length * 40px + 8px, 280px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: categories.length * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for category[index] in categories: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: category.name;
                                color: index == safe-index ? Theme.text-primary : Theme.text-secondary;
                                font-size: 13px;
                                font-weight: index == safe-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == safe-index: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== AccountSelector ====================
component AccountSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    property <int> safe-index: selected-index < AccountAdapter.accounts.length ? selected-index : 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: Translations.modal-account;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: AccountAdapter.accounts.length > 0 ? AccountAdapter.accounts[safe-index].name : "No accounts";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(AccountAdapter.accounts.length * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name + " (" + account.currency + ")";
                                color: index == safe-index ? Theme.text-primary : Theme.text-secondary;
                                font-size: 13px;
                                font-weight: index == safe-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == safe-index: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== TypeToggle ====================
component TypeToggle inherits Rectangle {
    in-out property <bool> is-expense: true;

    height: 48px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        // Expense button
        Rectangle {
            horizontal-stretch: 1;
            background: is-expense ? @linear-gradient(135deg, Theme.toggle-expense-start 0%, Theme.toggle-expense-end 100%) : transparent;
            border-radius: 8px;
            border-width: is-expense ? 1px : 0px;
            border-color: Theme.toggle-expense-border;

            animate background {
                duration: 200ms;
                easing: ease-out;
            }

            Text {
                text: Translations.modal-expense;
                color: is-expense ? Theme.danger : Theme.text-muted;
                font-size: 11px;
                font-weight: is-expense ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is-expense = true;
                }
            }
        }

        // Income button
        Rectangle {
            horizontal-stretch: 1;
            background: !is-expense ? @linear-gradient(135deg, Theme.toggle-income-start 0%, Theme.toggle-income-end 100%) : transparent;
            border-radius: 8px;
            border-width: !is-expense ? 1px : 0px;
            border-color: Theme.toggle-income-border;

            animate background {
                duration: 200ms;
                easing: ease-out;
            }

            Text {
                text: Translations.modal-income;
                color: !is-expense ? Theme.success : Theme.text-muted;
                font-size: 11px;
                font-weight: !is-expense ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is-expense = false;
                }
            }
        }
    }
}

// ==================== AddTransactionModal ====================
export component AddTransactionModal inherits Rectangle {
    in property <bool> editing: false;
    in property <int> selected-index: 0;

    property <bool> did-init: false;

    property <string> amount-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].amount-raw : "";
    property <string> description-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].description : "";
    property <int> category-index: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].category-index : 0;
    property <string> date-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].date : AppState.current-date;
    property <bool> is-expense: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].is-expense : true;
    property <int> account-index: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].account-index : 0;

    property <[TransactionCategoryData]> current-categories: is-expense ? CategoryAdapter.expense-categories : CategoryAdapter.income-categories;

    init => {
        CategoryAdapter.load-categories();
        AccountAdapter.fetch-accounts();
        key-scope.focus();
        did-init = true;
    }

    changed is-expense => {
        if (did-init) {
            category-index = 0;
        }
    }

    function reset-form() {
        amount-value = "";
        description-value = "";
        category-index = 0;
        date-value = AppState.current-date;
        is-expense = true;
        account-index = 0;
        AppState.transaction-edit-mode = false;
        AppState.selected-transaction-index = 0;
    }

    function submit() {
        if (AccountAdapter.accounts.length == 0) {
            NotificationAdapter.show("Create an account first", true);
            return;
        }
        if (current-categories.length == 0) {
            NotificationAdapter.show("Add a category first", true);
            return;
        }
        if (amount-value == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }
        if (account-index >= AccountAdapter.accounts.length) {
            account-index = 0;
        }
        let account-id = AccountAdapter.accounts[account-index].id;
        let safe-category-index = category-index >= current-categories.length ? 0 : category-index;
        let category-name = current-categories[safe-category-index].name;

        let safe-index = selected-index >= TransactionAdapter.transactions.length ? 0 : selected-index;
        let edit-id = TransactionAdapter.transactions.length > 0 ? TransactionAdapter.transactions[safe-index].id : "";
        if (editing && edit-id == "") {
            NotificationAdapter.show("Transaction no longer available", true);
            return;
        }
        let result = editing ? TransactionAdapter.update-transaction(
            edit-id,
            account-id,
            amount-value,
            category-name,
            description-value,
            date-value,
            is-expense) : TransactionAdapter.add-transaction(
            account-id,
            amount-value,
            category-name,
            description-value,
            date-value,
            is-expense);

        if (result == "") {
            root.reset-form();
            AppState.show-add-transaction = false;
            TransactionAdapter.is-loading = true;
            AccountAdapter.is-loading = true;
            TransactionAdapter.fetch-transactions();
            AccountAdapter.fetch-accounts();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-add-transaction = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset-form();
                AppState.show-add-transaction = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Theme.modal-width-md, parent.width - 40px);
        height: min(Theme.modal-height-compact, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? "EDIT ENTRY" : "NEW ENTRY";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-add-transaction = false;
                        }
                    }
                }
            }

            body := Flickable {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        key-scope.focus();
                    }
                }

                VerticalLayout {
                    width: parent.width;
                    spacing: 20px;

                    // Type toggle
                    TypeToggle {
                        is-expense <=> root.is-expense;
                    }

                    // Account selector
	                    if AccountAdapter.accounts.length > 0: AccountSelector {
                        selected-index <=> account-index;
                    }

                    if AccountAdapter.accounts.length == 0: Rectangle {
                        height: 48px;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.modal-no-accounts;
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Amount field
	                    FormField {
                        label: "AMOUNT";
                        placeholder: "0.00";
                        value <=> amount-value;
                        large: true;
                    }

                    // Category selector
                    CategorySelector {
                        label: "CATEGORY";
                        categories: current-categories;
                        selected-index <=> category-index;
                    }

                    // Description field
	                    FormField {
                        label: "DESCRIPTION (OPTIONAL)";
                        placeholder: "Add a note...";
                        value <=> description-value;
                    }

                    // Date field
	                    FormField {
                        label: "DATE";
                        placeholder: "YYYY-MM-DD";
                        value <=> date-value;
                    }

                    Rectangle {
                        height: 8px;
                    }
                }
            }

            // Submit button
	            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                border-radius: 10px;

                animate background { duration: 150ms; }

                Text {
                    text: editing ? "SAVE CHANGES" : "SAVE ENTRY";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
