// ==================== Add Transaction Modal ====================
// Premium Fintech UI - Overlay form for adding new transactions

import {
    Palette,
    AppState,
    TransactionAdapter,
    Categories,
    AccountAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        // Label
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        // Input container
        Rectangle {
            height: large ? 56px : 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                // Placeholder
                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== CategorySelector ====================
component CategorySelector inherits Rectangle {
    in property <string> label: "CATEGORY";
    in property <[string]> categories: [];
    in-out property <int> selected-index: 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: categories.length > 0 ? categories[selected-index] : "Select...";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(categories.length * 40px + 8px, 280px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: categories.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for category[index] in categories: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: category;
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== AccountSelector ====================
component AccountSelector inherits Rectangle {
    in-out property <int> selected-index: 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: "ACCOUNT";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: AccountAdapter.accounts.length > 0 ? AccountAdapter.accounts[selected-index].name : "No accounts";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(AccountAdapter.accounts.length * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name + " (" + account.currency + ")";
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== TypeToggle ====================
component TypeToggle inherits Rectangle {
    in-out property <bool> is-expense: true;

    height: 48px;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        // Expense button
        Rectangle {
            horizontal-stretch: 1;
            background: is-expense 
                ? @linear-gradient(135deg, #3d1f2f 0%, #2d1520 100%)
                : transparent;
            border-radius: 8px;
            border-width: is-expense ? 1px : 0px;
            border-color: #5d2f4f;

            animate background { duration: 200ms; easing: ease-out; }

            Text {
                text: "EXPENSE";
                color: is-expense ? Palette.danger : Palette.text-muted;
                font-size: 11px;
                font-weight: is-expense ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.is-expense = true; }
            }
        }

        // Income button
        Rectangle {
            horizontal-stretch: 1;
            background: !is-expense 
                ? @linear-gradient(135deg, #1f3d2f 0%, #152d20 100%)
                : transparent;
            border-radius: 8px;
            border-width: !is-expense ? 1px : 0px;
            border-color: #2f5d4f;

            animate background { duration: 200ms; easing: ease-out; }

            Text {
                text: "INCOME";
                color: !is-expense ? Palette.success : Palette.text-muted;
                font-size: 11px;
                font-weight: !is-expense ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.is-expense = false; }
            }
        }
    }
}

// ==================== AddTransactionModal ====================
export component AddTransactionModal inherits Rectangle {
    property <string> amount-value: "";
    property <string> description-value: "";
    property <int> category-index: 0;
    property <string> date-value: AppState.current-date;
    property <bool> is-expense: true;
    property <int> account-index: 0;

    property <[string]> current-categories: is-expense ? Categories.expense-categories : Categories.income-categories;

    function reset-form() {
        amount-value = "";
        description-value = "";
        category-index = 0;
        date-value = AppState.current-date;
        is-expense = true;
        account-index = 0;
    }

    function submit() {
        if (AccountAdapter.accounts.length == 0) {
            NotificationAdapter.show("Create an account first", true);
            return;
        }
        if (amount-value == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        if (account-index >= AccountAdapter.accounts.length) {
            account-index = 0;
        }
        let account-id = AccountAdapter.accounts[account-index].id;

        let result = TransactionAdapter.add-transaction(
            account-id,
            amount-value,
            current-categories[category-index],
            description-value,
            date-value,
            is-expense);

        if (result == "") {
            root.reset-form();
            AppState.show-add-transaction = false;
            TransactionAdapter.fetch-transactions();
            AccountAdapter.fetch-accounts();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-add-transaction = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 640px;
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, #0f0f1a 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000088;

        TouchArea {
            clicked => { key-scope.focus(); }
        }

	        VerticalLayout {
	            padding: 32px;
	            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: "NEW ENTRY";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-add-transaction = false;
                        }
                    }
                }
	            }
	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;

	                TouchArea {
	                    width: parent.width;
	                    height: parent.height;
	                    clicked => { key-scope.focus(); }
	                }

	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 20px;
	
	                    // Type toggle
	                    TypeToggle {
	                        is-expense <=> root.is-expense;
	                    }
	
	                    // Account selector
	                    if AccountAdapter.accounts.length > 0: AccountSelector {
	                        selected-index <=> account-index;
	                    }
	
	                    if AccountAdapter.accounts.length == 0: Rectangle {
	                        height: 48px;
	                        background: Palette.surface;
	                        border-radius: 8px;
	                        border-width: 1px;
	                        border-color: Palette.border;
	
	                        Text {
	                            text: "No accounts available. Create one first.";
	                            color: Palette.text-muted;
	                            font-size: 12px;
	                            horizontal-alignment: center;
	                            vertical-alignment: center;
	                        }
	                    }
	
	                    // Amount field
	                    FormField {
	                        label: "AMOUNT";
	                        placeholder: "0.00";
	                        value <=> amount-value;
	                        large: true;
	                    }
	
	                    // Category selector
	                    CategorySelector {
	                        label: "CATEGORY";
	                        categories: current-categories;
	                        selected-index <=> category-index;
	                    }
	
	                    // Description field
	                    FormField {
	                        label: "DESCRIPTION (OPTIONAL)";
	                        placeholder: "Add a note...";
	                        value <=> description-value;
	                    }
	
	                    // Date field
	                    FormField {
	                        label: "DATE";
	                        placeholder: "YYYY-MM-DD";
	                        value <=> date-value;
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                border-radius: 10px;

                animate background { duration: 150ms; }

                Text {
                    text: "SAVE ENTRY";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submit(); }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
