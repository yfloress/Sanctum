// ==================== Transfer Funds Modal ====================
// Noir Minimalist - Overlay form for transferring between accounts

import { Palette, AppState, AccountAdapter } from "../globals.slint";

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }
}

component AccountSelector inherits Rectangle {
    in property <string> label: "ACCOUNT";
    in-out property <int> selected-index: 0;

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            height: 32px;

            HorizontalLayout {
                Text {
                    text: AccountAdapter.accounts.length > 0 ? AccountAdapter.accounts[selected-index].name + " (" + AccountAdapter.accounts[selected-index].currency + ")" : "No accounts";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 56px;
        width: root.width;
        
        Rectangle {
            background: Palette.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            height: min(AccountAdapter.accounts.length * 36px + 8px, 240px);

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 36px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 36px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 2px;

                        Text {
                            text: account.name + " (" + account.currency + ")";
                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                            font-size: 12px;
                            font-weight: index == selected-index ? 500 : 400;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            x: 12px;
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component TransferFundsModal inherits Rectangle {
    property <int> from-index: 0;
    property <int> to-index: AccountAdapter.accounts.length > 1 ? 1 : 0;
    property <string> amount-value: "";
    property <string> description-value: "";
    property <string> date-value: AppState.current-date;
    property <string> error-message: "";

    function reset-form() {
        from-index = 0;
        to-index = AccountAdapter.accounts.length > 1 ? 1 : 0;
        amount-value = "";
        description-value = "";
        date-value = AppState.current-date;
        error-message = "";
    }

    function submit() {
        if (AccountAdapter.accounts.length < 2) {
            error-message = "Need at least two accounts";
            return;
        }
        if (from-index == to-index) {
            error-message = "Select different accounts";
            return;
        }
        if (amount-value == "") {
            error-message = "Amount is required";
            return;
        }
        let result = AccountAdapter.transfer-funds(
            AccountAdapter.accounts[from-index].id,
            AccountAdapter.accounts[to-index].id,
            amount-value,
            description-value,
            date-value);

        if (result == "") {
            root.reset-form();
            AppState.show-transfer-modal = false;
            AccountAdapter.fetch-accounts();
        } else {
            error-message = result;
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-transfer-modal = false;
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 520px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            HorizontalLayout {
                height: 32px;

                Text {
                    text: "TRANSFER FUNDS";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 32px;
                    height: 32px;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 24px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-transfer-modal = false;
                        }
                    }
                }
            }

            Rectangle {
                height: 24px;
            }

            AccountSelector {
                label: "FROM";
                selected-index <=> from-index;
            }

            Rectangle {
                height: 12px;
            }

            Text {
                text: "↓";
                color: Palette.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 12px;
            }

            AccountSelector {
                label: "TO";
                selected-index <=> to-index;
            }

            Rectangle {
                height: 16px;
            }

            UnderlineField {
                label: "AMOUNT";
                placeholder: "0.00";
                value <=> amount-value;
            }

            Rectangle {
                height: 12px;
            }

            UnderlineField {
                label: "DESCRIPTION (OPTIONAL)";
                placeholder: "Reason for transfer";
                value <=> description-value;
            }

            Rectangle {
                height: 12px;
            }

            UnderlineField {
                label: "DATE";
                placeholder: "YYYY-MM-DD";
                value <=> date-value;
            }

            if error-message != "": Rectangle {
                height: 32px;

                Text {
                    text: error-message;
                    color: Palette.danger;
                    font-size: 12px;
                    font-weight: 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: 48px;
                background: submit-touch.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;

                animate background { duration: 120ms; }

                Text {
                    text: "TRANSFER";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }
            }
        }
    }
}
