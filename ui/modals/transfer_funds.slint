// ==================== Transfer Funds Modal ====================
// Premium Fintech UI - Overlay form for transferring between accounts

import { AppState, AccountAdapter, TransactionAdapter, NotificationAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== AccountSelector ====================
component AccountSelector inherits Rectangle {
    in property <string> label: "ACCOUNT";
    in-out property <int> selected-index: 0;
    property <int> safe-index: selected-index < AccountAdapter.accounts.length ? selected-index : 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: AccountAdapter.accounts.length > 0 ? AccountAdapter.accounts[safe-index].name + " (" + AccountAdapter.accounts[safe-index].currency + ")" : "No accounts";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(AccountAdapter.accounts.length * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name + " (" + account.currency + ")";
                                color: index == safe-index ? Theme.text-primary : Theme.text-secondary;
                                font-size: 13px;
                                font-weight: index == safe-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == safe-index: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== TransferFundsModal ====================
export component TransferFundsModal inherits Rectangle {
    in property <bool> editing: false;
    in property <int> selected-index: 0;

    property <int> from-index: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].account-index : 0;
    property <int> to-index: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].transfer-account-index : AccountAdapter.accounts.length > 1 ? 1 : 0;
    property <string> amount-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].amount-raw : "";
    property <string> description-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].description-raw : "";
    property <string> date-value: editing && TransactionAdapter.transactions.length > selected-index ? TransactionAdapter.transactions[selected-index].date : AppState.current-date;

    init => { key-scope.focus(); }

    function reset-form() {
        from-index = 0;
        to-index = AccountAdapter.accounts.length > 1 ? 1 : 0;
        amount-value = "";
        description-value = "";
        date-value = AppState.current-date;
        AppState.transfer-edit-mode = false;
        AppState.selected-transfer-index = 0;
    }

    function submit() {
        if (AccountAdapter.accounts.length < 2) {
            NotificationAdapter.show("Need at least two accounts", true);
            return;
        }
        if (from-index >= AccountAdapter.accounts.length) {
            from-index = 0;
        }
        if (to-index >= AccountAdapter.accounts.length) {
            to-index = AccountAdapter.accounts.length > 1 ? 1 : 0;
        }
        if (from-index == to-index) {
            NotificationAdapter.show("Select different accounts", true);
            return;
        }
        if (amount-value == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }
        let safe-index = selected-index >= TransactionAdapter.transactions.length ? 0 : selected-index;
        let edit-id = TransactionAdapter.transactions.length > 0 ? TransactionAdapter.transactions[safe-index].id : "";
        if (editing && edit-id == "") {
            NotificationAdapter.show("Transfer no longer available", true);
            return;
        }

        let result = editing ? AccountAdapter.update-transfer(
            edit-id,
            AccountAdapter.accounts[from-index].id,
            AccountAdapter.accounts[to-index].id,
            amount-value,
            description-value,
            date-value) : AccountAdapter.transfer-funds(
            AccountAdapter.accounts[from-index].id,
            AccountAdapter.accounts[to-index].id,
            amount-value,
            description-value,
            date-value);

        if (result == "") {
            root.reset-form();
            AppState.show-transfer-modal = false;
            AccountAdapter.is-loading = true;
            AccountAdapter.fetch-accounts();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-transfer-modal = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset-form();
                AppState.show-transfer-modal = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Theme.modal-width-md, parent.width - 40px);
        height: min(Theme.modal-height-md, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => { key-scope.focus(); }
        }

	        VerticalLayout {
	            padding: 32px;
	            spacing: 16px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: editing ? "EDIT TRANSFER" : "TRANSFER FUNDS";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-transfer-modal = false;
                        }
                    }
                }
	            }
	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;

	                TouchArea {
	                    width: parent.width;
	                    height: parent.height;
	                    clicked => { key-scope.focus(); }
	                }

	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 16px;
	
	                    AccountSelector {
	                        label: "FROM";
	                        selected-index <=> from-index;
	                    }
	
	                    // Arrow indicator
	                    Rectangle {
	                        height: 32px;
	
	                        Rectangle {
	                            width: 40px;
	                            height: 40px;
	                            border-radius: 20px;
	                            background: Theme.surface;
	                            border-width: 1px;
	                            border-color: Theme.border;
	                            x: (parent.width - self.width) / 2;
	                            y: (parent.height - self.height) / 2;
	
	                            Text {
	                                text: "↓";
	                                color: Theme.accent;
	                                font-size: 18px;
	                                font-weight: 500;
	                                horizontal-alignment: center;
	                                vertical-alignment: center;
	                            }
	                        }
	                    }
	
	                    AccountSelector {
	                        label: "TO";
	                        selected-index <=> to-index;
	                    }
	
	                    FormField {
	                        label: "AMOUNT";
	                        placeholder: "0.00";
	                        value <=> amount-value;
	                    }
	
	                    FormField {
	                        label: "DESCRIPTION (OPTIONAL)";
	                        placeholder: "Reason for transfer";
	                        value <=> description-value;
	                    }
	
	                    FormField {
	                        label: "DATE";
	                        placeholder: "YYYY-MM-DD";
	                        value <=> date-value;
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
	                border-radius: 10px;

                Text {
                    text: "TRANSFER";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submit(); }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
