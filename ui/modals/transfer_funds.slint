// ==================== Transfer Funds Modal ====================
// Premium Fintech UI - Overlay form for transferring between accounts

import { Palette, AppState, AccountAdapter, NotificationAdapter } from "../globals.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== AccountSelector ====================
component AccountSelector inherits Rectangle {
    in property <string> label: "ACCOUNT";
    in-out property <int> selected-index: 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: AccountAdapter.accounts.length > 0 ? AccountAdapter.accounts[selected-index].name + " (" + AccountAdapter.accounts[selected-index].currency + ")" : "No accounts";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(AccountAdapter.accounts.length * 40px + 8px, 240px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: AccountAdapter.accounts.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for account[index] in AccountAdapter.accounts: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: account.name + " (" + account.currency + ")";
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== TransferFundsModal ====================
export component TransferFundsModal inherits Rectangle {
    property <int> from-index: 0;
    property <int> to-index: AccountAdapter.accounts.length > 1 ? 1 : 0;
    property <string> amount-value: "";
    property <string> description-value: "";
    property <string> date-value: AppState.current-date;

    function reset-form() {
        from-index = 0;
        to-index = AccountAdapter.accounts.length > 1 ? 1 : 0;
        amount-value = "";
        description-value = "";
        date-value = AppState.current-date;
    }

    function submit() {
        if (AccountAdapter.accounts.length < 2) {
            NotificationAdapter.show("Need at least two accounts", true);
            return;
        }
        if (from-index == to-index) {
            NotificationAdapter.show("Select different accounts", true);
            return;
        }
        if (amount-value == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }
        let result = AccountAdapter.transfer-funds(
            AccountAdapter.accounts[from-index].id,
            AccountAdapter.accounts[to-index].id,
            amount-value,
            description-value,
            date-value);

        if (result == "") {
            root.reset-form();
            AppState.show-transfer-modal = false;
            AccountAdapter.fetch-accounts();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-transfer-modal = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 560px;
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, #0f0f1a 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000088;

        TouchArea {
            clicked => { key-scope.focus(); }
        }

	        VerticalLayout {
	            padding: 32px;
	            spacing: 16px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: "TRANSFER FUNDS";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-transfer-modal = false;
                        }
                    }
                }
	            }
	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;

	                TouchArea {
	                    width: parent.width;
	                    height: parent.height;
	                    clicked => { key-scope.focus(); }
	                }

	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 16px;
	
	                    AccountSelector {
	                        label: "FROM";
	                        selected-index <=> from-index;
	                    }
	
	                    // Arrow indicator
	                    Rectangle {
	                        height: 32px;
	
	                        Rectangle {
	                            width: 40px;
	                            height: 40px;
	                            border-radius: 20px;
	                            background: Palette.surface;
	                            border-width: 1px;
	                            border-color: Palette.border;
	                            x: (parent.width - self.width) / 2;
	                            y: (parent.height - self.height) / 2;
	
	                            Text {
	                                text: "↓";
	                                color: Palette.accent;
	                                font-size: 18px;
	                                font-weight: 500;
	                                horizontal-alignment: center;
	                                vertical-alignment: center;
	                            }
	                        }
	                    }
	
	                    AccountSelector {
	                        label: "TO";
	                        selected-index <=> to-index;
	                    }
	
	                    FormField {
	                        label: "AMOUNT";
	                        placeholder: "0.00";
	                        value <=> amount-value;
	                    }
	
	                    FormField {
	                        label: "DESCRIPTION (OPTIONAL)";
	                        placeholder: "Reason for transfer";
	                        value <=> description-value;
	                    }
	
	                    FormField {
	                        label: "DATE";
	                        placeholder: "YYYY-MM-DD";
	                        value <=> date-value;
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                border-radius: 10px;

                Text {
                    text: "TRANSFER";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submit(); }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
