// ==================== Edit Account Icon Modal ====================
// Select a bank icon for a bank account

import {
    AppState,
    AccountAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { BankIconSelector } from "../components/bank_icon_selector.slint";

export component EditAccountIconModal inherits Rectangle {
    in property <string> account-id: "";
    in-out property <string> selected-icon: get-default-icon();

    init => {
        key-scope.focus();
        if (selected-icon == "") {
            selected-icon = get-default-icon();
        }
    }

    function get-default-icon() -> string {
        return "../assets/icons/landmark.svg";
    }

    function reset() {
        selected-icon = get-default-icon();
    }

    function submit() {
        if (account-id == "") {
            NotificationAdapter.show("Account ID is required", true);
            return;
        }
        let result = AccountAdapter.update-account-icon(account-id, selected-icon);

        if (result == "") {
            root.reset();
            AppState.show-edit-account-icon = false;
            AccountAdapter.fetch-accounts();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg;
        opacity: 1.0;

        Flickable {
            width: 100%;
            height: 100%;
            interactive: false;
            viewport-width: parent.width;
            viewport-height: parent.height;
        }

        TouchArea {
            clicked => {
                root.reset();
                AppState.show-edit-account-icon = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset();
                AppState.show-edit-account-icon = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Theme.modal-width-md, parent.width - 40px);
        height: min(460px, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow-strong;
        opacity: 1.0;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: Translations.modal-select-bank-icon;
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset();
                            AppState.show-edit-account-icon = false;
                        }
                    }
                }
            }

            BankIconSelector {
                selected-icon <=> root.selected-icon;
            }

            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                border-radius: 10px;

                HorizontalLayout {
                    alignment: center;

                    Text {
                        text: Translations.modal-save-icon;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
