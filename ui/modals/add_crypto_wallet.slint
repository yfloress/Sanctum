// ==================== Add Crypto Wallet Modal ====================

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }
        Rectangle {
            vertical-stretch: 1;
            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }
            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }
            TouchArea { clicked => { input.focus(); } }
        }
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;
            animate height { duration: 150ms; }
            animate background { duration: 150ms; }
        }
    }
}

component CategoryOption inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    background: selected ? Palette.surface : transparent;
    border-radius: 4px;
    border-width: 1px;
    border-color: selected ? Palette.border-light : Palette.border;

    Text {
        text: root.label;
        color: selected ? Palette.text-primary : Palette.text-muted;
        font-size: 12px;
        font-weight: selected ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea { clicked => { root.clicked(); } }
}

export component AddCryptoWalletModal inherits Rectangle {
    property <string> wallet-name: "";
    property <string> category: "wallet_single"; // wallet_single, wallet_multi, exchange

    function reset() {
        wallet-name = "";
        category = "wallet_single";
    }

    function submit() {
        if (wallet-name == "") {
            NotificationAdapter.show("Wallet name is required", true);
            return;
        }

        let result = CryptoAdapter.create-wallet(wallet-name, category);

        if (result == "") {
            root.reset();
            AppState.show-add-wallet = false;
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-wallet = false;
            }
        }
    }

    // Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 450px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 32px;
                Text {
                    text: "NEW CRYPTO WALLET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    Text { text: "×"; color: Palette.text-muted; font-size: 24px; vertical-alignment: center; horizontal-alignment: center;}
                    TouchArea { clicked => { root.reset(); AppState.show-add-wallet = false; } }
                }
            }

            Rectangle { height: 32px; }

            UnderlineField { label: "WALLET NAME"; placeholder: "e.g. Ledger Nano X"; value <=> root.wallet-name; }

            Rectangle { height: 24px; }

            Text {
                text: "CATEGORY";
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 400;
                letter-spacing: 2px;
            }
            
            Rectangle { height: 12px; }

            VerticalLayout {
                spacing: 8px;
                CategoryOption { 
                    label: "Software / Hot Wallet"; 
                    value: "wallet_single"; 
                    selected: root.category == "wallet_single";
                    clicked => { root.category = "wallet_single"; }
                }
                CategoryOption { 
                    label: "Hardware / Cold Wallet"; 
                    value: "wallet_multi"; 
                    selected: root.category == "wallet_multi";
                    clicked => { root.category = "wallet_multi"; }
                }
                CategoryOption { 
                    label: "Exchange"; 
                    value: "exchange"; 
                    selected: root.category == "exchange";
                    clicked => { root.category = "exchange"; }
                }
            }

            Rectangle { vertical-stretch: 1; }

            Rectangle {
                height: 48px;
                background: Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                
                Text {
                    text: "CREATE WALLET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.submit(); } }
            }
        }
    }
}
