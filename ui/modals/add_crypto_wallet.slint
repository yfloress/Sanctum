// ==================== Add Crypto Wallet Modal ====================
// Noir Fintech - Premium wallet creation flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== Form Field ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 10px;
        
        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
        }
        
        Rectangle {
            vertical-stretch: 1;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border-subtle;
            
            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                
                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea { clicked => { input.focus(); } }
        }
    }
}

// ==================== Category Card ====================
component CategoryCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <bool> selected;
    callback clicked;

    height: 80px;
    background: selected ? Palette.surface : Palette.surface.with-alpha(0.3);
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? Palette.accent.with-alpha(0.5) : Palette.border-subtle;
    
    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        
        // Icon
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: selected ? Palette.accent.with-alpha(0.1) : Palette.background;
            border-width: 1px;
            border-color: selected ? Palette.accent.with-alpha(0.2) : Palette.border-subtle;
            
            Text {
                text: root.icon;
                font-size: 22px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        
        // Text
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            
            Text {
                text: root.title;
                color: selected ? Palette.text-primary : Palette.text-secondary;
                font-size: 14px;
                font-weight: selected ? 500 : 400;
            }
            
            Text {
                text: root.subtitle;
                color: Palette.text-muted;
                font-size: 11px;
            }
        }
        
        // Checkmark
        if selected: Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Palette.accent;
            y: (parent.height - self.height) / 2;
            
            Text {
                text: "✓";
                color: Palette.background;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

// ==================== Main Modal ====================
export component AddCryptoWalletModal inherits Rectangle {
    property <string> wallet-name: "";
    property <string> category: "wallet_single";

    function reset() {
        wallet-name = "";
        category = "wallet_single";
    }

    function submit() {
        if (wallet-name == "") {
            NotificationAdapter.show("Wallet name is required", true);
            return;
        }

        let result = CryptoAdapter.create-wallet(wallet-name, category);

        if (result == "") {
            root.reset();
            AppState.show-add-wallet = false;
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.85);
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-wallet = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 520px;
        background: @linear-gradient(180deg, #0a0a10 0%, #080810 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 40px;
                alignment: space-between;
                
                VerticalLayout {
                    alignment: center;
                    
                    Text {
                        text: "NEW WALLET";
                        color: Palette.text-primary;
                        font-size: 14px;
                        font-weight: 500;
                        letter-spacing: 2px;
                    }
                }
                
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface : transparent;
                    
                    Text { 
                        text: "✕"; 
                        color: Palette.text-muted; 
                        font-size: 16px; 
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-wallet = false; } 
                    }
                }
            }

            Rectangle { height: 28px; }

            // Name Field
            FormField { 
                label: "WALLET NAME"; 
                placeholder: "e.g. Ledger Nano X"; 
                value <=> root.wallet-name; 
            }

            Rectangle { height: 24px; }

            // Category Label
            Text {
                text: "WALLET TYPE";
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 2px;
            }
            
            Rectangle { height: 12px; }

            // Category Options
            VerticalLayout {
                spacing: 10px;
                
                CategoryCard { 
                    icon: "💳";
                    title: "Software Wallet"; 
                    subtitle: "MetaMask, Trust Wallet, Exodus";
                    value: "wallet_single"; 
                    selected: root.category == "wallet_single";
                    clicked => { root.category = "wallet_single"; }
                }
                
                CategoryCard { 
                    icon: "🔐";
                    title: "Hardware Wallet"; 
                    subtitle: "Ledger, Trezor, KeepKey";
                    value: "wallet_multi"; 
                    selected: root.category == "wallet_multi";
                    clicked => { root.category = "wallet_multi"; }
                }
                
                CategoryCard { 
                    icon: "📊";
                    title: "Exchange"; 
                    subtitle: "Binance, Coinbase, Kraken";
                    value: "exchange"; 
                    selected: root.category == "exchange";
                    clicked => { root.category = "exchange"; }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Submit Button
            Rectangle {
                height: 52px;
                background: touch.has-hover ? Palette.accent-hover : Palette.accent;
                border-radius: 10px;
                
                animate background { duration: 150ms; }
                
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    
                    Text {
                        text: "+";
                        color: Palette.background;
                        font-size: 16px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "CREATE WALLET";
                        color: Palette.background;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }
            }
        }
    }
}
