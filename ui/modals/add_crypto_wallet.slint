// ==================== Add Crypto Wallet Modal ====================
// Premium Fintech UI - Wallet creation flow

import {
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { FormField } from "../components/transaction_form_components.slint";

// ==================== CategoryCard ====================
component CategoryCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <bool> selected;
    callback clicked;

    height: 76px;
    background: selected
        ? @linear-gradient(135deg, Theme.surface 0%, Theme.crypto-icon-gradient-start 100%)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: 12px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.border;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }
    animate border-width { duration: 200ms; }

    // Glow when selected
    if selected: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 15px;
        background: Theme.accent;
        opacity: 0.15;
    }

	    HorizontalLayout {
	        padding: 16px;
	        spacing: 14px;

        // Icon
	            Rectangle {
	                width: 44px;
	                height: 44px;
	                border-radius: 10px;
	                background: selected
	                ? @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%)
	                : Theme.surface-hover;

            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: selected ? Theme.text-primary : Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // Text
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: selected ? Theme.text-primary : Theme.text-secondary;
                font-size: 13px;
                font-weight: selected ? 600 : 400;
            }

            Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 400;
            }
        }

    }

    touch := TouchArea { 
        mouse-cursor: pointer;
        clicked => { root.clicked(); } 
    }
}

// ==================== Main Modal ====================
export component AddCryptoWalletModal inherits Rectangle {
    property <string> wallet-name: "";
    property <string> category: "wallet_single";
    init => { key-scope.focus(); }

    function reset() {
        wallet-name = "";
        category = "wallet_single";
    }

    function submit() {
        if (wallet-name == "") {
            NotificationAdapter.show("Wallet name is required", true);
            return;
        }

        let result = CryptoAdapter.create-wallet(wallet-name, category);

        if (result == "") {
            root.reset();
            AppState.show-add-wallet = false;
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop - captures all events to prevent scroll propagation
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay-bg;
        opacity: 1.0;

        // Flickable with no scrolling blocks scroll events from propagating
        Flickable {
            width: 100%;
            height: 100%;
            interactive: false;
            viewport-width: parent.width;
            viewport-height: parent.height;
        }

        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-wallet = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset();
                AppState.show-add-wallet = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Theme.modal-width-md, parent.width - 40px);
        height: min(Theme.modal-height-sm, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.crypto-modal-gradient-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow-strong;
        opacity: 1.0;

        TouchArea {
            clicked => { key-scope.focus(); }
        }

	        VerticalLayout {
	            padding: 32px;
	            spacing: 24px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                        Rectangle {
	                            width: 4px;
	                            height: 20px;
	                            border-radius: 2px;
	                            background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
	                            y: (parent.height - self.height) / 2;
	                        }

                    Text {
                        text: "NEW WALLET";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-wallet = false; } 
                    }
                }
	            }

	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;

	                TouchArea {
	                    width: parent.width;
	                    height: parent.height;
	                    clicked => { key-scope.focus(); }
	                }

	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 24px;

	                    // Name Field
	                    FormField {
	                        label: "WALLET NAME";
	                        placeholder: "e.g. Ledger Nano X";
	                        value <=> root.wallet-name;
	                        submit-shortcut => { root.submit(); }
	                    }

	                    // Category Label
	                    VerticalLayout {
	                        spacing: 12px;

	                        Text {
	                            text: "WALLET TYPE";
	                            color: Theme.text-muted;
	                            font-size: 10px;
	                            font-weight: 500;
	                            letter-spacing: 1.5px;
	                        }

	                        // Category Options
	                        VerticalLayout {
	                            spacing: 10px;
	                            
	                            CategoryCard {
	                                icon: @image-url("../assets/icons/wallet.svg");
	                                title: "Software Wallet";
	                                subtitle: "MetaMask, Trust Wallet, Exodus";
	                                value: "wallet_single";
	                                selected: root.category == "wallet_single";
	                                clicked => { root.category = "wallet_single"; }
	                            }

	                            CategoryCard {
	                                icon: @image-url("../assets/icons/shield.svg");
	                                title: "Hardware Wallet";
	                                subtitle: "Ledger, Trezor, KeepKey";
	                                value: "wallet_multi";
	                                selected: root.category == "wallet_multi";
	                                clicked => { root.category = "wallet_multi"; }
	                            }

	                            CategoryCard {
	                                icon: @image-url("../assets/icons/trending-up.svg");
	                                title: "Exchange";
	                                subtitle: "Binance, Coinbase, Kraken";
	                                value: "exchange";
	                                selected: root.category == "exchange";
	                                clicked => { root.category = "exchange"; }
	                            }
	                        }
	                    }

	                    Rectangle { height: 8px; }
	                }
	            }

	            // Submit Button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
	                border-radius: 10px;
	                
	                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    
                    Text {
                        text: "+";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "CREATE WALLET";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
