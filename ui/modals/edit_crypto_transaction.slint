// ==================== Edit Crypto Transaction Modal ====================
// Premium Fintech UI - Transaction edit flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { FormField } from "../components/transaction_form_components.slint";

// ==================== ReadonlyField ====================
component ReadonlyField inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: root.value;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ==================== Main Modal ====================
export component EditCryptoTransactionModal inherits Rectangle {
    function reset() {
        CryptoAdapter.edit-tx-id = "";
        CryptoAdapter.edit-wallet-id = "";
        CryptoAdapter.edit-wallet-name = "";
        CryptoAdapter.edit-coin-id = "";
        CryptoAdapter.edit-symbol = "";
        CryptoAdapter.edit-type = "";
        CryptoAdapter.edit-amount = "";
        CryptoAdapter.edit-price = "";
        CryptoAdapter.edit-fee = "";
        CryptoAdapter.edit-fee-coin-id = "";
        CryptoAdapter.edit-fee-coin-amount = "";
        CryptoAdapter.edit-date = AppState.current-date;
        CryptoAdapter.edit-notes = "";
    }

    function submit() {
        if (CryptoAdapter.edit-amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }
        let requires_price = CryptoAdapter.edit-type == "buy"
            || CryptoAdapter.edit-type == "sell";
        if (requires_price && CryptoAdapter.edit-price == "") {
            NotificationAdapter.show("Price is required", true);
            return;
        }

        let result = CryptoAdapter.update-transaction(
            CryptoAdapter.edit-tx-id,
            CryptoAdapter.edit-amount,
            CryptoAdapter.edit-price,
            CryptoAdapter.edit-fee,
            CryptoAdapter.edit-fee-coin-id,
            CryptoAdapter.edit-fee-coin-amount,
            CryptoAdapter.edit-date,
            CryptoAdapter.edit-notes
        );

        if (result == "") {
            AppState.show-edit-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
            CryptoAdapter.fetch-asset-details(CryptoAdapter.edit-coin-id);
            root.reset();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.overlay-bg;
        opacity: 1.0;

        animate opacity { duration: 150ms; easing: ease-out; }

        TouchArea {
            clicked => {
                root.reset();
                AppState.show-edit-crypto = false;
            }
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset();
                AppState.show-edit-crypto = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Palette.modal-width-md, parent.width - 40px);
        height: min(Palette.modal-height-compact, parent.height - 40px);
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, Palette.crypto-modal-gradient-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Palette.shadow-strong;
        opacity: 1.0;

        animate opacity { duration: 200ms; easing: ease-out; }

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;
                
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "EDIT CRYPTO TRANSACTION";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-edit-crypto = false; } 
                    }
                }
            }

            body := Flickable {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                VerticalLayout {
                    width: parent.width;
                    spacing: 20px;

                    ReadonlyField { label: "WALLET"; value: CryptoAdapter.edit-wallet-name; }
                    ReadonlyField { label: "ASSET"; value: CryptoAdapter.edit-symbol; }
                    ReadonlyField { label: "TYPE"; value: CryptoAdapter.edit-type; }

                    FormField { 
                        label: "AMOUNT"; 
                        placeholder: "0.00"; 
                        value <=> CryptoAdapter.edit-amount; 
                        large: true; 
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        FormField { 
                            label: "PRICE (USD)"; 
                            placeholder: (CryptoAdapter.edit-type == "transfer_in" || CryptoAdapter.edit-type == "transfer_out")
                                ? "Optional"
                                : "Required"; 
                            value <=> CryptoAdapter.edit-price; 
                            horizontal-stretch: 1;
                        }
                        FormField { 
                            label: "FEE (USD)"; 
                            placeholder: "0.00"; 
                            value <=> CryptoAdapter.edit-fee; 
                            width: 120px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        FormField {
                            label: "FEE COIN ID (OPTIONAL)";
                            placeholder: "e.g. ethereum";
                            value <=> CryptoAdapter.edit-fee-coin-id;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "FEE AMOUNT";
                            placeholder: "0.00";
                            value <=> CryptoAdapter.edit-fee-coin-amount;
                            width: 140px;
                        }
                    }

                    FormField { 
                        label: "NOTES"; 
                        placeholder: "Transaction details..."; 
                        value <=> CryptoAdapter.edit-notes; 
                    }

                    FormField { 
                        label: "DATE"; 
                        placeholder: "YYYY-MM-DD";
                        value <=> CryptoAdapter.edit-date; 
                    }

                    Rectangle { height: 8px; }
                }
            }

            // Submit Button
            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
                border-radius: 10px;
                
                Text {
                    text: "SAVE CHANGES";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
