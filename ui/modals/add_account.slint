// ==================== Add Account Modal ====================
// Premium Fintech UI - Overlay form for creating new accounts

import {
    AppState,
    AccountAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { Translations } from "../translations.slint";
import { Theme } from "../theme.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                    input.set-selection-offsets(2147483647, 2147483647);
                }
            }
        }
    }
}

// ==================== OptionSelector ====================
component OptionSelector inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options: [];
    in-out property <int> selected-index: 0;

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: options.length > 0 ? options[selected-index] : "Select...";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;

        Rectangle {
            background: Theme.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-light;
            height: min(options.length * 40px + 8px, 200px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            Flickable {
                viewport-height: options.length * 40px + 8px;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in options: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Theme.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: option;
                                color: index == selected-index ? Theme.text-primary : Theme.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Image {
                                source: @image-url("../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== AddAccountModal ====================
export component AddAccountModal inherits Rectangle {
    in property <bool> editing: false;
    in property <int> selected-index: 0;

    property <string> name-value: editing && AccountAdapter.accounts.length > selected-index ? AccountAdapter.accounts[selected-index].name : "";
    property <string> initial-balance: editing && AccountAdapter.accounts.length > selected-index ? AccountAdapter.accounts[selected-index].initial-balance : "";
    property <int> type-index: editing && AccountAdapter.accounts.length > selected-index ? (AccountAdapter.accounts[selected-index].account-type-key == "cash" ? 1 : AccountAdapter.accounts[selected-index].account-type-key == "savings" ? 2 : AccountAdapter.accounts[selected-index].account-type-key == "credit_card" ? 3 : AccountAdapter.accounts[selected-index].account-type-key == "other" ? 4 : 0) : 0;
    property <int> currency-index: editing && AccountAdapter.accounts.length > selected-index ? (AccountAdapter.accounts[selected-index].currency == "CLP" ? 1 : 0) : 0;
    property <bool> show-delete-confirm: false;

    property <[string]> type-options: ["Bank", "Cash", "Savings", "Credit Card", "Other"];
    property <[string]> currency-options: ["USD", "CLP"];

    init => {
        key-scope.focus();
    }

    function reset-form() {
        name-value = "";
        initial-balance = "";
        type-index = 0;
        currency-index = 0;
        show-delete-confirm = false;
    }

    function submit() {
        if (name-value == "") {
            NotificationAdapter.show("Name is required", true);
            return;
        }
        let should_pick_icon = type-options[type-index] == "Bank";
        let safe-index = selected-index >= AccountAdapter.accounts.length ? 0 : selected-index;
        let result = editing ? AccountAdapter.update-account(
                AccountAdapter.accounts[safe-index].id,
                name-value,
                type-options[type-index],
                currency-options[currency-index],
                initial-balance) : AccountAdapter.create-account(
                name-value,
                type-options[type-index],
                currency-options[currency-index],
                initial-balance);

        if (result == "") {
            root.reset-form();
            AppState.show-add-account = false;
            AccountAdapter.is-loading = true;
            AccountAdapter.fetch-accounts();
            if (should_pick_icon && !editing) {
                AppState.show-edit-account-icon = true;
            }
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-add-account = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reset-form();
                AppState.show-add-account = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: editing ? 520px : 460px;
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? Translations.modal-edit-account-title : Translations.modal-add-account-title;
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-add-account = false;
                        }
                    }
                }
            }

            FormField {
                label: Translations.label-name;
                placeholder: "Main Checking";
                value <=> name-value;
            }

            HorizontalLayout {
                spacing: 12px;

                OptionSelector {
                    horizontal-stretch: 1;
                    label: Translations.label-type;
                    options: type-options;
                    selected-index <=> type-index;
                }

                OptionSelector {
                    horizontal-stretch: 1;
                    label: Translations.label-currency;
                    options: currency-options;
                    selected-index <=> currency-index;
                }
            }

            FormField {
                label: Translations.label-balance;
                placeholder: "0.00";
                value <=> initial-balance;
            }

            Rectangle {
                vertical-stretch: 1;
            }

            if editing: Rectangle {
                height: 44px;
                background: Theme.delete-bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.delete-border;

                Text {
                    text: Translations.modal-delete-account;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        show-delete-confirm = true;
                    }
                }
            }

            // Submit button
            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                border-radius: 10px;

                Text {
                    text: Translations.modal-save-account;
                    color: Theme.text-light;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }

    if show-delete-confirm: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        z: 1200;

        Rectangle {
            background: Theme.overlay-bg-strong;
            TouchArea {
                clicked => {
                    show-delete-confirm = false;
                }
            }
        }

        Rectangle {
            width: min(360px, parent.width - 40px);
            height: min(180px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.sidebar-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-light;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow-color;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: Translations.confirm-delete-title + "?";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: Translations.modal-delete-account-confirm;
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        Text {
                            text: Translations.action-cancel;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                show-delete-confirm = false;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: confirm-touch.has-hover ? Theme.delete-bg-active : Theme.delete-bg-hover;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.delete-border;

                        Text {
                            text: Translations.action-delete;
                            color: Theme.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                let safe-index = selected-index >= AccountAdapter.accounts.length ? 0 : selected-index;
                                AccountAdapter.is-loading = true;
                                let result = AccountAdapter.delete-account(AccountAdapter.accounts[safe-index].id);
                                if (result == "") {
                                    root.reset-form();
                                    AppState.show-add-account = false;
                                } else {
                                    NotificationAdapter.show(result, true);
                                    AccountAdapter.is-loading = false;
                                    show-delete-confirm = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
