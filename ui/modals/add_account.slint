// ==================== Add Account Modal ====================
// Noir Minimalist - Overlay form for creating new accounts

import { Palette, AppState, AccountAdapter } from "../globals.slint";

// ==================== UnderlineField ====================
// Minimal input with bottom border

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }
}

// ==================== OptionSelector ====================
// Simple dropdown-style selector using PopupWindow

component OptionSelector inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options: [];
    in-out property <int> selected-index: 0;

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            height: 32px;

            HorizontalLayout {
                Text {
                    text: options.length > 0 ? options[selected-index] : "Select...";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 56px; 
        width: root.width;
        
        Rectangle {
            background: Palette.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            
            // Limit height and allow scrolling if many options
            height: min(options.length * 32px + 8px, 200px);

            Flickable {
                viewport-height: options.length * 32px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in options: Rectangle {
                        height: 32px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 2px;

                        Text {
                            text: option;
                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                            font-size: 12px;
                            font-weight: index == selected-index ? 500 : 400;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            x: 12px;
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                                // Slint's PopupWindow closes automatically on click outside, 
                                // but we explicitly close it here for better UX
                                // However, currently there isn't a direct close() on PopupWindow in vanilla Slint 1.8 
                                // without toggling visibility manually if it wasn't a PopupWindow.
                                // Standard PopupWindow closes when clicking an item if it consumes the event? 
                                // Actually usually we rely on focus loss. 
                                // Let's try to just set index. The popup stays open? 
                                // No, PopupWindow behavior is transient.
                                // We might need a way to close it programmatically if we want instant close.
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== AddAccountModal ====================

export component AddAccountModal inherits Rectangle {
    in property <bool> editing: false;
    in property <int> selected-index: 0;

    // Form state
    property <string> name-value: editing && AccountAdapter.accounts.length > selected-index ? AccountAdapter.accounts[selected-index].name : "";
    property <string> initial-balance: editing && AccountAdapter.accounts.length > selected-index ? AccountAdapter.accounts[selected-index].initial-balance : "";
    property <int> type-index: editing && AccountAdapter.accounts.length > selected-index ? (AccountAdapter.accounts[selected-index].account-type-key == "cash" ? 1 : AccountAdapter.accounts[selected-index].account-type-key == "savings" ? 2 : AccountAdapter.accounts[selected-index].account-type-key == "credit_card" ? 3 : 0) : 0;
    property <int> currency-index: editing && AccountAdapter.accounts.length > selected-index ? (AccountAdapter.accounts[selected-index].currency == "CLP" ? 1 : 0) : 0;
    property <string> error-message: "";

    property <[string]> type-options: ["Bank", "Cash", "Savings", "Credit"];
    property <[string]> currency-options: ["USD", "CLP"];

    function reset-form() {
        name-value = "";
        initial-balance = "";
        type-index = 0;
        currency-index = 0;
        error-message = "";
    }

    function submit() {
        if (name-value == "") {
            error-message = "Name is required";
            return;
        }
        let safe-index = selected-index >= AccountAdapter.accounts.length ? 0 : selected-index;
        let result = editing ? AccountAdapter.update-account(
                AccountAdapter.accounts[safe-index].id,
                name-value,
                type-options[type-index],
                currency-options[currency-index],
                initial-balance) : AccountAdapter.create-account(
                name-value,
                type-options[type-index],
                currency-options[currency-index],
                initial-balance);

        if (result == "") {
            root.reset-form();
            AppState.show-add-account = false;
            AccountAdapter.fetch-accounts();
        } else {
            error-message = result;
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => {
                root.reset-form();
                AppState.show-add-account = false;
            }
        }
    }

    // Modal panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 420px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        // Prevent clicks from closing
        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 32px;

                Text {
                    text: editing ? "EDIT ACCOUNT" : "NEW ACCOUNT";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 32px;
                    height: 32px;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 24px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;

                        animate color { duration: 120ms; }
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.reset-form();
                            AppState.show-add-account = false;
                        }
                    }
                }
            }

            Rectangle {
                height: 24px;
            }

            UnderlineField {
                label: "NAME";
                placeholder: "Main Checking";
                value <=> name-value;
            }

            Rectangle {
                height: 16px;
            }

            HorizontalLayout {
                spacing: 12px;

                OptionSelector {
                    horizontal-stretch: 1;
                    label: "TYPE";
                    options: type-options;
                    selected-index <=> type-index;
                }

                OptionSelector {
                    horizontal-stretch: 1;
                    label: "CURRENCY";
                    options: currency-options;
                    selected-index <=> currency-index;
                }
            }

            Rectangle {
                height: 16px;
            }

            UnderlineField {
                label: "INITIAL BALANCE";
                placeholder: "0.00";
                value <=> initial-balance;
            }

            if error-message != "": Rectangle {
                height: 32px;

                Text {
                    text: error-message;
                    color: Palette.danger;
                    font-size: 12px;
                    font-weight: 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: 48px;
                background: submit-touch.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;

                animate background { duration: 120ms; }

                Text {
                    text: "SAVE ACCOUNT";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }
            }
        }
    }
}
