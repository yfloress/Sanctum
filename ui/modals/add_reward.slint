import {
    HabitAdapter,
    RewardsAdapter,
    NotificationAdapter,
    HabitData,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { FormField, NumberField } from "../components/forms/form_fields.slint";
import { HabitDropdown } from "../components/forms/habit_dropdown.slint";

component TypeToggle inherits Rectangle {
    in-out property <bool> is-consecutive: true;
    height: 44px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            height: 36px;
            border-radius: 8px;
            background: is-consecutive ? Theme.surface-hover : transparent;
            border-width: is-consecutive ? 1px : 0px;
            border-color: Theme.border-light;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Image {
                    source: @image-url("../assets/icons/flame.svg");
                    width: 14px;
                    height: 14px;
                    colorize: is-consecutive ? Theme.warning : Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "CONSECUTIVE";
                    color: is-consecutive ? Theme.text-primary : Theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is-consecutive = true;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 36px;
            border-radius: 8px;
            background: !is-consecutive ? Theme.surface-hover : transparent;
            border-width: !is-consecutive ? 1px : 0px;
            border-color: Theme.border-light;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Image {
                    source: @image-url("../assets/icons/target.svg");
                    width: 14px;
                    height: 14px;
                    colorize: !is-consecutive ? Theme.accent : Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "ACCUMULATIVE";
                    color: !is-consecutive ? Theme.text-primary : Theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is-consecutive = false;
                }
            }
        }
    }
}

component MilestoneRow inherits Rectangle {
    in-out property <int> days: 7;
    in-out property <string> reward: "";
    in property <bool> can-delete: true;
    callback delete();
    property <string> days-text: days;
    height: 48px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        Rectangle {
            width: 70px;
            height: 32px;
            background: Theme.surface-hover;
            border-radius: 6px;
            y: (parent.height - self.height) / 2;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                days-input := TextInput {
                    horizontal-stretch: 1;
                    text: root.days-text;
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    input-type: number;
                    edited => {
                        root.days = max(1, round(self.text.to-float()));
                    }
                }

                Text {
                    text: "days";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "→";
            color: Theme.text-muted;
            font-size: 14px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            background: Theme.surface-hover;
            border-radius: 6px;
            y: (parent.height - self.height) / 2;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                TextInput {
                    text <=> root.reward;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            if reward == "": Text {
                x: 12px;
                text: "Reward...";
                color: Theme.text-subtle;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        if can-delete: Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: del-touch.has-hover ? Theme.delete-bg-hover : transparent;
            y: (parent.height - self.height) / 2;
            Image {
                source: @image-url("../assets/icons/trash.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            del-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.delete();
                }
            }
        }
    }
}

export component AddRewardModal inherits Rectangle {
    in property <bool> editing: false;
    callback close();

    property <int> selected-habit-index: -1;
    property <bool> is-consecutive: true;
    property <int> target-days: 10;
    property <int> target-total: 30;
    property <int> milestone-count: 1;
    property <int> m1-days: 7;
    property <string> m1-reward: "";
    property <int> m2-days: 21;
    property <string> m2-reward: "";
    property <int> m3-days: 50;
    property <string> m3-reward: "";

    // Helper function to shift milestones up after deletion
    function shift-milestones-from(position: int) {
        if position == 1 {
            m1-days = m2-days;
            m1-reward = m2-reward;
            m2-days = m3-days;
            m2-reward = m3-reward;
            m3-days = 50;
            m3-reward = "";
        } else if position == 2 {
            m2-days = m3-days;
            m2-reward = m3-reward;
            m3-days = 50;
            m3-reward = "";
        }
        milestone-count -= 1;
    }

    function auto-select-habit() {
        // Use selected habit index from adapter if valid, otherwise default to first
        if HabitAdapter.selected-habit-index >= 0 && HabitAdapter.selected-habit-index < HabitAdapter.habits.length {
            selected-habit-index = HabitAdapter.selected-habit-index;
        } else if HabitAdapter.habits.length > 0 {
            selected-habit-index = 0;
        }
    }

    function load-edit-data() {
        // habit index is set via RewardsAdapter.edit-reward-habit-index
        selected-habit-index = RewardsAdapter.edit-reward-habit-index;
        is-consecutive = RewardsAdapter.edit-reward-is-consecutive;
        target-days = RewardsAdapter.edit-reward-target-days;
        target-total = RewardsAdapter.edit-reward-target-total;
        milestone-count = max(1, RewardsAdapter.edit-reward-milestone-count);
        m1-days = RewardsAdapter.edit-reward-m1-days;
        m1-reward = RewardsAdapter.edit-reward-m1-text;
        m2-days = RewardsAdapter.edit-reward-m2-days;
        m2-reward = RewardsAdapter.edit-reward-m2-text;
        m3-days = RewardsAdapter.edit-reward-m3-days;
        m3-reward = RewardsAdapter.edit-reward-m3-text;
    }
    function reset() {
        selected-habit-index = -1;
        is-consecutive = true;
        target-days = 10;
        target-total = 30;
        milestone-count = 1;
        m1-days = 7;
        m1-reward = "";
        m2-days = 21;
        m2-reward = "";
        m3-days = 50;
        m3-reward = "";
    }
    function close-modal() {
        reset();
        root.close();
    }
    function submit() {
        if (selected-habit-index < 0) {
            NotificationAdapter.show("Please select a habit", true);
            return;
        }
        if (m1-reward == "") {
            NotificationAdapter.show("Add at least one milestone", true);
            return;
        }

        // Get the habit id from the selected index
        if (selected-habit-index >= HabitAdapter.habits.length) {
            NotificationAdapter.show("Invalid habit selection", true);
            return;
        }
        if (editing) {
            // Update existing reward - preserves unlocked milestone status
            // Set milestone data in adapter properties for the callback to read
            RewardsAdapter.edit-reward-milestone-count = milestone-count;
            RewardsAdapter.edit-reward-m1-days = m1-days;
            RewardsAdapter.edit-reward-m1-text = m1-reward;
            RewardsAdapter.edit-reward-m2-days = m2-days;
            RewardsAdapter.edit-reward-m2-text = m2-reward;
            RewardsAdapter.edit-reward-m3-days = m3-days;
            RewardsAdapter.edit-reward-m3-text = m3-reward;

            let result = RewardsAdapter.update-streak-reward(
                RewardsAdapter.edit-reward-id,
                HabitAdapter.habits[selected-habit-index].id,
                is-consecutive,
                is-consecutive ? 0 : target-days,
                is-consecutive ? 0 : target-total);

            if (result != "") {
                // Error occurred
                return;
            }
        } else {
            // Create new streak reward
            // For consecutive: target-days and target-total are 0 (milestones define targets)
            // For accumulative: use target-days and target-total values
            let result = RewardsAdapter.create-streak-reward(
                HabitAdapter.habits[selected-habit-index].id,
                is-consecutive,
                is-consecutive ? 0 : target-days,
                is-consecutive ? 0 : target-total);

            // Empty result means error (backend shows notification)
            // Non-empty result is the reward ID
            if (result == "") {
                return;
            }

            // Result is the reward ID - use it to add milestones
            let reward-id = result;

            // Add milestone 1
            let m1-result = RewardsAdapter.add-milestone(reward-id, m1-days, m1-reward);
            if (m1-result != "") {
                NotificationAdapter.show(m1-result, true);
            }

            // Add milestone 2 if exists
            if (milestone-count >= 2 && m2-reward != "") {
                let m2-result = RewardsAdapter.add-milestone(reward-id, m2-days, m2-reward);
                if (m2-result != "") {
                    NotificationAdapter.show(m2-result, true);
                }
            }

            // Add milestone 3 if exists
            if (milestone-count >= 3 && m3-reward != "") {
                let m3-result = RewardsAdapter.add-milestone(reward-id, m3-days, m3-reward);
                if (m3-result != "") {
                    NotificationAdapter.show(m3-result, true);
                }
            }
        }
        close-modal();
    }
    init => {
        key-scope.focus();
        if editing {
            load-edit-data();
        } else {
            auto-select-habit();
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        width: min(480px, parent.width - 40px);
        height: min(560px, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.warning 0%, Theme.accent 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? "EDIT REWARD" : "NEW STREAK REWARD";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }
                }
            }

            HabitDropdown {
                habits: HabitAdapter.habits;
                selected-index <=> selected-habit-index;
            }

            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "TYPE";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 500;
                    letter-spacing: 1.5px;
                }

                TypeToggle {
                    is-consecutive <=> root.is-consecutive;
                }

                Text {
                    text: is-consecutive ? "Days must be consecutive (resets if missed)" : "Accumulate days over time";
                    color: Theme.text-muted;
                    font-size: 10px;
                }
            }

            if !is-consecutive: HorizontalLayout {
                spacing: 16px;

                NumberField {
                    horizontal-stretch: 1;
                    label: "TARGET DAYS";
                    value <=> target-days;
                }

                NumberField {
                    horizontal-stretch: 1;
                    label: "OF TOTAL DAYS";
                    value <=> target-total;
                }
            }

            VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "MILESTONES";
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 500;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    if milestone-count < 3: Rectangle {
                        width: 70px;
                        height: 28px;
                        border-radius: 6px;
                        background: add-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.text-muted;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "ADD";
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        add-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (milestone-count < 3) {
                                    milestone-count += 1;
                                }
                            }
                        }
                    }
                }

                MilestoneRow {
                    days <=> m1-days;
                    reward <=> m1-reward;
                    can-delete: milestone-count > 1;
                    delete => {
                        shift-milestones-from(1);
                    }
                }

                if milestone-count >= 2: MilestoneRow {
                    days <=> m2-days;
                    reward <=> m2-reward;
                    delete => {
                        shift-milestones-from(2);
                    }
                }

                if milestone-count >= 3: MilestoneRow {
                    days <=> m3-days;
                    reward <=> m3-reward;
                    delete => {
                        shift-milestones-from(3);
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.warning 0%, Theme.accent 100%);
                border-radius: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Image {
                        source: @image-url("../assets/icons/flame.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? "SAVE CHANGES" : "CREATE REWARD";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
