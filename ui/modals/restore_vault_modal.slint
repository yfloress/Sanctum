// ==================== Restore Vault Modal ====================
// Confirmation modal for restoring vault from backup

import { AppState, VaultAdapter, NotificationAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";

export component RestoreVaultModal inherits Rectangle {
    callback close();

    function close-modal() {
        VaultAdapter.restore-backup-path = "";
        root.close();
    }

    function confirm-restore() {
        VaultAdapter.confirm-restore();
        root.close();
    }

    init => {
        key-scope.focus();
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        width: 540px;
        height: 360px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            // Warning Icon
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Theme.danger.with-alpha(0.15);

                    Image {
                        source: @image-url("../assets/icons/info.svg");
                        width: 32px;
                        height: 32px;
                        colorize: Theme.danger;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Title
            Text {
                text: Translations.vault-restore-warning-title;
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            // Description
            Text {
                text: Translations.vault-restore-warning-desc;
                color: Theme.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // File path display
            if VaultAdapter.restore-backup-path != "": Rectangle {
                height: 64px;
                background: transparent;

                VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: Translations.vault-restore-file-label;
                        color: Theme.text-muted;
                        font-size: 10px;
                        font-weight: 500;
                        letter-spacing: 1.5px;
                    }

                    Rectangle {
                        height: 40px;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: VaultAdapter.restore-backup-path;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Spacer
            Rectangle {
                vertical-stretch: 1;
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 12px;

                // Cancel Button
                cancel-btn := Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    border-radius: 10px;
                    background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-light;

                    Text {
                        text: Translations.vault-restore-cancel;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }

                    states [
                        hover when cancel-touch.has-hover: {
                            background: Theme.surface-hover;
                        }
                    ]
                }

                // Restore Button (Danger)
                restore-btn := Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    border-radius: 10px;
                    background: restore-touch.has-hover ? Theme.danger.darker(0.1) : Theme.danger;
                    border-width: 1px;
                    border-color: Theme.danger-strong;

                    Text {
                        text: Translations.vault-restore-confirm;
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    restore-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            confirm-restore();
                        }
                    }

                    states [
                        hover when restore-touch.has-hover: {
                            opacity: 0.9;
                        }
                    ]
                }
            }
        }
    }
}
