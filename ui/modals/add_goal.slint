// ==================== Add Goal Modal ====================
// Modal for creating and editing goals with checkpoints and deadline

import {
    RewardsAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { FormField, DateField } from "../components/forms/form_fields.slint";

// ==================== CheckpointRow ====================
component CheckpointRow inherits Rectangle {
    in-out property <string> description: "";
    in property <bool> can-delete: true;
    callback delete();

    height: 44px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        // Checkbox placeholder (unchecked for new checkpoints)
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            background: transparent;
            border-width: 1px;
            border-color: Theme.border;
            y: (parent.height - self.height) / 2;
        }

        // Description input
        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            background: Theme.surface-hover;
            border-radius: 6px;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                TextInput {
                    text <=> root.description;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            if description == "": Text {
                x: 12px;
                text: Translations.modal-checkpoint-desc;
                color: Theme.text-subtle;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // Delete button
        if can-delete: Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: del-touch.has-hover ? Theme.delete-bg-hover : transparent;
            y: (parent.height - self.height) / 2;

            Image {
                source: @image-url("../assets/icons/trash.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            del-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.delete();
                }
            }
        }
    }
}

// ==================== AddGoalModal ====================
export component AddGoalModal inherits Rectangle {
    in property <bool> editing: false;
    callback close();

    property <string> goal-name: "";
    property <string> goal-description: "";
    property <string> goal-reward: "";
    property <string> goal-deadline: "";
    property <int> checkpoint-count: 1;
    property <string> cp1: "";
    property <string> cp2: "";
    property <string> cp3: "";
    property <string> cp4: "";
    // Track existing checkpoint IDs for editing
    property <string> cp1-id: "";
    property <string> cp2-id: "";
    property <string> cp3-id: "";
    property <string> cp4-id: "";

    // Helper function to shift checkpoints up after deletion
    function shift-checkpoints-from(position: int) {
        if position == 1 {
            cp1 = cp2;
            cp1-id = cp2-id;
            cp2 = cp3;
            cp2-id = cp3-id;
            cp3 = cp4;
            cp3-id = cp4-id;
            cp4 = "";
            cp4-id = "";
        } else if position == 2 {
            cp2 = cp3;
            cp2-id = cp3-id;
            cp3 = cp4;
            cp3-id = cp4-id;
            cp4 = "";
            cp4-id = "";
        } else if position == 3 {
            cp3 = cp4;
            cp3-id = cp4-id;
            cp4 = "";
            cp4-id = "";
        } else if position == 4 {
            cp4 = "";
            cp4-id = "";
        }
        checkpoint-count -= 1;
    }

    // Helper to delete checkpoint and shift
    function delete-checkpoint-at(position: int, id: string) {
        if id != "" {
            RewardsAdapter.delete-checkpoint(id);
        }
        shift-checkpoints-from(position);
    }

    function reset() {
        goal-name = "";
        goal-description = "";
        goal-reward = "";
        goal-deadline = "";
        checkpoint-count = 1;
        cp1 = "";
        cp2 = "";
        cp3 = "";
        cp4 = "";
        cp1-id = "";
        cp2-id = "";
        cp3-id = "";
        cp4-id = "";
    }

    function load-edit-data() {
        goal-name = RewardsAdapter.edit-goal-name;
        goal-description = RewardsAdapter.edit-goal-description;
        goal-reward = RewardsAdapter.edit-goal-reward;
        goal-deadline = RewardsAdapter.edit-goal-deadline;
        checkpoint-count = RewardsAdapter.edit-goal-checkpoint-count;
        cp1 = RewardsAdapter.edit-goal-cp1-text;
        cp2 = RewardsAdapter.edit-goal-cp2-text;
        cp3 = RewardsAdapter.edit-goal-cp3-text;
        cp4 = RewardsAdapter.edit-goal-cp4-text;
        cp1-id = RewardsAdapter.edit-goal-cp1-id;
        cp2-id = RewardsAdapter.edit-goal-cp2-id;
        cp3-id = RewardsAdapter.edit-goal-cp3-id;
        cp4-id = RewardsAdapter.edit-goal-cp4-id;
        // Ensure at least 1 checkpoint
        if checkpoint-count < 1 {
            checkpoint-count = 1;
        }
    }

    function close-modal() {
        reset();
        root.close();
    }

    function submit() {
        if (goal-name == "") {
            NotificationAdapter.show("Goal name is required", true);
            return;
        }
        if (goal-reward == "") {
            NotificationAdapter.show("Please add a reward", true);
            return;
        }
        if (cp1 == "") {
            NotificationAdapter.show("Add at least one checkpoint", true);
            return;
        }
        if editing {
            // Update existing goal
            let result = RewardsAdapter.update-goal(
                RewardsAdapter.edit-goal-id,
                goal-name,
                goal-description,
                goal-reward,
                goal-deadline);

            if (result != "") {
                return;
            }

            // Handle checkpoints for existing goal
            let goal-id = RewardsAdapter.edit-goal-id;

            // For existing checkpoints, we keep them. For new ones, we add them.
            // Delete removed checkpoints
            if checkpoint-count < 4 && cp4-id != "" {
                RewardsAdapter.delete-checkpoint(cp4-id);
            }
            if checkpoint-count < 3 && cp3-id != "" {
                RewardsAdapter.delete-checkpoint(cp3-id);
            }
            if checkpoint-count < 2 && cp2-id != "" {
                RewardsAdapter.delete-checkpoint(cp2-id);
            }

            // Add new checkpoints (those without IDs)
            if checkpoint-count >= 2 && cp2 != "" && cp2-id == "" {
                RewardsAdapter.add-checkpoint(goal-id, cp2);
            }
            if checkpoint-count >= 3 && cp3 != "" && cp3-id == "" {
                RewardsAdapter.add-checkpoint(goal-id, cp3);
            }
            if checkpoint-count >= 4 && cp4 != "" && cp4-id == "" {
                RewardsAdapter.add-checkpoint(goal-id, cp4);
            }
            close-modal();
        } else {
            // Create new goal
            let result = RewardsAdapter.create-goal(
                goal-name,
                goal-description,
                goal-reward,
                goal-deadline);

            if (result == "") {
                return;
            }
            let goal-id = result;

            // Add checkpoints
            RewardsAdapter.add-checkpoint(goal-id, cp1);

            if (checkpoint-count >= 2 && cp2 != "") {
                RewardsAdapter.add-checkpoint(goal-id, cp2);
            }
            if (checkpoint-count >= 3 && cp3 != "") {
                RewardsAdapter.add-checkpoint(goal-id, cp3);
            }
            if (checkpoint-count >= 4 && cp4 != "") {
                RewardsAdapter.add-checkpoint(goal-id, cp4);
            }
            close-modal();
        }
    }

    init => {
        key-scope.focus();
        if editing {
            load-edit-data();
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        width: min(480px, parent.width - 40px);
        height: min(620px, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header (fixed)
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.success 0%, Theme.accent 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? Translations.modal-edit-goal : Translations.modal-new-goal;
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }
                }
            }

            // Spacer
            Rectangle {
                height: 16px;
            }

            // Scrollable content area
            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 16px;

                    FormField {
                        label: Translations.modal-goal-name;
                        placeholder: Translations.modal-goal-name-placeholder;
                        value <=> goal-name;
                    }

                    FormField {
                        label: Translations.modal-description-optional;
                        placeholder: Translations.modal-goal-description-placeholder;
                        value <=> goal-description;
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        FormField {
                            horizontal-stretch: 1;
                            label: Translations.modal-reward;
                            placeholder: Translations.modal-reward-placeholder-goal;
                            value <=> goal-reward;
                        }

                        DateField {
                            horizontal-stretch: 1;
                            label: Translations.modal-deadline-optional;
                            value <=> goal-deadline;
                        }
                    }

                    // Checkpoints section
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: Translations.modal-checkpoints;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 1.5px;
                                vertical-alignment: center;
                            }

                            if checkpoint-count < 4: Rectangle {
                                width: 70px;
                                height: 28px;
                                border-radius: 6px;
                                background: add-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/plus.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: Theme.text-muted;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: Translations.button-add;
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                add-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (checkpoint-count < 4) {
                                            checkpoint-count += 1;
                                        }
                                    }
                                }
                            }
                        }

                        CheckpointRow {
                            description <=> cp1;
                            can-delete: checkpoint-count > 1;
                            delete => {
                                delete-checkpoint-at(1, cp1-id);
                            }
                        }

                        if checkpoint-count >= 2: CheckpointRow {
                            description <=> cp2;
                            delete => {
                                delete-checkpoint-at(2, cp2-id);
                            }
                        }

                        if checkpoint-count >= 3: CheckpointRow {
                            description <=> cp3;
                            delete => {
                                delete-checkpoint-at(3, cp3-id);
                            }
                        }

                        if checkpoint-count >= 4: CheckpointRow {
                            description <=> cp4;
                            delete => {
                                delete-checkpoint-at(4, cp4-id);
                            }
                        }
                    }

                    // Bottom padding for scroll
                    Rectangle {
                        height: 8px;
                    }
                }
            }

            // Spacer
            Rectangle {
                height: 16px;
            }

            // Submit button (fixed at bottom)
            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.success 0%, Theme.accent 100%);
                border-radius: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Image {
                        source: @image-url("../assets/icons/target.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? Translations.modal-save-changes : Translations.modal-create-goal;
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
