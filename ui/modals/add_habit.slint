import { Palette, AppState, HabitAdapter, NotificationAdapter } from "../globals.slint";

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;

            animate height {
                duration: 150ms;
                easing: ease-out;
            }
            animate background {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }
}

export component AddHabitModal inherits Rectangle {
    property <string> name: "";
    property <string> description: "";
    property <string> habit-color: "#8b5cf6"; // Default purple
    
    callback close();

    function reset() {
        name = "";
        description = "";
        habit-color = "#8b5cf6";
    }

    function submit() {
        if (name == "") {
            NotificationAdapter.show("Name is required", true);
            return;
        }
        
        let result = HabitAdapter.create-habit(name, description, habit-color);
        
        if (result == "") {
            reset();
            // Parent will handle closing via callback if needed, or we set global state here?
            // We don't have direct access to AppState to close unless imported.
            // We imported AppState.
            AppState.show-add-habit = false;
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.close(); } }
    }

    Rectangle {
        width: 400px;
        height: 420px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        // Prevent clicks from closing
        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            Text {
                text: "NEW HABIT";
                color: Palette.text-primary;
                font-size: 12px;
                font-weight: 400;
                letter-spacing: 3px;
            }

            UnderlineField {
                label: "NAME";
                placeholder: "e.g. Read 10 pages";
                value <=> name;
            }

            UnderlineField {
                label: "DESCRIPTION (OPTIONAL)";
                placeholder: "Why this habit matters";
                value <=> description;
            }
            
            // Color Picker (Simple row)
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "COLOR";
                    color: Palette.text-muted;
                    font-size: 10px;
                    letter-spacing: 2px;
                }
                
                HorizontalLayout {
                    spacing: 8px;
                    
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #8b5cf6;
                        border-width: root.habit-color == "#8b5cf6" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#8b5cf6"; } }
                    }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #ec4899;
                        border-width: root.habit-color == "#ec4899" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#ec4899"; } }
                    }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #3b82f6;
                        border-width: root.habit-color == "#3b82f6" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#3b82f6"; } }
                    }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #10b981;
                        border-width: root.habit-color == "#10b981" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#10b981"; } }
                    }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #f59e0b;
                        border-width: root.habit-color == "#f59e0b" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#f59e0b"; } }
                    }
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 12px; background: #ef4444;
                        border-width: root.habit-color == "#ef4444" ? 2px : 0px; border-color: Palette.text-primary;
                        TouchArea { clicked => { root.habit-color = "#ef4444"; } }
                    }
                }
            }

            Rectangle {
                height: 48px;
                background: submit-touch.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                
                animate background { duration: 120ms; }

                Text { 
                    text: "SAVE HABIT"; 
                    color: Palette.text-primary;  
                    horizontal-alignment: center; 
                    vertical-alignment: center; 
                    font-size: 12px; 
                    letter-spacing: 2px; 
                }
                
                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}