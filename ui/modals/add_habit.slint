// ==================== Add Habit Modal ====================
// Premium Fintech UI - Overlay form for creating new habits

import { HabitAdapter, NotificationAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }
    }
}

// ==================== ColorOption ====================
component ColorOption inherits Rectangle {
    in property <color> option-color;
    in property <bool> selected;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: option-color;
    border-width: selected ? 3px : 0px;
    border-color: Theme.text-primary;

    // Glow when selected
    if selected: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 14px;
        background: option-color;
        opacity: 0.4;
    }

    // Inner highlight
    Rectangle {
        width: 50%;
        height: 50%;
        x: 4px;
        y: 4px;
        border-radius: 6px;
        background: @linear-gradient(135deg, Theme.text.with-alpha(0.19) 0%, transparent 100%);
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component CategoryOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    width: 110px;
    height: 34px;
    border-radius: 8px;
    background: selected ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;

    Text {
        text: root.label;
        color: selected ? Theme.text-primary : Theme.text-secondary;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// ==================== AddHabitModal ====================
export component AddHabitModal inherits Rectangle {
    property <string> name: "";
    property <string> description: "";
    property <int> selected-color-index: 0;
    property <int> selected-category-index: 0;
    in property <bool> editing: false;

    property <[color]> color-options: [
        Theme.habit-color-1,
        Theme.habit-color-2,
        Theme.habit-color-3,
        Theme.habit-color-4,
        Theme.habit-color-5,
        Theme.habit-color-6,
        Theme.habit-color-7,
        Theme.habit-color-8,
        Theme.habit-color-9,
        Theme.habit-color-10,
        Theme.habit-color-11,
        Theme.habit-color-12,
        Theme.habit-color-13,
        Theme.habit-color-14,
        Theme.habit-color-15,
        Theme.habit-color-16
    ];
    property <[string]> color-strings: [
        Theme.habit-color-1-hex,
        Theme.habit-color-2-hex,
        Theme.habit-color-3-hex,
        Theme.habit-color-4-hex,
        Theme.habit-color-5-hex,
        Theme.habit-color-6-hex,
        Theme.habit-color-7-hex,
        Theme.habit-color-8-hex,
        Theme.habit-color-9-hex,
        Theme.habit-color-10-hex,
        Theme.habit-color-11-hex,
        Theme.habit-color-12-hex,
        Theme.habit-color-13-hex,
        Theme.habit-color-14-hex,
        Theme.habit-color-15-hex,
        Theme.habit-color-16-hex
    ];
    property <[int]> color-row1: [0, 1, 2, 3, 4, 5, 6, 7];
    property <[int]> color-row2: [8, 9, 10, 11, 12, 13, 14, 15];
    property <[string]> category-labels: [
        Translations.habit-category-mind,
        Translations.habit-category-body,
        Translations.habit-category-spirit
    ];
    property <[string]> category-values: ["mind", "body", "spirit"];

    callback close();

    function load-edit() {
        name = HabitAdapter.edit-name;
        description = HabitAdapter.edit-description;
        selected-color-index = HabitAdapter.edit-color-index;

        if (HabitAdapter.edit-category == "body") {
            selected-category-index = 1;
        } else if (HabitAdapter.edit-category == "spirit") {
            selected-category-index = 2;
        } else {
            selected-category-index = 0;
        }
    }

    function clear-edit() {
        HabitAdapter.edit-id = "";
        HabitAdapter.edit-name = "";
        HabitAdapter.edit-description = "";
        HabitAdapter.edit-color-hex = "";
        HabitAdapter.edit-color-index = 0;
        HabitAdapter.edit-category = "";
    }

    function reset() {
        name = "";
        description = "";
        selected-color-index = 0;
        selected-category-index = 0;
    }

    function close-modal() {
        if (editing) {
            clear-edit();
        }
        reset();
        root.close();
    }

    function submit() {
        if (name == "") {
            NotificationAdapter.show("Name is required", true);
            return;
        }
        let habit-color = color-strings[selected-color-index];
        let habit-category = category-values[selected-category-index];
        let result = editing ? HabitAdapter.update-habit(
                HabitAdapter.edit-id,
                name,
                description,
                habit-color,
                habit-category) : HabitAdapter.create-habit(name, description, habit-color, habit-category);

        if (result == "") {
            close-modal();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    init => {
        key-scope.focus();
        if (editing) {
            load-edit();
        }
    }

    changed editing => {
        if (editing) {
            load-edit();
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                root.submit();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        width: min(Theme.modal-width-md, parent.width - 40px);
        height: min(Theme.modal-height-md, parent.height - 40px);
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.overlay-soft;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, Theme.habit-gradient-start 0%, Theme.habit-gradient-end 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: editing ? Translations.modal-edit-habit-title : Translations.modal-add-habit-title;
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 16px;
                        height: 16px;
                        colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }
                }
            }

            FormField {
                label: Translations.label-name;
                placeholder: Translations.modal-habit-name-placeholder;
                value <=> name;
            }

            FormField {
                label: Translations.modal-description-optional;
                placeholder: Translations.modal-habit-description-placeholder;
                value <=> description;
            }

            // Category Picker
            VerticalLayout {
                spacing: 12px;

                Text {
                    text: Translations.modal-category;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 500;
                    letter-spacing: 1.5px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    for idx in [0, 1, 2]: CategoryOption {
                        label: category-labels[idx];
                        selected: selected-category-index == idx;
                        clicked => {
                            selected-category-index = idx;
                        }
                    }
                }
            }

            // Color Picker
            VerticalLayout {
                spacing: 12px;

                Text {
                    text: Translations.modal-color;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 500;
                    letter-spacing: 1.5px;
                }

                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        for idx in color-row1: ColorOption {
                            option-color: color-options[idx];
                            selected: selected-color-index == idx;
                            clicked => {
                                selected-color-index = idx;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        for idx in color-row2: ColorOption {
                            option-color: color-options[idx];
                            selected: selected-color-index == idx;
                            clicked => {
                                selected-color-index = idx;
                            }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            // Submit button
            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, Theme.habit-gradient-start 0%, Theme.habit-gradient-end 100%);
                border-radius: 10px;

                Text {
                    text: editing ? Translations.modal-save-changes : Translations.action-save;
                    color: Theme.text-light;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                }

                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.submit();
                    }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
