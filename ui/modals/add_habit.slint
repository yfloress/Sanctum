// ==================== Add Habit Modal ====================
// Premium Fintech UI - Overlay form for creating new habits

import { Palette, AppState, HabitAdapter, NotificationAdapter } from "../globals.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== ColorOption ====================
component ColorOption inherits Rectangle {
    in property <color> option-color;
    in property <bool> selected;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: option-color;
    border-width: selected ? 3px : 0px;
    border-color: Palette.text-primary;

    // Glow when selected
    if selected: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 14px;
        background: option-color;
        opacity: 0.4;
    }

    // Inner highlight
    Rectangle {
        width: 50%;
        height: 50%;
        x: 4px;
        y: 4px;
        border-radius: 6px;
        background: @linear-gradient(135deg, #ffffff30 0%, transparent 100%);
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ==================== AddHabitModal ====================
export component AddHabitModal inherits Rectangle {
    property <string> name: "";
    property <string> description: "";
    property <int> selected-color-index: 0;

    property <[color]> color-options: [
        #8b5cf6, #ec4899, #3b82f6, #10b981, #f59e0b, #ef4444,
        #14b8a6, #22d3ee, #a855f7, #f97316, #eab308, #0ea5e9
    ];
    property <[string]> color-strings: [
        "#8b5cf6", "#ec4899", "#3b82f6", "#10b981", "#f59e0b", "#ef4444",
        "#14b8a6", "#22d3ee", "#a855f7", "#f97316", "#eab308", "#0ea5e9"
    ];
    property <[int]> color-row1: [0, 1, 2, 3, 4, 5];
    property <[int]> color-row2: [6, 7, 8, 9, 10, 11];
    
    callback close();

    function reset() {
        name = "";
        description = "";
        selected-color-index = 0;
    }

    function submit() {
        if (name == "") {
            NotificationAdapter.show("Name is required", true);
            return;
        }
        
        let habit-color = color-strings[selected-color-index];
        let result = HabitAdapter.create-habit(name, description, habit-color);
        
        if (result == "") {
            reset();
            AppState.show-add-habit = false;
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.close(); } }
    }

    // Modal panel
    Rectangle {
        width: 440px;
        height: 480px;
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, #0f0f1a 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000088;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 24px;

            // Header
            HorizontalLayout {
                height: 32px;

                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: @linear-gradient(180deg, #8b5cf6 0%, #ec4899 100%);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "NEW HABIT";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }
                }
            }

            FormField {
                label: "NAME";
                placeholder: "e.g. Read 10 pages";
                value <=> name;
            }

            FormField {
                label: "DESCRIPTION (OPTIONAL)";
                placeholder: "Why this habit matters";
                value <=> description;
            }
            
            // Color Picker
            VerticalLayout {
                spacing: 12px;

                Text {
                    text: "COLOR";
                    color: Palette.text-muted;
                    font-size: 10px;
                    font-weight: 500;
                    letter-spacing: 1.5px;
                }
                
                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        for idx in color-row1: ColorOption {
                            option-color: color-options[idx];
                            selected: selected-color-index == idx;
                            clicked => { selected-color-index = idx; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        for idx in color-row2: ColorOption {
                            option-color: color-options[idx];
                            selected: selected-color-index == idx;
                            clicked => { selected-color-index = idx; }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Submit button
            Rectangle {
                height: 48px;
                background: @linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
                border-radius: 10px;
                
                Text { 
                    text: "SAVE HABIT"; 
                    color: #ffffff;
                    horizontal-alignment: center; 
                    vertical-alignment: center; 
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px; 
                }
                
                submit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.submit(); }
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
