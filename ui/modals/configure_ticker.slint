// ==================== Configure Crypto Modal ====================
// Select which coins appear in the top price bar

import { AppState, CryptoAdapter, NotificationAdapter } from "../globals.slint";
import { ActionButton, TextButton } from "../widgets.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";

component TickerToggleRow inherits Rectangle {
    in property <string> symbol;
    in property <string> name;
    in property <bool> checked;
    in property <bool> is-custom: false;

    callback toggled;

    height: 48px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        alignment: space-between;

        // Label
        VerticalLayout {
            alignment: center;
            Text {
                text: root.symbol + (root.is-custom ? " *" : "");
                color: root.is-custom ? Theme.accent : Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
            }

            Text {
                text: root.name;
                color: root.is-custom ? Theme.text-secondary : Theme.text-muted;
                font-size: 10px;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            // Toggle Switch
            Rectangle {
                width: 36px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? Theme.accent : Theme.surface-hover;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : Theme.border;

                animate background { duration: 150ms; }

                // Knob
                Rectangle {
                    x: root.checked ? 18px : 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.checked ? Theme.background : Theme.text-secondary;

                    animate x {
                        duration: 150ms;
                        easing: ease-in-out;
                    }
                }

                TouchArea {
                    clicked => {
                        root.toggled();
                    }
                }
            }
        }
    }

    // Bottom line
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-subtle;
        opacity: 0.5;
    }
}

component ConfigTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;

    width: 150px;
    height: 32px;
    border-radius: 8px;
    background: active ? Theme.surface : transparent;
    border-width: 1px;
    border-color: active ? Theme.border-subtle : transparent;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Text {
        text: root.text;
        color: active ? Theme.text-primary : Theme.text-muted;
        font-size: 10px;
        font-weight: active ? 600 : 500;
        letter-spacing: 1.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SearchInput inherits Rectangle {
    in property <string> placeholder: "Search...";
    in-out property <string> text: "";
    callback edited(string);

    height: 40px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        if root.text == "" && !input.has-focus: Text {
            text: root.placeholder;
            color: Theme.text-subtle;
            font-size: 12px;
            vertical-alignment: center;
        }

        input := TextInput {
            text <=> root.text;
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;

            edited => {
                root.edited(root.text);
            }
        }

        if root.text != "": Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: clear-touch.has-hover ? Theme.surface-hover : transparent;

            Text {
                text: "×";
                color: clear-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }
    }

    TouchArea {
        clicked => {
            input.focus();
        }
    }
}

component ConfigField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";

    height: 60px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 36px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Theme.text-subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            TouchArea {
                clicked => {
                    input.focus();
                }
            }
        }
    }
}

component CatalogRow inherits Rectangle {
    in property <string> symbol;
    in property <string> name;
    in property <bool> is-custom: false;
    in property <bool> deletable: false;
    in-out property <bool> selected: false;

    callback delete;
    callback toggled;

    height: 48px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        alignment: space-between;

        Rectangle {
            background: transparent;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: root.selected ? Theme.accent : transparent;
                    border-width: 1px;
                    border-color: root.selected ? Theme.accent : Theme.border-subtle;
                    y: (parent.height - self.height) / 2;

                    if root.selected: Image {
                        source: @image-url("../assets/icons/check.svg");
                        width: 10px;
                        height: 10px;
                        colorize: Theme.text;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.symbol + (root.is-custom ? " *" : "");
                        color: root.is-custom ? Theme.accent : Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.name;
                        color: root.is-custom ? Theme.text-secondary : Theme.text-muted;
                        font-size: 10px;
                    }
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
            }
        }

        if root.deletable: ActionButton {
            text: Translations.modal-remove;
            primary: false;
            height: 28px;
            min-width: 88px;
            clicked => {
                root.delete();
            }
        }

        if !root.deletable: Text {
            text: Translations.modal-default;
            color: Theme.text-subtle;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-subtle;
        opacity: 0.5;
    }
}

export component ConfigureTickerModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    property <string> active-tab: "ticker";
    property <string> ticker-search: "";
    property <string> catalog-search: "";
    property <string> catalog-tab: "list";
    property <string> new-coin-id: "";
    property <string> new-coin-name: "";
    property <string> new-coin-symbol: "";

    init => {
        CryptoAdapter.load-ticker-options();
        CryptoAdapter.load-coin-catalog();
        CryptoAdapter.filter-coin-catalog("");
    }

    changed ticker-search => {
        CryptoAdapter.filter-ticker-options(root.ticker-search);
    }

    changed catalog-search => {
        CryptoAdapter.filter-coin-catalog(root.catalog-search);
    }

    // Backdrop
    Rectangle {
        background: Theme.overlay;
        opacity: 1.0;

        animate opacity {
            duration: 150ms;
            easing: ease-out;
        }

        TouchArea {
            clicked => {
                AppState.show-configure-ticker = false;
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                AppState.show-configure-ticker = false;
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                CryptoAdapter.save-ticker-options();
                AppState.show-configure-ticker = false;
                return accept;
            }
            return reject;
        }
    }

    // Modal Panel
    Rectangle {
        width: 420px;
        height: 600px;
        background: Theme.sidebar-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        opacity: 1.0;

        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            Text {
                text: Translations.modal-crypto-settings;
                color: Theme.text-muted;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 8px;
            }

            Text {
                text: Translations.modal-manage-price-bar;
                color: Theme.text-muted;
                font-size: 10px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 16px;
            }

            // Tabs
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                ConfigTabButton {
                    text: Translations.modal-price-bar;
                    active: root.active-tab == "ticker";
                    clicked => {
                        root.active-tab = "ticker";
                    }
                }

                ConfigTabButton {
                    text: Translations.modal-coin-catalog;
                    active: root.active-tab == "catalog";
                    clicked => {
                        root.active-tab = "catalog";
                    }
                }
            }

            Rectangle {
                height: 16px;
            }

            if root.active-tab == "ticker": VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                Text {
                    text: Translations.modal-max-coins;
                    color: Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }

                SearchInput {
                    text <=> root.ticker-search;
                    placeholder: Translations.modal-search-coins;
                }

                Rectangle {
                    height: 4px;
                }

                // List
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Flickable {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        viewport-height: CryptoAdapter.ticker-options.length * 48px;

                        ticker-list := VerticalLayout {
                            spacing: 0px;

                            for option[index] in CryptoAdapter.ticker-options: TickerToggleRow {
                                visible: option.visible;
                                height: option.visible ? 48px : 0px;
                                symbol: option.symbol;
                                name: option.name;
                                checked: option.enabled;
                                is-custom: option.custom;

                                toggled => {
                                    CryptoAdapter.ticker-options[index].enabled = !CryptoAdapter.ticker-options[index].enabled;
                                }
                            }
                        }
                    }
                }
            }

            if root.active-tab == "catalog": VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                Text {
                    text: Translations.modal-catalog-info;
                    color: Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    ConfigTabButton {
                        text: Translations.modal-coin-list;
                        active: root.catalog-tab == "list";
                        clicked => {
                            root.catalog-tab = "list";
                        }
                    }

                    ConfigTabButton {
                        text: Translations.modal-add-coin;
                        active: root.catalog-tab == "add";
                        clicked => {
                            root.catalog-tab = "add";
                        }
                    }
                }

                if root.catalog-tab == "list": VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;

                    Text {
                        text: Translations.modal-removing-info;
                        color: Theme.text-muted;
                        font-size: 9px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;

                            ActionButton {
                                text: Translations.modal-select-all;
                                primary: false;
                                min-width: 96px;
                                clicked => {
                                    CryptoAdapter.select-all-coins();
                                }
                            }

                            ActionButton {
                                text: Translations.action-clear;
                                primary: false;
                                min-width: 72px;
                                clicked => {
                                    CryptoAdapter.clear-coin-selection();
                                }
                            }
                        }

                        ActionButton {
                            text: Translations.modal-remove-selected;
                            primary: false;
                            min-width: 140px;
                            clicked => {
                                let res = CryptoAdapter.delete-selected-coins();
                                if (res != "") {
                                    NotificationAdapter.show(res, true);
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;

                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding: 8px;
                            spacing: 8px;

                            SearchInput {
                                text <=> root.catalog-search;
                                placeholder: Translations.modal-search-coins;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                                opacity: 0.6;
                            }

                            Flickable {
                                vertical-stretch: 1;
                                horizontal-stretch: 1;
                                viewport-height: CryptoAdapter.coin-catalog.length * 48px;

                                catalog-list := VerticalLayout {
                                    spacing: 0px;

                                    for coin[index] in CryptoAdapter.coin-catalog: CatalogRow {
                                        visible: coin.visible;
                                        height: coin.visible ? 48px : 0px;
                                        symbol: coin.symbol;
                                        name: coin.name;
                                        is-custom: coin.custom;
                                        deletable: true;
                                        selected: coin.selected;
                                        delete => {
                                            let res = CryptoAdapter.delete-custom-coin(coin.id);
                                            if (res != "") {
                                                NotificationAdapter.show(res, true);
                                            }
                                        }
                                        toggled => {
                                            CryptoAdapter.coin-catalog[index].selected = !CryptoAdapter.coin-catalog[index].selected;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.catalog-tab == "add": VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            Text {
                                text: Translations.modal-add-custom-coin;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 2px;
                            }

                            Text {
                                text: Translations.modal-coingecko-hint;
                                color: Theme.text-muted;
                                font-size: 9px;
                            }

                            Text {
                                text: Translations.modal-symbol-hint;
                                color: Theme.text-muted;
                                font-size: 9px;
                            }

                            ConfigField {
                                label: Translations.modal-coingecko-id;
                                placeholder: Translations.modal-coingecko-id-placeholder;
                                value <=> root.new-coin-id;
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                ConfigField {
                                    label: Translations.label-name;
                                    placeholder: Translations.modal-name-placeholder;
                                    value <=> root.new-coin-name;
                                    horizontal-stretch: 1;
                                }

                                ConfigField {
                                    label: Translations.modal-symbol;
                                    placeholder: Translations.modal-symbol-placeholder;
                                    value <=> root.new-coin-symbol;
                                    width: 120px;
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                TextButton {
                                    text: Translations.modal-add-coin;
                                    clicked => {
                                        let res = CryptoAdapter.add-custom-coin(
                                            root.new-coin-id,
                                            root.new-coin-name,
                                            root.new-coin-symbol);
                                        if (res != "") {
                                            NotificationAdapter.show(res, true);
                                        } else {
                                            root.new-coin-id = "";
                                            root.new-coin-name = "";
                                            root.new-coin-symbol = "";
                                            root.catalog-search = "";
                                            CryptoAdapter.filter-coin-catalog(root.catalog-search);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 16px;
            }

            HorizontalLayout {
                alignment: center;
                ActionButton {
                    text: Translations.modal-save-configuration;
                    primary: true;
                    clicked => {
                        CryptoAdapter.save-ticker-options();
                        AppState.show-configure-ticker = false;
                    }
                }
            }
        }
    }
}
