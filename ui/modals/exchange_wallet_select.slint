// ==================== Exchange Wallet Select Modal ====================
// Step between CSV file selection and import preview.
// Lets the user pick an existing wallet or create a new one
// as the target for imported exchange transactions.

import {
    AppState,
    CryptoAdapter,
    IngestionAdapter,
    NotificationAdapter,
    WalletSimple,
} from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { FormField } from "../components/forms/form_field.slint";

// ==================== Wallet Option Row ====================
component WalletOptionRow inherits Rectangle {
    in property <string> wallet-name;
    in property <bool> selected;
    callback clicked;

    height: 48px;
    background: selected
        ? @linear-gradient(135deg, Theme.surface 0%, Theme.crypto-icon-gradient-start 100%)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: 10px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 16px;
            vertical-stretch: 1;

            Image {
                source: @image-url("../assets/icons/wallet.svg");
                width: 16px;
                height: 16px;
                colorize: selected ? Theme.accent : Theme.text-muted;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.wallet-name;
            color: selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if selected: Rectangle {
            width: 14px;
            vertical-stretch: 1;

            Image {
                source: @image-url("../assets/icons/check.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.accent;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// ==================== Category Option ====================
component CategoryOption inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> value;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    background: selected
        ? @linear-gradient(135deg, Theme.surface 0%, Theme.crypto-icon-gradient-start 100%)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: 8px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        Rectangle {
            width: 14px;
            vertical-stretch: 1;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: selected ? Theme.accent : Theme.text-muted;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.title;
            color: selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// ==================== Main Modal ====================
export component ExchangeWalletSelectModal inherits Rectangle {
    callback close();
    callback continue-import();

    // State: false = select existing, true = create new
    property <bool> create-mode: false;
    property <int> selected-wallet-index: -1;

    // New wallet fields
    property <string> new-wallet-name: "";
    property <string> new-wallet-category: "wallet_single";

    // Computed: can proceed
    property <bool> can-continue: !create-mode && selected-wallet-index >= 0 && selected-wallet-index < CryptoAdapter.wallet-list.length;
    property <bool> can-create: create-mode && new-wallet-name != "";

    function close-modal() {
        root.reset();
        root.close();
    }

    function reset() {
        create-mode = false;
        selected-wallet-index = -1;
        new-wallet-name = "";
        new-wallet-category = "wallet_single";
    }

    function do-continue() {
        if (create-mode) {
            if (new-wallet-name == "") {
                NotificationAdapter.show(Translations.exchange-wallet-name-required, true);
                return;
            }
            // Create the wallet via CryptoAdapter
            CryptoAdapter.icon-edit-wallet-category = new-wallet-category;
            CryptoAdapter.icon-edit-wallet-icon = "";
            let result = CryptoAdapter.create-wallet(new-wallet-name, new-wallet-category);
            if (result != "") {
                NotificationAdapter.show(result, true);
                return;
            }
            CryptoAdapter.fetch-wallets();
            // Set the wallet name on the ingestion adapter
            IngestionAdapter.exchange-wallet-name = new-wallet-name;
        } else {
            if (selected-wallet-index < 0 || selected-wallet-index >= CryptoAdapter.wallet-list.length) {
                NotificationAdapter.show(Translations.exchange-wallet-select-required, true);
                return;
            }
            IngestionAdapter.exchange-wallet-name = CryptoAdapter.wallet-list[selected-wallet-index].name;
        }
        root.reset();
        root.continue-import();
    }

    init => {
        key-scope.focus();
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        Flickable {
            width: 100%;
            height: 100%;
            interactive: false;
            viewport-width: parent.width;
            viewport-height: parent.height;
        }

        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                do-continue();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        width: min(480px, parent.width - 40px);
        height: min(560px, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #00000040;

        TouchArea {
            clicked => {
                key-scope.focus();
            }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Scrollable body
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                body := Flickable {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 20px;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 28px;
                        padding-bottom: 12px;

                        // Header
                        HorizontalLayout {
                            height: 32px;

                            HorizontalLayout {
                                spacing: 12px;
                                horizontal-stretch: 1;

                                Rectangle {
                                    width: 4px;
                                    height: 20px;
                                    border-radius: 2px;
                                    background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: Translations.exchange-wallet-select-title;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 500;
                                    letter-spacing: 2px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: close-touch.has-hover ? Theme.surface-hover : transparent;

                                Image {
                                    source: @image-url("../assets/icons/x.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                close-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        close-modal();
                                    }
                                }
                            }
                        }

                        // Subtitle
                        Text {
                            text: Translations.exchange-wallet-select-subtitle;
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        // Detected format info
                        if IngestionAdapter.exchange-detected-format != "": Rectangle {
                            height: detected-layout.preferred-height + 16px;
                            background: Theme.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;

                            detected-layout := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;

                                Text {
                                    text: Translations.import-exchange-detected;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    font-weight: 500;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: IngestionAdapter.exchange-detected-format;
                                    color: Theme.accent;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Mode toggle tabs
                        Rectangle {
                            height: 40px;
                            background: Theme.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 4px;
                                spacing: 4px;

                                // Select existing tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: !create-mode
                                        ? @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%)
                                        : (select-tab-touch.has-hover ? Theme.surface-hover : transparent);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        padding-top: 0px;
                                        padding-bottom: 0px;

                                        Rectangle {
                                            width: 12px;
                                            vertical-stretch: 1;

                                            Image {
                                                source: @image-url("../assets/icons/wallet.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: !create-mode ? Theme.text-light : Theme.text-muted;
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        Text {
                                            text: Translations.exchange-wallet-tab-select;
                                            color: !create-mode ? Theme.text-light : Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: !create-mode ? 600 : 400;
                                            letter-spacing: 1px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    select-tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            create-mode = false;
                                        }
                                    }
                                }

                                // Create new tab
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: create-mode
                                        ? @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%)
                                        : (create-tab-touch.has-hover ? Theme.surface-hover : transparent);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        padding-top: 0px;
                                        padding-bottom: 0px;

                                        Rectangle {
                                            width: 12px;
                                            vertical-stretch: 1;

                                            Image {
                                                source: @image-url("../assets/icons/plus.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: create-mode ? Theme.text-light : Theme.text-muted;
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        Text {
                                            text: Translations.exchange-wallet-tab-create;
                                            color: create-mode ? Theme.text-light : Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: create-mode ? 600 : 400;
                                            letter-spacing: 1px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    create-tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            create-mode = true;
                                        }
                                    }
                                }
                            }
                        }

                        // ===== Select Existing Wallet Mode =====
                        if !create-mode: VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: Translations.exchange-wallet-select-label;
                                color: Theme.text-muted;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 1.5px;
                            }

                            if CryptoAdapter.wallet-list.length == 0: Rectangle {
                                height: 64px;
                                background: Theme.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    alignment: center;
                                    padding-left: 16px;
                                    padding-right: 16px;

                                    Text {
                                        text: Translations.exchange-wallet-no-wallets;
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        font-weight: 400;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Wallet list
                            if CryptoAdapter.wallet-list.length > 0: Rectangle {
                                height: min(CryptoAdapter.wallet-list.length * 56px + 8px, 200px);
                                background: Theme.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;

                                wallet-scroll := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    viewport-height: CryptoAdapter.wallet-list.length * 56px + 8px;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 4px;

                                        for wallet[index] in CryptoAdapter.wallet-list: WalletOptionRow {
                                            wallet-name: wallet.name;
                                            selected: index == selected-wallet-index;
                                            clicked => {
                                                selected-wallet-index = index;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ===== Create New Wallet Mode =====
                        if create-mode: VerticalLayout {
                            spacing: 16px;

                            // Wallet name field
                            FormField {
                                label: Translations.modal-wallet-name;
                                placeholder: "e.g. Feather Wallet";
                                value <=> new-wallet-name;
                                submit-shortcut => {
                                    do-continue();
                                }
                            }

                            // Category selection
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: Translations.modal-wallet-type;
                                    color: Theme.text-muted;
                                    font-size: 10px;
                                    font-weight: 500;
                                    letter-spacing: 1.5px;
                                }

                                VerticalLayout {
                                    spacing: 6px;

                                    CategoryOption {
                                        icon: @image-url("../assets/icons/wallet.svg");
                                        title: Translations.exchange-wallet-category-software;
                                        value: "wallet_single";
                                        selected: new-wallet-category == "wallet_single";
                                        clicked => {
                                            new-wallet-category = "wallet_single";
                                        }
                                    }

                                    CategoryOption {
                                        icon: @image-url("../assets/icons/shield.svg");
                                        title: Translations.exchange-wallet-category-hardware;
                                        value: "wallet_multi";
                                        selected: new-wallet-category == "wallet_multi";
                                        clicked => {
                                            new-wallet-category = "wallet_multi";
                                        }
                                    }

                                    CategoryOption {
                                        icon: @image-url("../assets/icons/trending-up.svg");
                                        title: Translations.exchange-wallet-category-exchange;
                                        value: "exchange";
                                        selected: new-wallet-category == "exchange";
                                        clicked => {
                                            new-wallet-category = "exchange";
                                        }
                                    }
                                }
                            }
                        }

                        // Spacer
                        Rectangle {
                            height: 4px;
                        }
                    }
                }
            }

            // Action buttons
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 28px;
                padding-top: 12px;

                // Cancel Button
                Rectangle {
                    horizontal-stretch: 1;
                    height: 44px;
                    border-radius: 10px;
                    background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-light;

                    Text {
                        text: Translations.import-preview-cancel;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }
                }

                // Continue Button
                continue-btn := Rectangle {
                    property <bool> enabled: create-mode ? can-create : can-continue;

                    horizontal-stretch: 1;
                    height: 44px;
                    border-radius: 10px;
                    background: enabled
                        ? @linear-gradient(135deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%)
                        : Theme.surface;
                    border-width: enabled ? 0px : 1px;
                    border-color: Theme.border-light;
                    opacity: enabled ? 1.0 : 0.5;

                    Text {
                        text: Translations.exchange-wallet-continue;
                        color: continue-btn.enabled ? Theme.text-light : Theme.text-muted;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    continue-touch := TouchArea {
                        mouse-cursor: continue-btn.enabled ? pointer : not-allowed;
                        clicked => {
                            if (continue-btn.enabled) {
                                do-continue();
                            }
                        }
                    }

                    states [
                        hover when continue-touch.has-hover && continue-btn.enabled: {
                            opacity: 0.9;
                        }
                    ]
                }
            }
        }
    }
}
