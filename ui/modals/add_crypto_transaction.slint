// ==================== Add Crypto Asset Modal ====================
// Noir Fintech - Premium asset registration flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== Form Field ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;
    in property <bool> readonly: false;

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 10px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border-subtle;
            
            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                
                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 400 : 300;
                    vertical-alignment: center;
                    read-only: root.readonly;
                }
            }

            TouchArea {
                clicked => { if (!root.readonly) { input.focus(); } }
            }
        }
    }
}

// ==================== Transaction Type Toggle ====================
component TypeToggle inherits Rectangle {
    in-out property <bool> is-buy: true;

    height: 48px;
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border-subtle;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        Rectangle {
            horizontal-stretch: 1;
            background: is-buy ? Palette.success.with-alpha(0.15) : transparent;
            border-radius: 6px;
            border-width: 1px;
            border-color: is-buy ? Palette.success.with-alpha(0.3) : transparent;
            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                
                Text {
                    text: "▲";
                    color: is-buy ? Palette.success : Palette.text-subtle;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "BUY";
                    color: is-buy ? Palette.success : Palette.text-muted;
                    font-size: 11px;
                    font-weight: is-buy ? 600 : 400;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = true; } 
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: !is-buy ? Palette.danger.with-alpha(0.15) : transparent;
            border-radius: 6px;
            border-width: 1px;
            border-color: !is-buy ? Palette.danger.with-alpha(0.3) : transparent;
            animate background { duration: 150ms; }
            animate border-color { duration: 150ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                
                Text {
                    text: "▼";
                    color: !is-buy ? Palette.danger : Palette.text-subtle;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "SELL";
                    color: !is-buy ? Palette.danger : Palette.text-muted;
                    font-size: 11px;
                    font-weight: !is-buy ? 600 : 400;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = false; } 
            }
        }
    }
}

// ==================== Wallet Selector ====================
component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 10px;
        
        Text { 
            text: "TARGET WALLET"; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 600; 
            letter-spacing: 2px; 
        }
        
        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: touch.has-hover ? Palette.border-light.with-alpha(0.3) : Palette.border-subtle;
            
            animate border-color { duration: 150ms; }
            
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                
                // Wallet icon
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 6px;
                    background: Palette.background;
                    y: (parent.height - self.height) / 2;
                    
                    Text {
                        text: "💼";
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                
                Rectangle { width: 12px; }
                
                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? 
                        CryptoAdapter.wallet-list[selected-index].name : 
                        "No wallets available";
                    color: CryptoAdapter.wallet-list.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text { 
                    text: "▾"; 
                    color: Palette.text-muted; 
                    font-size: 12px; 
                    vertical-alignment: center; 
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.wallet-list.length > 0) { 
                        popup.show(); 
                    } 
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0; 
        y: 64px; 
        width: root.width;
        close-policy: close-on-click;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            height: min(CryptoAdapter.wallet-list.length * 44px + 8px, 220px);
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 44px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                background: Palette.surface;
                                y: (parent.height - self.height) / 2;
                                
                                Text {
                                    text: "💼";
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                            
                            Text { 
                                text: wallet.name; 
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            
                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        
                        option-touch := TouchArea { 
                            mouse-cursor: pointer;
                            clicked => { 
                                root.selected-index = index; 
                                popup.close(); 
                            } 
                        }
                    }
                }
            }
        }
    }
}

// ==================== Coin Selector ====================
component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    in property <[string]> options;
    
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 10px;
        
        Text { 
            text: "CRYPTOCURRENCY"; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 600; 
            letter-spacing: 2px; 
        }
        
        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: touch.has-hover ? Palette.border-light.with-alpha(0.3) : Palette.border-subtle;
            
            animate border-color { duration: 150ms; }
            
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                
                // Coin icon placeholder
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: @linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
                    border-width: 1px;
                    border-color: Palette.border-subtle;
                    y: (parent.height - self.height) / 2;
                    
                    Text {
                        text: "₿";
                        color: Palette.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                
                Rectangle { width: 12px; }
                
                Text {
                    text: root.options.length > selected-index ? root.options[selected-index] : "Select Asset";
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                
                Text { 
                    text: "▾"; 
                    color: Palette.text-muted; 
                    font-size: 12px; 
                    vertical-alignment: center; 
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.options.length > 0) {
                        popup.show();
                    }
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            height: min(root.options.length * 40px + 8px, 300px);
            
            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: root.options.length * 40px + 8px;
                interactive: true;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    
                    for option[index] in root.options: Rectangle {
                        height: 36px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            
                            Text { 
                                text: option; 
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 12px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            
                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        
                        option-touch := TouchArea { 
                            mouse-cursor: pointer;
                            clicked => { 
                                root.selected-index = index; 
                                popup.close();
                            } 
                        }
                    }
                }
            }
        }
    }
}

