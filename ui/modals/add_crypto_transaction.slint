// ==================== Add Crypto Asset Modal ====================
// Premium Fintech UI - Asset registration flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";
import { CustomVScrollbar } from "../widgets.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;
    in property <bool> show-refresh: false;
    callback edited(string);
    callback refresh();

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.label;
                color: Palette.text-muted;
                font-size: 10px;
                font-weight: 500;
                letter-spacing: 1.5px;
                horizontal-stretch: 1;
            }

            if root.show-refresh: Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);

                Text {
                    text: "↻";
                    color: Palette.text-primary;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh(); }
                }
            }
        }

        Rectangle {
            height: large ? 56px : 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                    edited => { root.edited(root.value); }
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== TypeSelector ====================
component TypeSelector inherits Rectangle {
    in-out property <string> selected-type: "buy";
    property <string> active-group: (root.selected-type == "buy" || root.selected-type == "sell")
        ? "trade"
        : (root.selected-type == "swap" ? "swap" : "move");

    height: root.active-group == "swap" ? 48px : 92px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: 36px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                for group[index] in ["trade", "move", "swap"]: Rectangle {
                    horizontal-stretch: 1;
                    background: root.active-group == group ? Palette.primary.with-alpha(0.2) : transparent;
                    border-radius: 8px;
                    border-width: root.active-group == group ? 1px : 0px;
                    border-color: Palette.primary.with-alpha(0.4);

                    Text {
                        text: group == "trade" ? "TRADE" : group == "move" ? "MOVE" : "SWAP";
                        color: root.active-group == group ? Palette.text-primary : Palette.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (group == "trade") {
                                root.selected-type = "buy";
                            } else if (group == "move") {
                                root.selected-type = "move";
                            } else {
                                root.selected-type = "swap";
                            }
                        }
                    }
                }
            }
        }

        if root.active-group == "trade": Rectangle {
            height: 48px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                for type[index] in ["buy", "sell"]: Rectangle {
                    horizontal-stretch: 1;
                    background: root.selected-type == type
                        ? (type == "buy" ? Palette.success.with-alpha(0.2) : Palette.danger.with-alpha(0.2))
                        : transparent;
                    border-radius: 8px;
                    border-width: root.selected-type == type ? 1px : 0px;
                    border-color: type == "buy"
                        ? Palette.success.with-alpha(0.4)
                        : Palette.danger.with-alpha(0.4);

                    Text {
                        text: type == "buy" ? "BUY" : "SELL";
                        color: root.selected-type == type ? Palette.text-primary : Palette.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected-type = type; }
                    }
                }
            }
        }

        if root.active-group == "move": Rectangle {
            height: 48px;
            background: Palette.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                for type[index] in ["transfer_in", "transfer_out", "move"]: Rectangle {
                    horizontal-stretch: 1;
                    background: root.selected-type == type
                        ? (type == "transfer_in" ? Palette.success.with-alpha(0.2) :
                           type == "transfer_out" ? Palette.danger.with-alpha(0.2) :
                           Palette.primary.with-alpha(0.2))
                        : transparent;
                    border-radius: 8px;
                    border-width: root.selected-type == type ? 1px : 0px;
                    border-color: type == "transfer_in"
                        ? Palette.success.with-alpha(0.4)
                        : type == "transfer_out"
                            ? Palette.danger.with-alpha(0.4)
                            : Palette.primary.with-alpha(0.4);

                    Text {
                        text: type == "transfer_in" ? "IN" : type == "transfer_out" ? "OUT" : "MOVE";
                        color: root.selected-type == type ? Palette.text-primary : Palette.text-muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected-type = type; }
                    }
                }
            }
        }
    }
}

// ==================== WalletSelector ====================
component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    in property <string> label: "WALLET";
    
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        
        Text { 
            text: root.label; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 500; 
            letter-spacing: 1.5px; 
        }
        
        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? 
                        CryptoAdapter.wallet-list[selected-index].name : 
                        "No wallets available";
                    color: CryptoAdapter.wallet-list.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text { 
                    text: "▼"; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.wallet-list.length > 0) { 
                        popup.show(); 
                    } 
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0; 
        y: 64px; 
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(CryptoAdapter.wallet-list.length * 40px + 8px, 200px);
            drop-shadow-blur: 16px;
            drop-shadow-color: Palette.shadow-color;
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text { 
                                text: wallet.name; 
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== CoinSelector ====================
component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    in property <string> label: "CRYPTOCURRENCY";
    property <bool> popup-open: false;
    property <string> search-query: "";
    property <int> safe-index: CryptoAdapter.coin-catalog.length > 0 && selected-index < CryptoAdapter.coin-catalog.length
        ? selected-index
        : 0;

    callback selected(int, string); // index, name

    property <length> popup-height: min(CryptoAdapter.coin-catalog.length * 40px + 64px, 300px);

    function reset-search() {
        root.search-query = "";
        CryptoAdapter.filter-coin-catalog("");
    }

    height: popup-open ? 64px + popup-height : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: CryptoAdapter.coin-catalog.length > 0
                        ? CryptoAdapter.coin-catalog[safe-index].name
                            + " ("
                            + CryptoAdapter.coin-catalog[safe-index].symbol
                            + ")"
                            + (CryptoAdapter.coin-catalog[safe-index].custom ? " *" : "")
                        : "No coins available";
                    color: CryptoAdapter.coin-catalog.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.coin-catalog.length > 0) { 
                        root.popup-open = !root.popup-open;
                        root.reset-search();
                    } 
                }
            }
        }
    }

    if popup-open: Rectangle {
        x: 0;
        y: 64px;
        width: root.width;
        height: popup-height;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 16px;
        drop-shadow-color: Palette.shadow-color;
        clip: true;

        TouchArea {
            clicked => {
                root.popup-open = false;
                root.reset-search();
            }
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: 8px;
            spacing: 8px;

            Rectangle {
                height: 32px;
                background: Palette.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: search-input.has-focus ? Palette.accent : Palette.border;

                animate border-color { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;

                    if root.search-query == "" && !search-input.has-focus: Text {
                        text: "Search coin...";
                        color: Palette.text-subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        text <=> root.search-query;
                        color: Palette.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;

                        edited => { CryptoAdapter.filter-coin-catalog(root.search-query); }
                    }
                }

                TouchArea {
                    clicked => { search-input.focus(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border-subtle;
                opacity: 0.6;
            }

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                clip: true;

                list-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: CryptoAdapter.coin-catalog.length * 40px + 8px;

                    background-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.popup-open = false;
                            root.reset-search();
                        }
                    }
                    
                    coin-list := VerticalLayout {
                        spacing: 0px;

                        for coin[index] in CryptoAdapter.coin-catalog: Rectangle {
                            visible: coin.visible && coin.favorite;
                            height: coin.visible && coin.favorite ? 40px : 0px;
                            background: option-touch-fav.has-hover ? Palette.surface-hover : transparent;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    background: favorite-touch-fav.has-hover ? Palette.surface-hover : transparent;

                                    Text {
                                        text: coin.favorite ? "★" : "☆";
                                        color: coin.favorite ? Palette.accent : Palette.text-muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    favorite-touch-fav := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let next = !coin.favorite;
                                            let result = CryptoAdapter.set-favorite-coin(coin.id, next);
                                            if (result == "") {
                                                CryptoAdapter.coin-catalog[index].favorite = next;
                                            } else {
                                                NotificationAdapter.show(result, true);
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    HorizontalLayout {
                                        Text {
                                            text: coin.name + " (" + coin.symbol + ")" + (coin.custom ? " *" : "");
                                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                            font-size: 13px;
                                            font-weight: index == selected-index ? 500 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        if index == selected-index: Text {
                                            text: "✓";
                                            color: Palette.accent;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    option-touch-fav := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { 
                                            root.selected-index = index; 
                                            root.selected(index, coin.name);
                                            root.popup-open = false;
                                            root.reset-search();
                                        }
                                    }
                                }
                            }
                        }

                        for coin[index] in CryptoAdapter.coin-catalog: Rectangle {
                            visible: coin.visible && !coin.favorite;
                            height: coin.visible && !coin.favorite ? 40px : 0px;
                            background: option-touch-all.has-hover ? Palette.surface-hover : transparent;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    background: favorite-touch-all.has-hover ? Palette.surface-hover : transparent;

                                    Text {
                                        text: coin.favorite ? "★" : "☆";
                                        color: coin.favorite ? Palette.accent : Palette.text-muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    favorite-touch-all := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let next = !coin.favorite;
                                            let result = CryptoAdapter.set-favorite-coin(coin.id, next);
                                            if (result == "") {
                                                CryptoAdapter.coin-catalog[index].favorite = next;
                                            } else {
                                                NotificationAdapter.show(result, true);
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    HorizontalLayout {
                                        Text {
                                            text: coin.name + " (" + coin.symbol + ")" + (coin.custom ? " *" : "");
                                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                            font-size: 13px;
                                            font-weight: index == selected-index ? 500 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        if index == selected-index: Text {
                                            text: "✓";
                                            color: Palette.accent;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    option-touch-all := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { 
                                            root.selected-index = index; 
                                            root.selected(index, coin.name);
                                            root.popup-open = false;
                                            root.reset-search();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 4px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: list-scroll.viewport-height;
                    viewport-y: list-scroll.viewport-y;
                }
            }
        }
    }
}

// ==================== Main Modal ====================
export component AddCryptoTransactionModal inherits Rectangle {
    property <string> amount: "";
    property <string> price: "";
    property <string> fee: "0";
    property <string> notes: "";
    property <string> date: AppState.current-date;
    property <string> selected-type: "buy";
    property <int> wallet-index: 0;
    property <int> wallet-index-to: 0;
    property <int> coin-index: 0;
    property <int> fee-coin-index: 0;
    property <string> fee-coin-amount: "";
    property <string> swap-amount: "";
    property <int> swap-coin-index: 0;
    property <string> move-amount: "";

    function update-swap-quote() {
        if (selected-type != "swap") {
            return;
        }
        if (amount == "" || CryptoAdapter.coin-catalog.length == 0) {
            swap-amount = "";
            return;
        }

        let safe-index = coin-index >= CryptoAdapter.coin-catalog.length ? 0 : coin-index;
        let swap-safe-index = swap-coin-index >= CryptoAdapter.coin-catalog.length ? 0 : swap-coin-index;
        let from-coin-id = CryptoAdapter.coin-catalog[safe-index].id;
        let to-coin-id = CryptoAdapter.coin-catalog[swap-safe-index].id;

        let quote = CryptoAdapter.get-swap-quote(from-coin-id, to-coin-id, amount);
        swap-amount = quote;
    }

    function refresh-price-from-coin() {
        if (selected-type != "buy" && selected-type != "sell") {
            return;
        }
        if (CryptoAdapter.coin-catalog.length == 0) {
            price = "";
            return;
        }

        let safe-index = coin-index >= CryptoAdapter.coin-catalog.length ? 0 : coin-index;
        price = CryptoAdapter.get-last-price(CryptoAdapter.coin-catalog[safe-index].id);
    }

    function refresh-swap-quote() {
        CryptoAdapter.refresh-prices();
        root.update-swap-quote();
        swap-quote-timer.restart();
    }

    swap-quote-timer := Timer {
        interval: 1200ms;
        triggered => { root.update-swap-quote(); }
    }

    init => {
        CryptoAdapter.load-coin-catalog();
        CryptoAdapter.filter-coin-catalog("");
        wallet-index = CryptoAdapter.default-wallet-index;
        coin-index = CryptoAdapter.default-coin-index;
        fee-coin-index = coin-index;
        root.refresh-price-from-coin();
    }

    function reset() {
        amount = "";
        price = "";
        fee = "0";
        fee-coin-amount = "";
        notes = "";
        date = AppState.current-date;
        selected-type = "buy";
        wallet-index = CryptoAdapter.default-wallet-index;
        wallet-index-to = 0;
        coin-index = CryptoAdapter.default-coin-index;
        fee-coin-index = coin-index;
        swap-amount = "";
        swap-coin-index = 0;
        move-amount = "";
        CryptoAdapter.filter-coin-catalog("");
        root.refresh-price-from-coin();
    }

    changed selected-type => {
        if (selected-type == "swap") {
            root.update-swap-quote();
        }
        root.refresh-price-from-coin();
    }

    changed coin-index => {
        if (fee-coin-amount == "") {
            fee-coin-index = coin-index;
        }
        root.update-swap-quote();
        root.refresh-price-from-coin();
    }
    changed swap-coin-index => { root.update-swap-quote(); }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (selected-type == "move" && CryptoAdapter.wallet-list.length < 2) {
            NotificationAdapter.show("Create two wallets to move assets", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }
        if (CryptoAdapter.coin-catalog.length == 0) {
            NotificationAdapter.show("Add coins in settings first", true);
            return;
        }

        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        let safe-index = coin-index >= CryptoAdapter.coin-catalog.length ? 0 : coin-index;
        let from-coin-id = CryptoAdapter.coin-catalog[safe-index].id;
        let from-symbol = CryptoAdapter.coin-catalog[safe-index].symbol;
        let fee-safe-index = fee-coin-index >= CryptoAdapter.coin-catalog.length ? 0 : fee-coin-index;
        let fee-coin-id = CryptoAdapter.coin-catalog[fee-safe-index].id;

        if (selected-type == "move") {
            if (wallet-index-to >= CryptoAdapter.wallet-list.length) {
                wallet-index-to = 0;
            }
            let to-wallet-id = CryptoAdapter.wallet-list[wallet-index-to].id;
            if (wallet-id == to-wallet-id) {
                NotificationAdapter.show("Pick two different wallets", true);
                return;
            }

            let to-amount = move-amount == "" ? amount : move-amount;

            let result = CryptoAdapter.add-transfer(
                wallet-id,
                to-wallet-id,
                from-coin-id,
                from-symbol,
                amount,
                to-amount,
                fee,
                fee-coin-id,
                fee-coin-amount,
                date,
                notes
            );

            if (result == "") {
                root.reset();
                AppState.show-add-crypto = false;
                CryptoAdapter.fetch-portfolio();
                CryptoAdapter.fetch-wallets();
            } else {
                NotificationAdapter.show(result, true);
            }
            return;
        }

        if (selected-type == "swap") {
            if (swap-amount == "") {
                NotificationAdapter.show("To amount is required", true);
                return;
            }

            let swap-safe-index = swap-coin-index >= CryptoAdapter.coin-catalog.length ? 0 : swap-coin-index;
            let to-coin-id = CryptoAdapter.coin-catalog[swap-safe-index].id;
            let to-symbol = CryptoAdapter.coin-catalog[swap-safe-index].symbol;

            if (from-coin-id == to-coin-id) {
                NotificationAdapter.show("Swap assets must be different", true);
                return;
            }

            let result = CryptoAdapter.add-swap(
                wallet-id,
                from-coin-id,
                from-symbol,
                amount,
                to-coin-id,
                to-symbol,
                swap-amount,
                fee,
                fee-coin-id,
                fee-coin-amount,
                date,
                notes
            );

            if (result == "") {
                root.reset();
                AppState.show-add-crypto = false;
                CryptoAdapter.fetch-portfolio();
                CryptoAdapter.fetch-wallets();
            } else {
                NotificationAdapter.show(result, true);
            }
            return;
        }

        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            from-coin-id, 
            from-symbol, 
            selected-type, 
            amount, 
            price, 
            fee, 
            fee-coin-id,
            fee-coin-amount,
            date,
            notes
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.overlay-bg;
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(Palette.modal-width-md, parent.width - 40px);
        height: min(Palette.modal-height-lg, parent.height - 40px);
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, Palette.crypto-modal-gradient-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: Palette.shadow-strong;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;
                
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: "NEW CRYPTO TRANSACTION";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-crypto = false; } 
                    }
                }
            }

	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;
	
	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 20px;
	
                    // Type Toggle
                    TypeSelector { selected-type <=> root.selected-type; }

                    // Coin Selector (From)
                    CoinSelector { 
                        label: root.selected-type == "swap" ? "FROM ASSET" : "CRYPTOCURRENCY";
                        selected-index <=> root.coin-index; 
                        selected(idx, name) => {
                            root.refresh-price-from-coin();
                        }
                    }

                    // Coin Selector (To) for swaps
                    if root.selected-type == "swap": CoinSelector {
                        label: "TO ASSET";
                        selected-index <=> root.swap-coin-index;
                    }

                    // Wallet Selector
                    if root.selected-type == "move": VerticalLayout {
                        spacing: 12px;
                        WalletSelector {
                            label: "FROM WALLET";
                            selected-index <=> root.wallet-index;
                        }
                        WalletSelector {
                            label: "TO WALLET";
                            selected-index <=> root.wallet-index-to;
                        }
                    }
                    if root.selected-type != "move": WalletSelector {
                        selected-index <=> root.wallet-index;
                    }
                    
                    // Warning if no wallets
                    if CryptoAdapter.wallet-list.length == 0: Rectangle {
                        height: 40px;
                        background: Palette.warning-bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.warning-border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Text {
                                text: "⚠";
                                color: Palette.danger;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            Text { 
                                text: "Create a wallet in the Wallets tab first"; 
                                color: Palette.danger; 
                                font-size: 11px;
                                font-weight: 400;
                                vertical-alignment: center; 
                            }
                        }
                    }
                    if root.selected-type == "move" && CryptoAdapter.wallet-list.length < 2: Rectangle {
                        height: 40px;
                        background: Palette.warning-bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.warning-border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Text {
                                text: "⚠";
                                color: Palette.danger;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Create another wallet to move assets";
                                color: Palette.danger;
                                font-size: 11px;
                                font-weight: 400;
                                vertical-alignment: center;
                            }
                        }
                    }
	                    
                    // Amount Field
                    FormField { 
                        label: root.selected-type == "swap" || root.selected-type == "move" ? "FROM AMOUNT" : "AMOUNT"; 
                        placeholder: "0.00"; 
                        value <=> root.amount; 
                        large: true; 
                        edited => {
                            if (root.selected-type == "swap") {
                                root.update-swap-quote();
                            }
                        }
                    }

                    if root.selected-type == "swap": FormField {
                        label: "TO AMOUNT";
                        placeholder: "0.00";
                        value <=> root.swap-amount;
                        large: true;
                        show-refresh: true;
                        refresh => { root.refresh-swap-quote(); }
                    }
                    if root.selected-type == "move": FormField {
                        label: "TO AMOUNT (optional)";
                        placeholder: "Same as FROM";
                        value <=> root.move-amount;
                        large: true;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        if root.selected-type != "swap" && root.selected-type != "move": FormField { 
                            label: "PRICE (USD)"; 
                            placeholder: (root.selected-type == "transfer_in" || root.selected-type == "transfer_out")
                                ? "Optional"
                                : "Required"; 
                            value <=> root.price; 
                            horizontal-stretch: 1;
                        }
                        FormField { 
                            label: "FEE (USD)"; 
                            placeholder: "0.00"; 
                            value <=> root.fee; 
                            width: root.selected-type == "swap" ? 160px : 120px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        CoinSelector {
                            label: "FEE COIN (OPTIONAL)";
                            selected-index <=> root.fee-coin-index;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "FEE AMOUNT";
                            placeholder: "0.00";
                            value <=> root.fee-coin-amount;
                            width: 140px;
                        }
                    }

                        // Notes Field
                        FormField { 
                            label: "NOTES"; 
                            placeholder: "Transaction details..."; 
                            value <=> root.notes; 
                        }
	                    
	                    // Date Field
	                    FormField { 
	                        label: "DATE"; 
	                        placeholder: "YYYY-MM-DD";
	                        value <=> root.date; 
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit Button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                border-radius: 10px;
	                
                Text {
                    text: "SAVE TRANSACTION";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
