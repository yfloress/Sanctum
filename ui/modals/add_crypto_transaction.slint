// ==================== Add Crypto Transaction Modal ====================

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 80px : 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;
            animate height { duration: 150ms; }
            animate background { duration: 150ms; }
        }
    }
}

component TypeToggle inherits Rectangle {
    in-out property <bool> is-buy: true;

    height: 48px;
    background: transparent;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "BUY";
                color: is-buy ? Palette.success : Palette.text-muted;
                font-size: 11px;
                font-weight: is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { clicked => { root.is-buy = true; } }
        }

        Rectangle { width: 8px; }

        Rectangle {
            horizontal-stretch: 1;
            background: !is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "SELL";
                color: !is-buy ? Palette.danger : Palette.text-muted;
                font-size: 11px;
                font-weight: !is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { clicked => { root.is-buy = false; } }
        }
    }
}

component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        Text { text: "WALLET"; color: Palette.text-muted; font-size: 10px; font-weight: 400; letter-spacing: 2px; }
        
        Rectangle {
            height: 32px;
            HorizontalLayout {
                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? CryptoAdapter.wallet-list[selected-index].name : "No wallets available";
                    color: Palette.text-primary; font-size: 14px; font-weight: 300; vertical-alignment: center; horizontal-stretch: 1;
                }
                Text { text: "▼"; color: Palette.text-muted; font-size: 10px; vertical-alignment: center; }
            }
            TouchArea { clicked => { if (CryptoAdapter.wallet-list.length > 0) { popup.show(); } } }
        }
        Rectangle { height: 1px; background: Palette.border; }
    }

    popup := PopupWindow {
        x: 0; y: 56px; width: root.width;
        Rectangle {
            background: Palette.surface; border-radius: 4px; border-width: 1px; border-color: Palette.border;
            height: min(CryptoAdapter.wallet-list.length * 36px + 8px, 240px);
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 36px + 8px;
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 36px; background: option-touch.has-hover ? Palette.surface-hover : transparent; border-radius: 2px;
                        Text { text: wallet.name; color: index == selected-index ? Palette.text-primary : Palette.text-secondary; font-size: 12px; font-weight: index == selected-index ? 500 : 400; vertical-alignment: center; x: 12px; }
                        option-touch := TouchArea { clicked => { root.selected-index = index; } }
                    }
                }
            }
        }
    }
}

export component AddCryptoTransactionModal inherits Rectangle {
    property <string> coin-id: "";
    property <string> symbol: "";
    property <string> amount: "";
    property <string> price: "";
    property <string> date: AppState.current-date;
    property <bool> is-buy: true;
    property <int> wallet-index: 0;

    function reset() {
        coin-id = "";
        symbol = "";
        amount = "";
        price = "";
        date = AppState.current-date;
        is-buy = true;
        wallet-index = 0;
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (coin-id == "" || symbol == "" || amount == "") {
            NotificationAdapter.show("Coin, Symbol and Amount are required", true);
            return;
        }

        // Safe guard index
        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;

        let type = is-buy ? "buy" : "sell";
        
        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            coin-id, 
            symbol, 
            type, 
            amount, 
            price, 
            "0", 
            date
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets(); // Update wallet balance
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 680px; // Increased height for wallet selector
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { } // Block clicks

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 32px;
                Text {
                    text: "ADD CRYPTO ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    Text { text: "×"; color: Palette.text-muted; font-size: 24px; vertical-alignment: center; horizontal-alignment: center;}
                    TouchArea { clicked => { root.reset(); AppState.show-add-crypto = false; } }
                }
            }

            Rectangle { height: 24px; }

            TypeToggle { is-buy <=> root.is-buy; }

            Rectangle { height: 24px; }
            
            WalletSelector { selected-index <=> root.wallet-index; }
            
            if CryptoAdapter.wallet-list.length == 0: Rectangle {
                height: 24px;
                Text { text: "Create a wallet in the Wallets tab first."; color: Palette.danger; font-size: 10px; vertical-alignment: center; }
            }

            Rectangle { height: 16px; }

            UnderlineField { label: "COIN ID (e.g. bitcoin)"; value <=> root.coin-id; }
            Rectangle { height: 16px; }
            UnderlineField { label: "SYMBOL (e.g. BTC)"; value <=> root.symbol; }
            Rectangle { height: 16px; }
            UnderlineField { label: "AMOUNT"; placeholder: "0.00"; value <=> root.amount; large: true; }
            Rectangle { height: 16px; }
            UnderlineField { label: "PRICE PER COIN (USD)"; placeholder: "Optional"; value <=> root.price; }
            Rectangle { height: 16px; }
            UnderlineField { label: "DATE"; value <=> root.date; }

            Rectangle { vertical-stretch: 1; }

            Rectangle {
                height: 48px;
                background: Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                
                Text {
                    text: "SAVE ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.submit(); } }
            }
        }
    }
}