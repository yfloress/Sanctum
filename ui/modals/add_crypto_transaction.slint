// ==================== Add Crypto Transaction Modal ====================

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

component UnderlineField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 80px : 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;
            animate height { duration: 150ms; }
            animate background { duration: 150ms; }
        }
    }
}

component TypeToggle inherits Rectangle {
    in-out property <bool> is-buy: true;

    height: 48px;
    background: transparent;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "BUY";
                color: is-buy ? Palette.success : Palette.text-muted;
                font-size: 11px;
                font-weight: is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { clicked => { root.is-buy = true; } }
        }

        Rectangle { width: 8px; }

        Rectangle {
            horizontal-stretch: 1;
            background: !is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "SELL";
                color: !is-buy ? Palette.danger : Palette.text-muted;
                font-size: 11px;
                font-weight: !is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { clicked => { root.is-buy = false; } }
        }
    }
}

component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        Text { text: "WALLET"; color: Palette.text-muted; font-size: 10px; font-weight: 400; letter-spacing: 2px; }
        
        Rectangle {
            height: 32px;
            HorizontalLayout {
                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? CryptoAdapter.wallet-list[selected-index].name : "No wallets available";
                    color: Palette.text-primary; font-size: 14px; font-weight: 300; vertical-alignment: center; horizontal-stretch: 1;
                }
                Text { text: "▼"; color: Palette.text-muted; font-size: 10px; vertical-alignment: center; }
            }
            TouchArea { clicked => { if (CryptoAdapter.wallet-list.length > 0) { popup.show(); } } }
        }
        Rectangle { height: 1px; background: Palette.border; }
    }

    popup := PopupWindow {
        x: 0; y: 56px; width: root.width;
        close-policy: close-on-click;
        Rectangle {
            background: Palette.surface; border-radius: 4px; border-width: 1px; border-color: Palette.border;
            height: min(CryptoAdapter.wallet-list.length * 36px + 8px, 240px);
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 36px + 8px;
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 36px; background: option-touch.has-hover ? Palette.surface-hover : transparent; border-radius: 2px;
                        Text { text: wallet.name; color: index == selected-index ? Palette.text-primary : Palette.text-secondary; font-size: 12px; font-weight: index == selected-index ? 500 : 400; vertical-alignment: center; x: 12px; }
                        option-touch := TouchArea { clicked => { root.selected-index = index; popup.close(); } }
                    }
                }
            }
        }
    }
}

component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    in property <[string]> options;
    
    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        Text { text: "ASSET"; color: Palette.text-muted; font-size: 10px; font-weight: 400; letter-spacing: 2px; }
        
        Rectangle {
            height: 32px;
            HorizontalLayout {
                Text {
                    text: root.options.length > selected-index ? root.options[selected-index] : "Select Asset";
                    color: Palette.text-primary; font-size: 14px; font-weight: 300; vertical-alignment: center; horizontal-stretch: 1;
                }
                Text { text: "▼"; color: Palette.text-muted; font-size: 10px; vertical-alignment: center; }
            }

            // Make the entire row clickable to open the popup
            TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {
                    if (root.options.length > 0) {
                        popup.show();
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }
    }

    popup := PopupWindow {
        x: 0; y: root.height; width: root.width;
        close-policy: close-on-click;

        Rectangle {
            background: Palette.sidebar-bg; // Solid background
            border-radius: 4px; 
            border-width: 1px; 
            border-color: Palette.accent; // Highlight border
            clip: true;
            // Limit height to 300px
            height: min(root.options.length * 36px + 8px, 300px);
            
            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: root.options.length * 36px + 8px;
                interactive: true;
                
                VerticalLayout {
                    padding: 4px; spacing: 0px;
                    for option[index] in root.options: Rectangle {
                        height: 36px; 
                        background: option-touch.has-hover ? Palette.surface-hover : transparent; 
                        border-radius: 2px;
                        
                        Text { 
                            text: option; 
                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary; 
                            font-size: 12px; 
                            font-weight: index == selected-index ? 500 : 400; 
                            vertical-alignment: center; 
                            x: 12px; 
                        }
                        
                        option-touch := TouchArea { 
                            clicked => { 
                                root.selected-index = index; 
                                popup.close();
                            } 
                        }
                    }
                }
            }
        }
    }
}

