// ==================== Add Crypto Asset Modal ====================
// Premium Fintech UI - Asset registration flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: large ? 56px : 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== TypeSelector ====================
component TypeSelector inherits Rectangle {
    in-out property <string> selected-type: "buy";

    height: 48px;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        for type[index] in ["buy", "sell", "transfer_in", "transfer_out", "swap"]: Rectangle {
            horizontal-stretch: 1;
            background: root.selected-type == type 
                ? (type == "buy" || type == "transfer_in" ? Palette.success.with-alpha(0.2) : 
                   type == "sell" || type == "transfer_out" ? Palette.danger.with-alpha(0.2) :
                   Palette.primary.with-alpha(0.2))
                : transparent;
            border-radius: 8px;
            border-width: root.selected-type == type ? 1px : 0px;
            border-color: type == "buy" || type == "transfer_in" ? Palette.success.with-alpha(0.4) : 
                          type == "sell" || type == "transfer_out" ? Palette.danger.with-alpha(0.4) :
                          Palette.primary.with-alpha(0.4);

            Text {
                text: type == "buy" ? "BUY" : 
                      type == "sell" ? "SELL" : 
                      type == "transfer_in" ? "IN" : 
                      type == "transfer_out" ? "OUT" : "SWAP";
                color: root.selected-type == type ? Palette.text-primary : Palette.text-muted;
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.selected-type = type; } 
            }
        }
    }
}

// ==================== WalletSelector ====================
component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        
        Text { 
            text: "WALLET"; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 500; 
            letter-spacing: 1.5px; 
        }
        
        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? 
                        CryptoAdapter.wallet-list[selected-index].name : 
                        "No wallets available";
                    color: CryptoAdapter.wallet-list.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text { 
                    text: "▼"; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.wallet-list.length > 0) { 
                        popup.show(); 
                    } 
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0; 
        y: 64px; 
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(CryptoAdapter.wallet-list.length * 40px + 8px, 200px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text { 
                                text: wallet.name; 
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== CoinSelector ====================
component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    in property <string> label: "CRYPTOCURRENCY";

    callback selected(int, string); // index, name

    property <[string]> coins: [
        "Bitcoin (BTC)", "Litecoin (LTC)", "Monero (XMR)", "Ethereum (ETH)", "Tether (USDT)",
        "BNB (BNB)", "Solana (SOL)", "XRP (XRP)", "USDC (USDC)", "Cardano (ADA)",
        "Dogecoin (DOGE)", "TRON (TRX)", "Polygon (POL)", "Chainlink (LINK)", "Polkadot (DOT)",
        "Shiba Inu (SHIB)", "Avalanche (AVAX)", "Stellar (XLM)", "Bitcoin Cash (BCH)", "Uniswap (UNI)",
        "Cosmos Hub (ATOM)", "Ethereum Classic (ETC)", "Hedera (HBAR)", "Aave (AAVE)", "VeChain (VET)",
        "NEAR Protocol (NEAR)", "Algorand (ALGO)", "Quant (QNT)", "Arbitrum (ARB)", "Sui (SUI)",
        "Aptos (APT)", "Cronos (CRO)", "Zcash (ZEC)", "Dai (DAI)", "Toncoin (TON)",
        "Internet Computer (ICP)", "Kaspa (KAS)", "Mantle (MNT)", "Bittensor (TAO)", "Worldcoin (WLD)",
        "Other..."
    ];

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: coins[selected-index];
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: 300px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: coins.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for coin[index] in coins: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: coin;
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { 
                                root.selected-index = index; 
                                root.selected(index, coin);
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== Main Modal ====================
export component AddCryptoTransactionModal inherits Rectangle {
    property <string> amount: "";
    property <string> price: "";
    property <string> fee: "0";
    property <string> notes: "";
    property <string> date: AppState.current-date;
    property <string> selected-type: "buy";
    property <int> wallet-index: 0;
    property <int> coin-index: 0;
    property <string> swap-amount: "";
    property <int> swap-coin-index: 0;
    
    // Custom coin fields
    property <string> custom-id: "";
    property <string> custom-symbol: "";
    property <string> swap-custom-id: "";
    property <string> swap-custom-symbol: "";

    property <[string]> coin-ids: [
        "bitcoin", "litecoin", "monero", "ethereum", "tether",
        "binancecoin", "solana", "ripple", "usd-coin", "cardano",
        "dogecoin", "tron", "polygon-ecosystem-token", "chainlink", "polkadot",
        "shiba-inu", "avalanche-2", "stellar", "bitcoin-cash", "uniswap",
        "cosmos", "ethereum-classic", "hedera-hashgraph", "aave", "vechain",
        "near", "algorand", "quant-network", "arbitrum", "sui",
        "aptos", "crypto-com-chain", "zcash", "dai", "the-open-network",
        "internet-computer", "kaspa", "mantle", "bittensor", "worldcoin-wld"
    ];
    
    property <[string]> coin-symbols: [
        "BTC", "LTC", "XMR", "ETH", "USDT",
        "BNB", "SOL", "XRP", "USDC", "ADA",
        "DOGE", "TRX", "POL", "LINK", "DOT",
        "SHIB", "AVAX", "XLM", "BCH", "UNI",
        "ATOM", "ETC", "HBAR", "AAVE", "VET",
        "NEAR", "ALGO", "QNT", "ARB", "SUI",
        "APT", "CRO", "ZEC", "DAI", "TON",
        "ICP", "KAS", "MNT", "TAO", "WLD"
    ];

    function reset() {
        amount = "";
        price = "";
        fee = "0";
        notes = "";
        date = AppState.current-date;
        selected-type = "buy";
        wallet-index = 0;
        coin-index = 0;
        swap-amount = "";
        swap-coin-index = 0;
        custom-id = "";
        custom-symbol = "";
        swap-custom-id = "";
        swap-custom-symbol = "";
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        
        // Validate custom input if selected
        if (coin-index == coin-ids.length) {
            if (custom-id == "" || custom-symbol == "") {
                NotificationAdapter.show("Custom ID and Symbol are required", true);
                return;
            }
        }

        // Safe access to array with clamp
        let safe-index = coin-index >= coin-ids.length ? 0 : coin-index;

        let from-coin-id = (coin-index == coin-ids.length) ? custom-id : coin-ids[safe-index];
        let from-symbol = (coin-index == coin-ids.length) ? custom-symbol : coin-symbols[safe-index];

        if (selected-type == "swap") {
            if (swap-amount == "") {
                NotificationAdapter.show("To amount is required", true);
                return;
            }

            if (swap-coin-index == coin-ids.length) {
                if (swap-custom-id == "" || swap-custom-symbol == "") {
                    NotificationAdapter.show("Custom ID and Symbol are required", true);
                    return;
                }
            }

            let swap-safe-index = swap-coin-index >= coin-ids.length ? 0 : swap-coin-index;
            let to-coin-id = (swap-coin-index == coin-ids.length) ? swap-custom-id : coin-ids[swap-safe-index];
            let to-symbol = (swap-coin-index == coin-ids.length) ? swap-custom-symbol : coin-symbols[swap-safe-index];

            if (from-coin-id == to-coin-id) {
                NotificationAdapter.show("Swap assets must be different", true);
                return;
            }

            let result = CryptoAdapter.add-swap(
                wallet-id,
                from-coin-id,
                from-symbol,
                amount,
                to-coin-id,
                to-symbol,
                swap-amount,
                fee,
                date,
                notes
            );

            if (result == "") {
                root.reset();
                AppState.show-add-crypto = false;
                CryptoAdapter.fetch-portfolio();
                CryptoAdapter.fetch-wallets();
            } else {
                NotificationAdapter.show(result, true);
            }
            return;
        }

        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            from-coin-id, 
            from-symbol, 
            selected-type, 
            amount, 
            price, 
            fee, 
            date,
            notes
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: max(320px, min(440px, parent.width - 48px));
        height: max(520px, min(720px, parent.height - 48px));
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, #0f0f1a 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000088;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;
                
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: "ADD CRYPTO ASSET";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-crypto = false; } 
                    }
                }
            }

	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;
	
	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 20px;
	
                    // Type Toggle
                    TypeSelector { selected-type <=> root.selected-type; }

                    // Coin Selector (From)
                    CoinSelector { 
                        label: root.selected-type == "swap" ? "FROM ASSET" : "CRYPTOCURRENCY";
                        selected-index <=> root.coin-index; 
                        selected(idx, name) => {
                            if (idx < coin-ids.length) {
                                root.price = CryptoAdapter.get-last-price(coin-ids[idx]);
                            } else {
                                root.price = "";
                            }
                        }
                    }

                    if root.coin-index == coin-ids.length: HorizontalLayout {
                        spacing: 12px;
                        FormField {
                            label: "COINGECKO ID";
                            placeholder: "e.g. pepe";
                            value <=> root.custom-id;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "SYMBOL";
                            placeholder: "e.g. PEPE";
                            value <=> root.custom-symbol;
                            width: 100px;
                        }
                    }

                    // Coin Selector (To) for swaps
                    if root.selected-type == "swap": CoinSelector {
                        label: "TO ASSET";
                        selected-index <=> root.swap-coin-index;
                    }

                    if root.selected-type == "swap" && root.swap-coin-index == coin-ids.length: HorizontalLayout {
                        spacing: 12px;
                        FormField {
                            label: "COINGECKO ID";
                            placeholder: "e.g. pepe";
                            value <=> root.swap-custom-id;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "SYMBOL";
                            placeholder: "e.g. PEPE";
                            value <=> root.swap-custom-symbol;
                            width: 100px;
                        }
                    }

                    // Wallet Selector
                    WalletSelector { selected-index <=> root.wallet-index; }
                    
                    // Warning if no wallets
                    if CryptoAdapter.wallet-list.length == 0: Rectangle {
                        height: 40px;
                        background: #2d1515;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #4d2525;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Text {
                                text: "⚠";
                                color: Palette.danger;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            Text { 
                                text: "Create a wallet in the Wallets tab first"; 
                                color: Palette.danger; 
                                font-size: 11px;
                                font-weight: 400;
                                vertical-alignment: center; 
                            }
                        }
                    }
	                    
                    // Amount Field
                    FormField { 
                        label: root.selected-type == "swap" ? "FROM AMOUNT" : "AMOUNT"; 
                        placeholder: "0.00"; 
                        value <=> root.amount; 
                        large: true; 
                    }

                    if root.selected-type == "swap": FormField {
                        label: "TO AMOUNT";
                        placeholder: "0.00";
                        value <=> root.swap-amount;
                        large: true;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        if root.selected-type != "swap": FormField { 
                            label: "PRICE (USD)"; 
                            placeholder: "Required"; 
                            value <=> root.price; 
                            horizontal-stretch: 1;
                        }
                        FormField { 
                            label: "FEE (USD)"; 
                            placeholder: "0.00"; 
                            value <=> root.fee; 
                            width: root.selected-type == "swap" ? 160px : 120px;
                        }
                    }

                        // Notes Field
                        FormField { 
                            label: "NOTES"; 
                            placeholder: "Transaction details..."; 
                            value <=> root.notes; 
                        }
	                    
	                    // Date Field
	                    FormField { 
	                        label: "DATE"; 
	                        placeholder: "YYYY-MM-DD";
	                        value <=> root.date; 
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit Button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Palette.action-gradient-start 0%, Palette.action-gradient-end 100%);
	                border-radius: 10px;
	                
	                Text {
                    text: "SAVE ASSET";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
