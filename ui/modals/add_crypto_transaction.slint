        "ATOM",
        "LBTC",
        "VET",
        "FLR"
    ];

    function reset() {
        amount = "";
        price = "";
        date = AppState.current-date;
        is-buy = true;
        wallet-index = 0;
        coin-index = 0;
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        
        if (coin-index >= coin-ids.length) { coin-index = 0; }
        let coin-id = coin-ids[coin-index];
        let symbol = coin-symbols[coin-index];

        let type = is-buy ? "buy" : "sell";
        
        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            coin-id, 
            symbol, 
            type, 
            amount, 
            price, 
            "0", 
            date
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.85);
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 680px;
        background: @linear-gradient(180deg, #0a0a10 0%, #080810 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { } // Block clicks

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 40px;
                alignment: space-between;
                
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "ADD CRYPTO ASSET";
                        color: Palette.text-primary;
                        font-size: 14px;
                        font-weight: 500;
                        letter-spacing: 2px;
                    }
                }
                
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface : transparent;
                    
                    Text { 
                        text: "✕"; 
                        color: Palette.text-muted; 
                        font-size: 16px; 
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-crypto = false; } 
                    }
                }
            }

            Rectangle { height: 24px; }

            // Type Toggle
            TypeToggle { is-buy <=> root.is-buy; }

            Rectangle { height: 20px; }
            
            // Wallet Selector
            WalletSelector { selected-index <=> root.wallet-index; }
            
            // Warning if no wallets
            if CryptoAdapter.wallet-list.length == 0: Rectangle {
                height: 36px;
                background: Palette.danger.with-alpha(0.1);
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.danger.with-alpha(0.2);
                
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    
                    Text { 
                        text: "⚠"; 
                        color: Palette.danger; 
                        font-size: 12px; 
                        vertical-alignment: center; 
                    }
                    Text { 
                        text: "Create a wallet first in the Wallets tab"; 
                        color: Palette.danger; 
                        font-size: 11px; 
                        vertical-alignment: center; 
                    }
                }
            }

            Rectangle { height: 16px; }

            // Coin Selector
            CoinSelector { 
                options: root.coin-names;
                selected-index <=> root.coin-index; 
            }
            
            Rectangle { height: 16px; }
            
            // Amount Field
            FormField { 
                label: "AMOUNT"; 
                placeholder: "0.00"; 
                value <=> root.amount; 
                large: true; 
            }
            
            Rectangle { height: 12px; }
            
            // Price Field
            FormField { 
                label: "PRICE PER COIN (USD)"; 
                placeholder: "Leave empty for market price"; 
                value <=> root.price; 
            }
            
            Rectangle { height: 12px; }
            
            // Date Field
            FormField { 
                label: "DATE"; 
                value <=> root.date; 
            }

            Rectangle { vertical-stretch: 1; }

            // Submit Button
            Rectangle {
                height: 52px;
                background: touch.has-hover ? Palette.accent-hover : Palette.accent;
                border-radius: 10px;
                
                animate background { duration: 150ms; }
                
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    
                    Text {
                        text: is-buy ? "▲" : "▼";
                        color: Palette.background;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: is-buy ? "ADD TO PORTFOLIO" : "RECORD SALE";
                        color: Palette.background;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }
            }
        }
    }
}
