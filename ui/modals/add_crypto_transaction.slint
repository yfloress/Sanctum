// ==================== Add Crypto Asset Modal ====================
// Premium Fintech UI - Asset registration flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== FormField ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 88px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: large ? 56px : 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? Palette.accent : Palette.border;

            animate border-color { duration: 150ms; }
            animate border-width { duration: 150ms; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                if root.value == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-subtle;
                    font-size: large ? 24px : 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.value;
                    color: Palette.text-primary;
                    font-size: large ? 24px : 14px;
                    font-weight: large ? 500 : 400;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }
    }
}

// ==================== TypeToggle ====================
component TypeToggle inherits Rectangle {
    in-out property <bool> is-buy: true;

    height: 48px;
    background: Palette.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        Rectangle {
            horizontal-stretch: 1;
            background: is-buy 
                ? @linear-gradient(135deg, #1f3d2f 0%, #152d20 100%)
                : transparent;
            border-radius: 8px;
            border-width: is-buy ? 1px : 0px;
            border-color: #2f5d4f;

            animate background { duration: 200ms; easing: ease-out; }

            Text {
                text: "BUY";
                color: is-buy ? Palette.success : Palette.text-muted;
                font-size: 11px;
                font-weight: is-buy ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = true; } 
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: !is-buy 
                ? @linear-gradient(135deg, #3d1f2f 0%, #2d1520 100%)
                : transparent;
            border-radius: 8px;
            border-width: !is-buy ? 1px : 0px;
            border-color: #5d2f4f;

            animate background { duration: 200ms; easing: ease-out; }

            Text {
                text: "SELL";
                color: !is-buy ? Palette.danger : Palette.text-muted;
                font-size: 11px;
                font-weight: !is-buy ? 600 : 400;
                letter-spacing: 1.5px;
                horizontal-alignment: center;
                vertical-alignment: center;

                animate color { duration: 150ms; }
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = false; } 
            }
        }
    }
}

// ==================== WalletSelector ====================
component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        
        Text { 
            text: "WALLET"; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 500; 
            letter-spacing: 1.5px; 
        }
        
        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? 
                        CryptoAdapter.wallet-list[selected-index].name : 
                        "No wallets available";
                    color: CryptoAdapter.wallet-list.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text { 
                    text: "▼"; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.wallet-list.length > 0) { 
                        popup.show(); 
                    } 
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0; 
        y: 64px; 
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: min(CryptoAdapter.wallet-list.length * 40px + 8px, 200px);
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text { 
                                text: wallet.name; 
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== CoinSelector ====================
component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;

    property <[string]> coins: [
        "Bitcoin (BTC)", "Ethereum (ETH)", "Tether (USDT)", "BNB (BNB)", "Solana (SOL)",
        "XRP (XRP)", "USDC (USDC)", "Cardano (ADA)", "Dogecoin (DOGE)", "TRON (TRX)",
        "Polygon (POL)", "Chainlink (LINK)", "Polkadot (DOT)", "Litecoin (LTC)", "Shiba Inu (SHIB)",
        "Avalanche (AVAX)", "Stellar (XLM)", "Monero (XMR)", "Bitcoin Cash (BCH)", "Uniswap (UNI)",
        "Cosmos Hub (ATOM)", "Ethereum Classic (ETC)", "Hedera (HBAR)", "Aave (AAVE)", "VeChain (VET)",
        "NEAR Protocol (NEAR)", "Algorand (ALGO)", "Quant (QNT)", "Arbitrum (ARB)", "Sui (SUI)",
        "Aptos (APT)", "Cronos (CRO)", "Zcash (ZEC)", "Dai (DAI)", "Toncoin (TON)",
        "Internet Computer (ICP)", "Kaspa (KAS)", "Mantle (MNT)", "Bittensor (TAO)", "Worldcoin (WLD)"
    ];

    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: "CRYPTOCURRENCY";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 1.5px;
        }

        Rectangle {
            height: 40px;
            background: Palette.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;

                Text {
                    text: coins[selected-index];
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        
        Rectangle {
            background: Palette.sidebar-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border-light;
            height: 300px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            Flickable {
                viewport-height: coins.length * 40px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for coin[index] in coins: Rectangle {
                        height: 40px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: coin;
                                color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                                font-size: 13px;
                                font-weight: index == selected-index ? 500 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if index == selected-index: Text {
                                text: "✓";
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected-index = index; }
                        }
                    }
                }
            }
        }
    }
}

// ==================== Main Modal ====================
export component AddCryptoTransactionModal inherits Rectangle {
    property <string> amount: "";
    property <string> price: "";
    property <string> date: AppState.current-date;
    property <bool> is-buy: true;
    property <int> wallet-index: 0;
    property <int> coin-index: 0;

    property <[string]> coin-ids: [
        "bitcoin", "ethereum", "tether", "binancecoin", "solana",
        "ripple", "usd-coin", "cardano", "dogecoin", "tron",
        "polygon-ecosystem-token", "chainlink", "polkadot", "litecoin", "shiba-inu",
        "avalanche-2", "stellar", "monero", "bitcoin-cash", "uniswap",
        "cosmos", "ethereum-classic", "hedera-hashgraph", "aave", "vechain",
        "near", "algorand", "quant-network", "arbitrum", "sui",
        "aptos", "crypto-com-chain", "zcash", "dai", "the-open-network",
        "internet-computer", "kaspa", "mantle", "bittensor", "worldcoin-wld"
    ];
    
    property <[string]> coin-symbols: [
        "BTC", "ETH", "USDT", "BNB", "SOL",
        "XRP", "USDC", "ADA", "DOGE", "TRX",
        "POL", "LINK", "DOT", "LTC", "SHIB",
        "AVAX", "XLM", "XMR", "BCH", "UNI",
        "ATOM", "ETC", "HBAR", "AAVE", "VET",
        "NEAR", "ALGO", "QNT", "ARB", "SUI",
        "APT", "CRO", "ZEC", "DAI", "TON",
        "ICP", "KAS", "MNT", "TAO", "WLD"
    ];

    function reset() {
        amount = "";
        price = "";
        date = AppState.current-date;
        is-buy = true;
        wallet-index = 0;
        coin-index = 0;
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        
        if (coin-index >= coin-ids.length) { coin-index = 0; }
        let coin-id = coin-ids[coin-index];
        let symbol = coin-symbols[coin-index];

        let type = is-buy ? "buy" : "sell";
        
        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            coin-id, 
            symbol, 
            type, 
            amount, 
            price, 
            "0", 
            date
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 680px;
        background: @linear-gradient(180deg, Palette.sidebar-bg 0%, #0f0f1a 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000088;

        TouchArea { }

        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            // Header
            HorizontalLayout {
                height: 32px;
                
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

	                    Rectangle {
	                        width: 4px;
	                        height: 20px;
	                        border-radius: 2px;
	                        background: @linear-gradient(180deg, Palette.accent 0%, Palette.primary 100%);
	                        y: (parent.height - self.height) / 2;
	                    }

                    Text {
                        text: "ADD CRYPTO ASSET";
                        color: Palette.text-primary;
                        font-size: 16px;
                        font-weight: 500;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: close-touch.has-hover ? Palette.surface-hover : transparent;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 20px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-crypto = false; } 
                    }
                }
            }

	
	            body := Flickable {
	                horizontal-stretch: 1;
	                vertical-stretch: 1;
	
	                VerticalLayout {
	                    width: parent.width;
	                    spacing: 20px;
	
	                    // Type Toggle
	                    TypeToggle { is-buy <=> root.is-buy; }
	                    
	                    // Wallet Selector
	                    WalletSelector { selected-index <=> root.wallet-index; }
	                    
	                    // Warning if no wallets
	                    if CryptoAdapter.wallet-list.length == 0: Rectangle {
	                        height: 40px;
	                        background: #2d1515;
	                        border-radius: 8px;
	                        border-width: 1px;
	                        border-color: #4d2525;
	
	                        HorizontalLayout {
	                            padding-left: 12px;
	                            padding-right: 12px;
	                            spacing: 8px;
	
	                            Text {
	                                text: "⚠";
	                                color: Palette.danger;
	                                font-size: 14px;
	                                vertical-alignment: center;
	                            }
	
	                            Text { 
	                                text: "Create a wallet in the Wallets tab first"; 
	                                color: Palette.danger; 
	                                font-size: 11px;
	                                font-weight: 400;
	                                vertical-alignment: center; 
	                            }
	                        }
	                    }
	
	                    // Coin Selector
	                    CoinSelector { 
	                        selected-index <=> root.coin-index; 
	                    }
	                    
	                    // Amount Field
	                    FormField { 
	                        label: "AMOUNT"; 
	                        placeholder: "0.00"; 
	                        value <=> root.amount; 
	                        large: true; 
	                    }
	                    
	                    // Price Field
	                    FormField { 
	                        label: "PRICE PER COIN (USD)"; 
	                        placeholder: "Leave empty for market price"; 
	                        value <=> root.price; 
	                    }
	                    
	                    // Date Field
	                    FormField { 
	                        label: "DATE"; 
	                        placeholder: "YYYY-MM-DD";
	                        value <=> root.date; 
	                    }
	
	                    Rectangle { height: 8px; }
	                }
	            }
	
	            // Submit Button
	            Rectangle {
	                height: 48px;
	                background: @linear-gradient(135deg, Palette.accent 0%, Palette.primary 100%);
	                border-radius: 10px;
	                
	                Text {
                    text: "SAVE ASSET";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }

                states [
                    hover when submit-touch.has-hover: {
                        opacity: 0.9;
                    }
                ]
            }
        }
    }
}
