// ==================== Add Crypto Asset Modal ====================
// Noir Fintech - Premium asset registration flow

import {
    Palette,
    AppState,
    CryptoAdapter,
    NotificationAdapter,
} from "../globals.slint";

// ==================== Form Field ====================
component FormField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> large: false;

    height: large ? 80px : 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
        }

        Rectangle {
            vertical-stretch: 1;

            if root.value == "" && !input.has-focus: Text {
                text: root.placeholder;
                color: Palette.text-subtle;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.value;
                color: Palette.text-primary;
                font-size: large ? 28px : 14px;
                font-weight: 300;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { input.focus(); }
            }
        }

        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus ? Palette.accent : Palette.border;
            animate height { duration: 150ms; }
            animate background { duration: 150ms; }
        }
    }
}

// ==================== Transaction Type Toggle ====================
component TypeToggle inherits Rectangle {
    in-out property <bool> is-buy: true;

    height: 48px;
    background: transparent;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "BUY";
                color: is-buy ? Palette.success : Palette.text-muted;
                font-size: 11px;
                font-weight: is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = true; } 
            }
        }

        Rectangle { width: 8px; }

        Rectangle {
            horizontal-stretch: 1;
            background: !is-buy ? Palette.surface : transparent;
            border-radius: 4px;
            animate background { duration: 150ms; }

            Text {
                text: "SELL";
                color: !is-buy ? Palette.danger : Palette.text-muted;
                font-size: 11px;
                font-weight: !is-buy ? 500 : 400;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { 
                mouse-cursor: pointer;
                clicked => { root.is-buy = false; } 
            }
        }
    }
}

// ==================== Wallet Selector ====================
component WalletSelector inherits Rectangle {
    in-out property <int> selected-index: 0;
    
    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;
        
        Text { 
            text: "WALLET"; 
            color: Palette.text-muted; 
            font-size: 10px; 
            font-weight: 600; 
            letter-spacing: 2px; 
        }
        
        Rectangle {
            height: 32px;
            
            HorizontalLayout {
                Text {
                    text: CryptoAdapter.wallet-list.length > 0 ? 
                        CryptoAdapter.wallet-list[selected-index].name : 
                        "No wallets available";
                    color: CryptoAdapter.wallet-list.length > 0 ? Palette.text-primary : Palette.text-muted;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Text { 
                    text: "▼"; 
                    color: Palette.text-muted; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { 
                    if (CryptoAdapter.wallet-list.length > 0) { 
                        popup.show(); 
                    } 
                }
            }
        }
        
        Rectangle { 
            height: 1px; 
            background: Palette.border; 
        }
    }

    popup := PopupWindow {
        x: 0; 
        y: 56px; 
        width: root.width;
        
        Rectangle {
            background: Palette.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            height: min(CryptoAdapter.wallet-list.length * 36px + 8px, 200px);
            
            Flickable {
                viewport-height: CryptoAdapter.wallet-list.length * 36px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    
                    for wallet[index] in CryptoAdapter.wallet-list: Rectangle {
                        height: 36px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 2px;

                        Text { 
                            text: wallet.name; 
                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                            font-size: 12px;
                            font-weight: index == selected-index ? 500 : 400;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            x: 12px;
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { 
                                root.selected-index = index; 
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== Coin Selector ====================
component CoinSelector inherits Rectangle {
    in-out property <int> selected-index: 0;

    property <[string]> coins: [
        "Bitcoin (BTC)", "Ethereum (ETH)", "Tether (USDT)", "BNB (BNB)", "Solana (SOL)",
        "XRP (XRP)", "USDC (USDC)", "Cardano (ADA)", "Dogecoin (DOGE)", "TRON (TRX)",
        "Polygon (POL)", "Chainlink (LINK)", "Polkadot (DOT)", "Litecoin (LTC)", "Shiba Inu (SHIB)",
        "Avalanche (AVAX)", "Stellar (XLM)", "Monero (XMR)", "Bitcoin Cash (BCH)", "Uniswap (UNI)",
        "Cosmos Hub (ATOM)", "Ethereum Classic (ETC)", "Hedera (HBAR)", "Aave (AAVE)", "VeChain (VET)",
        "NEAR Protocol (NEAR)", "Algorand (ALGO)", "Quant (QNT)", "Arbitrum (ARB)", "Sui (SUI)",
        "Aptos (APT)", "Cronos (CRO)", "Zcash (ZEC)", "Dai (DAI)", "Toncoin (TON)",
        "Internet Computer (ICP)", "Kaspa (KAS)", "Mantle (MNT)", "Bittensor (TAO)", "Worldcoin (WLD)"
    ];

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 8px;

        Text {
            text: "CRYPTOCURRENCY";
            color: Palette.text-muted;
            font-size: 10px;
            font-weight: 400;
            letter-spacing: 2px;
        }

        Rectangle {
            height: 32px;

            HorizontalLayout {
                Text {
                    text: coins[selected-index];
                    color: Palette.text-primary;
                    font-size: 14px;
                    font-weight: 300;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "▼";
                    color: Palette.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    popup.show();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 56px;
        width: root.width;
        
        Rectangle {
            background: Palette.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.border;
            height: 300px;

            Flickable {
                viewport-height: coins.length * 36px + 8px;
                
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for coin[index] in coins: Rectangle {
                        height: 36px;
                        background: option-touch.has-hover ? Palette.surface-hover : transparent;
                        border-radius: 2px;

                        Text {
                            text: coin;
                            color: index == selected-index ? Palette.text-primary : Palette.text-secondary;
                            font-size: 12px;
                            font-weight: index == selected-index ? 500 : 400;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            x: 12px;
                        }

                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-index = index;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==================== Main Modal ====================
export component AddCryptoTransactionModal inherits Rectangle {
    property <string> amount: "";
    property <string> price: "";
    property <string> date: AppState.current-date;
    property <bool> is-buy: true;
    property <int> wallet-index: 0;
    property <int> coin-index: 0;

    // Arrays must match the order in CoinSelector.coins
    property <[string]> coin-ids: [
        "bitcoin", "ethereum", "tether", "binancecoin", "solana",
        "ripple", "usd-coin", "cardano", "dogecoin", "tron",
        "polygon-ecosystem-token", "chainlink", "polkadot", "litecoin", "shiba-inu",
        "avalanche-2", "stellar", "monero", "bitcoin-cash", "uniswap",
        "cosmos", "ethereum-classic", "hedera-hashgraph", "aave", "vechain",
        "near", "algorand", "quant-network", "arbitrum", "sui",
        "aptos", "crypto-com-chain", "zcash", "dai", "the-open-network",
        "internet-computer", "kaspa", "mantle", "bittensor", "worldcoin-wld"
    ];
    
    property <[string]> coin-symbols: [
        "BTC", "ETH", "USDT", "BNB", "SOL",
        "XRP", "USDC", "ADA", "DOGE", "TRX",
        "POL", "LINK", "DOT", "LTC", "SHIB",
        "AVAX", "XLM", "XMR", "BCH", "UNI",
        "ATOM", "ETC", "HBAR", "AAVE", "VET",
        "NEAR", "ALGO", "QNT", "ARB", "SUI",
        "APT", "CRO", "ZEC", "DAI", "TON",
        "ICP", "KAS", "MNT", "TAO", "WLD"
    ];

    function reset() {
        amount = "";
        price = "";
        date = AppState.current-date;
        is-buy = true;
        wallet-index = 0;
        coin-index = 0;
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        
        if (coin-index >= coin-ids.length) { coin-index = 0; }
        let coin-id = coin-ids[coin-index];
        let symbol = coin-symbols[coin-index];

        let type = is-buy ? "buy" : "sell";
        
        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            coin-id, 
            symbol, 
            type, 
            amount, 
            price, 
            "0", 
            date
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets();
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Modal Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 620px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { } // Block clicks

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 32px;
                
                Text {
                    text: "ADD CRYPTO ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Rectangle {
                    width: 32px;
                    height: 32px;
                    
                    Text { 
                        text: "×"; 
                        color: close-touch.has-hover ? Palette.text-primary : Palette.text-muted;
                        font-size: 24px;
                        font-weight: 300;
                        vertical-alignment: center; 
                        horizontal-alignment: center;
                        animate color { duration: 120ms; }
                    }
                    
                    close-touch := TouchArea { 
                        mouse-cursor: pointer;
                        clicked => { root.reset(); AppState.show-add-crypto = false; } 
                    }
                }
            }

            Rectangle { height: 24px; }

            // Type Toggle
            TypeToggle { is-buy <=> root.is-buy; }

            Rectangle { height: 24px; }
            
            // Wallet Selector
            WalletSelector { selected-index <=> root.wallet-index; }
            
            // Warning if no wallets
            if CryptoAdapter.wallet-list.length == 0: Rectangle {
                height: 24px;
                Text { 
                    text: "Create a wallet in the Wallets tab first."; 
                    color: Palette.danger; 
                    font-size: 10px; 
                    vertical-alignment: center; 
                }
            }

            Rectangle { height: 16px; }

            // Coin Selector
            CoinSelector { 
                selected-index <=> root.coin-index; 
            }
            
            Rectangle { height: 16px; }
            
            // Amount Field
            FormField { 
                label: "AMOUNT"; 
                placeholder: "0.00"; 
                value <=> root.amount; 
                large: true; 
            }
            
            Rectangle { height: 16px; }
            
            // Price Field
            FormField { 
                label: "PRICE PER COIN (USD)"; 
                placeholder: "Leave empty for market price"; 
                value <=> root.price; 
            }
            
            Rectangle { height: 16px; }
            
            // Date Field
            FormField { 
                label: "DATE"; 
                value <=> root.date; 
            }

            Rectangle { vertical-stretch: 1; }

            // Submit Button
            Rectangle {
                height: 48px;
                background: submit-touch.has-hover ? Palette.surface-hover : Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                
                animate background { duration: 120ms; }
                
                Text {
                    text: "SAVE ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 400;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                submit-touch := TouchArea { 
                    mouse-cursor: pointer;
                    clicked => { root.submit(); } 
                }
            }
        }
    }
}
