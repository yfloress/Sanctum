        "VET",
        "FLR"
    ];

    function reset() {
        amount = "";
        price = "";
        date = AppState.current-date;
        is-buy = true;
        wallet-index = 0;
        coin-index = 0;
    }

    function submit() {
        if (CryptoAdapter.wallet-list.length == 0) {
            NotificationAdapter.show("Please create a wallet first", true);
            return;
        }
        if (amount == "") {
            NotificationAdapter.show("Amount is required", true);
            return;
        }

        // Safe guard index
        if (wallet-index >= CryptoAdapter.wallet-list.length) {
            wallet-index = 0;
        }
        let wallet-id = CryptoAdapter.wallet-list[wallet-index].id;
        
        // Coin logic
        if (coin-index >= coin-ids.length) { coin-index = 0; }
        let coin-id = coin-ids[coin-index];
        let symbol = coin-symbols[coin-index];

        let type = is-buy ? "buy" : "sell";
        
        let result = CryptoAdapter.add-transaction(
            wallet-id, 
            coin-id, 
            symbol, 
            type, 
            amount, 
            price, 
            "0", 
            date
        );

        if (result == "") {
            root.reset();
            AppState.show-add-crypto = false;
            CryptoAdapter.fetch-portfolio();
            CryptoAdapter.fetch-wallets(); // Update wallet balance
        } else {
            NotificationAdapter.show(result, true);
        }
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;
        TouchArea {
            clicked => {
                root.reset();
                AppState.show-add-crypto = false;
            }
        }
    }

    // Panel
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 680px;
        background: Palette.sidebar-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        TouchArea { } // Block clicks

        VerticalLayout {
            padding: 32px;
            spacing: 0px;

            // Header
            HorizontalLayout {
                height: 32px;
                Text {
                    text: "ADD CRYPTO ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    Text { text: "×"; color: Palette.text-muted; font-size: 24px; vertical-alignment: center; horizontal-alignment: center;}
                    TouchArea { clicked => { root.reset(); AppState.show-add-crypto = false; } }
                }
            }

            Rectangle { height: 24px; }

            TypeToggle { is-buy <=> root.is-buy; }

            Rectangle { height: 24px; }
            
            WalletSelector { selected-index <=> root.wallet-index; }
            
            if CryptoAdapter.wallet-list.length == 0: Rectangle {
                height: 24px;
                Text { text: "Create a wallet in the Wallets tab first."; color: Palette.danger; font-size: 10px; vertical-alignment: center; }
            }

            Rectangle { height: 16px; }

            CoinSelector { 
                options: root.coin-names;
                selected-index <=> root.coin-index; 
            }
            
            Rectangle { height: 16px; }
            
            UnderlineField { label: "AMOUNT"; placeholder: "0.00"; value <=> root.amount; large: true; }
            Rectangle { height: 16px; }
            UnderlineField { label: "PRICE PER COIN (USD)"; placeholder: "Leave empty for current market price"; value <=> root.price; }
            Rectangle { height: 16px; }
            UnderlineField { label: "DATE"; value <=> root.date; }

            Rectangle { vertical-stretch: 1; }

            Rectangle {
                height: 48px;
                background: Palette.surface;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                
                Text {
                    text: "SAVE ASSET";
                    color: Palette.text-primary;
                    font-size: 12px;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.submit(); } }
            }
        }
    }
}
