// ==================== Import Results Modal ====================
// Summary modal showing final import results

import { IngestionAdapter } from "../globals.slint";
import { Theme } from "../theme.slint";
import { Translations } from "../translations.slint";
import { ImportSummaryPanel } from "../components/import_summary_panel.slint";
import { CustomVScrollbar } from "../widgets.slint";

export component ImportResultsModal inherits Rectangle {
    callback close();

    function close-modal() {
        root.close();
    }

    init => {
        key-scope.focus();
    }

    width: 100%;
    height: 100%;
    background: transparent;

    // Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        Flickable {
            width: 100%;
            height: 100%;
            interactive: false;
            viewport-width: parent.width;
            viewport-height: parent.height;
        }

        TouchArea {
            clicked => {
                close-modal();
            }
        }
    }

    key-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                close-modal();
                return accept;
            }
            return reject;
        }
    }

    // Modal panel
    Rectangle {
        width: min(Theme.modal-width-lg, parent.width - 40px);
        height: min(Theme.modal-height-lg, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: @linear-gradient(180deg, Theme.sidebar-bg 0%, Theme.modal-bg-end 100%);
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-light;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #00000040;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                body := Flickable {
                    width: parent.width;
                    height: parent.height;

                    content-root := VerticalLayout {
                        width: parent.width;
                        spacing: 20px;
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 28px;
                        padding-bottom: 20px;

                        // Header
                        HorizontalLayout {
                            height: 32px;

                            HorizontalLayout {
                                spacing: 12px;
                                horizontal-stretch: 1;

                                Rectangle {
                                    width: 4px;
                                    height: 20px;
                                    border-radius: 2px;
                                    background: @linear-gradient(180deg, Theme.action-gradient-start 0%, Theme.action-gradient-end 100%);
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: Translations.import-summary-title;
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 500;
                                    letter-spacing: 2px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: close-touch.has-hover ? Theme.surface-hover : transparent;

                                Image {
                                    source: @image-url("../assets/icons/x.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                close-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        close-modal();
                                    }
                                }
                            }
                        }

                        // Status indicator with icon
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;

                            // Status icon circle
                            Rectangle {
                                property <bool> is-failed: IngestionAdapter.import-errors > 0 && IngestionAdapter.import-inserted == 0;
                                property <bool> is-partial: IngestionAdapter.import-errors > 0 || IngestionAdapter.import-skipped > 0;
                                property <color> status-color: is-failed ? Theme.danger : (is-partial ? Theme.warning : Theme.success);

                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: status-color.with-alpha(0.15);
                                border-width: 1px;
                                border-color: status-color.with-alpha(0.3);

                                Image {
                                    source: parent.is-failed ? @image-url("../assets/icons/x.svg") : @image-url("../assets/icons/check.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: parent.status-color;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: IngestionAdapter.import-errors > 0 && IngestionAdapter.import-inserted == 0 ? Translations.import-failed : (IngestionAdapter.import-errors > 0 || IngestionAdapter.import-skipped > 0 ? Translations.import-partial : Translations.import-success);
                                color: IngestionAdapter.import-errors > 0 && IngestionAdapter.import-inserted == 0 ? Theme.danger : (IngestionAdapter.import-errors > 0 || IngestionAdapter.import-skipped > 0 ? Theme.warning : Theme.success);
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Summary panel
                        ImportSummaryPanel {
                            show-file-info: false;
                            error-list-height: 180;
                        }

                        Rectangle {
                            height: 8px;
                        }
                    }
                }

                CustomVScrollbar {
                    x: parent.width - self.width - 6px;
                    y: 0;
                    height: parent.height;
                    visible-height: parent.height;
                    viewport-height: body.viewport-height;
                    viewport-y: body.viewport-y;
                }
            }

            // Close button
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 28px;
                padding-top: 12px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 44px;
                    border-radius: 10px;
                    background: close-btn-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-light;

                    Text {
                        text: Translations.action-close;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-btn-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            close-modal();
                        }
                    }
                }
            }
        }
    }
}
