// ==================== Sanctum Theme ====================
// All colors in one place for easy theming

export global Theme {
    // ==================== Core ====================
    out property <color> bg: #000000;
    out property <color> bg-surface: #111111;
    out property <color> bg-hover: #1a1a1a;
    out property <color> bg-sidebar: #050505;

    // ==================== Text ====================
    out property <color> text: #ffffff;
    out property <color> text-secondary: #a3a3a3;
    out property <color> text-muted: #666666;
    out property <color> text-subtle: #333333;

    // ==================== Borders ====================
    out property <color> border: #333333;
    out property <color> border-light: #ffffff;
    out property <color> border-subtle: #222222;

    // ==================== Accent ====================
    out property <color> accent: #ffffff;
    out property <color> accent-muted: #ffffff20;
    out property <color> primary: #8b5cf6;
    out property <color> primary-hover: #a78bfa;

    // ==================== Semantic ====================
    out property <color> success: #22c55e;
    out property <color> danger: #ef4444;
    out property <color> warning: #f59e0b;

    // ==================== Overlays ====================
    out property <color> overlay: #000000cc;
    out property <color> overlay-strong: #000000d9;
    out property <color> overlay-soft: #00000088;
    out property <color> shadow: #00000066;

    // ==================== Charts ====================
    out property <color> chart-bg-start: #0d0d12;
    out property <color> chart-bg-end: #080810;
    out property <color> chart-line: #8b5cf6;
    out property <color> chart-line-secondary: #94a3b8;

    // ==================== Notifications ====================
    out property <color> notify-error-bg: #1a1215;
    out property <color> notify-error-border: #3d2020;
    out property <color> notify-success-bg: #0f1a15;
    out property <color> notify-success-border: #203d30;

    // Icon backgrounds (for notification icons, status indicators, etc)
    out property <color> icon-error-bg: #2d1515;
    out property <color> icon-error-border: #3d2020;
    out property <color> icon-success-bg: #152d20;
    out property <color> icon-success-border: #203d30;

    // ==================== Account Types ====================
    out property <color> account-bank: #1e3a5f;
    out property <color> account-bank-light: #2d5a8f;
    out property <color> account-cash: #2d4a3e;
    out property <color> account-cash-light: #3d6a5e;
    out property <color> account-savings: #3d3a1e;
    out property <color> account-savings-light: #5d5a2e;
    out property <color> account-credit: #3d1e2e;
    out property <color> account-credit-light: #5d2e4e;
    out property <color> account-other: #2a2a3a;
    out property <color> account-other-light: #3a3a4a;

    // ==================== Transactions ====================
    out property <color> tx-expense-bg: #1c1520;
    out property <color> tx-income-bg: #0f1a14;
    out property <color> tx-transfer-bg: #1a1a2a;

    // Type toggles (expense/income buttons)
    out property <color> toggle-expense-start: #3d1f2f;
    out property <color> toggle-expense-end: #2d1520;
    out property <color> toggle-expense-border: #5d2f4f;
    out property <color> toggle-income-start: #1f3d2f;
    out property <color> toggle-income-end: #152d20;
    out property <color> toggle-income-border: #2f5d4f;

    // Modal
    out property <color> modal-bg-end: #0f0f1a;

    // ==================== Heatmap ====================
    out property <color> heat-0: #1a1a1a;
    out property <color> heat-1: #3b2f5f;
    out property <color> heat-2: #6b4f9f;
    out property <color> heat-3: #8b5cf6;
    out property <color> heat-4: #a78bfa;

    // ==================== Habit Colors ====================
    out property <color> habit-gradient-start: #8b5cf6;
    out property <color> habit-gradient-end: #ec4899;
    out property <color> habit-1: #8b5cf6;
    out property <color> habit-2: #ec4899;
    out property <color> habit-3: #3b82f6;
    out property <color> habit-4: #22c55e;
    out property <color> habit-5: #f59e0b;
    out property <color> habit-6: #06b6d4;
    out property <color> habit-7: #f43f5e;
    out property <color> habit-8: #a855f7;
    out property <color> habit-9: #14b8a6;
    out property <color> habit-10: #6366f1;
    out property <color> habit-11: #84cc16;
    out property <color> habit-12: #f97316;
    out property <color> habit-13: #0ea5e9;
    out property <color> habit-14: #d946ef;
    out property <color> habit-15: #10b981;
    out property <color> habit-16: #fbbf24;

    // ==================== Sizes ====================
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> radius-xl: 12px;
    out property <length> radius-2xl: 16px;
    out property <length> radius-pill: 24px;

    out property <length> icon-xs: 24px;
    out property <length> icon-sm: 28px;
    out property <length> icon-md: 32px;
    out property <length> icon-lg: 36px;
    out property <length> icon-xl: 40px;

    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;

    out property <length> font-xs: 10px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 18px;
    out property <length> font-xl: 24px;
}
