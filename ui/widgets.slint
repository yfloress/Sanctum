// ==================== Sanctum Widgets ====================
// Premium Fintech UI - Core reusable components

import { Palette } from "globals.slint";

// ==================== UnderlineInput ====================
// Minimalist input with underline focus indicator

export component UnderlineInput inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text: "";
    in property <bool> is-password: false;
    in property <bool> enabled: true;

    callback accepted(string);
    callback edited(string);

    height: 48px;
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // Input area
        Rectangle {
            height: 36px;

            HorizontalLayout {
                // Placeholder
                if root.text == "" && !input.has-focus: Text {
                    text: root.placeholder;
                    color: Palette.text-muted;
                    font-size: 16px;
                    font-weight: 300;
                    vertical-alignment: center;
                    letter-spacing: 1px;
                }

                input := TextInput {
                    text <=> root.text;
                    input-type: root.is-password ? InputType.password : InputType.text;
                    enabled: root.enabled;
                    color: Palette.text-primary;
                    font-size: 16px;
                    font-weight: 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    letter-spacing: 0.5px;

                    accepted => {
                        root.accepted(root.text);
                    }

                    edited => {
                        root.edited(root.text);
                    }
                }
            }
        }

        // Underline with gradient
        Rectangle {
            height: input.has-focus ? 2px : 1px;
            background: input.has-focus 
                ? @linear-gradient(90deg, Palette.accent 0%, #6366f1 100%)
                : Palette.border;

            animate height { duration: 150ms; easing: ease-out; }
            animate background { duration: 150ms; easing: ease-out; }
        }
    }

    // Click to focus
    TouchArea {
        clicked => {
            input.focus();
        }
    }
}

// ==================== TextButton ====================
// Minimalist text-only button with hover effect

export component TextButton inherits Rectangle {
    in property <string> text: "BUTTON";
    in property <bool> enabled: true;
    in property <bool> uppercase: true;

    callback clicked();

    height: 48px;
    background: transparent;

    label := Text {
        text: root.uppercase ? root.text : root.text;
        color: Palette.text-primary;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: !root.enabled ? 0.3 : touch.has-hover ? 0.7 : 1.0;

        animate opacity {
            duration: 150ms;
            easing: ease-out;
        }
    }

    // Subtle underline on hover
    if touch.has-hover && enabled: Rectangle {
        y: parent.height - 4px;
        height: 2px;
        width: parent.width * 0.4;
        x: parent.width * 0.3;
        background: @linear-gradient(90deg, transparent 0%, Palette.accent 50%, transparent 100%);
        opacity: 0.5;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;

        clicked => {
            root.clicked();
        }
    }
}

// ==================== BorderButton ====================
// Text button with fine border

export component BorderButton inherits Rectangle {
    in property <string> text: "BUTTON";
    in property <bool> enabled: true;

    callback clicked();

    height: 48px;
    min-width: 160px;
    background: touch.has-hover ? Palette.surface : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.border-light : Palette.border;
    border-radius: 8px;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    Text {
        text: root.text;
        color: Palette.text-primary;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: !root.enabled ? 0.3 : 1.0;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;

        clicked => {
            root.clicked();
        }
    }
}

// ==================== PrimaryButton ====================
// Gradient action button

export component PrimaryButton inherits Rectangle {
    in property <string> text: "BUTTON";
    in property <bool> enabled: true;

    callback clicked();

    height: 48px;
    min-width: 160px;
    background: @linear-gradient(135deg, Palette.accent 0%, #6366f1 100%);
    border-radius: 10px;
    opacity: enabled ? (touch.has-hover ? 0.9 : 1.0) : 0.5;

    animate opacity { duration: 150ms; easing: ease-out; }

    Text {
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;

        clicked => {
            root.clicked();
        }
    }
}

// ==================== Divider ====================
// Gradient horizontal line

export component Divider inherits Rectangle {
    height: 1px;
    background: @linear-gradient(90deg, transparent 0%, Palette.border 50%, transparent 100%);
    horizontal-stretch: 1;
}

// ==================== SanctumCard ====================
// Premium card container with gradient background

export component SanctumCard inherits Rectangle {
    in property <length> card-padding: 24px;

    background: @linear-gradient(135deg, Palette.surface 0%, #1a1a2e 100%);
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: root.card-padding;
        @children
    }
}

// ==================== IconButton ====================
// Circular icon button

export component IconButton inherits Rectangle {
    in property <string> icon: "•";
    in property <bool> enabled: true;

    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: touch.has-hover ? Palette.surface-hover : Palette.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.border-light : Palette.border;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    Text {
        text: root.icon;
        color: enabled ? Palette.text-primary : Palette.text-muted;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;

        clicked => {
            root.clicked();
        }
    }
}

// ==================== ActionButton ====================
// Standard action button (Primary/Secondary) for dashboards

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked;

    height: 36px;
    min-width: 120px;
    border-radius: 8px;
    background: primary 
        ? @linear-gradient(135deg, Palette.accent 0%, #6366f1 100%)
        : (touch.has-hover ? Palette.surface-hover : Palette.surface);
    border-width: primary ? 0px : 1px;
    border-color: Palette.border-light;

    animate background { duration: 200ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;

        if has-icon: Image {
            source: icon;
            width: 16px;
            height: 16px;
            colorize: primary ? #ffffff : Palette.text-primary;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: primary ? #ffffff : Palette.text-primary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ==================== CustomScrollbar ====================
// Horizontal scrollbar indicator - Auto-hides when not scrolling

export component CustomScrollbar inherits Rectangle {
    in property <length> viewport-width;
    in property <length> viewport-x;
    in property <length> visible-width;
    
    // Internal state to track scrolling
    property <bool> is-scrolling: false;
    
    height: 4px;
    width: visible-width;
    background: transparent;
    
    // Only show if content overflows
    visible: viewport-width > visible-width;
    
    // Detect viewport changes (scrolling)
    changed viewport-x => {
        self.is-scrolling = true;
        hide-timer.restart();
    }
    
    // The Scroll Thumb
    if viewport-width > visible-width: Rectangle {
        height: 100%;
        border-radius: 2px;
        background: Palette.text-muted;
        // Show when scrolling or hovering, hide otherwise
        opacity: (root.is-scrolling || touch.has-hover) ? 0.6 : 0.0;
        
        animate opacity { 
            duration: 600ms;
            easing: ease-out;
        }
        
        // Calculate width: Ratio of visible to total
        width: max(20px, parent.width * (parent.width / viewport-width));
        
        // Calculate position: Inverse of viewport-x (which is negative)
        x: (-viewport-x / viewport-width) * parent.width;
        
        touch := TouchArea {
            mouse-cursor: pointer;
        }
    }
    
    // Timer to hide after scrolling stops
    hide-timer := Timer {
        interval: 1000ms;
        triggered => {
            root.is-scrolling = false;
        }
    }
}
