// ==================== Sanctum - Main Application Entry Point ====================
// Noir Minimalist - Elegant, luxury-inspired interface

import {
    AuthAdapter,
    AppState,
    AccountAdapter,
    TransactionAdapter,
    CategoryAdapter,
    DashboardAdapter,
    AnalyticsAdapter,
    NotificationAdapter,
    HabitAdapter,
    RewardsAdapter,
    CryptoAdapter,
    SettingsAdapter,
    IngestionAdapter,
    VaultAdapter,
} from "globals.slint";
import { Translations } from "translations.slint";
import { Theme } from "theme.slint";
import { LoginPage } from "pages/login.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { FinancesPage } from "pages/finances.slint";
import { HabitsPage } from "pages/habits.slint";
import { CryptoPage } from "pages/crypto.slint";
import { SettingsPage } from "pages/settings.slint";
import { SanctumSidebar } from "components/sidebar.slint";
import { AddTransactionModal } from "modals/add_transaction.slint";
import { AddAccountModal } from "modals/add_account.slint";
import { TransferFundsModal } from "modals/transfer_funds.slint";
import { AddCryptoTransactionModal } from "modals/add_crypto_transaction.slint";
import { AddCryptoWalletModal } from "modals/add_crypto_wallet.slint";
import { EditWalletIconModal } from "modals/edit_wallet_icon.slint";
import { EditAccountIconModal } from "modals/edit_account_icon.slint";
import {
    EditCryptoTransactionModal,
} from "modals/edit_crypto_transaction.slint";
import { ConfigureTickerModal } from "modals/configure_ticker.slint";
import { ConfigureCategoriesModal } from "modals/configure_categories.slint";
import { RestoreVaultModal } from "modals/restore_vault_modal.slint";
import { ImportPreviewModal } from "modals/import_preview.slint";
import { ImportResultsModal } from "modals/import_results.slint";
import { NotificationToast } from "components/notification.slint";

// ==================== Main Application Window ====================

export component AppWindow inherits Window {
    title: "Sanctum";
    min-width: 1024px;
    min-height: 680px;
    background: Theme.background;

    in-out property <string> login-title: "SANCTUM";

    // Sync Theme.is-dark with SettingsAdapter.dark-mode
    property <bool> dark-mode-tracker: SettingsAdapter.dark-mode;
    changed dark-mode-tracker => {
        Theme.is-dark = SettingsAdapter.dark-mode;
    }
    init => {
        Theme.is-dark = SettingsAdapter.dark-mode;
    }

    // ==================== Conditional Rendering ====================

    // Login view
    if !AppState.is-logged-in: LoginPage {
        width: 100%;
        height: 100%;
        title-text: root.login-title;
    }

    // Main application shell (when logged in)
    if AppState.is-logged-in: HorizontalLayout {
        spacing: 0px;

        // Sidebar navigation
        SanctumSidebar {
            collapsed <=> AppState.sidebar-collapsed;
        }

        // Main content area
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            // Dashboard
            if AppState.active-page == "dashboard": DashboardPage {
                width: 100%;
                height: 100%;
            }

            // Finances (Unified Accounts & Transactions)
            if AppState.active-page == "finances": FinancesPage {
                width: 100%;
                height: 100%;
            }

            // Habits
            if AppState.active-page == "habits": HabitsPage {
                width: 100%;
                height: 100%;
            }

            // Crypto
            if AppState.active-page == "crypto": CryptoPage {
                width: 100%;
                height: 100%;
            }

            // Settings
            if AppState.active-page == "settings": SettingsPage {
                width: 100%;
                height: 100%;
            }
        }
    }

    // ==================== Modal Overlays ====================

    // Add Transaction Modal
    if AppState.show-add-transaction: AddTransactionModal {
        width: 100%;
        height: 100%;
        editing: AppState.transaction-edit-mode;
        selected-index: AppState.selected-transaction-index;
    }

    // Add Account Modal
    if AppState.show-add-account: AddAccountModal {
        width: 100%;
        height: 100%;
        editing: AppState.account-edit-mode;
        selected-index: AppState.selected-account-index;
    }

    // Transfer Modal
    if AppState.show-transfer-modal: TransferFundsModal {
        width: 100%;
        height: 100%;
        editing: AppState.transfer-edit-mode;
        selected-index: AppState.selected-transfer-index;
    }

    // Configure Categories Modal
    if AppState.show-configure-categories: ConfigureCategoriesModal {
        width: 100%;
        height: 100%;
    }

    // Add Crypto Modal
    if AppState.show-add-crypto: AddCryptoTransactionModal {
        width: 100%;
        height: 100%;
    }

    // Edit Crypto Modal
    if AppState.show-edit-crypto: EditCryptoTransactionModal {
        width: 100%;
        height: 100%;
    }

    // Add Wallet Modal
    if AppState.show-add-wallet: AddCryptoWalletModal {
        width: 100%;
        height: 100%;
    }

    // Edit Wallet Icon Modal
    if AppState.show-edit-wallet-icon: EditWalletIconModal {
        width: 100%;
        height: 100%;
        wallet-id: CryptoAdapter.icon-edit-wallet-id;
        wallet-category: CryptoAdapter.icon-edit-wallet-category;
        selected-icon <=> CryptoAdapter.icon-edit-wallet-icon;
    }

    // Configure Ticker Modal
    if AppState.show-configure-ticker: ConfigureTickerModal {
        width: 100%;
        height: 100%;
    }

    // Edit Account Icon Modal
    if AppState.show-edit-account-icon: EditAccountIconModal {
        width: 100%;
        height: 100%;
        account-id: AccountAdapter.edit-account-id;
        selected-icon <=> AccountAdapter.edit-account-icon;
    }

    // Restore Vault Modal
    if AppState.show-restore-vault: RestoreVaultModal {
        width: 100%;
        height: 100%;

        close => {
            AppState.show-restore-vault = false;
        }
    }

    // Import Preview Modal
    if AppState.show-import-preview: ImportPreviewModal {
        width: 100%;
        height: 100%;

        close => {
            AppState.show-import-preview = false;
            IngestionAdapter.cancel-preview();
        }

        confirm => {
            IngestionAdapter.confirm-import();
        }
    }

    // Import Results Modal
    if AppState.show-import-results: ImportResultsModal {
        width: 100%;
        height: 100%;

        close => {
            AppState.show-import-results = false;
            IngestionAdapter.reset-results();
        }
    }

    // Notification Toast (Global Overlay)
    NotificationToast {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - 32px;
        message: NotificationAdapter.message;
        is-error: NotificationAdapter.is-error;
        active: NotificationAdapter.active;
    }
}

// Re-export adapters for main.rs
export { AuthAdapter, AccountAdapter, TransactionAdapter, CategoryAdapter, DashboardAdapter, AnalyticsAdapter, NotificationAdapter, HabitAdapter, RewardsAdapter, CryptoAdapter, AppState, SettingsAdapter, IngestionAdapter, Translations, VaultAdapter }
