// ==================== Sanctum - Main Application Entry Point ====================
// Noir Minimalist - Elegant, luxury-inspired interface

import { Palette, AuthAdapter, AppState } from "globals.slint";
import { LoginPage } from "pages/login.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { SanctumSidebar } from "components/sidebar.slint";

// ==================== Main Application Window ====================

export component AppWindow inherits Window {
    title: "Sanctum";
    min-width: 1024px;
    min-height: 680px;
    background: Palette.background;

    // ==================== Conditional Rendering ====================

    // Login view
    if !AppState.is-logged-in: LoginPage {
        width: 100%;
        height: 100%;
    }

    // Main application shell (when logged in)
    if AppState.is-logged-in: HorizontalLayout {
        spacing: 0px;

        // Sidebar navigation
        SanctumSidebar { }

        // Main content area
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // Dashboard
            if AppState.active-page == "dashboard": DashboardPage {
                width: 100%;
                height: 100%;
            }

            // Accounts (placeholder)
            if AppState.active-page == "accounts": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "ACCOUNTS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 16px;
                    }

                    Text {
                        text: "Coming soon";
                        color: Palette.text-subtle;
                        font-size: 13px;
                        font-weight: 300;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                }
            }

            // Transactions (placeholder)
            if AppState.active-page == "transactions": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "TRANSACTIONS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 16px;
                    }

                    Text {
                        text: "Coming soon";
                        color: Palette.text-subtle;
                        font-size: 13px;
                        font-weight: 300;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                }
            }

            // Settings (placeholder)
            if AppState.active-page == "settings": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "SETTINGS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 16px;
                    }

                    Text {
                        text: "Coming soon";
                        color: Palette.text-subtle;
                        font-size: 13px;
                        font-weight: 300;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// Re-export AuthAdapter for main.rs to access
export { AuthAdapter }
