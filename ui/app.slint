// ==================== Sanctum - Main Application Entry Point ====================
// Noir Minimalist - Elegant, luxury-inspired interface

import {
    Palette,
    AuthAdapter,
    AppState,
    AccountAdapter,
    TransactionAdapter,
    DashboardAdapter,
    AnalyticsAdapter,
    NotificationAdapter,
    HabitAdapter,
} from "globals.slint";
import { LoginPage } from "pages/login.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { AccountsPage } from "pages/accounts.slint";
import { TransactionsPage } from "pages/transactions.slint";
import { AnalyticsPage } from "pages/analytics.slint";
import { HabitsPage } from "pages/habits.slint";
import { SanctumSidebar } from "components/sidebar.slint";
import { AddTransactionModal } from "modals/add_transaction.slint";
import { AddAccountModal } from "modals/add_account.slint";
import { TransferFundsModal } from "modals/transfer_funds.slint";
import { NotificationToast } from "components/notification.slint";

// ==================== Main Application Window ====================

export component AppWindow inherits Window {
    title: "Sanctum";
    min-width: 1024px;
    min-height: 680px;
    background: Palette.background;

    in-out property <string> login-title: "SANCTUM";

    // ==================== Conditional Rendering ====================

    // Login view
    if !AppState.is-logged-in: LoginPage {
        width: 100%;
        height: 100%;
        title-text: root.login-title;
    }

    // Main application shell (when logged in)
    if AppState.is-logged-in: HorizontalLayout {
        spacing: 0px;

        // Sidebar navigation
        SanctumSidebar { }

        // Main content area
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // Dashboard
            if AppState.active-page == "dashboard": DashboardPage {
                width: 100%;
                height: 100%;
            }

            // Accounts
            if AppState.active-page == "accounts": AccountsPage {
                width: 100%;
                height: 100%;
            }

            // Transactions
            if AppState.active-page == "transactions": TransactionsPage {
                width: 100%;
                height: 100%;
            }

            // Analytics
            if AppState.active-page == "analytics": AnalyticsPage {
                width: 100%;
                height: 100%;
            }

            // Habits
            if AppState.active-page == "habits": HabitsPage {
                width: 100%;
                height: 100%;
            }

            // Settings (placeholder)
            if AppState.active-page == "settings": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "SETTINGS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 400;
                        letter-spacing: 3px;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 16px;
                    }

                    Text {
                        text: "Coming soon";
                        color: Palette.text-subtle;
                        font-size: 13px;
                        font-weight: 300;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ==================== Modal Overlays ====================

    // Add Transaction Modal
    if AppState.show-add-transaction: AddTransactionModal {
        width: 100%;
        height: 100%;
    }

    // Add Account Modal
    if AppState.show-add-account: AddAccountModal {
        width: 100%;
        height: 100%;
        editing: AppState.account-edit-mode;
        selected-index: AppState.selected-account-index;
    }

    // Transfer Modal
    if AppState.show-transfer-modal: TransferFundsModal {
        width: 100%;
        height: 100%;
    }
    
    // Notification Toast (Global Overlay)
    NotificationToast {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - 32px;
        message: NotificationAdapter.message;
        is-error: NotificationAdapter.is-error;
        active: NotificationAdapter.active;
    }
}

// Re-export adapters for main.rs
export { AuthAdapter, AccountAdapter, TransactionAdapter, DashboardAdapter, AnalyticsAdapter, NotificationAdapter, HabitAdapter, AppState }
