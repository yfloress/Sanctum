// ==================== Sanctum - Main Application Entry Point ====================
// Noir Minimalist - Elegant, luxury-inspired interface

import {
    Palette,
    AuthAdapter,
    AppState,
    AccountAdapter,
    TransactionAdapter,
    DashboardAdapter,
    AnalyticsAdapter,
    NotificationAdapter,
    HabitAdapter,
    CryptoAdapter,
    SettingsAdapter,
} from "globals.slint";
import { LoginPage } from "pages/login.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { AccountsPage } from "pages/accounts.slint";
import { TransactionsPage } from "pages/transactions.slint";
import { AnalyticsPage } from "pages/analytics.slint";
import { HabitsPage } from "pages/habits.slint";
import { CryptoPage } from "pages/crypto.slint";
import { SanctumSidebar } from "components/sidebar.slint";
import { AddTransactionModal } from "modals/add_transaction.slint";
import { AddAccountModal } from "modals/add_account.slint";
import { TransferFundsModal } from "modals/transfer_funds.slint";
import { AddCryptoTransactionModal } from "modals/add_crypto_transaction.slint";
import { AddCryptoWalletModal } from "modals/add_crypto_wallet.slint";
import { NotificationToast } from "components/notification.slint";

// ==================== Main Application Window ====================

export component AppWindow inherits Window {
    title: "Sanctum";
    min-width: 1024px;
    min-height: 680px;
    background: Palette.background;

    in-out property <string> login-title: "SANCTUM";

    // ==================== Conditional Rendering ====================

    // Login view
    if !AppState.is-logged-in: LoginPage {
        width: 100%;
        height: 100%;
        title-text: root.login-title;
    }

    // Main application shell (when logged in)
    if AppState.is-logged-in: HorizontalLayout {
        spacing: 0px;

        // Sidebar navigation
        SanctumSidebar { }

        // Main content area
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.background;

            // Dashboard
            if AppState.active-page == "dashboard": DashboardPage {
                width: 100%;
                height: 100%;
            }

            // Accounts
            if AppState.active-page == "accounts": AccountsPage {
                width: 100%;
                height: 100%;
            }

            // Transactions
            if AppState.active-page == "transactions": TransactionsPage {
                width: 100%;
                height: 100%;
            }

            // Analytics
            if AppState.active-page == "analytics": AnalyticsPage {
                width: 100%;
                height: 100%;
            }

            // Habits
            if AppState.active-page == "habits": HabitsPage {
                width: 100%;
                height: 100%;
            }

            // Crypto
            if AppState.active-page == "crypto": CryptoPage {
                width: 100%;
                height: 100%;
            }

            // Settings
            if AppState.active-page == "settings": Rectangle {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding: 48px;
                    spacing: 24px;
                    alignment: start;

                    Text {
                        text: "SETTINGS";
                        color: Palette.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 3px;
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border-subtle;
                    }

                    // Setting Item: Auto-fetch
                    Rectangle {
                        height: 64px;
                        background: Palette.surface;
                        border-radius: 4px;
                        
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            alignment: space-between;
                            
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text { 
                                    text: "Auto-fetch Crypto Prices"; 
                                    color: Palette.text-primary; 
                                    font-size: 14px; 
                                    font-weight: 500; 
                                }
                                Text { 
                                    text: "Automatically update prices when app starts (uses data)"; 
                                    color: Palette.text-secondary; 
                                    font-size: 12px; 
                                }
                            }
                            
                            // Toggle Switch
                            Rectangle {
                                width: 48px;
                                height: 24px;
                                border-radius: 12px;
                                background: SettingsAdapter.auto-fetch-enabled ? Palette.success : Palette.surface-hover;
                                border-width: 1px;
                                border-color: Palette.border;
                                vertical-alignment: center;
                                
                                animate background { duration: 200ms; }
                                
                                // Knob
                                Rectangle {
                                    x: SettingsAdapter.auto-fetch-enabled ? 26px : 2px;
                                    y: 2px;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: Palette.text-primary;
                                    
                                    animate x { duration: 200ms; easing: ease-out; }
                                }
                                
                                TouchArea {
                                    clicked => {
                                        SettingsAdapter.set-auto-fetch(!SettingsAdapter.auto-fetch-enabled);
                                        SettingsAdapter.auto-fetch-enabled = !SettingsAdapter.auto-fetch-enabled;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== Modal Overlays ====================

    // Add Transaction Modal
    if AppState.show-add-transaction: AddTransactionModal {
        width: 100%;
        height: 100%;
    }

    // Add Account Modal
    if AppState.show-add-account: AddAccountModal {
        width: 100%;
        height: 100%;
        editing: AppState.account-edit-mode;
        selected-index: AppState.selected-account-index;
    }

    // Transfer Modal
    if AppState.show-transfer-modal: TransferFundsModal {
        width: 100%;
        height: 100%;
    }
    
    // Add Crypto Modal
    if AppState.show-add-crypto: AddCryptoTransactionModal {
        width: 100%;
        height: 100%;
    }

    // Add Wallet Modal
    if AppState.show-add-wallet: AddCryptoWalletModal {
        width: 100%;
        height: 100%;
    }
    
    // Notification Toast (Global Overlay)
    NotificationToast {
        x: parent.width - self.width - 32px;
        y: parent.height - self.height - 32px;
        message: NotificationAdapter.message;
        is-error: NotificationAdapter.is-error;
        active: NotificationAdapter.active;
    }
}

// Re-export adapters for main.rs
export { AuthAdapter, AccountAdapter, TransactionAdapter, DashboardAdapter, AnalyticsAdapter, NotificationAdapter, HabitAdapter, CryptoAdapter, AppState, SettingsAdapter }
