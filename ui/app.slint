// ==================== Sanctum - Main Application Entry Point ====================
// Noir Minimalist - Elegant, luxury-inspired interface

import { Palette, AuthAdapter, AppState } from "globals.slint";
import { LoginPage } from "pages/login.slint";
import { TextButton, Divider } from "widgets.slint";

// ==================== Main Application Window ====================

export component AppWindow inherits Window {
    title: "Sanctum";
    min-width: 800px;
    min-height: 600px;
    background: Palette.background;

    // ==================== Conditional Rendering ====================

    // Login view
    if !AppState.is-logged-in: LoginPage {
        width: 100%;
        height: 100%;
    }

    // Dashboard view (placeholder)
    if AppState.is-logged-in: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;

        VerticalLayout {
            spacing: 0px;

            // Top spacer
            Rectangle {
                vertical-stretch: 1;
            }

            // Main content
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 400px;

                    VerticalLayout {
                        spacing: 0px;
                        alignment: center;

                        // Title
                        Text {
                            text: "SANCTUM";
                            color: Palette.text-primary;
                            font-size: 36px;
                            font-weight: 300;
                            letter-spacing: 10px;
                            horizontal-alignment: center;
                        }

                        // Spacer
                        Rectangle {
                            height: 24px;
                        }

                        // Divider
                        Rectangle {
                            height: 1px;
                            background: Palette.border;
                            horizontal-stretch: 1;
                        }

                        // Spacer
                        Rectangle {
                            height: 24px;
                        }

                        // Status
                        Text {
                            text: "VAULT UNLOCKED";
                            color: Palette.text-secondary;
                            font-size: 11px;
                            font-weight: 400;
                            letter-spacing: 3px;
                            horizontal-alignment: center;
                        }

                        // Spacer
                        Rectangle {
                            height: 48px;
                        }

                        // Dashboard placeholder message
                        Text {
                            text: "Dashboard coming soon";
                            color: Palette.text-muted;
                            font-size: 13px;
                            font-weight: 300;
                            font-italic: true;
                            horizontal-alignment: center;
                        }

                        // Spacer
                        Rectangle {
                            height: 64px;
                        }

                        // Lock button
                        TextButton {
                            text: "LOCK VAULT";

                            clicked => {
                                AuthAdapter.lock-vault();
                                AppState.is-logged-in = false;
                            }
                        }
                    }
                }
            }

            // Bottom spacer
            Rectangle {
                vertical-stretch: 1;
            }

            // Footer
            Rectangle {
                height: 60px;

                Text {
                    text: "v0.1.0";
                    color: Palette.text-subtle;
                    font-size: 10px;
                    font-weight: 400;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Re-export AuthAdapter for main.rs to access
export { AuthAdapter }
