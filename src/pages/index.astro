---
// Main landing page with home and generator sections
import Layout from '@layouts/Layout.astro';
import Hero from '@components/landing/Hero.astro';
import Features from '@components/landing/Features.astro';
import ImportFlow from '@components/landing/ImportFlow.astro';
import Privacy from '@components/landing/Privacy.astro';
import Download from '@components/landing/Download.astro';
import Footer from '@components/landing/Footer.astro';
import Generator from '@components/generator/Generator';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Sanctum — Your Personal Fortress">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#home" class="flex items-center gap-3 text-xl font-semibold text-foreground">
          <img src={`${baseUrl}favicon.svg`} alt="Sanctum" class="h-8 w-8" />
          <span>Sanctum</span>
        </a>
        <div class="hidden items-center gap-6 text-sm sm:flex">
          <a href="#modules" class="text-muted-foreground hover:text-foreground transition-colors">Modules</a>
          <a href="#security" class="text-muted-foreground hover:text-foreground transition-colors">Security</a>
          <a href="#import" class="text-muted-foreground hover:text-foreground transition-colors">Import</a>
          <a href="#generator" class="text-muted-foreground hover:text-foreground transition-colors">Sanctum Web</a>
          <a href="#download" class="text-muted-foreground hover:text-foreground transition-colors">Download</a>
        </div>
        <a
          href="#generator"
          class="sm:hidden rounded-full border border-border px-3 py-1 text-xs font-semibold text-foreground"
        >
          Sanctum Web
        </a>
      </div>
    </div>
  </nav>

  <!-- Landing Sections -->
  <main class="pt-16">
    <section id="home" class="scroll-mt-24">
      <Hero />
    </section>

    <section id="modules" class="scroll-mt-24 py-24 bg-sanctum-section">
      <Features />
    </section>

    <section id="security" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <Privacy />
    </section>

    <section id="import" class="scroll-mt-24 py-24 bg-sanctum-section">
      <ImportFlow />
    </section>

    <section id="generator" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 reveal" data-reveal="left">
          <p class="text-xs font-semibold uppercase tracking-[0.4em] text-muted-foreground">Sanctum Web</p>
          <h2 class="font-display text-3xl font-semibold text-foreground mb-4">Daily Log Generator</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto">
            Create or append to a single sanctum_export.json file while traveling or offline. Load
            an existing file, add entries, and export a clean JSON v1 payload.
          </p>
        </div>
        <!-- React Island for interactive form -->
        <Generator client:load />
      </div>
    </section>

    <section id="download" class="scroll-mt-24 py-24 bg-sanctum-section">
      <Download />
    </section>
  </main>

  <Footer />
</Layout>
