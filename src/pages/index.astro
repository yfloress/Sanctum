---
// Main landing page with home and generator sections
import Layout from '@layouts/Layout.astro';
import Hero from '@components/landing/Hero.astro';
import Features from '@components/landing/Features.astro';
import Privacy from '@components/landing/Privacy.astro';
import Download from '@components/landing/Download.astro';
import Footer from '@components/landing/Footer.astro';
import Generator from '@components/generator/Generator';
---

<Layout title="Sanctum - Your Personal Fortress">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#home" class="text-xl font-bold text-white">Sanctum</a>
        <div class="flex gap-6">
          <a href="#home" class="text-slate-300 hover:text-white transition-colors">Home</a>
          <a href="#generator" class="text-slate-300 hover:text-white transition-colors">Generator</a>
          <a href="#download" class="text-slate-300 hover:text-white transition-colors">Download</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Landing Sections -->
  <main>
    <section id="home">
      <Hero />
    </section>

    <section id="features" class="py-24 bg-slate-900">
      <Features />
    </section>

    <section id="privacy" class="py-24 bg-slate-950">
      <Privacy />
    </section>

    <section id="generator" class="py-24 bg-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-white mb-4">JSON Generator</h2>
          <p class="text-slate-400 max-w-2xl mx-auto">
            Create or edit your sanctum_export.json file. All data stays in your browser.
          </p>
        </div>
        <!-- React Island for interactive form -->
        <Generator client:load />
      </div>
    </section>

    <section id="download" class="py-24 bg-slate-950">
      <Download />
    </section>
  </main>

  <Footer />
</Layout>
