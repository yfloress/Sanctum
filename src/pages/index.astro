---
// Main landing page with home and generator sections
import Layout from '@layouts/Layout.astro';
import Hero from '@components/landing/Hero.astro';
import Features from '@components/landing/Features.astro';
import Privacy from '@components/landing/Privacy.astro';
import Download from '@components/landing/Download.astro';
import Footer from '@components/landing/Footer.astro';
import Generator from '@components/generator/Generator';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Sanctum - Your Personal Fortress">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-black/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#home" class="flex items-center gap-3 text-xl font-semibold text-white">
          <img src={`${baseUrl}favicon.svg`} alt="Sanctum" class="h-8 w-8" />
          <span>Sanctum</span>
        </a>
        <div class="hidden items-center gap-6 text-sm sm:flex">
          <a href="#features" class="text-slate-300 hover:text-white transition-colors">Features</a>
          <a href="#privacy" class="text-slate-300 hover:text-white transition-colors">Privacy</a>
          <a href="#generator" class="text-slate-300 hover:text-white transition-colors">Sanctum Web</a>
          <a href="#download" class="text-slate-300 hover:text-white transition-colors">Download</a>
        </div>
        <a
          href="#generator"
          class="sm:hidden rounded-full border border-slate-700 px-3 py-1 text-xs font-semibold text-slate-200"
        >
          Sanctum Web
        </a>
      </div>
    </div>
  </nav>

  <!-- Landing Sections -->
  <main class="pt-16">
    <section id="home" class="scroll-mt-24">
      <Hero />
    </section>

    <section id="features" class="scroll-mt-24 py-24 bg-sanctum-section">
      <Features />
    </section>

    <section id="privacy" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <Privacy />
    </section>

    <section id="generator" class="scroll-mt-24 py-24 bg-sanctum-section">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-semibold text-white mb-4">Sanctum Web Generator</h2>
          <p class="text-slate-400 max-w-2xl mx-auto">
            Create or append to a single sanctum_export.json file while traveling or offline.
          </p>
        </div>
        <!-- React Island for interactive form -->
        <Generator client:load />
      </div>
    </section>

    <section id="download" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <Download />
    </section>
  </main>

  <Footer />
</Layout>
