---
// Main landing page with home and generator sections
import Layout from '@layouts/Layout.astro';
import Hero from '@components/landing/Hero.astro';
import Features from '@components/landing/Features.astro';
import ImportFlow from '@components/landing/ImportFlow.astro';
import Privacy from '@components/landing/Privacy.astro';
import Download from '@components/landing/Download.astro';
import Footer from '@components/landing/Footer.astro';
import Generator from '@components/generator/Generator';
---

<Layout title="Sanctum — Your Personal Fortress">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-md nav-fade-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#home" class="flex items-center text-xl font-semibold text-foreground">
          <span>Sanctum</span>
        </a>
        <div class="hidden items-center gap-6 text-sm sm:flex">
          <a
            href="#modules"
            class="text-muted-foreground hover:text-foreground transition-colors"
            data-i18n="nav.modules"
          >Modules</a>
          <a
            href="#security"
            class="text-muted-foreground hover:text-foreground transition-colors"
            data-i18n="nav.security"
          >Security</a>
          <a
            href="#import"
            class="text-muted-foreground hover:text-foreground transition-colors"
            data-i18n="nav.import"
          >Import</a>
          <a
            href="#generator"
            class="text-muted-foreground hover:text-foreground transition-colors"
            data-i18n="nav.generator"
          >Sanctum Generator</a>
          <a
            href="#download"
            class="text-muted-foreground hover:text-foreground transition-colors"
            data-i18n="nav.download"
          >Download</a>
          <button
            type="button"
            data-theme-toggle
            class="theme-toggle"
            aria-label="Switch to light mode"
            aria-pressed="false"
          >
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb"></span>
            </span>
            <span class="theme-toggle__label" data-theme-toggle-label>Dark</span>
          </button>
          <button
            type="button"
            data-lang-toggle
            class="btn-surface inline-flex items-center justify-center rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] leading-none text-center transition-all duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:shadow-md active:scale-[0.98]"
            aria-label="Switch to Spanish"
          >
            <span data-lang-toggle-label>EN</span>
          </button>
        </div>
        <div class="flex items-center gap-2 sm:hidden">
          <button
            type="button"
            data-theme-toggle
            class="theme-toggle theme-toggle--compact"
            aria-label="Switch to light mode"
            aria-pressed="false"
          >
            <span class="theme-toggle__track" aria-hidden="true">
              <span class="theme-toggle__thumb"></span>
            </span>
            <span class="theme-toggle__label" data-theme-toggle-label>Dark</span>
          </button>
          <button
            type="button"
            data-lang-toggle
            class="btn-surface inline-flex items-center justify-center rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] leading-none text-center transition-all duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:shadow-md active:scale-[0.98]"
            aria-label="Switch to Spanish"
          >
            <span data-lang-toggle-label>EN</span>
          </button>
          <details class="nav-mobile self-center">
            <summary class="btn-surface inline-flex items-center justify-center rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] leading-none text-center transition-all duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:shadow-md active:scale-[0.98]">
              <span class="sr-only" data-i18n="nav.menu">Menu</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-foreground">
                <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="nav-mobile__panel">
              <a href="#modules" class="nav-mobile__link" data-i18n="nav.modules">Modules</a>
              <a href="#security" class="nav-mobile__link" data-i18n="nav.security">Security</a>
              <a href="#import" class="nav-mobile__link" data-i18n="nav.import">Import</a>
              <a href="#generator" class="nav-mobile__link nav-mobile__link--primary" data-i18n="nav.generator">
                Sanctum Generator
              </a>
              <a href="#download" class="nav-mobile__link" data-i18n="nav.download">Download</a>
            </div>
          </details>
        </div>
      </div>
    </div>
  </nav>

  <!-- Landing Sections -->
  <main class="pt-16">
    <section id="home" class="scroll-mt-24">
      <Hero />
    </section>

    <section id="modules" class="scroll-mt-24 py-24 bg-sanctum-section">
      <Features />
    </section>

    <section id="security" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <Privacy />
    </section>

    <section id="import" class="scroll-mt-24 py-24 bg-sanctum-section">
      <ImportFlow />
    </section>

    <section id="generator" class="scroll-mt-24 py-24 bg-sanctum-section-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 reveal" data-reveal="left">
          <p
            class="text-xs font-semibold uppercase tracking-[0.4em] text-muted-foreground"
            data-i18n="generator.tag"
          >Sanctum Generator</p>
          <h2 class="font-display text-3xl font-semibold text-foreground mb-4" data-i18n="generator.title">
            Daily Log Builder
          </h2>
          <p class="text-muted-foreground max-w-2xl mx-auto" data-i18n="generator.description">
            Create or append to a single sanctum_export.json file while traveling or offline. Load
            an existing file, add entries, and export a clean JSON v1 payload.
          </p>
        </div>
        <!-- React Island for interactive form -->
        <Generator client:load />
      </div>
    </section>

    <section id="download" class="scroll-mt-24 py-24 bg-sanctum-section">
      <Download />
    </section>
  </main>

  <Footer />
</Layout>
