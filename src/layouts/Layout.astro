---
// Main layout wrapper for all pages
// Includes meta tags, fonts, global styles, and PWA support

import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sanctum is a privacy-first fortress for finance, crypto, and habit tracking with local encryption and offline workflows.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("sanctum-theme");
          if (theme === "light") {
            document.documentElement.classList.remove("dark");
          }
          const lang = localStorage.getItem("sanctum-lang");
          if (lang === "es") {
            document.documentElement.lang = "es";
            document.documentElement.dataset.lang = "es";
          }
        } catch {}
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16x16.png`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- PWA Manifest -->
    <link rel="manifest" href={`${baseUrl}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>

    <!-- Global styles loaded via frontmatter import -->
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
    <script is:inline>
      const themeKey = "sanctum-theme";
      const langKey = "sanctum-lang";
      const root = document.documentElement;
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const themeToggles = Array.from(document.querySelectorAll("[data-theme-toggle]"));
      const langToggles = Array.from(document.querySelectorAll("[data-lang-toggle]"));
      const themeColors = { dark: "#050505", light: "#f7f1e5" };

      const translations = {
        en: {
          nav: {
            modules: "Modules",
            imports: "Imports",
            generator: "Generator",
            menu: "Menu",
          },
          imports: {
            nav: {
              home: "Home",
              generator: "Generator",
              current: "Imports",
            },
            tag: "Imports",
            title: "Import formats, simplified.",
            description:
              "Choose the format that fits your day. CSV for spreadsheets, TXT for notes, JSON for full fidelity.",
            csv: {
              tag: "CSV",
              title: "Spreadsheet exports (one file per type)",
              description:
                "Export as CSV from Excel, Sheets, LibreOffice, or Proton Sheets. You must export three separate files.",
              download: "Download Excel Template",
              required: "Required columns: date, account, type, amount, currency, category, description.",
              optional: "Optional: transfer_to_account (only for transfers).",
              tabs: {
                transactions: "Transactions CSV",
                habits: "Habit Logs CSV",
                crypto: "Crypto CSV",
              },
            },
            txt: {
              tag: "TXT",
              title: "Quick notes format (prefixed)",
              description: "Use prefixes to paste straight from notes or paper. One line per entry.",
              required: "Required per line: date + key fields. Prefixes: T; transaction, H; habit, C; crypto.",
            },
            json: {
              tag: "JSON",
              title: "Full fidelity (recommended)",
              description: "JSON v1 is the most complete format. Use the Generator to build it safely.",
              cta: "Open Generator",
            },
          },
          hero: {
            tag: "SANCTUM",
            title: "SANCTUM",
            description:
              "Your private vault for money, crypto, and habits. Encrypted, offline-first, and built for daily use.",
            cta: {
              primary: "Open Generator",
              secondary: "Download Desktop Vault",
            },
            badges: {
              sqlcipher: "SQLCipher Vault",
              offline: "Privacy-first",
              noTelemetry: "No Telemetry",
            },
            modules: {
              tag: "Vault Modules",
              badge: "Encrypted Local Storage",
              finance: {
                title: "Finance Core",
                description: "Accounts, categories, transfers, and net-worth analytics.",
              },
              crypto: {
                title: "Crypto Portfolio",
                description: "Wallets, trades, swaps, and price sync via CoinGecko.",
              },
              habits: {
                title: "Habits",
                description: "Daily logs, heatmaps, streak rewards, and goals.",
              },
            },
          },
          features: {
            tag: "Core Screens",
            title: "Four screens. One encrypted vault.",
            description:
              "A clean, offline-first suite for money, crypto, and habits.",
            pages: {
              dashboard: {
                title: "Dashboard",
                description: "Net worth, trends, and a quick pulse of your vault.",
              },
              finances: {
                title: "Finances",
                description: "Accounts, categories, transfers, and everyday spending.",
              },
              crypto: {
                title: "Crypto",
                description: "Wallets, trades, swaps, and portfolio balance.",
              },
              habits: {
                title: "Habits",
                description: "Daily check-ins, streaks, and heatmap progress.",
              },
            },
            highlights: {
              languages: "EN / ES",
              currency: "USD / CLP",
              themes: "Dark / Light",
              encryption: "Encrypted Vault",
            },
          },
          generator: {
            tag: "Generator",
            title: "Daily Log Builder",
            description:
              "Build a single sanctum_export.json file while traveling or offline. Load, add entries, export.",
          },
          download: {
            title: "Deploy the Vault",
            description:
              "Sanctum lives on your machine. Download the desktop app or audit the source on Codeberg.",
            primary: "Desktop Releases",
            secondary: "View Source",
          },
          footer: {
            note: "Sanctum — AGPL-3.0-or-later — Your data stays encrypted and local.",
          },
          theme: {
            light: "Light",
            dark: "Dark",
            ariaLight: "Switch to light mode",
            ariaDark: "Switch to dark mode",
          },
          lang: {
            label: "EN",
            aria: "Switch to Spanish",
          },
        },
        es: {
          nav: {
            modules: "Módulos",
            imports: "Importaciones",
            generator: "Generador",
            menu: "Menú",
          },
          imports: {
            nav: {
              home: "Inicio",
              generator: "Generador",
              current: "Importaciones",
            },
            tag: "Importaciones",
            title: "Formatos de importación, simples.",
            description:
              "Elige el formato que mejor te acomode. CSV para hojas de cálculo, TXT para notas, JSON para todo.",
            csv: {
              tag: "CSV",
              title: "Exportación desde hojas de cálculo (un archivo por tipo)",
              description:
                "Exporta CSV desde Excel, Sheets, LibreOffice o Proton Sheets. Debes exportar tres archivos separados.",
              download: "Descargar plantilla Excel",
              required: "Columnas requeridas: date, account, type, amount, currency, category, description.",
              optional: "Opcional: transfer_to_account (solo para transferencias).",
              tabs: {
                transactions: "Transacciones CSV",
                habits: "Hábitos CSV",
                crypto: "Cripto CSV",
              },
            },
            txt: {
              tag: "TXT",
              title: "Formato rápido (prefijos)",
              description: "Usa prefijos para pegar desde notas o papel. Una línea por entrada.",
              required: "Requerido por línea: fecha + campos clave. Prefijos: T; transacción, H; hábito, C; cripto.",
            },
            json: {
              tag: "JSON",
              title: "Máxima fidelidad (recomendado)",
              description: "JSON v1 es el formato más completo. Usa el Generador para crearlo.",
              cta: "Abrir Generador",
            },
          },
          hero: {
            tag: "SANCTUM",
            title: "SANCTUM",
            description:
              "Tu bóveda privada para finanzas, cripto y hábitos. Cifrado, offline y pensado para el día a día.",
            cta: {
              primary: "Abrir Generador",
              secondary: "Descargar bóveda de escritorio",
            },
            badges: {
              sqlcipher: "Bóveda SQLCipher",
              offline: "Privacidad primero",
              noTelemetry: "Sin telemetría",
            },
            modules: {
              tag: "Módulos de la bóveda",
              badge: "Almacenamiento local cifrado",
              finance: {
                title: "Núcleo financiero",
                description: "Cuentas, categorías, transferencias y analíticas de patrimonio.",
              },
              crypto: {
                title: "Portafolio cripto",
                description: "Wallets, operaciones, swaps y sincronización de precios vía CoinGecko.",
              },
              habits: {
                title: "Hábitos",
                description: "Registros diarios, heatmaps, recompensas por rachas y metas.",
              },
            },
          },
          features: {
            tag: "Pantallas principales",
            title: "Cuatro pantallas. Una bóveda cifrada.",
            description:
              "Una suite limpia y offline para dinero, cripto y hábitos.",
            pages: {
              dashboard: {
                title: "Dashboard",
                description: "Patrimonio, tendencias y resumen del día.",
              },
              finances: {
                title: "Finanzas",
                description: "Cuentas, categorías, transferencias y gastos diarios.",
              },
              crypto: {
                title: "Cripto",
                description: "Wallets, trades, swaps y balance del portafolio.",
              },
              habits: {
                title: "Hábitos",
                description: "Check-ins diarios, rachas y heatmap.",
              },
            },
            highlights: {
              languages: "ES / EN",
              currency: "USD / CLP",
              themes: "Oscuro / Claro",
              encryption: "Bóveda cifrada",
            },
          },
          generator: {
            tag: "Generador",
            title: "Constructor de registro diario",
            description:
              "Crea un sanctum_export.json mientras viajas u offline. Carga, agrega y exporta.",
          },
          download: {
            title: "Despliega la bóveda",
            description:
              "Sanctum vive en tu máquina. Descarga la app de escritorio o audita el código en Codeberg.",
            primary: "Versiones de escritorio",
            secondary: "Ver código",
          },
          footer: {
            note: "Sanctum — AGPL-3.0-or-later — Tus datos permanecen cifrados y locales.",
          },
          theme: {
            light: "Claro",
            dark: "Oscuro",
            ariaLight: "Cambiar a modo claro",
            ariaDark: "Cambiar a modo oscuro",
          },
          lang: {
            label: "ES",
            aria: "Cambiar a inglés",
          },
        },
      };

      const resolveKey = (obj, key) =>
        key.split(".").reduce((acc, part) => (acc ? acc[part] : null), obj);

      const getText = (lang, key) =>
        resolveKey(translations[lang], key) ?? resolveKey(translations.en, key);

      const updateStaticText = (lang) => {
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (!key) return;
          const value = getText(lang, key);
          if (typeof value === "string") {
            el.textContent = value;
          }
        });

        document.querySelectorAll("[data-i18n-html]").forEach((el) => {
          const key = el.getAttribute("data-i18n-html");
          if (!key) return;
          const value = getText(lang, key);
          if (typeof value === "string") {
            el.innerHTML = value;
          }
        });

        document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
          const key = el.getAttribute("data-i18n-placeholder");
          if (!key) return;
          const value = getText(lang, key);
          if (typeof value === "string") {
            el.setAttribute("placeholder", value);
          }
        });
      };

      let currentLang = "en";

      const updateThemeToggleLabels = (mode) => {
        const labels = translations[currentLang]?.theme ?? translations.en.theme;
        const currentLabel = mode === "dark" ? labels.dark : labels.light;
        const nextAria = mode === "dark" ? labels.ariaLight : labels.ariaDark;

        themeToggles.forEach((button) => {
          const label = button.querySelector("[data-theme-toggle-label]");
          if (label) {
            label.textContent = currentLabel;
          }
          button.setAttribute("aria-label", nextAria);
          button.setAttribute("aria-pressed", String(mode === "light"));
          button.classList.toggle("is-light", mode === "light");
        });
      };

      const updateLangToggleLabels = (lang) => {
        const labels = translations[lang]?.lang ?? translations.en.lang;
        langToggles.forEach((button) => {
          const label = button.querySelector("[data-lang-toggle-label]");
          if (label) {
            label.textContent = labels.label;
          }
          button.setAttribute("aria-label", labels.aria);
          button.setAttribute("aria-pressed", String(lang === "es"));
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      const getStoredTheme = () => {
        try {
          return localStorage.getItem(themeKey);
        } catch {
          return null;
        }
      };

      const getStoredLang = () => {
        try {
          return localStorage.getItem(langKey);
        } catch {
          return null;
        }
      };

      const applyTheme = (mode, persist = true) => {
        if (mode === "light") {
          root.classList.remove("dark");
        } else {
          root.classList.add("dark");
        }

        if (themeMeta) {
          themeMeta.setAttribute("content", themeColors[mode] ?? themeColors.dark);
        }

        updateThemeToggleLabels(mode);

        if (!persist) return;
        try {
          localStorage.setItem(themeKey, mode);
        } catch {}
      };

      const applyLanguage = (lang, persist = true) => {
        currentLang = lang;
        root.lang = lang;
        root.dataset.lang = lang;

        updateStaticText(lang);
        updateLangToggleLabels(lang);
        updateThemeToggleLabels(root.classList.contains("dark") ? "dark" : "light");

        if (!persist) return;
        try {
          localStorage.setItem(langKey, lang);
        } catch {}

        window.dispatchEvent(new CustomEvent("sanctum-lang-change", { detail: { lang } }));
      };

      const storedLang = getStoredLang();
      applyLanguage(storedLang === "es" ? "es" : "en", false);

      const storedTheme = getStoredTheme();
      applyTheme(storedTheme === "light" ? "light" : "dark", false);

      themeToggles.forEach((button) => {
        button.addEventListener("click", () => {
          const next = root.classList.contains("dark") ? "light" : "dark";
          applyTheme(next);
        });
      });

      langToggles.forEach((button) => {
        button.addEventListener("click", () => {
          const next = currentLang === "en" ? "es" : "en";
          applyLanguage(next);
        });
      });
    </script>
  </body>
</html>
