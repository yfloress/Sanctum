---
// Footer component - site footer with license and links
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-border">
  <div class="max-w-7xl mx-auto px-4 py-10 text-sm text-muted-foreground flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p data-i18n="footer.note">Sanctum — AGPL-3.0-or-later — Your data stays encrypted and local.</p>
    <div class="flex gap-4 text-muted-foreground">
      <a href="https://codeberg.org/Kyronix/Sanctum" class="hover:text-foreground">Codeberg</a>
      <a href="#modules" class="hover:text-foreground" data-i18n="nav.modules">Modules</a>
      <a href={`${base}imports/`} class="hover:text-foreground" data-i18n="nav.imports">Imports</a>
      <a href="#generator" class="hover:text-foreground" data-i18n="nav.generator">Generator</a>
    </div>
  </div>
</footer>
