---
// Features section - highlights key Sanctum capabilities
// Uses scroll reveal animations via CSS classes

const features = [
  {
    title: 'Privacy by default',
    description:
      'Your vault is local, encrypted, and never leaves your machine unless you export it yourself.',
  },
  {
    title: 'Offline-first workflow',
    description:
      'No network required. Use the desktop app at home and the web log when you are traveling.',
  },
  {
    title: 'Unified ledger',
    description:
      'Track cashflow, habits, and crypto in one place with clean categorization and analytics.',
  },
  {
    title: 'Best-effort imports',
    description:
      'Ingestion accepts partial files and reports clean errors so you never lose good entries.',
  },
  {
    title: 'Security mindset',
    description:
      'SQLCipher, session protection, and zero telemetry keep your sensitive data safe.',
  },
  {
    title: 'Open source',
    description:
      'The project is auditable and hackable. Build your own modules and keep full control.',
  },
];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-16 reveal">
    <h2 class="text-3xl sm:text-4xl font-semibold text-white mb-4">
      A security-first life OS
    </h2>
    <p class="text-slate-400 max-w-2xl mx-auto text-lg">
      Sanctum blends finance, habits, and crypto into one encrypted workspace—without tracking you.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {features.map((feature, index) => (
      <div
        class="reveal panel-gradient panel-hover rounded-2xl border border-border p-6"
        style={`transition-delay: ${index * 90}ms`}
      >
        <div class="h-10 w-10 rounded-full border border-border bg-background"></div>
        <h3 class="mt-4 text-xl font-semibold text-white">{feature.title}</h3>
        <p class="mt-2 text-slate-400">{feature.description}</p>
      </div>
    ))}
  </div>
</div>
