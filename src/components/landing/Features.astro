---
// Features section - highlights key Sanctum capabilities based on app behavior

import { Image } from 'astro:assets';

import crypto from '@/assets/screenshots/crypto.png';
import dashboard from '@/assets/screenshots/dashboard.png';
import finances from '@/assets/screenshots/finances.png';
import lock from '@/assets/screenshots/lock.png';
import settings from '@/assets/screenshots/settings.png';

// Written out rather than read off disk, so each shot carries an alt text a
// person wrote and the build knows its dimensions.
const screens = [
  { src: lock, alt: 'The vault asking for its master password' },
  { src: dashboard, alt: 'Net worth and trends across finances and crypto' },
  { src: finances, alt: 'Accounts, categories and the transaction ledger' },
  { src: crypto, alt: 'Crypto portfolio with holdings and cost basis' },
  { src: settings, alt: 'Settings, with backups and the appearance options' },
];

const slideDuration = 6;

const pages = [
  {
    key: 'dashboard',
    title: 'Dashboard',
    description: 'Net worth, trends, and a quick pulse of your vault.',
  },
  {
    key: 'finances',
    title: 'Finances',
    description: 'Accounts, categories, transfers, and everyday spending.',
  },
  {
    key: 'crypto',
    title: 'Crypto',
    description: 'Wallets, trades, swaps, portfolio, and tax reports (FIFO / LIFO / HIFO).',
  },
];

const highlights = [
  { key: 'languages', label: 'EN / ES' },
  { key: 'currency', label: 'Multi-currency FX' },
  { key: 'tax', label: 'Crypto Tax' },
  { key: 'themes', label: 'Dark / Light' },
  { key: 'encryption', label: 'Encrypted Vault' },
];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="reveal text-center mb-12" data-reveal="left">
    <p
      class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground"
      data-i18n="features.tag"
    >Core Systems</p>
    <h2 class="font-display mt-4 text-4xl sm:text-5xl text-foreground" data-i18n="features.title">
      Your money and your crypto in one encrypted vault.
    </h2>
    <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-lg" data-i18n="features.description">
      A clean, offline-first suite for money and crypto.
    </p>
  </div>

  {screens.length > 0 && (
    <div class="reveal mt-10" data-reveal="right">
      <div
        class="sanctum-slider panel-gradient-strong rounded-3xl border border-border shadow-strong"
        data-slider
        data-interval={slideDuration * 1000}
      >
        <div class="sanctum-slider__frame">
          {screens.map((screen, index) => (
            <Image
              src={screen.src}
              alt={screen.alt}
              widths={[640, 1280, 1920]}
              sizes="(min-width: 1024px) 960px, 100vw"
              format="webp"
              quality={72}
              class={`sanctum-slider__slide${index === 0 ? " is-active" : ""}`}
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
        <button class="sanctum-slider__expand" type="button" data-expand aria-label="Expand image">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h6v6"/>
            <path d="M9 21H3v-6"/>
            <path d="M21 3l-7 7"/>
            <path d="M3 21l7-7"/>
          </svg>
        </button>
        <div class="sanctum-slider__controls">
          <button class="sanctum-slider__btn" type="button" data-prev aria-label="Previous screen">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>
          <button class="sanctum-slider__btn" type="button" data-next aria-label="Next screen">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
        <div class="sanctum-slider__dots" data-dots>
          {screens.map((screen, index) => (
            <button
              class={`sanctum-slider__dot${index === 0 ? " is-active" : ""}`}
              type="button"
              data-dot={index}
              aria-label={`Go to ${screen.alt}`}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-12">
    {pages.map((page, index) => (
      <div
        class="reveal panel-gradient-strong rounded-3xl border border-border p-6 panel-hover"
        style={`transition-delay: ${index * 90}ms`}
      >
        <h3 class="text-2xl font-semibold text-foreground" data-i18n={`features.pages.${page.key}.title`}>
          {page.title}
        </h3>
        <p class="mt-3 text-sm text-muted-foreground" data-i18n={`features.pages.${page.key}.description`}>
          {page.description}
        </p>
      </div>
    ))}
  </div>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    {highlights.map((item, index) => (
      <div
        class="reveal rounded-full border border-border px-4 py-2 text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground"
        style={`transition-delay: ${index * 80}ms`}
        data-reveal="right"
      >
        <span data-i18n={`features.highlights.${item.key}`}>{item.label}</span>
      </div>
    ))}
  </div>
</div>
