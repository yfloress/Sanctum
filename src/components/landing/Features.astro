---
// Features section - highlights key Sanctum capabilities based on app behavior

import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const screenshotsDir = path.resolve(process.cwd(), 'public', 'screenshots');

const preferredOrder = ['lock', 'dashboard', 'finances', 'crypto', 'habits', 'settings'];

const screenshotFiles = fs.existsSync(screenshotsDir)
  ? fs
      .readdirSync(screenshotsDir)
      .filter((name) => {
        const ext = name.split('.').pop()?.toLowerCase();
        return ext === 'png' || ext === 'jpg' || ext === 'jpeg';
      })
      .sort((a, b) => {
        const aBase = a.replace(/\.[^.]+$/, '').toLowerCase();
        const bBase = b.replace(/\.[^.]+$/, '').toLowerCase();
        const aIndex = preferredOrder.indexOf(aBase);
        const bIndex = preferredOrder.indexOf(bBase);
        if (aIndex !== -1 || bIndex !== -1) {
          if (aIndex === -1) return 1;
          if (bIndex === -1) return -1;
          return aIndex - bIndex;
        }
        return aBase.localeCompare(bBase);
      })
  : [];

const screens = screenshotFiles.map((name) => {
  const baseName = name.replace(/\.[^.]+$/, '');
  const label = baseName.replace(/[-_]+/g, ' ');
  const alt = `${label.charAt(0).toUpperCase()}${label.slice(1)} screen`;
  return { src: `${base}screenshots/${name}`, alt };
});

const slideDuration = 6;

const pages = [
  {
    key: 'dashboard',
    title: 'Dashboard',
    description: 'Net worth, trends, and a quick pulse of your vault.',
  },
  {
    key: 'finances',
    title: 'Finances',
    description: 'Accounts, categories, transfers, and everyday spending.',
  },
  {
    key: 'crypto',
    title: 'Crypto',
    description: 'Wallets, trades, swaps, and portfolio balance.',
  },
  {
    key: 'habits',
    title: 'Habits',
    description: 'Daily check-ins, streaks, and heatmap progress.',
  },
];

const highlights = [
  { key: 'languages', label: 'EN / ES' },
  { key: 'currency', label: 'USD / CLP' },
  { key: 'themes', label: 'Dark / Light' },
  { key: 'encryption', label: 'Encrypted Vault' },
];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="reveal text-center mb-12" data-reveal="left">
    <p
      class="text-xs font-semibold uppercase tracking-[0.4em] text-muted-foreground"
      data-i18n="features.tag"
    >Core Systems</p>
    <h2 class="font-display mt-4 text-4xl sm:text-5xl text-foreground" data-i18n="features.title">
      Four screens. One encrypted vault.
    </h2>
    <p class="mt-3 text-muted-foreground max-w-2xl mx-auto text-lg" data-i18n="features.description">
      A clean, offline-first suite for money, crypto, and habits.
    </p>
  </div>

  {screens.length > 0 && (
    <div class="reveal mt-10" data-reveal="right">
      <div
        class="sanctum-slider panel-gradient-strong rounded-3xl border border-border shadow-strong"
        data-slider
        data-interval={slideDuration * 1000}
      >
        <div class="sanctum-slider__frame">
          {screens.map((screen, index) => (
            <img
              src={screen.src}
              alt={screen.alt}
              class={`sanctum-slider__slide${index === 0 ? " is-active" : ""}`}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ))}
        </div>
        <div class="sanctum-slider__controls">
          <button class="sanctum-slider__btn" type="button" data-prev aria-label="Previous screen">
            <span aria-hidden="true">‹</span>
          </button>
          <button class="sanctum-slider__btn" type="button" data-next aria-label="Next screen">
            <span aria-hidden="true">›</span>
          </button>
        </div>
        <div class="sanctum-slider__dots" data-dots>
          {screens.map((screen, index) => (
            <button
              class={`sanctum-slider__dot${index === 0 ? " is-active" : ""}`}
              type="button"
              data-dot={index}
              aria-label={`Go to ${screen.alt}`}
            />
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mt-12">
    {pages.map((page, index) => (
      <div
        class="reveal panel-gradient-strong rounded-3xl border border-border p-6 panel-hover"
        style={`transition-delay: ${index * 90}ms`}
      >
        <h3 class="text-2xl font-semibold text-foreground" data-i18n={`features.pages.${page.key}.title`}>
          {page.title}
        </h3>
        <p class="mt-3 text-sm text-muted-foreground" data-i18n={`features.pages.${page.key}.description`}>
          {page.description}
        </p>
      </div>
    ))}
  </div>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    {highlights.map((item, index) => (
      <div
        class="reveal rounded-full border border-border px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground"
        style={`transition-delay: ${index * 80}ms`}
        data-reveal="right"
      >
        <span data-i18n={`features.highlights.${item.key}`}>{item.label}</span>
      </div>
    ))}
  </div>
</div>
